{
	conditions
	{
		
		if module "General GetCountB" <= 2.0 and
			if module "General GetCountB" > 1.0 goto SetZoneBDroneGroup3Init
		
		

		
		if Timer > 0.1 goto SetZoneBDroneGroup2
		
	}
	actions

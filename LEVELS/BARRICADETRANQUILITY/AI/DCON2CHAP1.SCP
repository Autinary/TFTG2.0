state Chapter1_Main
{
	conditions
	{
		;if module "D2C1WaveA1 Complete" == 1.0 goto Chapter1_MainWave2
		if module "D2C1Drone1 GetCountAlive" == 0.0 and
			if module "D2C1Drone2 GetCountAlive" == 0.0 and
				if module "D2C1Drone3 GetCountAlive" == 0.0 and
					if module "D2C1Drone4 GetCountAlive" == 0.0 goto Chapter1_MainWave2
		if module "D2C1KeyLocationA FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		SetMusic "ACTION Mission1_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter1_DeathFailMission"
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D2_ch1_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
			
		SendToModule "#General" "#PhysObj" "#SetPlayer=#Chapter1Start" "#FadeUp" "#CountASet=0"

		CreateModule "#KeyLocation" "#D2C1KeyLocationA" "#Spline=D2C1KeyLocA" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#Protect"
		

		;;AGC - THE CACHE COMMENTS MAY BE INCORRECT

		;;;;;;;;; Cache - [Default, TowTruck, Pickup]
		;CreateModule "#AttackWave" "#D2C1WaveA1" "#NoRender"
		;SendToModule "#D2C1WaveA1" "#CreateWave=#Wave1"
		;SendToModule "#D2C1WaveA1" "#Creature=DroneDefault_a"		"#Spline=D2C1WaveA" "#KeyLocation=On" 
		;SendToModule "#D2C1WaveA1" "#Creature=DroneDefault_a"		"#Spline=D2C1WaveA" "#SplineStep=2" "#KeyLocation=On"
		;SendToModule "#D2C1WaveA1" "#Creature=DroneTowTruck_a"		"#Spline=D2C1WaveA" "#SplineStep=4" "#KeyLocation=On" 
		;SendToModule "#D2C1WaveA1" "#Creature=DronePickupTruck_a"	"#Spline=D2C1WaveA" "#SplineStep=6" "#KeyLocation=On" 
		;SendToModule "#D2C1WaveA1" "#WaitEmpty" "#NoRender"

		CreateModule "#Creature" "#D2C1Drone1" "#Type=DroneDefault_a" "#Spline=D2C1WaveA" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementA" 
		CreateModule "#Creature" "#D2C1Drone2" "#Type=DroneDefault_a" "#Spline=D2C1WaveA" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementD" "#SpawnAsVehicle" 
		CreateModule "#Creature" "#D2C1Drone3" "#Type=DroneTowTruck_a" "#Spline=D2C1WaveA" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementB" "#SpawnAsVehicle"
		CreateModule "#Creature" "#D2C1Drone4" "#Type=DronePickupTruck_a" "#Spline=D2C1WaveA" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementC" "#SpawnAsVehicle"

		Idle 0.1 
		SendToModule "#D2C1Drone2" "#ForcePlayerAsOpp"

		
		;;;;;;;;; Cache - [TowTruck, Pickup, Pickup]
		
	}
}
state Chapter1_MainWave2
{
	conditions
	{
		;if module "D2C1WaveA2 Complete" == 1.0 goto Chapter1_MainBWaitTrigger
		if module "D2C1Drone1 GetCountAlive" == 0.0 and
			if module "D2C1Drone2 GetCountAlive" == 0.0 and
				if module "D2C1Drone3 GetCountAlive" == 0.0 and
					if module "D2C1Drone4 GetCountAlive" == 0.0 goto Chapter1_MainBWaitTrigger		

		if module "D2C1KeyLocationA FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		DestroyModule "#D2C1WaveA1"
		DestroyAllModules
		
		CreateModule "#Speech" "#DefeatDrones2" "#speech=#D2_ch1_obj4" "#AutoDestroy" "#Start"
		
		
		
		;CreateModule "#AttackWave" "#D2C1WaveA2" "#NoRender" "#RemoveBoss"
		;SendToModule "#D2C1WaveA2" "#Delay=2.0"
		;SendToModule "#D2C1WaveA2" "#CreateWave=#Wave1"
		;SendToModule "#D2C1WaveA2" "#Creature=DroneTowTruck_a"		"#Spline=D2C1WaveA" "#SplineStep=8" "#KeyLocation=On" 
		;SendToModule "#D2C1WaveA2" "#Creature=DroneDefault_a"		"#Spline=D2C1WaveA" "#SplineStep=10" "#KeyLocation=On" 
		;SendToModule "#D2C1WaveA2" "#Creature=DronePickupTruck_a"	"#Spline=D2C1WaveA" "#SplineStep=12" "#KeyLocation=On" 
		;SendToModule "#D2C1WaveA2" "#Creature=DronePickupTruck_a"	"#Spline=D2C1WaveA" "#SplineStep=14" "#KeyLocation=On" 
		;SendToModule "#D2C1WaveA2" "#WaitEmpty" "#NoRender" "#RemoveBoss"
		
		CreateModule "#Creature" "#D2C1Drone1" "#Type=DroneDefault_a" "#Spline=D2C1WaveA" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementE" "#SpawnAsVehicle"
		CreateModule "#Creature" "#D2C1Drone2" "#Type=DronePickupTruck_a" "#Spline=D2C1WaveA" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementF" "#SpawnAsVehicle"
		CreateModule "#Creature" "#D2C1Drone3" "#Type=DroneTowTruck_a" "#Spline=D2C1WaveA" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementH" "#SpawnAsVehicle"
		CreateModule "#Creature" "#D2C1Drone4" "#Type=DronePickupTruck_a" "#Spline=D2C1WaveA" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementG" "#SpawnAsVehicle"

		;Idle 0.1
		;CreateModule "#Timer" "#Destruction" "#Time=150.0" "#DrawHealthBar" "#HeadType=#Destruction" "#Index=2" "#Random"
		;CreateModule "#Timer" "#Destruction2" "#Time=150.0" "#DrawHealthBar" "#HeadType=#Destruction" "#Random"
		;DestroyModule "#Destruction"
		;DestroyModule "#Destruction2"
		
		
		
	}
}
state Chapter1_MainBWaitTrigger
{
	conditions
	{
		;if module "D2C1TriggerB InArea" == 1.0 goto Chapter1_MainB
		if timer > 5.0 and
			if module "D2C1KeyLocationB InArea" == 1.0 goto Chapter1_MainB
		if module "D2C1KeyLocationB FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		ResetTimer
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#BG_UnLoadCreature=DroneDefault_a"
		SendToModule "#General" "#BG_LoadCreature=DroneArmouredCar_a"
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D2_ch1_obj2" "#AutoDestroy" "#Start"
		CreateModule "#AreaRange" "#D2C1TriggerB" "#Trigger=#D2C1TriggerB" "#Beacon"
		CreateModule "#KeyLocation" "#D2C1KeyLocationB" "#Spline=D2C1KeyLocB" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#HeadType=#StarScream" "#Protect" "#NoProcess"
		CreateModule "#DelayedSend" "#DelayedSend" "#moduletag=#D2C1KeyLocationB" "#param=#Process" "#delay=10"
	}
}


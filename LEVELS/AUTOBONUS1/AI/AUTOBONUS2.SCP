state Chapter2_Enter
{
	conditions
	{
	
	}
	actions
	{
		DestroyAllModules 
		SetState Chapter2_Main
	}
}

state Chapter2_Main
{
	conditions
	{

	}
	actions
	{
		SetDeathPoint "Chapter2_DeathFailMission"
		;CreateModule "#Speech" "#DefeatDrones" "#speech=#D5C1GetAllSpark" "#AutoDestroy" "#Start"
		SendToModule "#General" "#PhysObj" "#SetPlayer=#Chapter2Start" "#FadeUp" "#PlayerType=Bumblebee"
		
		CreateModule "#Throwable" "#Throwable" "#Spline=Bonus1_Throw" "#MaxAlive=10" "#Type=TRQ_GENERIC20" "#Total=10" "#Random"
		
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=BONUS1_KEYLOC" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER"
		CreateModule "#Timer" "#Timer" "#Time=120.0"
		
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=10" "#IconType=#Drone" "#ModuleTag=#Throwable" "#GetPercentageComplete"
		
		SetState Chapter2_FindTheDonuts
		
	}
}

state Chapter2_FindTheDonuts
{
	conditions
	{
		  if module "KeyLocation FailMission" == 1.0 goto Chapter2_FailMission
		  if module "Timer" <= 0.0 goto Chapter2_FailMission
		  
		  if module "Throwable Complete" == 1.0 goto Chapter2_Complete
	}
	actions
	{
	
		
	}


}


state Chapter2_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter2_Restart
	}
	actions
	{
		SendToModule "#General" "#DeathFailMission"
	}
}
state Chapter2_FailMission
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter2_Restart
	}
	actions
	{
		SendToModule "#General" "#FailMission"
	}
}
state Chapter2_Restart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter2Restart" "#FadeUp"
		SetState "StartLevel"
	}
}
state Chapter2_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter2_CompleteVideo
	}
	actions
	{
		DestroyModule "#KeyLocation"
		SendToModule "#General" "#CompleteMission" 
	}
}



state Chapter2_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter2_CompleteVideoFinished
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartVideo=#D6C1LevelOutro"
	}
}
state Chapter2_CompleteVideoFinished
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter2_Leave
	}
	actions
	{
		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter2_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		IncreasePlayerHealth max
		setstate "FinishedLevel" 
	}
}

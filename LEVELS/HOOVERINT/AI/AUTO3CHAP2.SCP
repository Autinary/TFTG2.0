state Chapter2_PlayCameraA
{
	
	Actions
	{
		SetMusic "ACTION Mission2_2 QUIET Generic Play Action"
		SendToModule "#Timer" "#AddTime=90.0"
		SendToModule "#A3C2TunnelA" "#EndExplosion"
		SendToModule "#ProgressPoint" "#ClearAnyBeenTriggered"
		CreateModule "#SplineCamera" "#SplineCamera" "#SetPosition=A3C2CameraA" "#SetFocus=A3C2FocusA" "#CreatureMove=A3C2CreatureA" "#SetTime=3.5"
		SetState Chapter2_WaitForCam
	}
}


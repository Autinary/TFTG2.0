state base
{
	conditions
	{
	}
	actions
	{
		DrawConditionsFromThisScript
		CreateModule "#General" "#General" "#ProtectSystem"
		;CreateModule "#SubMissions" "#SubMissions" "#Spline=SubMissions" "#ProtectSystem"
		SendToModule "#General" "#AllowPlayerMovement"
		SetState "Main"
	}
}

state Main
{
	conditions
	{
;		if module "SubMissions GetSubMissionAnyBeenTriggered" == 1.0 goto SubMission_Init
	}
	actions
	{
		;SendToModule "#General" "#FadeUp"
		;SendToModule "#SubMissions" "#TurnON"
		;SendToModule "#General" "#FadeUp" "#ResetAll" "#SetPlayer=#StartMission" "#AllowPlayerMovement"
		
		SendToModule "#General" "#FadeUp" "#ResetAll" "#SetPlayer=#StartMission"
		DestroyAllModules "#IncludeProtected"
		SetDeathPoint "Death"


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;choose opponent
		;SetState "Wait"
		SetState "DroneArmouredCarTest"
		;SetState "BarricadeTest"
		;SetState "MegatronTest"
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
	}
}


state SubMission_Init
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission_Start
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#FadeDown"
	}
}

state SubMission_Start
{
	conditions
	{
		;if module "SubMissions GetSubMissionTriggered" == 1.0 goto SubMission1_Enter
		;if module "SubMissions GetSubMissionTriggered" == 2.0 goto SubMission2_Enter

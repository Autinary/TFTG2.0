		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelADust1" "#SetSplineType=#DustSmall" "#SetBitRadius=125"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelADust1" "#SetSplineType=#DustMedium" "#SetBitRadius=100"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelADust1" "#SetSplineType=#DustLarge" "#SetBitRadius=90"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelADust2" "#SetSplineType=#DustSmall" "#SetBitRadius=170"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelADust2" "#SetSplineType=#DustSmall" "#SetBitRadius=110"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelADust2" "#SetSplineType=#DustMedium" "#SetBitRadius=80"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelADust2" "#SetSplineType=#DustLarge" "#SetBitRadius=70"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelAExp1" "#SetSplineType=#ExplosionSmall" "#SetBitRadius=150"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelAExp1" "#SetSplineType=#ExplosionSmall" "#SetBitRadius=110"		
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelAExp1" "#SetSplineType=#ExplosionMedium" "#SetBitRadius=108"		
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelAExp2" "#SetSplineType=#ExplosionSmall" "#SetBitRadius=100"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelAExp2" "#SetSplineType=#ExplosionMedium" "#SetBitRadius=98"		

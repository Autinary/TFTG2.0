state Chapter3_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" "#FadeUp"
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A5_ch3_Goto"
		SetState "Chapter3_Goto"
	}
}
state Chapter3_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter3_HubRestart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter3_InitGoto
{
	actions
	{
		DestroyAllModules "#IncludeProtected"

		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
    	SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming

		SetState "Chapter3_Goto"
	}
}
state Chapter3_Goto
{
	actions
	{
		SendToModule "#General" "#AllowPlayerMovement"
		DestroyModule "#MissionStartSpeech"
		
		Idle 2.0
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A5_ch3_Goto" "#AutoDestroy" "#Start"
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A5_ch3_Goto2" "#AutoDestroy"
		Idle 3.0
		
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=60" "#times=1" 
		CreateModule "#AndSwitch" "#AndSwitchReminder" "#moduletag=#DelayedSendReminder" "#placement=#Chapter3Beacon" "#rangeoutside=75"
		SetState "GlobalActionRing"
	}
}
state Chapter3_Enter
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter3_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter3_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#A5C3Intro"
	}
}
state Chapter3_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter3_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter3_Main
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"

		SendToModule "#General" "#PlayerType=IronHide"  ; Jazz
		SendToModule "#General" "#UnLoadCreature=EnergonDrone"
		SendToModule "#General" "#UnLoadCreature=DroneForklift"
		SendToModule "#General" "#UnLoadCreature=DroneDefault"
		SendToModule "#General" "#LoadCreature=Brawl"
		SendToModule "#General" "#LoadCreature=DroneDefault"
		SendToModule "#General" "#LoadCreature=DronePickupTruck"
		SendToModule "#General" "#LoadCreature=DroneArmouredCar_a"
	}
}
;;state Chapter3_VideoIntro
;;{
;;	conditions
;;	{
;;		if module "General VideoFinished" == 1.0 goto Chapter3_Main
;;	}
;;	actions
;;	{
;;		DestroyAllModules 
;;		SendToModule "#General" "#EndMissionIntro" "#StartIntroVideo=#A5C3Intro"
;;	}
;;}
state Chapter3_Main
{
	conditions
	{
		if Timer > 0.2 goto Chapter3_MainLoop
	}
	actions
	{
		ResetTimer
		SetMusic "ACTION Mission3_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter3_DeathFailMission"
		CreateModule "#Speech" "#A5_ch3_obj1" "#speech=#A5_ch3_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#Chapter3Start" 

		SendToModule "#General" "#SetMaxOpponents=9" "#SetMaxApproachers=9" "#SetAttackRingSize=20"

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 4"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 4"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 4"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission

	}
}
state Chapter3_MainLoop
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter3_FailMission
		if module "BrawlCreature IsEnergyAtMin" == 1.0 goto Chapter3_BrawlDriveAwayToA

		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountA" == 1.0 goto Chapter3_HealF1A
	}
	actions
	{
		SendToModule "#General" "#FadeUp" "#CountASet=1"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=A5C3KeyLoc"  "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#HeadType=#Optimus" "#Timeout=30"
		CreateModule "#Goto" "#BrawlCreature" "#Spline=A5C3Brawl" "#Script=Brawl" "#Boss" "#count=1" "#maxalive=1" "#Type=Brawl" "#SpawnAsCreature" "#SpawnInLOSInit" "#SetEnergyMax=4000" "#SetHealth=4000" "#SetEnergyMin=100" "#BlockDeath" "#InhibitRubble"  ;"#SetEnergyMax=12100" 
		CreateModule "#Creature" "#Ratchet" "#Spline=A5C1KeyLoc" "#Type=DroneArmouredCar_a" "#count=1" "#maxalive=1" "#AddToRadar" "#SpawnAsCreature" "#SpawnInLOSInit" "#Script=Ratchet"  "#InVulnerable" "#SetEnergyMax=1500" "#SetEnergy=1500" "#SetEnergyMin=899.0" "#SetPosition=#RatchetSpawn3"
		
		CreateModule "#Creature" "#CreatureWaveA" "#Spline=A5C3Spawn" "#count=20000" "#maxalive=2" "#Type=DroneDefault" "#SpawnAsVehicle" "#KeyLocation=On" "#Script=CarDrone" "#SetEnergyMax=1000" "#SetHealth=1000"
		CreateModule "#Creature" "#CreatureWaveB" "#Spline=A5C3Spawn" "#count=20000" "#maxalive=2" "#Type=DronePickupTruck" "#SpawnAsVehicle" "#KeyLocation=On" "#Script=TruckDrone" "#SetEnergyMax=1200" "#SetHealth=1200"
		
	}
}
state Chapter3_HealF1A
{
	
	actions
	{
		DoMacro AutoHeal
		SetState Chapter3_PostMedicProcessF1A
		
	}
}
state Chapter3_PostMedicProcessF1A
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter3_FailMission
		if module "BrawlCreature IsEnergyAtMin" == 1.0 goto Chapter3_BrawlDriveAwayToA

		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountA" == 1.0 goto Chapter3_HealF1A
	}
	
}
state Chapter3_HealF1B
{
	
	actions
	{
		DoMacro AutoHeal
		SetState Chapter3_PostMedicProcessF1B
		
	}
}
state Chapter3_HealF1B2
{
	
	actions
	{
		CreateModule "#Speech" "#A5_ch3_obj3" "#speech=#A5_ch3_obj3" "#AutoDestroy" "#Start"
		DoMacro AutoHeal
		SetState Chapter3_PostMedicProcessF1B
		
	}
}
state Chapter3_PostMedicProcessF1B
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter3_FailMission
		if module "BrawlCreature Complete" == 1.0 goto Chapter3_BrawlArrivedAtA
		if module "CreatureWaveA Energy" <= 0.0 and
			if module "CreatureWaveB Energy" <= 0.0 goto Chapter3_PlayerDriveToBrawlAEarly

		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountA" == 1.0 goto Chapter3_HealF1B
	}
	
}
state Chapter3_HealF1C
{
	
	actions
	{
		DoMacro AutoHeal
		SetState Chapter3_PostMedicProcessF1C
		
	}
}
state Chapter3_PostMedicProcessF1C
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter3_FailMission
		if module "Timer Timer" < 0.0 goto Chapter3_FailMission
		if module "CreatureWaveA Energy" <= 0.0 and
			if module "CreatureWaveB Energy" <= 0.0 goto Chapter3_PlayerDriveToBrawlA
		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountA" == 1.0 goto Chapter3_HealF1C
	}
	
}
state Chapter3_BrawlDriveAwayToA
{
	conditions
	{
		if module "Ratchet PlayerRange" < 30 and  
			if Timer < 4.0 and 
				if module "General GetCountA" == 1.0 goto Chapter3_HealF1B2

		if module "KeyLocation FailMission" == 1.0 goto Chapter3_FailMission
		if module "BrawlCreature Complete" == 1.0 goto Chapter3_BrawlArrivedAtA
		if module "CreatureWaveA Energy" <= 0.0 and
			if module "CreatureWaveB Energy" <= 0.0 goto Chapter3_PlayerDriveToBrawlAEarly

		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountA" == 1.0 goto Chapter3_HealF1B
	}
	actions
	{
		
		ResetTimer 
		SendToModule "#BrawlCreature"  "#RemoveBoss" "#DirectSpline=A5C3BrawlRouteA" "#Script=FollowSplineVeh" "#Unstoppable" "#AddToRadarOff" 
		SendToModule "#CreatureWaveA" "#count=2"  
		SendToModule "#CreatureWaveB" "#count=2" 
		Idle 4.0
		CreateModule "#Speech" "#A5_ch3_obj3" "#speech=#A5_ch3_obj3" "#AutoDestroy" "#Start"
	}
}
state Chapter3_BrawlArrivedAtA
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter3_FailMission
		if module "Timer Timer" < 0.0 goto Chapter3_FailMission
		if module "CreatureWaveA Energy" <= 0.0 and
			if module "CreatureWaveB Energy" <= 0.0 goto Chapter3_PlayerDriveToBrawlA
		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountA" == 1.0 goto Chapter3_HealF1C
	}
	actions
	{
		SendToModule "#BrawlCreature" "#Script=TurnToShoot"
		Idle 1.6 
		
	}
}
state Chapter3_PlayerDriveToBrawlAEarly
{
	conditions
	{
		if module "BrawlCreature PlayerRange" <= 60.0 goto Chapter3_PlayerReachedBrawlA
		if module "Timer Timer" < 0.0 goto Chapter3_FailMission
		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		
	}
	actions
	{
		SetMusic "ACTION Mission3_2 QUIET Generic Play Action"
		SendToModule "#General" "#BG_UnLoadCreature=DronePickupTruck"
		SendToModule "#General" "#BG_LoadCreature=DroneArmouredCar"
		SendToModule "#Ratchet" "#Script=FollowSplineTC" "#TransformForceCar" "#AddToRadarOff"
		
		
		SendToModule "#BrawlCreature" "#SetPosition=#BrawlSpawn1" "#Script=TurnToShoot"
		Idle 1.6 
		SendToModule "#BrawlCreature" "#AddToRadar" "#SetEnergy=4000" "#SetEnergyMin=100"
		
		DestroyModule "#KeyLocation"
		CreateModule "#Timer" "#Timer" "Time=45.0" "#Start"
		CreateModule "#Speech" "#A5_ch3_obj2" "#speech=#A5_ch3_obj2" "#AutoDestroy" "#Start"

	}
}
state Chapter3_PlayerDriveToBrawlA
{
	conditions
	{
		if module "BrawlCreature PlayerRange" <= 60.0 goto Chapter3_PlayerReachedBrawlA
		if module "Timer Timer" < 0.0 goto Chapter3_FailMission
		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		
	}
	actions
	{
		SetMusic "ACTION Mission3_2 QUIET Generic Play Action"
		SendToModule "#General" "#BG_UnLoadCreature=DronePickupTruck"
		SendToModule "#General" "#BG_LoadCreature=DroneArmouredCar"

		

		SendToModule "#BrawlCreature" "#AddToRadar" "#SetEnergy=4000" "#SetEnergyMin=100"
		SendToModule "#Ratchet" "#Script=FollowSplineTC" "#TransformForceCar" "#AddToRadarOff"
		DestroyModule "#KeyLocation"
		CreateModule "#Timer" "#Timer" "Time=45.0" "#Start"
		CreateModule "#Speech" "#A5_ch3_obj2" "#speech=#A5_ch3_obj2" "#AutoDestroy" "#Start"

	}
}
state Chapter3_PlayerReachedBrawlA
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter3_FailMission
		if module "BrawlCreature IsEnergyAtMin" == 1.0 goto Chapter3_BrawlDriveAwayToB

		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountA" == 1.0 goto Chapter3_HealF2A
	}
	actions
	{
		DestroyModule "#Timer"
		DestroyModule "#CreatureWaveA"
		DestroyModule "#CreatureWaveB"
		SetMusic "ACTION Mission3_1 QUIET Generic Play Action"
		DestroyModule "#A5C3TriggerA"
		SendToModule "#Ratchet" "#Script=Ratchet" "#TransformForceRobot" "#AddToRadar" "#SetPosition=#RatchetSpawn4"
		DestroyModule "#KeyLocation"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=A5C3KeyLocA" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#HeadType=#Optimus" "#Timeout=30"
		SendToModule "#BrawlCreature" "#Script=Brawl" "#Stoppable" "#EnableBoss" 
		SendToModule "#BrawlCreature" "#AddToRadar"
		Idle 2.0 
		CreateModule "#Creature" "#CreatureWaveA" "#Spline=Spawn3" "#count=80000" "#maxalive=3" "#Type=DroneDefault" "#SpawnAsVehicle" "#KeyLocation=On" "#Script=CarDrone" "#SetEnergyMax=1000" "#SetHealth=1000"
		
	}
}

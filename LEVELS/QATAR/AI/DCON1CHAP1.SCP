		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj5" "#AutoDestroy" 
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj6" "#AutoDestroy" 
                CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj7" "#AutoDestroy" 
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=30" "#times=4" 
	
		SetState Chapter1_Process
	}


}

		;if module "EnergonDrone GetCountAlive" == 0.0 goto Chapter1_AllSparkHunt3

		;if Timer > 6.0 and 
		;	if module "SplineObj StopSpawn" == 1.0 goto Chapter1_EnergonDroneAssault4

		if module "CubeSecret FoundRand" == 1.0 goto Chapter1_StopAssault

		if module "Optimus Dead" == 1.0 goto Chapter1_LastOneStanding
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission

	}
	Actions
	{
		ResetTimer 
		
		
		Idle 0.1
		SendToModule "#SplineObj" "#Creature=#EnergonDrone" "#MaxAlive=10" "#StartSpawn=7" "#SpawnSpline=D6C1BUILD10" "#ForcePlayerAsOpp"

		
	}

}
state Chapter1_EnergonDroneAssault4
{
	Conditions
	{
		;if timer >= 6.0 and
		;if module "EnergonDrone GetCountAlive" == 0.0 goto Chapter1_AllSparkHunt3

		if Timer > 6.0 and 
			if module "SplineObj StopSpawn" == 1.0 goto Chapter1_EnergonDroneAssault3

		if module "CubeSecret FoundRand" == 1.0 goto Chapter1_StopAssault

		if module "Optimus Dead" == 1.0 goto Chapter1_LastOneStanding
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	Actions
	{
		ResetTimer 
		
		SendToModule "#SplineObj" "#Creature=#EnergonDrone" "#MaxAlive=10" "#StartSpawn=7" "#SpawnSpline=D6C1BUILD10" "#ForcePlayerAsOpp"

		
	}

}
state Chapter1_StopAssault
{
	Conditions
	{
		

		if module "Optimus Dead" == 1.0 goto Chapter1_Complete
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission

	}
	Actions
	{
		DestroyModule "#CubeSecret"
		DestroyModule "#AllSpark"
		CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6LOC4_ALLSPARK" "#Wobble=2.0" "#Creature=#Creature" "#Time=20.0" "#NoDraw" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference"
		
		SendToModule "#General" "#SetMessage=DCB3" "#SetMessageTimer=3"
		SendToModule "#EnergonDrone2" "#count=8"
	}

}
state Chapter1_LastOneStanding
{
	Conditions
	{
		
		if module "CubeSecret FoundRand" == 1.0 goto Chapter1_Complete2

		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission

	}
	Actions
	{
		
		CreateModule "#Speech" "#D6_ch1_obj14" "#speech=#D6_ch1_obj14" "#AutoDestroy" "#Start"
		Idle 4.0
		SendToModule "#General" "#SetMessage=DCB4" "#SetMessageTimer=3"
		SendToModule "#EnergonDrone2" "#count=8" "#SetEnergy=0" "#ForcePlayerAsOpp"
	}

}
;end of location 4



state Chapter1_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_Restart
	}
	actions
	{
		SendToModule "#General" "#EndOfMission"  "#DeathFailMission"
	}
}
state Chapter1_FailMission
{
	
	actions
	{
		SendToModule "#General" "#SetRadarInterference=0"
		SetState Chapter1_FailMission2
	}
}
state Chapter1_FailMission2
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter1_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state Chapter1_Restart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		
		SendToModule "#General" "#UnLoadCreature=OptimusPrime"
		
		SendToModule "#General" "#UnLoadCreature=StarScream"
		SendToModule "#General" "#UnLoadCreature=Blackout"
		
		SendToModule "#General" "#UnLoadCreature=DronePickupTruck_a"
    	SendToModule "#General" "#UnloadCreature=DroneMig_a"
		SendToModule "#General" "#UnloadCreature=DroneCement_a"
		SendToModule "#General" "#UnloadCreature=DroneDefault_a"
		SendToModule "#General" "#UnloadCreature=DroneTowTruck_a"


		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter1Restart" "#FadeUp"
		SetState GlobalActionRing
	}
}
state Chapter1_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter1_CompleteVideo
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT1" "#Spline=COMCAM1" "#SetFocus=CAMFOCUS1"
		DestroyModule "#KeyLocation"
		SendToModule #General #UnlockBonus=Character_DecepticonCampaign
		CreateModule "#ActionRing" "#ActionRing" "#ProtectSystem" "#AddToRadarOff"
		SendToModule "#ActionRing" "#CreateChapter=#Chapter1"
		SendToModule "#ActionRing" "#SetCompleted=#Chapter1" "#Unlock=#Chapter1"
		SendToModule "#General" "#CompleteMission" "#LevelCompleteAchievement"

		CreateModule "#Speech" "#D6_ch1_obj14" "#speech=#D6_ch1_obj14" "#PlayDelay=1.2" "#AutoDestroy" "#Start"
	}
}
state Chapter1_Complete2
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter1_CompleteVideo
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT1" "#Spline=COMCAM1" "#SetFocus=CAMFOCUS1"
		DestroyModule "#KeyLocation"
		SendToModule #General #UnlockBonus=Character_DecepticonCampaign
		CreateModule "#ActionRing" "#ActionRing" "#ProtectSystem" "#AddToRadarOff"
		SendToModule "#ActionRing" "#CreateChapter=#Chapter1"
		SendToModule "#ActionRing" "#SetCompleted=#Chapter1" "#Unlock=#Chapter1"
		SendToModule "#General" "#CompleteMission" "#LevelCompleteAchievement"

	}
}
state Chapter1_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_CompleteVideoFinished
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartCampaignOutro=#D6C1LevelOutro"
	}
}
state Chapter1_CompleteVideoFinished
{
	conditions
	{
;		if module "General GetFinishedOutro" == 1.0 goto Chapter1_Leave
	}
	actions
	{
		SendToModule "#General" "#FinishedOutroVideo"
		SendToModule "#General" "#HoldOnBlackScreen"
		SendToModule "#General" "#FinishedLevel"
		;SetState Chapter1_Leave	Go Back to front end so dont do this
	}
}
state Chapter1_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		IncreasePlayerHealth max
		SendToModule "#General" "#SetPlayerDeathPoint=#COMPPOINT1"
		SendToModule #General #AllowPlayerMovement
		SetState GlobalActionRing
	}
}

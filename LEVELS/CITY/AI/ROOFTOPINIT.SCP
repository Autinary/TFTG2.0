{
	conditions
	{
		
		if module "General GetCountB" <= 1.0 goto SetZoneBDroneGroup2Init
		
		

		
		if Timer > 0.1 goto SetZoneBDroneGroup1
		
	}
	actions
	{
		ResetTimer 
	}

}

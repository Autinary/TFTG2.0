state Chapter3_Watch_Alt
{
	conditions
	{
		;;;LEVEL COMPLETE STATES;;;; --- if all dead ----
		if module "GotoDroneA GetPercentageComplete" == 1.0 and
			if module "GotoDroneB GetPercentageComplete" == 1.0 and
				if module "GotoDroneC GetPercentageComplete" == 1.0 and
					if module "GotoDroneD GetPercentageComplete" == 1.0 and
						if module "GotoDroneE GetPercentageComplete" == 1.0 and
							if module "GotoDroneF GetPercentageComplete" == 1.0 and
								if module "GotoDroneG GetPercentageComplete" == 1.0 and
									if module "GotoDroneH GetPercentageComplete" == 1.0 goto Chapter3_Complete_Alt
						
		;;;GAME OVER STATES;;;;; --- if timer reaches end -----		
		if module "Timer FailMission" == 1.0 goto Chapter3_FailMission_Alt						

		;;STOP TIMER STATES;;;;; -- if dead add time on
		if module "GotoDroneA CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeA_Alt
		if module "GotoDroneB CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeB_Alt
		if module "GotoDroneC CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeC_Alt
		if module "GotoDroneD CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeD_Alt
		if module "GotoDroneE CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeE_Alt
		if module "GotoDroneF CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeF_Alt
		if module "GotoDroneG CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeG_Alt
		if module "GotoDroneH CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeH_Alt
	}

}

state Chapter3_DeathFailMission_Alt
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter3_Restart_Alt
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter3_FailMission_Alt
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter3_Restart_Alt
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state Chapter3_Restart_Alt
{
	actions
	{
		DestroyAllModules "#IncludeProtected"

		
		SendToModule "#General" "#PlayerType=Blackout,Blackout,Blackout,Blackout"
		SendToModule "#General" "#ResetAll" "#SetPlayerAtDeathPoint" "#FadeUp"
		
		SendToModule "#General" "#ResponseLvPlayerDetected=5"

		SetState "Exit"
	}
}
state Chapter3_Complete_Alt
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter3_CompleteVideo_Alt
	}
	actions
	{
		DestroyModule "#Timer"
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT25" "#Spline=COMCAM2" "#SetFocus=CAMFOCUS2"
		SendToModule "#General" "#CompleteMission" 
		SendToModule "#ActionRing" "#SetCompleted=#Chapter3" "#Unlock=#Chapter4"
               
	}
}
state Chapter3_CompleteVideo_Alt
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter3_CompleteVideoFinished_Alt
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		;SendToModule "#General" "#StartOutroVideo=#D1C3Outro1" ;#D1C2Outro1"
	}
}
state Chapter3_CompleteVideoFinished_Alt
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter3_Leave_Alt
	}
	actions
	{
		SendToModule "#General" "#PlayerType=Blackout,Blackout,Scorponok,Blackout"
		SendToModule "#General" "#SetPlayer=#COMPPOINT25"
		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter3_Leave_Alt
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter4"
		SendToModule "#General" "#SetPlayerDeathPoint=#COMPPOINT2"
		
		SendToModule "#General" "#ResponseLvPlayerDetected=5"

		IncreasePlayerHealth max
		setstate "PickGoto2"
	}
}

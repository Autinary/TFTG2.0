state Chapter4_RespawnDrones
{
	
	actions
	{
		DestroyModule "#CreatureWaveA"
		DestroyModule "#CreatureWaveB"
		CreateModule "#Creature" "#CreatureWaveA" "#Spline=A5C3Spawn" "#count=1" "#maxalive=1" "#Type=DroneForklift" "#SpawnAsVehicle"  "#Script=ForkliftDrone" "#SetEnergyMax=800" "#SetHealth=800" "#Protect" 
		CreateModule "#Creature" "#CreatureWaveB" "#Spline=A5C3Spawn" "#count=1" "#maxalive=1" "#Type=DronePickupTruck" "#SpawnAsCreature" "#Script=TruckDrone" "#SetEnergyMax=1200" "#SetHealth=1200"  "#Protect" 
		SendToModule "#General" "#CountSet=1" "#CountBSet=1"
		SetState Chapter4_ThirdPart
	}
}
state Chapter4_ThirdPart
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter4_FailMission
		if module "BarricadeCreature IsEnergyAtMin" == 1.0 goto Chapter4_FourthPartIntro

		;if module "CreatureWaveA GetCountAlive" == 0.0 and
		;	if module "General GetCount" == 1.0 goto Chapter4_DroneAP2Death
		;if module "CreatureWaveB GetCountAlive" == 0.0 and
		;	if module "General GetCountB" == 1.0 goto Chapter4_DroneBP2Death
		;if module "CreatureWaveC GetCountAlive" == 0.0 and
		;	if module "General GetCountC" == 1.0 goto Chapter4_DroneCP2Death
		;if module "CreatureWaveD GetCountAlive" == 0.0 and
		;	if module "General GetCountD" == 1.0 goto Chapter4_DroneDP2Death
	}
	actions
	{
		DestroyAllModules
		CreateModule "#Creature" "#BarricadeCreature" "#Spline=A5C4BarricadeB" "#count=1" "#maxalive=1" "#addtoradar" "#Boss=#Barricade" "#Type=Barricade" "#SpawnInLosInit" "#Script=Barricade" "#SetPosition=#BarricadeSpawn2"
		SendToModule "#BarricadeCreature" "#SetEnergyMax=1799.0" "#SetEnergy=1799.0" "#SetEnergyMin=2.0"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=A5C4BarricadeB" "#Radius=125" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key14Return" "#HeadType=#Ironhide" 
		CreateModule "#Speech" "#A5C4StopBarricade"  "#PlayDelay=2"  "#speech=#A5_ch4_obj4" "#Start" "#AutoDestroy" 
		CreateModule "#SplineExplode" "#RadarSplinePoint" "#Spline=A5C4SamB" "#MilesPerHour=60" "#AddToRadar" "#Start"
		SendToModule "#General" "#PhysObj"  "#FadeUp" "#SetPlayer=#Chapter4StartB" "#BarricadeHelpOn"
		
		
		SendToModule "#CreatureWaveA" "#SetPosition=#ForkDroneSpawn3" 
		SendToModule "#CreatureWaveB" "#SetPosition=#TruckDroneSpawn3" 
		SendToModule "#CreatureWaveC" "#SetPosition=#ForkDroneSpawn4"
		SendToModule "#CreatureWaveD" "#SetPosition=#TruckDroneSpawn4"
		;SetState Chapter4_P2Process
	}
}

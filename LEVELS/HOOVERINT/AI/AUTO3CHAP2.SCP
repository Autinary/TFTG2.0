state Chapter2_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" "#FadeUp"
		SetState "Chapter2_Goto"
	}
}
state Chapter2_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter2_HubRestart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter2_InitGoto
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		
		SendToModule "#General" "#LevelSpecialOff=1"
		SetState "Chapter2_Goto"


		SendToModule "#General" "#TrafficLv = 4"                       
		SendToModule "#General" "#PatrolLv = 1"                        

		SendToModule "#General" "#ResponseLv_FreeRoam"                  
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            
    	SendToModule "#General" "#ResponseLv_ClampMax   = 3"            
		SendToModule "#General" "#ResponseLv_Detection  = 0"    
		SendToModule "#General" "#ResponseLv_FreeRoamSet"      
	}
}
state Chapter2_Goto
{
	actions
	{
		SendToModule "#General" "#AllowPlayerMovement"
		
		DestroyModule "#MissionStartSpeech"
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=60" "#times=1" 
		CreateModule "#AndSwitch" "#AndSwitchReminder" "#moduletag=#DelayedSendReminder" "#placement=#Chapter2Beacon" "#rangeoutside=75"
        CreateModule "#AAGun" "#AAGun"
		SendToModule "#AAGun" "#Type=AAGUNTYPE_BULLITS" "#Placement=TurretRocketGlobal" "#Range=100.0" "#Delay=5.0" "#Energy=100.0" "#RespawnDelay=30" "#Ammo=0" "#Create"

		Idle 2.0
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A3_ch2_Goto2" "#AutoDestroy" "#Start"
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A3_ch2_Goto" "#AutoDestroy" 
		Idle 3.0

		SetState "GlobalActionRing"
	}
}
state Chapter2_Enter
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter2_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter2_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules 
		
		SendToModule "#General" "#StartMissionIntro"
	}
}
state Chapter2_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter2_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter2_Main
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"
	}
}

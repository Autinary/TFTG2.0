		SendToModule "#DroneCounter" "#Increment=1"
		SendToModule "#DroneCounter2" "#Increment=1"

		SendToModule "#GunShip1" "#maxalive=2"
		
		SetState "Chapter1_CheckAreas"
	}
}

state Chapter1_DeathFailMission
{
	conditions
	{
		
		if module "General ChapterProgress" == 0.0 and
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_Restart
		
		if module "General ChapterProgress" >= 1.0 and
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_TurnInterferenceOff
		
	
	}
	actions
	{
		SendToModule "#General" "#EndOfMission"  "#DeathFailMission"
	}
}
state Chapter1_FailMission
{
	conditions
	{
	
		if module "General ChapterProgress" == 0.0 and
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter1_Restart
		
		if module "General ChapterProgress" >= 1.0 and
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter1_TurnInterferenceOff
		
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}

state Chapter1_TurnInterferenceOff
{
	actions
	{
		SendToModule "#General" "#SetRadarInterference=0"
		SetState Chapter1_Restart
	}
}

state Chapter1_Restart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#UnLoadCreature=Blackout" 
		SendToModule "#General" "#UnLoadCreature=TripleC" 
	
		
		SendToModule "#General" "#PlayerType=StarScream,StarScream,StarScream,StarScream,StarScream"
    	SendToModule "#General" "#ResetLevelCharacters" "#DangerZoneOff"

		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission4" "#FadeUp"
		SetState "GlobalActionRing"
	}
}
state Chapter1_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter1_CompleteVideo
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT1" "#Spline=COMCAM1" "#SetFocus=CAMFOCUS1"
		DestroyModule "#DroneCounter"
		SendToModule "#General" "#CompleteMission" "#DangerZoneOff"
		SendToModule "#ActionRing" "#SetCompleted=#Chapter1" "#Unlock=#Chapter2"
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D3_ch1_obj5" "#PlayDelay=1.2" "#AutoDestroy" "#Start"
	}
}
state Chapter1_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_CompleteVideoFinished
	}
	actions
	{
		ResetTimer
		IncreasePlayerHealth max
		SendToModule "#General" "#DeleteRadarFreeInterferenceZones"
		SendToModule "#General" "#SetRadarInterference=0"
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartOutroVideo=#D3C1Outro1"
	}
}
state Chapter1_CompleteVideoFinished
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter1_Leave
	}
	actions
	{
	SendToModule "#General" "#UnLoadCreature=Blackout" 
	SendToModule "#General" "#UnLoadCreature=TripleC" 
	
		
    	SendToModule "#General" "#PlayerType=StarScream,StarScream,StarScream,StarScream,StarScream"
		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter1_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter2"
		IncreasePlayerHealth max

		SendToModule "#General" "#DeleteRadarFreeInterferenceZones"
		SendToModule "#General" "#SetRadarInterference=0"

		setstate "PickGoto" ;goto next chapter
	}
}

state Chapter4_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" "#FadeUp"
		SetState "Chapter4_Goto"
	}
}
state Chapter4_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter4_HubRestart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter4_InitGoto
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SetState "Chapter4_Goto"
	}
}
state Chapter4_Goto
{
	actions
	{
		SendToModule "#General" "#AllowPlayerMovement"
		DestroyModule "#MissionStartSpeech"
		
		Idle 2.0
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D2_ch4_Goto2" "#AutoDestroy" "#Start"
		;CreateModule "#Speech" "#FrenzySpeech" "#speech=#D2_ch4_Goto" "#AutoDestroy" "#Start"
		Idle 3.0
		
		CreateModule "#Timer" "#FrenzySpeech" "#Time=60" "#NoRender"
		;CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=60" "#times=1" 
		CreateModule "#AndSwitch" "#AndSwitchReminder" "#moduletag=#DelayedSendReminder" "#placement=#Chapter4Beacon" "#rangeoutside=75"
		SetState "GlobalActionRing"
	}
}
state Chapter4_Enter
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter4_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter4_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#D2C4Intro"
	}
}
state Chapter4_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter4_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter4_Main
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"
    	SendToModule "#General" "#LoadCreature=BumbleBee"
	;SendToModule "#General" "#LoadCreature=OptimusPrime"
    	SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#PlayerType=Barricade"
	}
}
;;state Chapter4_VideoIntro
;;{
;;	conditions
;;	{
;;		if module "General VideoFinished" == 1.0 goto Chapter4_Main
;;	}
;;	actions
;;	{
;;		DestroyAllModules 
;;		SendToModule "#General" "#EndMissionIntro" "#StartIntroVideo=#D2C4Intro"
;;	}
;;}
state Chapter4_Main
{
	conditions
	{
		if module "D2C4SpawnA IsEnergyAtMin" == 1.0 goto Chapter4_MainBChaseEnter
		if module "D2C4KeyLocA FailMission" == 1.0 goto Chapter4_FailMission 
	        
	}
	actions
	{
		SetMusic "ACTION Mission4_1 QUIET Generic Play Action"
		DestroyAllModules "#IncludeProtected"
		SetDeathPoint "Chapter4_DeathFailMission"
		
;		CreateModule "#VehicleLevels" "#VehicleLevels" "#ResponseLv=5" "#TrafficLv=1" "#PatrolLv=0" "#Protect"
		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission

		CreateModule "#Speech" "#D2C4DefeatBumblebee" "#speech=#D2_ch4_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		SendToModule "#General" "#PhysObj" "#SetPlayer=#Chapter4Start" "#FadeUp" "#CountASet=0"
		CreateModule "#Creature" "#D2C4SpawnA" "#Spline=D2C4SpawnA" "#Boss" "#Type=Bumblebee" "#SpawnInLosInit" "#SetPosition=#D2C4StartA" "#SpawnAsVehicle" "#AddToRadarAlways" "#BlockDeath" 
		SendToModule "#D2C4SpawnA" "#SetEnergyMax=600" "#SetHealth=600" "#SetEnergyMin=2.0" 
		
		CreateModule "#KeyLocation" "#D2C4KeyLocA" "#Creature=#D2C4SpawnA" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key2Return" "#HeadType=#StarScream" "#Radius=150"
		CreateModule "#SplineExplode" "#D2C4SamA" "#Spline=D2C4SamA" "#MilesPerHour=65" "#AddToRadar=#SamIcon" "#Start"
		Idle 0.3 
		SendToModule "#D2C4SpawnA" "#TransformForceRobot"
	}
}
state Chapter4_MainBChaseEnter
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter4_MainBChase
	}
	actions
	{
		SendToModule "#General" "#StartVideo=#D2C4Midtro1"
	}
}
state Chapter4_MainBChase
{
	conditions
	{
		if module "D2C4TriggerB InArea" == 1.0 goto Chapter4_MainBFightEnter
		if module "D2C4RaceB GetPercentage" == 1.0 goto Chapter4_MainBWait
	}
	actions
	{
		SetMusic "ACTION Mission4_2 QUIET Generic Play Action"
		DestroyAllModules
		
		CreateModule "#Speech" "#D2_ch4_obj6" "#speech=#D2_ch4_obj4" "#AutoDestroy" "#Start"
		SendToModule "#General" "#SetMessage=Key4Goto" "#SetMessageTimer=5" "#SetPlayer=#D2C4RepositionA"
		CreateModule "#SplineExplode" "#D2C4RaceB" "#Spline=D2C4Goto1" "#MilesPerHour=80" "#AddToRadar=#AutoBotRadarIconNotClamped" "#Start"
		CreateModule "#SplineExplode" "#D2C4WaitB" "#Spline=D2C4SpawnB" "#AddToRadar=#GreenMediumDot"
		CreateModule "#AreaRange" "#D2C4TriggerB" "#Trigger=#D2C4TriggerB" "#ParticleRing"
	}
}
state Chapter4_MainBWait
{
	conditions
	{
		if module "D2C4TriggerB InArea" == 1.0 goto Chapter4_MainBFightEnter
		if module "D2C4TimerB FailMission" == 1.0 goto Chapter4_FailMission
	}
	actions
	{
		DestroyModule "#D2C4RaceB"
		CreateModule "#Timer" "#D2C4TimerB" "#time=45.0"
	}
}
state Chapter4_MainBFightEnter
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter4_MainBFight
	}
	actions
	{
		SendToModule "#General" "#StartVideo=#D2C4Midtro2"
	}
}
state Chapter4_MainBFight
{
	conditions
	{
		if module "D2C4SpawnB IsEnergyAtMin" == 1.0 goto Chapter4_MainCChaseEnter
		if module "D2C4SpawnB BeenHit" == 1.0 goto Chapter4_BeeHit
		if module "D2C4KeyLocB FailMission" == 1.0 goto Chapter4_FailMission
	}
	actions
	{
		SetMusic "ACTION Mission4_1 QUIET Generic Play Action"
		DestroyAllModules
		CreateModule "#Speech" "#D2C4DefeatBumblebee" "#speech=#D2_ch4_obj2" "#AutoDestroy" "#Start"
		SendToModule "#General" "#SetPlayer=#D2C4FightPosBC1"
		CreateModule "#Creature" "#D2C4SpawnB" "#Spline=D2C4SpawnB" "#Boss" "#Type=Bumblebee" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Agile" "#SetPosition=#D2C4FightPosBB1"
		SendToModule "#D2C4SpawnB" "#SetEnergyMax=900" "#SetHealth=900" "#SetEnergyMin=2.0"
		CreateModule "#KeyLocation" "#D2C4KeyLocB" "#Creature=#D2C4SpawnB" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key2Return" "#HeadType=#StarScream" "#Radius=150"
		CreateModule "#SplineExplode" "#D2C4SamB" "#Spline=D2C4SamB" "#MilesPerHour=65" "#AddToRadar=#SamIcon" "#Start"
	}
}
state Chapter4_BeeHit
{
	conditions
	{
		if module "D2C4SpawnB IsEnergyAtMin" == 1.0 goto Chapter4_MainCChaseEnter
		if Timer > 1.2 goto Chapter4_HoldIt 
		if module "D2C4KeyLocB FailMission" == 1.0 goto Chapter4_FailMission
		if module "D2C4SpawnC IsEnergyAtMin" == 1.0 goto Chapter4_MainDChaseEnter
		if module "D2C4KeyLocC FailMission" == 1.0 goto Chapter4_FailMission
		if module "D2C4SpawnD Dead" == 1.0 goto Chapter4_BumbleBeeDead
		if module "Creature GetPercentageComplete" == 1.0 goto Chapter4_DronesDead
		if module "D2C4KeyLocD FailMission" == 1.0 goto Chapter4_FailMission
	}
	actions
	{
		ResetTimer
		SendToModule "#D2C4SpawnB" "#SetHealth=800" ;Off"
		SendToModule "#D2C4SpawnC" "#SetHealth=900" ;Off"
		SendToModule "#D2C4SpawnD" "#SetHealth=1175" ;Off"
		
	}
}

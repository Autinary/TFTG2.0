;push all drones out of key location within time limit
;player and drones are invincible
;if anyone leaves area instant death

;requires:
;	Keylocation spline 				KeyLoc#
;	Spawn spline for type 1 creatures		Spawn#a
;	Spawn spline for type 2 creatures		Spawn#b

;Changeable params:
;	300		time in which to complete the mission
;	10	total number of creature type 1 that need to be killed
;	10	total number of creature type 2 that need to be killed
;	2		total creature type 1 that are simultaneously active 
;	2		total creature type 2 that are simultaneously active 
;	DroneTowTruck_a	type of creature one to fight against
;	DronePickupTruck_a	type of creature two to fight against
;						DroneForkLift
;						DroneTowTruck
;						DroneArmouredCar
;						DroneCement
;						DronePickupTruck
;						DroneMig
;						BumbleBee
;						Barricade


state SubMission4_Enter
{
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"
		
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission4_Death"
		;SendToModule "#General" "#PlayerType=Megatron"
		SetState "SubMission4_ChooseInit"
	}
}
state SubMission4_ChooseInit
{
	conditions
	{
		;if module "General GetCountA" == 2.0 goto SubMission4_ScorponokInit
	
		if module "General ChapterProgress" == 0.0 goto SubMission4_Init
		if module "General ChapterProgress" == 1.0 goto SubMission4_BonecrusherInit
		if module "General ChapterProgress" == 2.0 goto SubMission4_BonecrusherInit
		if module "General ChapterProgress" == 3.0 goto SubMission4_MegatronInit
		if module "General ChapterProgress" == 4.0 goto SubMission4_Init
	}		
}
state SubMission4_BonecrusherInit
{
	conditions
	{
		if timer > 1.0 goto SubMission4_BonecrusherMain
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#PlayerType=Bonecrusher" "#SetPlayer=#SubMission4" "#CountASet=1"
		
		SendToModule "#General" "#LoadCreature=DroneCement_a"
		SendToModule "#General" "#LoadCreature=DronePickupTruck_a"
		CreateModule "#Timer" "#Timer" "#Time=300"
	}
}
state SubMission4_MegatronInit
{
	conditions
	{
		if timer > 1.0 goto SubMission4_MegatronMain
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission4" "#CountASet=0"
		
		SendToModule "#General" "#LoadCreature=DroneTowTruck_a"
		SendToModule "#General" "#LoadCreature=DronePickupTruck_a"
		CreateModule "#Timer" "#Timer" "#Time=300"
	}
}
state SubMission4_Init
{
	conditions
	{
		if timer > 1.0 goto SubMission4_Main
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission4" "#CountASet=0"
		
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#LoadCreature=DronePickupTruck_a"
		CreateModule "#Timer" "#Timer" "#Time=300"
	}
}
state SubMission4_ScorponokInit
{
	conditions
	{
		if timer > 1.0 goto SubMission4_ScorponokMain
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission4" "#CountASet=2"
		
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#LoadCreature=DronePickupTruck_a"
		CreateModule "#Timer" "#Timer" "#Time=300"
	}
}
state SubMission4_BonecrusherMain
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneCement_a" "#Spline=Spawn4a" "#count=4" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DronePickupTruck_a" "#Spline=Spawn4b" "#count=8" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=12" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#FadeUp"
		SendToModule "#General" "#SetMaxOpponents=9" "#SetMaxApproachers=9" "#SetAttackRingSize=20"
	}
}
state SubMission4_MegatronMain
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneTowTruck_a" "#Spline=Spawn4a" "#count=4" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DronePickupTruck_a" "#Spline=Spawn4b" "#count=8" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=12" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION Mission4_1 PLAY ACTION"
		SendToModule "#General" "#FadeUp"
		SendToModule "#General" "#SetMaxOpponents=9" "#SetMaxApproachers=9" "#SetAttackRingSize=20"
	}
}
state SubMission4_Main
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneDefault_a" "#Spline=Spawn4a" "#count=4" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DronePickupTruck_a" "#Spline=Spawn4b" "#count=8" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=12" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#FadeUp"
		SendToModule "#General" "#SetMaxOpponents=9" "#SetMaxApproachers=9" "#SetAttackRingSize=20"
	}
}
state SubMission4_ScorponokMain
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneDefault_a" "#Spline=Spawn4a" "#count=4" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DronePickupTruck_a" "#Spline=Spawn4b" "#count=8" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=12" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#FadeUp"
		SendToModule "#General" "#SetMaxOpponents=9" "#SetMaxApproachers=9" "#SetAttackRingSize=20"
	}
}
state SubMission4_Finish
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission4_FinishWait
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission4_FinishWait
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=4"
		;SetState "SubMission4_Leave"
	}
}
state SubMission4_Death
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state SubMission4_Fail
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state SubMission4_Leave
{
	conditions
	{
		;if module "General GetCountA" == 2.0 goto GlobalActionRing
		if module "General GetCountA" == 1.0 goto RevertCreature
		if module "General GetCountA" == 0.0 goto GlobalActionRing
	}
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission4" "#FadeUp"
	   	SendToModule "#General" "#UnLoadCreature=DroneTowTruck_a"
		SendToModule "#General" "#UnLoadCreature=DroneCement_a"
		SendToModule "#General" "#UnLoadCreature=DroneDefault_a"
		
	   	SendToModule "#General" "#UnLoadCreature=DronePickupTruck_a"
		;SendToModule "#General" "#FadeUp" "#RevertPlayerType"				
		;SetState "GlobalActionRing"
	}
}


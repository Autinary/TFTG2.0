		CreateModule "#Creature" "#DroneScout1" "#Type=DroneDefault" "#Spline=A3C1SS7Drone1" "#count=1000" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#KeyLocation=On" "#Script=AdvDefault" "#ForcePlayerAsOpp"
		CreateModule "#Creature" "#DroneScout2" "#Type=DroneDefault" "#Spline=A3C1SS7Drone2" "#count=1000" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#KeyLocation=On" "#Script=AdvDefault" "#ForcePlayerAsOpp"

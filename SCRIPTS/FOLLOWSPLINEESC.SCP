
INCLUDE "Rules.scp"

state Base
{
	Actions
	{
		SetFlag "TakeHitPhysics=false" "TakeHitMelee=false" "TakeHit=false" "StuckEscape=false"
		SetMinAggression 2.0
		SetState Main
	}
}

state Main
{
	ReferenceScript
	{
		Script=FollowSplineVeh
		Source=Global
		ReturnState=Main
		Conditions
		{
			OnMacro RuleEscapeVehicle
		}
	}

	ReferenceScript
	{
		Script=Combat
		Source=Global
		ReturnState=Main
		Conditions
		{
			OnMacro RuleEscapeCombat
		}
	}
}

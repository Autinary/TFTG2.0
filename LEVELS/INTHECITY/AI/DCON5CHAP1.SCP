state Chapter1_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetVehicle=#StartMission" "#FadeUp"
		SetState "GlobalActionRing"
	}
}
state Chapter1_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_HubRestart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter1_InitGoto
{
	conditions
	{
		if module "General GetFinishedMissionStart" == 1.0 goto Chapter1_GotoWaitSpeech
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		;CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D5_ch1_Goto"
		SendToModule "#General" "#StartMission" "#SetVehicle=#StartMission" "#PlayerType=Barricade" "#VEHICLEROLLINGSTART_MPH=120.0"

		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
    	SendToModule "#General" "#ResponseLv_ClampMax   = 3"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming

	}
}
state Chapter1_GotoWaitSpeech
{
	actions
	{
		SendToModule "#General" "#AllowPlayerMovement" "#VEHICLEROLLINGSTART_MPH=-1.0"
		Idle 2.0
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D5_ch1_Goto" "#AutoDestroy" "#Start" 
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D5_ch1_Goto2" "#AutoDestroy"
		Idle 3.0
		SetState Chapter1_Goto
	}
}
state Chapter1_Goto
{
	conditions
	{
		
		if module "General ChapterProgress" == 4.0 goto GlobalActionRing
	}
	actions
	{
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=60" "#times=1" 
		CreateModule "#AndSwitch" "#AndSwitchReminder" "#moduletag=#DelayedSendReminder" "#placement=#Chapter1Beacon" "#rangeoutside=75"
		Idle 0.2
		SetState "GlobalActionRing2"
	}
}
state Chapter1_Enter
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter1_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter1_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#D5C1Intro1"
	}
}
state Chapter1_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_FightStage1
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"
		SendToModule "#General" "#PlayerType=Barricade"
	SendToModule "#General" "#UnLoadCreature=DroneDefault_a"
		SendToModule "#General" "#UnLoadCreature=EnergonDrone"
		SendToModule "#General" "#UnLoadCreature=DroneForklift_a"
    	SendToModule "#General" "#LoadCreature=Jazz"
	SendToModule "#General" "#LoadCreature=DroneArmouredCar"
	}
}
;;state Chapter1_VideoIntro
;;{
;;	conditions
;;	{
;;		if module "General VideoFinished" == 1.0 goto Chapter1_FightStage1
;;	}
;;	actions
;;	{
;;		DestroyAllModules 
;;		SendToModule "#General" "#EndMissionIntro" "#StartIntroVideo=#D5C1Intro1"
;;	}
;;}

state Chapter1_FightStage1
{
	conditions
	{
	
		if module "Jazz Energy" <= 0.50 goto Chapter1_RatchetHeal
		if module "DroneBackUp FailMission" == 1.0 goto Chapter1_FightStage2
		if module "Ratchet Energy" <= 0.05 goto Chapter1_FightStage5
		if module "Ratchet PlayerRange" < 30 goto Chapter1_ClearTheRadar
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		ResetTimer
		SetMusic "ACTION Mission1_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter1_DeathFailMission"
		
		CreateModule "#Speech" "#Speech" "#speech=#D5_ch1_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
				
		CreateModule "#Creature" "#Jazz" "#Spline=D5C1JAZZSPAWN1" "#count=1" "#maxalive=1" "#addtoradar" "#Boss" "#Type=Jazz" "#SpawnInLosInit" "#SpawnAsCreature" "#InhibitRubble" "#BlockDeath"  "#Script=Jazz"
		CreateModule "#KeyLocation" "#KeyLocation"  "#Spline=D5C1KEYLOC1" "#Radius=190" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER"
		CreateModule "#Creature" "#Ratchet" "#Spline=Spawn1" "#count=1" "#maxalive=1" "#addtoradaroff" "#Type=DroneArmouredCar" "#SuppressShield" "#SpawnAsCreature" "#Script=RatchetInit" "#SetEnergyMax=1500" "#BlockDeath" "#SetPosition=#RatchetSpawn1" "#SetEnergyMin=1005"
				

		CreateModule "#AreaRange" "#RatArea" "#Trigger=#Ratchet"  
		;CreateModule "#KeyLocation" "#KeyLocation" "#Spline=D5C4KeyLoc2" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#HeadType=#StarScream"
		CreateModule "Timer" "#DroneBackUp" "#Time=20" "#NoRender" 

		SendToModule "#General" "#ResetLevel" "#SetPlayer=#Chapter1Start" "#FadeUp"  
		SendToModule "#General" "#CountASet=0" "#CountBSet=1"

		SendToModule "#General" "#TrafficLv = 4"                        ; lock traffic level (1-5) (0=OFF)
		SendToModule "#General" "#PatrolLv = 0"                         ; patrol level (1=ON, 0=OFF)

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 2"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 2"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 3"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
		Idle 6.0
		
		
		
		SendToModule "#General" "#SetRadarInterference=1"
		SendToModule "#General" "#SetMessage=ITC1" "#SetMessageTimer=3.0"
		
	}
}
state Chapter1_FightProcess
{
	conditions
	{

		;if module "Ratchet BeenHit" == 1.0 and
		;	if module "Ratchet Health" == 1.0 and 
		;		if module "General GetCountA" == 0.0 goto Chapter1_Advice

		if Timer > 3.0 and
			if module "General GetCountC" == 2.0 goto Chapter1_RatchetAlert

		if Timer > 3.0 and
			if module "General GetCountC" == 4.0 goto Chapter1_RatchetAlert2


		if module "General GetCountC" == 6.0 goto Chapter1_ResetCountC

		if module "Jazz Energy" <= 0.50 goto Chapter1_RatchetHeal
		if module "HealTheTroops Timer" < 0.0 goto Chapter1_RatchetHeal2

		if module "DroneBackUp FailMission" == 1.0 goto Chapter1_FightStage2
		if module "Ratchet IsEnergyAtMin" == 1.0 and
			if module "General GetCountB" == 1.0 goto Chapter1_FightStage5
		if module "Ratchet IsEnergyAtMin" == 1.0 and
			if module "General GetCountB" == 2.0 goto Chapter1_FightStage4
		if module "Ratchet PlayerRange" < 45 goto Chapter1_ClearTheRadar
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission

		;if module "Ratchet Energy" <= 0.89 and 
		;		if module "General GetCountA" == 1.0 goto RatchetHold1
		;if module "Ratchet Energy" <= 0.78 and 
		;		if module "General GetCountA" == 2.0 goto RatchetHold2
		
	}
}
state Chapter1_RatchetAlert
{
	actions
	{
		SendToModule "#General" "#CountCSet=3"
		SendToModule "#General" "#SetMessage=RatchetHuntAlert" "#SetMessageTimer=7.0"
		SetState Chapter1_FightProcess
		
	}
}
state Chapter1_RatchetAlert2
{
	actions
	{
		SendToModule "#General" "#CountCSet=5"
		SendToModule "#General" "#SetMessage=RatchetHuntAlert2" "#SetMessageTimer=7.0"
		SetState Chapter1_FightProcess
		
	}
}
state Chapter1_ResetCountC
{
	actions
	{
		SendToModule "#General" "#CountCSet=5"
		SetState Chapter1_FightProcess
		
	}
}

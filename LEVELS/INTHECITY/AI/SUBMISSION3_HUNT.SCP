;hunt and destroy all the vehicles within the time limit

;requires:
;   Route spline 1		Route#a
;   Route spline 2		Route#b
;   Route spline 3		Route#c
;   Route spline 4		Route#d

;Changeable params:
;	300		time in which to complete the mission
;	Jeep			vehicle type 1
;	Jeep			vehicle type 2
;	CommTruck			vehicle type 3
;	CommTruck			vehicle type 4
;						Jeep
;						Sector7Drone
;						CommTruck
;						Shilka
;						ShilkaTracer
;						SUV

state SubMission3_Enter
{
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"
		
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission3_Death"
		
		;SendToModule "#General" "#PlayerType=Barricade"
		SetState "SubMission3_Init"
	}
}
state SubMission3_Init
{
	conditions
	{
		if timer > 0.1 goto SubMission3_MainInit
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission3"
		CreateModule "#Timer" "#Timer" "#Time=300"
	}
}
state SubMission3_MainInit
{
	conditions
	{
		if module "General ChapterProgress" == 0.0 goto SubMission3_BonecrusherMain
		if module "General ChapterProgress" == 1.0 goto SubMission3_BarricadeMain
		if module "General ChapterProgress" == 2.0 goto SubMission3_BrawlMain
		if module "General ChapterProgress" == 3.0 goto SubMission3_BlackoutMain
		if module "General ChapterProgress" == 4.0 goto SubMission3_Main
	}		
}
state SubMission3_MainCheckChar
{
	conditions
	{
		if module "General GetCountA" == 2.0 goto SubMission3_ScorponokMain
		
	}	
	actions
	{
		Idle 0.1
		SetState SubMission3_Main
	}	
}
state SubMission3_BonecrusherMain
{
	conditions
	{
		if module "GotoDroneA GetPercentageComplete" == 1.0 and
			if module "GotoDroneB GetPercentageComplete" == 1.0 and
				if module "DroneCounter Complete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#LoadCreature=DroneForklift_a"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		
		CreateModule "#DriverDrone" "#GotoDroneA" "#spline=Route3a" "#maxalive=1" "#count=1" "#FollowSpline=Route3a" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
		CreateModule "#DriverDrone" "#GotoDroneB" "#spline=Route3b" "#maxalive=1" "#count=1" "#FollowSpline=Route3b" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneC" "#SpawnSpline=Route3c" "#DirectSpline=Route3c" "#LoopSpline"  "#TransformBothWays=5.0" "#type=DroneDefault_a" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#SetEnergyMax=1000" "#SetEnergy=1000";"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneD" "#SpawnSpline=Route3d" "#DirectSpline=Route3d" "#LoopSpline"  "#TransformBothWays=2.0" "#type=DroneForklift_a" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#SetEnergyMax=800" "#SetEnergy=800" ;"#Script=Early_Combat"
																																																					   
																																																					   
		SendToModule "#General" "#PlayerType=Bonecrusher" "#CountASet=1"
		Idle 0.5
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=2" "#IconType=#Drone"	
		SendToModule "#General" "#FadeUp"
	}
}
state SubMission3_BarricadeMain
{
	conditions
	{
		if module "GotoDroneA GetPercentageComplete" == 1.0 and
			if module "GotoDroneB GetPercentageComplete" == 1.0 and
				if module "GotoDroneC GetPercentageComplete" == 1.0 and
					if module "GotoDroneD GetPercentageComplete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		CreateModule "#DriverDrone" "#GotoDroneA" "#spline=Route3a" "#maxalive=1" "#count=1" "#FollowSpline=Route3a" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
		CreateModule "#DriverDrone" "#GotoDroneB" "#spline=Route3b" "#maxalive=1" "#count=1" "#FollowSpline=Route3b" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
		CreateModule "#DriverDrone" "#GotoDroneC" "#spline=Route3c" "#maxalive=1" "#count=1" "#FollowSpline=Route3c" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
		CreateModule "#DriverDrone" "#GotoDroneD" "#spline=Route3d" "#maxalive=1" "#count=1" "#FollowSpline=Route3d" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
																																																						   
		SendToModule "#General" "#FadeUp" "#PlayerType=Barricade" "#CountASet=1"	
	}
}
state SubMission3_BrawlMain
{
	
	actions
	{
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		
		SendToModule "#General" "#LoadCreature=DronePickupTruck_a"
		SendToModule "#General" "#LoadCreature=DroneCement_a"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		CreateModule "#Goto" "#GotoDroneA" "#SpawnSpline=Route3a" "#DirectSpline=Route3a" "#LoopSpline"  "#TransformBothWays=4.0" "#type=DronePickupTruck_a" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#SetEnergyMax=1200" "#SetEnergy=1200" ;"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneB" "#SpawnSpline=Route3b" "#DirectSpline=Route3b" "#LoopSpline"  "#TransformBothWays=4.0" "#type=DronePickupTruck_a" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#SetEnergyMax=1200" "#SetEnergy=1200";"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneC" "#SpawnSpline=Route3c" "#DirectSpline=Route3c" "#LoopSpline"  "#TransformBothWays=5.0" "#type=DroneCement_a" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#SuppressShield" ;"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneD" "#SpawnSpline=Route3d" "#DirectSpline=Route3d" "#LoopSpline"  "#TransformBothWays=2.0" "#type=DroneDefault_a" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#SetEnergyMax=1000" "#SetEnergy=1000";"#Script=Early_Combat"
		SendToModule "#General" "#FadeUp" "#PlayerType=Brawl" "#CountASet=1"
		
		Idle 0.5
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=4" "#IconType=#Drone"																																																				   
		SetState SubMission3_AbotDroneProcess	
	}
}
state SubMission3_AbotDroneProcess	
{
	conditions
	{
		;if module "GotoDroneA GetPercentageComplete" == 1.0 and
		;	if module "GotoDroneB GetPercentageComplete" == 1.0 and
		;		if module "GotoDroneC GetPercentageComplete" == 1.0 and
		;			if module "GotoDroneD GetPercentageComplete" == 1.0 goto SubMission3_Finish

		if module "DroneCounter Complete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail
	}
	
}
state SubMission3_BlackoutMain
{
	conditions
	{
		if module "GotoDroneA GetPercentageComplete" == 1.0 and
			if module "GotoDroneB GetPercentageComplete" == 1.0 and
				if module "GotoDroneC GetPercentageComplete" == 1.0 and
					if module "GotoDroneD GetPercentageComplete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		CreateModule "#DriverDrone" "#GotoDroneA" "#spline=Route3a" "#maxalive=1" "#count=1" "#FollowSpline=Route3a" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
		CreateModule "#DriverDrone" "#GotoDroneB" "#spline=Route3b" "#maxalive=1" "#count=1" "#FollowSpline=Route3b" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
		CreateModule "#DriverDrone" "#GotoDroneC" "#spline=Route3c" "#maxalive=1" "#count=1" "#FollowSpline=Route3c" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
		CreateModule "#DriverDrone" "#GotoDroneD" "#spline=Route3d" "#maxalive=1" "#count=1" "#FollowSpline=Route3d" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
																																																						   
		SendToModule "#General" "#FadeUp" "#PlayerType=Blackout" "#CountASet=1"
	}
}

state SubMission3_Main
{
	conditions
	{
		if module "GotoDroneA GetPercentageComplete" == 1.0 and
			if module "GotoDroneB GetPercentageComplete" == 1.0 and
				if module "DroneCounter Complete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		
		SendToModule "#General" "#LoadCreature=DronePickupTruck_a"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		CreateModule "#DriverDrone" "#GotoDroneA" "#spline=Route3a" "#maxalive=1" "#count=1" "#FollowSpline=Route3a" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
		CreateModule "#DriverDrone" "#GotoDroneB" "#spline=Route3b" "#maxalive=1" "#count=1" "#FollowSpline=Route3b" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneC" "#SpawnSpline=Route3c" "#DirectSpline=Route3c" "#LoopSpline"  "#TransformBothWays=5.0" "#type=DronePickupTruck_a" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120"  "#SetEnergyMax=1200" "#SetEnergy=1200" ;"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneD" "#SpawnSpline=Route3d" "#DirectSpline=Route3d" "#LoopSpline"  "#TransformBothWays=2.0" "#type=DroneDefault_a" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#SetEnergyMax=1000" "#SetEnergy=1000";"#Script=Early_Combat"
		Idle 0.5		
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=2" "#IconType=#Drone"																																																				   
		SendToModule "#General" "#FadeUp" "#CountASet=0"	
	}
}
state SubMission3_Finish
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission3_FinishWait
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission3_FinishWait
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission3_Leave
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=3"
		;SetState "SubMission3_Leave"
	}
}
state SubMission3_Death
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMission3_Leave
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state SubMission3_Fail
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission3_Leave
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state SubMission3_Leave
{
	conditions
	{
		;if module "General GetCountA" == 2.0 goto GlobalActionRing
		if module "General GetCountA" == 1.0 goto RevertCreature
		if module "General GetCountA" == 0.0 goto GlobalActionRing
	}
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#UnLoadCreature=DronePickupTruck_a"
		SendToModule "#General" "#UnLoadCreature=DroneCement_a"
		SendToModule "#General" "#UnLoadCreature=DroneDefault_a"
		SendToModule "#General" "#UnLoadCreature=DroneForklift_a"
		
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission3" "#FadeUp"
		;SendToModule "#General" "#FadeUp" "#RevertPlayerType"		
		;SetState "GlobalActionRing"
	}
}


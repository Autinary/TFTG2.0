state Chapter3_SpeechMain
{
	conditions
	{
		if module "DroneCounter DronesDefeated" == 1.0 goto Chapter3_Speech1
		if module "DroneCounter DronesDefeated" == 2.0 goto Chapter3_Speech2
		if module "DroneCounter DronesDefeated" == 3.0 goto Chapter3_Speech3
		if module "DroneCounter DronesDefeated" == 4.0 goto Chapter3_Speech4
		if module "DroneCounter DronesDefeated" == 5.0 goto Chapter3_Watch
		
	}
	
}
state Chapter3_Speech1
{
	
	actions {
		CreateModule "#Speech" "#DefeatDrones" "#AutoDestroy" "#speech=#D1_ch2_obj2" "#Start"
		
		

		SetState Chapter3_Watch
	}
}
state Chapter3_Speech2
{
	
	actions {
		CreateModule "#Speech" "#DefeatDrones" "#AutoDestroy" "#speech=#D1_ch2_obj3" "#Start"
		CreateModule "#DriverDrone" "#CreatureWaveF" "#spline=DUCreateV" "#maxalive=2" "#count=2" "#FollowPlayer" "#type=ShilkaTracer" "#spacing=20.0" "#GoalRange=40.0" "#RapidInitFire" 
		CreateModule "#DriverDrone" "#CreatureWaveG" "#spline=DUGuns" "#maxalive=7" "#count=7" "#FollowPlayer" "#type=ShilkaTracer" "#spacing=20.0" "#GoalRange=40.0" "#RapidInitFire" 
		
		SetState Chapter3_Watch
	}
}

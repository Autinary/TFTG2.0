;;}
state Chapter3_Main
{
	conditions
	{
	}
	actions
	{
		SetMusic "ACTION Mission3_1 QUIET Generic Play Action"
		SendToModule "#General" "#ResetCounters"
		
		CreateModule "#DroneCounter" "#DroneCounter" "#IgnoreDroneKills" "#DronesToDefeat=6" "#IconType=#ReactorItem"  "#Protect
		SetDeathPoint "Chapter3_DeathFailMission"
		CreateModule "#Speech" "#A3_ch3_obj2" "#speech=#A3_ch3_obj2" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		SendToModule "#General" "#PhysObj" "#SetPlayer=#Chapter3Start" "#FadeUp"
        CreateModule "#AAGun" "#AAGun" "#Protect"
		SendToModule "#AAGun" "#Type=AAGUNTYPE_BULLITS" "#Placement=TurretRocketGlobal" "#Range=100.0" "#Delay=5.0" "#Energy=100.0" "#RespawnDelay=30" "#Ammo=0" "#Create"
		
		SendToModule "#General" "#ClearStateBits"


		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission

		
		SetState "Chapter3_ReactorInit"
	}
}
state Chapter3_ReactorInit
{
	actions
	{

		CreateModule "#SpecialObj" "#ReactorCoreA" "#Spline=A3C3ReactorA" "#PhysObjGlow=1" "#PhysObjGlowColour=GREEN" "#Breakable" "#Radius=2" "#SetDestroyTime=40" "#SetCriticalWarnTime=10"  ;10" "#Protect" "#RadarType=#Generator"  #DeathVFX=VFX_EMP
		CreateModule "#SpecialObj" "#ReactorCoreB" "#Spline=A3C3ReactorB" "#PhysObjGlow=1" "#PhysObjGlowColour=GREEN" "#Breakable" "#Radius=2" "#SetDestroyTime=45" "#SetCriticalWarnTime=10"  ;10" "#Protect" "#RadarType=#Generator"  #DeathVFX=VFX_EMP
		CreateModule "#SpecialObj" "#ReactorCoreC" "#Spline=A3C3ReactorC" "#PhysObjGlow=1" "#PhysObjGlowColour=GREEN" "#Breakable" "#Radius=2" "#SetDestroyTime=120" "#SetCriticalWarnTime=10"  ;10" "#Protect" "#RadarType=#Generator"  #DeathVFX=VFX_EMP
		CreateModule "#SpecialObj" "#ReactorCoreD" "#Spline=A3C3ReactorD" "#PhysObjGlow=1" "#PhysObjGlowColour=GREEN" "#Breakable" "#Radius=2" "#SetDestroyTime=65" "#SetCriticalWarnTime=10"  ;10" "#Protect" "#RadarType=#Generator"  #DeathVFX=VFX_EMP
		CreateModule "#SpecialObj" "#ReactorCoreE" "#Spline=A3C3ReactorE" "#PhysObjGlow=1" "#PhysObjGlowColour=GREEN" "#Breakable" "#Radius=2" "#SetDestroyTime=52" "#SetCriticalWarnTime=10"  ;10" "#Protect" "#RadarType=#Generator"  #DeathVFX=VFX_EMP
		CreateModule "#SpecialObj" "#ReactorCoreF" "#Spline=A3C3ReactorF" "#PhysObjGlow=1" "#PhysObjGlowColour=GREEN" "#Breakable" "#Radius=2" "#SetDestroyTime=85" "#SetCriticalWarnTime=10"  ;10" "#Protect" "#RadarType=#Generator"  #DeathVFX=VFX_EMP
		;CreateModule "#Timer" "#Timer" "Time=40.0" "#Protect"
		;CreateModule "#Timer" "#Timer1" "Time=200.0" "#Protect"
		;CreateModule "#Timer" "#Timer2" "Time=230.0" "#Protect"
		;CreateModule "#Timer" "#Timer3" "Time=660.0" "#Protect"
		;CreateModule "#Timer" "#Timer4" "Time=340.0" "#Protect"
		;CreateModule "#Timer" "#Timer5" "Time=280.0" "#Protect"
		;CreateModule "#Timer" "#Timer6" "Time=430.0" "#Protect"
		
		SendToModule "#ReactorCoreA" "#Reactor"
		SendToModule "#ReactorCoreB" "#Reactor"
		SendToModule "#ReactorCoreC" "#Reactor"
		SendToModule "#ReactorCoreD" "#Reactor"
		SendToModule "#ReactorCoreE" "#Reactor"
		SendToModule "#ReactorCoreF" "#Reactor"

		SetState "Chapter3_ReactorMain"	
	}
}
state Chapter3_ReactorMainRestart
{
	conditions
	{
		if module "DroneCounter DronesDefeated" == 1.0 goto Chapter3_SetTimeA
		if module "DroneCounter DronesDefeated" == 2.0 goto Chapter3_SetTimeB
		if module "DroneCounter DronesDefeated" == 3.0 goto Chapter3_SetTimeC
		if module "DroneCounter DronesDefeated" == 4.0 goto Chapter3_SetTimeD
		if module "DroneCounter DronesDefeated" == 5.0 goto Chapter3_SetTimeE
		if module "DroneCounter DronesDefeated" == 6.0 goto Chapter3_ReactorMainSpeech
		
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#SetStateBit=6"
	}
}
state Chapter3_ReactorMainSpeech
{
	conditions
	{
		if Timer > 1.0 and
			if module "DroneCounter DronesDefeated" == 1.0 goto Chapter3_PlaySpeech1
		if Timer > 1.0 and
			if module "DroneCounter DronesDefeated" == 6.0 goto Chapter3_PlaySpeech2
		if Timer > 1.5 goto Chapter3_ReactorMain
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#SetStateBit=6"
	}
}
state Chapter3_PlaySpeech1
{
	actions
	{
		CreateModule "#Speech" "#A3_ch3_obj1" "#speech=#A3_ch3_obj1"  "#AutoDestroy" "#Start"
		SetState "Chapter3_ReactorMain"
	}
}
state Chapter3_PlaySpeech2
{
	actions
	{
		;CreateModule "#Speech" "#A3_ch3_cmplt" "#speech=#A3_ch3_cmplt"  "#AutoDestroy" "#Start"
		SetState "Chapter3_ReactorMain"
	}
}
state Chapter3_ReactorMain
{
	conditions
	{
		if module "General GetStateBit1" == 0.0 and
			if module "ReactorCoreA GetPercentageComplete" == 1.0 goto Chapter3_AwardTimeA
		if module "General GetStateBit2" == 0.0 and
			if module "ReactorCoreB GetPercentageComplete" == 1.0 goto Chapter3_AwardTimeB
		if module "General GetStateBit3" == 0.0 and
			if module "ReactorCoreC GetPercentageComplete" == 1.0 goto Chapter3_AwardTimeC
		if module "General GetStateBit4" == 0.0 and
			if module "ReactorCoreD GetPercentageComplete" == 1.0 goto Chapter3_AwardTimeD
		if module "General GetStateBit5" == 0.0 and
			if module "ReactorCoreE GetPercentageComplete" == 1.0 goto Chapter3_AwardTimeE
		if module "General GetStateBit6" == 0.0 and
			if module "ReactorCoreF GetPercentageComplete" == 1.0 goto Chapter3_AwardTimeF
	
		if module "ReactorCoreA GetPercentageComplete" == 1.0 and
			if module "ReactorCoreB GetPercentageComplete" == 1.0 and
				if module "ReactorCoreC GetPercentageComplete" == 1.0 and
					if module "ReactorCoreD GetPercentageComplete" == 1.0 and
						if module "ReactorCoreE GetPercentageComplete" == 1.0 and
							if module "ReactorCoreF GetPercentageComplete" == 1.0 goto Chapter3_Outro
		if module "ReactorCoreA GetDestroyTime" < 0.0 goto Chapter3_FailMission
		if module "ReactorCoreB GetDestroyTime" < 0.0 goto Chapter3_FailMission
		if module "ReactorCoreC GetDestroyTime" < 0.0 goto Chapter3_FailMission
		if module "ReactorCoreD GetDestroyTime" < 0.0 goto Chapter3_FailMission
		if module "ReactorCoreE GetDestroyTime" < 0.0 goto Chapter3_FailMission
		if module "ReactorCoreF GetDestroyTime" < 0.0 goto Chapter3_FailMission
		if module "Timer Timer" < 0.0 goto Chapter3_FailMission
	}
	
}
state Chapter3_SetTimeA
{
	actions
	{
		
		SendToModule "#ReactorCoreA" "#SetDestroyTime=53" "#SetCriticalWarnTime=10"  ;10"9"  ; 1
		SendToModule "#ReactorCoreB" "#SetDestroyTime=60" "#SetCriticalWarnTime=10"  ;10"11"  ; 1
		SendToModule "#ReactorCoreC" "#SetDestroyTime=150" "#SetCriticalWarnTime=10"  ;10"25"  ; 5
		SendToModule "#ReactorCoreD" "#SetDestroyTime=85" "#SetCriticalWarnTime=10"  ;10"18"  ; 2
		SendToModule "#ReactorCoreE" "#SetDestroyTime=69" "#SetCriticalWarnTime=10"  ;10"15"  ; 3
		SendToModule "#ReactorCoreF" "#SetDestroyTime=109" "#SetCriticalWarnTime=10"  ;10"20"  ; 4
		SetState "Chapter3_ReactorMainSpeech"
	}
}

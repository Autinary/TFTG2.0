		SendToModule "#BoneCrusherHealth" "#Time=90.0"
		SendToModule "#BoneCrusher" "#TransformForceRobot"
		SendToModule "#BoneCrusherHealth" "#StartLoseHealth" "#Draw"
		SendToModule "#BoneCrusher" "#Object=#RedMediumDot"
	}
}
state Chapter3_IntoStage4 
{
	conditions {
		if module "BoneCrusher Complete" == 1.0 goto Chapter3_Stage4
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		if module "AAGunLaser GetPercentageComplete" == 1.0 and
			if module "AAGunRockets GetPercentageComplete" == 1.0 goto Chapter3_AADestroyedEarly3
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		SendToModule "#Chatter2" "#StartOneShot" 
		SendToModule "#BoneCrusher" "#TransformForceCar"

		SendToModule #BoneCrusherHealth #NoDraw

		SendToModule "#BoneCrusherHealth" "#Time=45.0" "#Stop"

		SendToModule "#BoneCrusher" "#DirectSpline=D3C2BONECRUSHER3"
		SendToModule "#BoneCrusher" "#Object=#GreenMediumDot"

		DestroyModule "#AAGunLaser"
		DestroyModule "#AAGunRockets"
		
		SendToModule "#ArtilleryTurret2" "#SetEnergy=0.0"
		
		CreateModule "#Creature" "#ArtilleryTurret" "#Type=TripleCTurret" "#count=1" "#maxalive=1" "#ForcePlayerAsOpp" "#Spline=Spawn4b" "#Script=Art_Turret" "#SpawnInLos" "#SetEnergyMax=800" "#AddToRadarOff" "#SuppressShield" "#SetPosition=#Art_Turret34"
	
   		CreateModule "#AAGun" "#AAGunLaser"
		SendToModule "#AAGunLaser" "#Breakable" "#Type=AAGUNTYPE_LASER" "#Placement=AAGun_D3C34L" "#Range=100.0" "#Delay=0.0" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#IgnorePlayer" "#Create"

        CreateModule "#AAGun" "#AAGunRockets"
		SendToModule "#AAGunRockets" "#Breakable" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAGun_D3C34R" "#Range=100.0" "#Delay=0.7" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#IgnorePlayer" "#Create"

		Idle 3.0
		DestroyModule "#ArtilleryTurret2"
	}
}
state Chapter3_Stage4 
{
	conditions 
	{
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		if module "AAGunLaser GetPercentageComplete" == 1.0 and
			if module "AAGunRockets GetPercentageComplete" == 1.0 goto Chapter3_IntoComplete
			
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		DestroyModule "#ArtilleryTurret2"
		
		SendToModule "#BoneCrusherHealth" "#Time=90.0"
		SendToModule "#BoneCrusher" "#TransformForceRobot"
		SendToModule "#BoneCrusherHealth" "#StartLoseHealth" "#Draw"
		SendToModule "#BoneCrusher" "#Object=#RedMediumDot"
	}
}

state Chapter3_IntoStage5 
{
	conditions {
		if module "BoneCrusher Complete" == 1.0 goto Chapter3_IntoComplete
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		SendToModule "#Chatter3" "#StartOneShot" 
		SendToModule "#BoneCrusher" "#TransformForceCar"

		SendToModule #BoneCrusherHealth #NoDraw

		SendToModule "#BoneCrusherHealth" "#Time=45.0" "#Stop"

		SendToModule "#ArtilleryTurret" "#SetEnergy=0.0"
		
		SendToModule "#BoneCrusher" "#DirectSpline=D3C2BONECRUSHER4"
		SendToModule "#BoneCrusher" "#Object=#GreenMediumDot"

		DestroyModule "#AAGunLaser"
		DestroyModule "#AAGunRockets"
		Idle 3.0 
		DestroyModule "#ArtilleryTurret"
    
	}
}
state Chapter3Alt_Enter
{
	
	actions
	{
		SendToModule "#General" "#StartChapter"
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#TurnOff"
		SendToModule "#General" "#ResetCounters"
		SendToModule "#SubMissions" "#TurnOff"
		SendToModule "#General" "#DisableLevelCreatures"
		
		SendToModule "#General" "#BG_UnLoadCreature=DroneMig_a"
		SetState Chapter3Alt_EnterInit
	}
}
state Chapter3Alt_EnterInit
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter3_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter3Alt_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#D3C5Intro"
	}
}
state Chapter3Alt_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter3_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter3Alt_Main
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"

``
		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 3"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
		SendToModule "#General" "#PlayerType=StarScream" "#ResetLevelCharacters"
		SendToModule "#General" "#LoadCreature=BoneCrusher" 
		
		
	}
}

state Chapter3Alt_Main
{
	actions
	{
		SetMusic "ACTION Mission2_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter2_DeathFailMission"
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D3_ch3_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		
		SendToModule "#General" "#SetMessage=Frenzy6" "#SetMessageTimer=3"
		SendToModule "#General" "#PhysObj" "#SetPlayer=#AltC3Start" "#FadeUp" "#CountCSet=0"

		CreateModule "#Timer" "#BoneCrusherHealth" "#HeadType=#BoneCrusher" "#Time=45.0" "#DrawHealthBar" "#Protect" "#Random" "#StartLoseHealth" ;"#CREATURERECOIL=#BoneCrusher" ; DON'T PUT RECOIL BACK IN UNLESS YOU FIX THE FACT THAT HE WILL MOVE BACKWARDS ALSO!
		CreateModule "#Goto" "#BoneCrusher" "#Script=D3Follow" "#SpawnSpline=D3C3_BONECRUSHER1" "#Object=#RedMediumDot" "#type=BoneCrusher" "#SplineStep=0" "#Speed=50" "#Health=#BoneCrusherHealth" "#Unstoppable" "#SuppressShield" "#Friend" ; "#Invulnerable" 
		
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#BoneCrusher" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key7Return" "#HeadType=#Megatron" "#Radius=140.0"

       

       	CreateModule "#AAGun" "#AAGunLaser"
		SendToModule "#AAGunLaser" "#Breakable" "#Type=AAGUNTYPE_LASER" "#Placement=AAGun_AD3C31L" "#Range=100.0" "#Delay=0.0" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"

        CreateModule "#AAGun" "#AAGunRockets"
		SendToModule "#AAGunRockets" "#Breakable" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAGun_AD3C31R" "#Range=100.0" "#Delay=0.7" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"

		CreateModule "#VehicleLevels" "#VehicleLevels" "#ResponseLv=4" "#TrafficLv=1" "#PatrolLv=1" "#RoadBlocks=D3C2ROADBLOCKS"

		SetState "Chapter3Alt_Stage1"
	}
}

state Chapter3Alt_Stage1 
{
	conditions {
		if module "AAGunRockets GetPercentageComplete" == 1.0 and
			if module "AAGunLaser GetPercentageComplete" == 1.0 goto Chapter3Alt_IntoStage2
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission

		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission

		;if Timer > 5 goto Chapter3Alt_IntoStage2
	}
	actions 
	{
		;ResetTimer
		SendToModule "#BoneCrusherHealth" "#Time=50.0"
		SendToModule "#BoneCrusher" "#TransformForceRobot"
	}
}
state Chapter3Alt_IntoStage2 
{
	conditions 
	{
		if module "BoneCrusher Complete" == 1.0 goto Chapter3Alt_Stage2
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		SendToModule "#BoneCrusher" "#TransformForceCar"
		
		SendToModule #BoneCrusherHealth #NoDraw

		SendToModule "#BoneCrusherHealth" "#Time=45.0" "#Stop"


		SendToModule "#BoneCrusher" "#DirectSpline=D3C3_BONECRUSHER2"
		SendToModule "#BoneCrusher" "#Object=#GreenMediumDot"
	
		DestroyModule "#AAGunRockets"
		DestroyModule "#AAGunLaser"

       		CreateModule "#AAGun" "#AAGunLaser"
		SendToModule "#AAGunLaser" "#Breakable" "#Type=AAGUNTYPE_LASER" "#Placement=AAGun_AD3C32L" "#Range=100.0" "#Delay=0.0" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"
		CreateModule "#AAGun" "#AAGunRockets"
		SendToModule "#AAGunRockets" "#Breakable" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAGun_AD3C32R" "#Range=100.0" "#Delay=0.7" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"

	}
}

state Chapter3Alt_Stage2 
{
	conditions 
{
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission
		if module "AAGunLaser GetPercentageComplete" == 1.0 and
			if module "AAGunRockets GetPercentageComplete" == 1.0 goto Chapter3Alt_IntoStage3
			

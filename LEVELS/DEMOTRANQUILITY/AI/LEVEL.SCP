state Wait
{
	Actions
	{
		DrawConditionsFromThisScript
		SetState Pause
	}
}

state Pause
{
	Conditions
	{
		if Timer > 5.0 goto MissionStage1
	}
	Actions
	{
		ResetTimer
	}
}


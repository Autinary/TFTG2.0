state Chapter1_Banter
{
	conditions
	{
		;if module "DestructTime" <= 180.0 and
			if module "General GetCountA" == 2.0 goto Chapter1_BanterA
		;if module "DestructTime" <= 150.0 and
			if module "General GetCountA" == 3.0 goto Chapter1_BanterB
		;if module "DestructTime" <= 120.0 and
			if module "General GetCountA" == 4.0 goto Chapter1_BanterC
		;if module "DestructTime" <= 90.0 and
			if module "General GetCountA" == 5.0 goto Chapter1_BanterD
		;if module "DestructTime" <= 60.0 and
			if module "General GetCountA" == 6.0 goto Chapter1_BanterE

	}
}

state Chapter1_TankDeploymentA
{
	actions
	{
		SendToModule "#General" "#CountInc"
		CreateModule "#DriverDrone" "#CreatureWaveJ" "#spline=DVCreateV" "#maxalive=8" "#count=8" "#FollowPlayer" "#type=ShilkaTracer" "#spacing=20.0"  "#GoalRange=40.0" "#RapidInitFire" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SetState Chapter1_Process
	}
}

state Chapter1_TankDeploymentB
{
	actions
	{
		SendToModule "#General" "#CountInc"
		
		SendToModule "#CreatureWaveJ" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveI" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveH" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveG" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveF" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveE" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveD" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveC" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveB" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveA" "#Object=#RedSmallDot" "#AddToRadarAlways"
		CreateModule "#DriverDrone" "#CreatureWaveK" "#spline=DSCreateV" "#maxalive=8" "#count=8" "#FollowPlayer" "#type=ShilkaTracer" "#spacing=20.0" "#GoalRange=40.0" "#RapidInitFire" "#Object=#RedSmallDot" "#AddToRadarAlways"
		;SendToModule "#General" "#SetMessage=QS3" "#SetMessageTimer=3.0" 

		SetState Chapter1_Process
	}
}

state Chapter1_TankDeploymentC
{
	actions
	{
		SendToModule "#General" "#CountInc"
		CreateModule "#DriverDrone" "#CreatureWaveL" "#spline=DSGuns" "#maxalive=8" "#count=5000" "#SpawnInLOSInit" "#type=ShilkaTracer" "#GoalRange=40.0" "#NoShibby" "#RapidInitFire" #IgnorePaths #WaitEnd
		SetState Chapter1_Process
	}
}
state Chapter1_JetDeployment
{
	actions
	{

		DestroyModule "#CreatureWaveL"

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 4"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 4"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 4"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		SendToModule "#General" "#CountInc"
		SendToModule "#General" ;"#CountDSet=0"
		CreateModule "#AirAttack" "#AirAttack" "NumWaves=7" 
	        SendToModule "#AirAttack" "#Total=3" "#VehicleTypes=DDRIVETYPE_F22" "#Spline=D1C1_Patrol1" "#SplinePos=0.0"  "#HeightOffset=50.0" "#CruiseSpd=150" "#AttackSpd=100" "#NumBomb=1" "#NumRocket=5" "#BombDelay=5.0" "#RocketDelay=0.5" "#WeaponAccuracy=0.0" "#WeaponBias=0.5" "#CreateWave=1"
		SendToModule "#General" "#SetMessage=QS4" "#SetMessageTimer=3.0" 
		SendToModule "#DestructTime" "#AddTime=40.0"
		SetState Chapter1_Process
	}
}
state Chapter1_AirAttackWave2
{
	
	actions
	{
		SendToModule "#General" "#CountInc"
		
		SendToModule "#AirAttack" "#Total=2" "#VehicleTypes=DDRIVETYPE_F22" "#Spline=D1C1_Patrol2" "#SplinePos=0.0"  "#HeightOffset=50.0" "#CruiseSpd=150" "#AttackSpd=100" "#NumBomb=1" "#NumRocket=5" "#BombDelay=5.0" "#RocketDelay=0.5" "#WeaponAccuracy=0.0" "#WeaponBias=0.5" "#CreateWave=1"
		SendToModule "#AirAttack" "#Total=1" "#VehicleTypes=DDRIVETYPE_F22" "#Spline=D1C1Patrol3" "#SplinePos=0.0"  "#HeightOffset=50.0" "#CruiseSpd=150" "#AttackSpd=100" "#NumBomb=1" "#NumRocket=5" "#BombDelay=5.0" "#RocketDelay=0.5" "#WeaponAccuracy=0.0" "#WeaponBias=0.5" "#CreateWave=1"
		SendToModule "#DestructTime" "#AddTime=15.0"
		
		SetState Chapter1_Process
	}
}


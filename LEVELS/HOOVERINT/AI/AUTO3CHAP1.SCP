state Chapter1_DecepticonAmbush3
{
	conditions
	{
		if module "DoorC GetPercentageComplete" == 1.0 goto Chapter1_DecepticonAmbush33
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
		if Timer > 1.0 and
			if module "DroneScout1 Energy" <= 0.0 and
				if module "DroneScout2 Energy" <= 0.0 and
					if module "DroneScout4 Energy" <= 0.0 goto Chapter1_Return3
	}
	actions
	{
		ResetTimer
		SendToModule "#DroneScout1" "#count=2"
		SendToModule "#DroneScout2" "#count=2"
		SendToModule "#DroneScout3" "#count=2"
		SendToModule "#General" "#SetMessage=FinishThem" "#SetMessageTimer=3"
		;CreateModule "#Creature" "#DroneScout4" "#Type=DroneDefault" "#Spline=A3C1SS7Drone3" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnAsCreature" "#Script=Advanced" "#ForcePlayerAsOpp" 
		CreateModule "#Creature" "#DroneScout4" "#Type=DroneCement" "#Spline=A3C1SS7Drone3" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=CAgile"
		SendToModule "Barricade" "#NoHealthBar" "#DirectSpline=A3C2TunnelA" "#Script=FollowSplineCre" "#Unstoppable" "#AddToRadarOff" "#InhibitRubble"

		Idle 3.5
		SendToModule "Barricade" "#DirectSpline=A3C2TunnelA" "#Script=FollowSplineVeh" "#TransformForceCar" "#Speed=150" "#Unstoppable" "#AddToRadarOff" "#InhibitRubble"
	}
}
state Chapter1_Return3
{
	conditions
	{
		if module "DoorC GetPercentageComplete" == 1.0 goto Chapter1_DoorCSmashed2
		if module "Return InArea" == 1.0 goto Chapter1_MidtroC
		if module "TimerR FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		SetMusic "ACTION Mission1_1 QUIET Generic Play Action"
		DestroyModule "#KeyLocation"
		SendToModule "#DroneScout1" "#AddToRadarOff" "#SetEnergy=0.0"
		SendToModule "#DroneScout2" "#AddToRadarOff" "#SetEnergy=0.0"
		SendToModule "#DroneScout3" "#AddToRadarOff" "#SetEnergy=0.0"
		SendToModule "#DroneScout4" "#AddToRadarOff" "#SetEnergy=0.0"
		CreateModule "#AreaRange" "#Return" "#Trigger=#A3C1NoTrans2"
		SendToModule "#General" "#SetMessage=Key7Goto" "#SetMessageTimer=3"
		CreateModule "#Timer" "#TimerR" "Time=60.0"
		
	}
}
state Chapter1_DecepticonAmbush32
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
		if module "DroneScout1 Energy" <= 0.0 and
			if module "DroneScout2 Energy" <= 0.0 and
				if module "DroneScout4 Energy" <= 0.0 goto Chapter1_DoorCSmashed2
	}
	actions
	{
		
		SendToModule "#DroneScout1" "#count=2"
		SendToModule "#DroneScout2" "#count=2"
		SendToModule "#DroneScout3" "#count=2"
		SendToModule "#General" "#SetMessage=FinishThem" "#SetMessageTimer=3"

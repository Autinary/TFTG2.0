state Wait
{
	conditions
	{
		if message MissionMessage == 1.0 goto DroneArmouredCarTest
	}
}

state DroneArmouredCarTest
{
	conditions
	{
		if message MissionMessage == 1.0 goto BarricadeTest
		if Timer > 20.0 goto BarricadeTest
	}
	actions
	{
		ResetTimer
		DestroyModule "#Creature"
		SendToModule "#General" "#LoadCreature=DroneArmouredCar"
		CreateModule "#Creature" "#Creature" "#Script=Default" "#Type=DroneArmouredCar" "#Spline=test33" "#count=10000" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#ForcePlayerAsOpp" "#SpawnInLOS"
		IncreasePlayerHealth max
		SendToModule "#General" "#SetPlayer=#StartMission"
	}
}



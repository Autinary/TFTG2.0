{
	conditions
	{
	
		if module "Timer FailMission" == 1.0 goto Chapter2_CompleteIntro
	}
	actions
	{
		
		CreateModule "#Timer" "#Timer" "#Time=3.7" "#NoRender" "#Start"
		CreateModule "#Creature" "#Ratchet" "#SpawnSpline=A2C2SpawnD" "#type=DroneArmouredCar_a" "#AddToRadarOff" "#SpawnAsVehicle" "#Speed=120" "#Unstoppable" "#Friend" "#SetPosition=#BackupRatchetSpawn5" "#SetEnergyMax=1500" "#SetEnergy=1500" ; "#Invulnerable" 
		SendToModule "#Ratchet" "#TransformForceRobot"
		SendToModule "#Ratchet" "#SetEnergyMax=9000.0" "#SetEnergy=9000.0" 
		
		
	}
}
state Chapter2_FifthPart3
{
	conditions
	{
	
		if module "Timer FailMission" == 1.0 goto Chapter2_CompleteIntro
	}
	actions
	{
		
		CreateModule "#Timer" "#Timer" "#Time=3.7" "#NoRender" "#Start"
		CreateModule "#Creature" "#Ratchet" "#SpawnSpline=A2C2SpawnD" "#type=DroneArmouredCar_a" "#AddToRadarOff" "#SpawnAsVehicle" "#Speed=120" "#Unstoppable" "#Friend" "#SetPosition=#BackupRatchetSpawn5" "#SetEnergyMax=1500" "#SetEnergy=1500" ; "#Invulnerable" 

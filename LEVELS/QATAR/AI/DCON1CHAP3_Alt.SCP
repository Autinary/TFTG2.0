state Chapter3_Main_Alt
{

	actions
	{
		SetMusic "ACTION Mission1_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter2_DeathFailMission"

		CreateModule "#DriverDrone" "#GotoDroneA" "#spline=Route3a" "#maxalive=1" "#count=1" "#FollowSpline=Route3a" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		CreateModule "#DriverDrone" "#GotoDroneB" "#spline=Route3b" "#maxalive=1" "#count=1" "#FollowSpline=Route3b" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		CreateModule "#DriverDrone" "#GotoDroneC" "#spline=Route3c" "#maxalive=1" "#count=1" "#FollowSpline=Route3c" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		CreateModule "#DriverDrone" "#GotoDroneD" "#spline=Route3d" "#maxalive=1" "#count=1" "#FollowSpline=Route3d" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		CreateModule "#DriverDrone" "#GotoDroneE" "#spline=Route3e" "#maxalive=1" "#count=1" "#FollowSpline=Route3e" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		CreateModule "#DriverDrone" "#GotoDroneF" "#spline=Route3f" "#maxalive=1" "#count=1" "#FollowSpline=Route3f" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		CreateModule "#DriverDrone" "#GotoDroneG" "#spline=Route3g" "#maxalive=1" "#count=1" "#FollowSpline=Route3g" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		CreateModule "#DriverDrone" "#GotoDroneH" "#spline=Route3h" "#maxalive=1" "#count=1" "#FollowSpline=Route3h" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		
		
		CreateModule "#DroneCounter" "#DroneCounter"  "#DronesToDefeat=8" "#IconType=#CommTower" 
		
		CreateModule "#Timer" "#Timer" "#Time=45.0" "#Start"
 
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D1_ch2_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		SendToModule "#General" "#PhysObj" "#SetPlayer=#Chapter2Start" "#FadeUp"  "#CountBSet=0"	
		Idle 2.0 
		CreateModule "#DriverDrone" "#CreatureWaveA" "#spline=Route3a" "#maxalive=2" "#count=2" "#FollowSpline=Route3a" "#spacing=25.0" "#goalrange=25.0" #type=Jeep #IgnorePaths #WaitEnd
		CreateModule "#DriverDrone" "#CreatureWaveC" "#spline=Route3c" "#maxalive=2" "#count=2" "#FollowSpline=Route3c" "#spacing=25.0" "#goalrange=25.0" #type=Jeep #IgnorePaths #WaitEnd
		CreateModule "#DriverDrone" "#CreatureWaveF" "#spline=Route3f" "#maxalive=2" "#count=2" "#FollowSpline=Route3f" "#spacing=25.0" "#goalrange=25.0" #type=Jeep #IgnorePaths #WaitEnd
		CreateModule "#DriverDrone" "#CreatureWaveH" "#spline=Route3h" "#maxalive=2" "#count=2" "#FollowSpline=Route3h" "#spacing=25.0" "#goalrange=25.0" #type=Jeep #IgnorePaths #WaitEnd
	

		SetState Chapter3_Watch_Alt
	}
}



state Chapter3_AddOnTimeA_Alt
{
	actions {
		
		SendToModule "#Timer" "#AddTime=15.0"
		SendToModule "#GoToDroneA" "#ClearTriggeredComplete"
		SendToModule "#DroneCounter" "#Increment=1"
		SetState Chapter3_Watch_Alt
	}
}


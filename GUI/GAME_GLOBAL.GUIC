Begin Window
Name Fadeout_timer
Position 0,0
Size 0,0
Alpha 0.0
ZOrder 0.01
Timeout 0.5
OnDeactivate QuitRace
End
Begin Window
Name Fadeout
Position 0,0
Size 640,480
Style whiteonblack,whiteonblack,whiteonblack
Animation LINEAR 0.4
NoBlockInput
Alpha 1.0 0.0 1.0
ZOrder 0.01
OnActivate AddPage Fadeout_timer
End
Begin Window
Name Fadein
Position 0,0
Size 640,480
Style whiteonblack,whiteonblack,whiteonblack
Animation LINEAR 1.3
Alpha 1.0 1.0 0.0
ZOrder 0.01
Timeout 0.05
End
Begin Window
Name Flash
Position 0,0
Size 640,480
Style white,white,white
Animation LINEAR 0.2
Alpha 1.0 0.0 0.0
ZOrder 0.01
Timeout 0.1
NoBlockInput
End
Begin Window
Name FlashRed
Position 0,0
Size 640,480
Style FlashRed,FlashRed,FlashRed
Animation LINEAR 0.2
Alpha 0.8 0.0 0.0
ZOrder 0.01
Timeout 0.1
NoBlockInput
End
Begin Window
Name FlashBehind 
Position 0,0
Size 640,480
Style white,white,white
Animation LINEAR 0.2
Alpha 1.0 1.0 0.0
ZOrder 0.9
NoBlockInput
End
Begin Window
Name FlashTurn 
Position 0,0
Size 640,480
Style white,white,white
Animation LINEAR 0.2
Alpha 1.0 1.0 0.0
ZOrder 0.9
End

Begin Window
Name Loading
Position 0,0
Size 640,480
Animation LINEAR 0.3
Alpha 1.0 0.0
ZOrder 0.011
Begin Text
Position 0,130
Size 640,20
Style SMALLWHITE
Text ? GetTimeStamp
Align center
End
Begin Window 
Position 0,230,0,300
Size 640,30
Alpha 1 0
Animation DECELERATE 0.2
Begin Text
Position 0,0
Size 640,30
Style SMALLWHITE
Text ? GetLoadingText
Align center
End
Begin Text
Position 0,20
Size 640,30
Style SMALLWHITE
Text ? GetLastFile
Align center
End
End
End


;push all drones out of key location within time limit
;player and drones are invincible
;if anyone leaves area instant death

;requires:
;	Keylocation spline 				KeyLoc#
;	Spawn spline for type 1 creatures		Spawn#a
;	Spawn spline for type 2 creatures		Spawn#b

;Changeable params:
;	300		time in which to complete the mission
;	6	total number of creature type 1 that need to be killed
;	2	total number of creature type 2 that need to be killed
;	2		total creature type 1 that are simultaneously active 
;	1		total creature type 2 that are simultaneously active 
;	DroneDefault_a	type of creature one to fight against
;	DroneCement_a	type of creature two to fight against
;						DroneForkLift
;						DroneTowTruck
;						DroneArmouredCar
;						DroneCement
;						DronePickupTruck
;						DroneMig
;						BumbleBee
;						Barricade


state SubMission4_Enter
{
	conditions
	{
		if timer > 0.2 goto SubMission4_Enter4
		if module "General ChapterProgress" >= 4.0 goto SubMission4_Init4
	}
	actions
	{
		ResetTimer
		SendToModule "#ActionRing" "#RemoveCreatures"
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission4_Death"
		;SendToModule "#General" "#PlayerType=TripleC"
		;SetState "SubMission4_Init"
	}
}
state SubMission4_Enter2
{
	
	actions
	{
		
		;SendToModule "#General" "#PlayerType=Blackout"
		SetState "SubMission4_Init2"
	}
}
state SubMission4_Enter3
{
	
	actions
	{
		
		;SendToModule "#General" "#PlayerType=Scorponok"
		SetState "SubMission4_Init"
	}
}
state SubMission4_Enter6
{
	
	actions
	{
		
		;SendToModule "#General" "#PlayerType=Scorponok"
		
		SetState "SubMission4_Init3"
	}
}
state SubMission4_Enter4
{
	conditions
	{
		if timer > 0.2 goto SubMission4_Enter5
		if module "General ChapterProgress" >= 3.0 goto SubMission4_Enter2
	}
	actions
	{
		ResetTimer
		
	}
}
state SubMission4_Enter5
{
	conditions
	{
		if timer > 0.2 goto SubMission4_Enter2
		if module "General ChapterProgress" >= 2.0 goto SubMission4_Enter6
	}
	actions
	{
		ResetTimer
		
	}
}
state SubMission4_Init3
{
	conditions
	{
		if timer > 1.0 goto SubMission4_Main3
	}
	actions
	{
		ResetTimer
		;SendToModule "#General" "#PlayerType=Scorponok"
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission4"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#LoadCreature=DroneForklift_a"
		CreateModule "#Timer" "#Timer" "#Time=300"
	}
}
state SubMission4_Main3
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneDefault_a" "#Spline=Spawn4a" "#count=8" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DroneForklift_a" "#Spline=Spawn4b" "#count=8" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=16" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION Mission2_1 Play Action"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission4_Init4
{
	conditions
	{
		if timer > 1.0 goto SubMission4_Main4
	}
	actions
	{
		ResetTimer
		;SendToModule "#General" "#PlayerType=Scorponok"
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission4"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#LoadCreature=DroneForklift_a"
		CreateModule "#Timer" "#Timer" "#Time=300"
	}
}
state SubMission4_Main4
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneDefault_a" "#Spline=Spawn4a" "#count=8" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DroneForklift_a" "#Spline=Spawn4b" "#count=8" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=16" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION Generic Play Action"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission4_Init2
{
	conditions
	{
		if timer > 1.0 goto SubMission4_Main2
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission4"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#LoadCreature=DroneCement_a"
		CreateModule "#Timer" "#Timer" "#Time=300"
	}
}
state SubMission4_Main2
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneDefault_a" "#Spline=Spawn4a" "#count=16" "#maxalive=3" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DroneCement_a" "#Spline=Spawn4b" "#count=2" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=CACCombat"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=18" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission4_Init
{
	conditions
	{
		if timer > 1.0 goto SubMission4_Main
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission4"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#LoadCreature=DroneCement_a"
		CreateModule "#Timer" "#Timer" "#Time=300"
	}
}
state SubMission4_Main
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneDefault_a" "#Spline=Spawn4a" "#count=16" "#maxalive=4" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Combat"
		;CreateModule "#Creature" "#CreatureWaveB" "#Type=DroneCement_a" "#Spline=Spawn4b" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=CACCombat"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=16" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission4_Finish
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission4_FinishWait
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission4_FinishWait
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=4"
		;SetState "SubMission4_Leave"
	}
}
state SubMission4_Death
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state SubMission4_Fail
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state SubMission4_Leave
{
	conditions
	{
		if module "General ChapterProgress" >= 4.0 goto Exit
	}
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		;
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Race2" "#FadeUp"
	   	SendToModule "#General" "#UnLoadCreature=DroneDefault_a"
	   	SendToModule "#General" "#UnLoadCreature=DroneCement_a"
		SendToModule "#General" "#UnLoadCreature=DroneForklift_a"
		Idle 0.1
		SendToModule "#General" "#PlayerType=Blackout,Blackout,Scorponok,Blackout,Scorponok"
		;SendToModule "#General" "#FadeUp"		
		SetState "Exit"
	}
}


;;push all drones out of key location within time limit
;player and drones are invincible
;if anyone leaves area instant death

;requires:
;	Keylocation spline 				KeyLoc#
;	Spawn spline for type 1 creatures		Spawn#a
;	Spawn spline for type 2 creatures		Spawn#b

;Changeable params:
;	300		time in which to complete the mission
;	7	total number of creature type 1 that need to be killed
;	1	total number of creature type 2 that need to be killed
;	2		total creature type 1 that are simultaneously active 
;	1		total creature type 2 that are simultaneously active 
;	DronePickupTruck	type of creature one to fight against
;	DroneTowTruck	type of creature two to fight against
;						DroneForkLift
;						DroneTowTruck
;						DroneArmouredCar
;						DroneCement
;						DronePickupTruck
;						DroneMig
;						BumbleBee
;						Barricade


state SubMission4_Enter
{
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission4_Death"
		;SendToModule "#General" "#PlayerType=Optimus"
		SetState "SubMission4_Init"
	}
}
state SubMission4_Enter2
{
	conditions
	{
		if module "General ChapterProgress" >= 2.0 goto SubMission4_Enter3
		if timer > 1.0 goto SubMission4_Main3
	}
	actions
	{
	
	}
}
state SubMission4_Enter3
{
	conditions
	{
		if module "General ChapterProgress" >= 4.0 goto SubMission4_Main
		if timer > 1.0 goto SubMission4_Main4
	}
	actions
	{
	
	}
}
state SubMission4_Init
{
	conditions
	{
		if module "General ChapterProgress" >= 1.0 goto SubMission4_Enter2
		if timer > 1.0 goto SubMission4_Main2
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission4"
		SendToModule "#General" "#UnLoadCreature=DroneDefault"
		SendToModule "#General" "#LoadCreature=DronePickupTruck"
		SendToModule "#General" "#LoadCreature=DroneTowTruck"
		SendToModule "#General" "#LoadCreature=Blackout"
		CreateModule "#Timer" "#Timer" "#Time=300"
	}
}
state SubMission4_Main
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		SendToModule "#General" "#SetPlayer=#SubMission4"
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DronePickupTruck" "#Spline=Spawn4a" "#count=13" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" 
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DroneTowTruck" "#Spline=Spawn4b" "#count=5" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" 
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=18" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission4_Main2
{
	conditions
	{
		
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 and
				if module "CreatureWaveC GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission1_1 PLAY ACTION"
		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
    	SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		CreateModule "#VehicleLevels" "#VehicleLevels" "#ResponseLv=5" "#TrafficLv=1" "#PatrolLv=1" "#RoadBlocks=A2C1RoadBlocks"

		SendToModule "#General" "#UnLoadCreature=DroneTowTruck"
		SendToModule "#General" "#UnLoadCreature=Blackout"
		SendToModule "#General" "#LoadCreature=DroneDefault"
		SendToModule "#General" "#LoadCreature=Scorponok"

		CreateModule "#Creature" "#CreatureWaveA" "#Type=DronePickupTruck" "#Spline=Spawn4a" "#count=4" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" 
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DroneDefault" "#Spline=Spawn4b" "#count=4" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" 
		CreateModule "#Creature" "#CreatureWaveC" "#Type=Scorponok" "#Spline=Spawn4b" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" 
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB" "#SumoCreatureModule=#CreatureWaveC"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=9" "#IconType=#Drone"
		SendToModule "#General" "#FadeUp"		
	}
}



state SubMission4_Main3
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 and
				if module "CreatureWaveC GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission2_1 PLAY ACTION"
		
		SendToModule "#General" "#UnLoadCreature=DroneTowTruck"
		SendToModule "#General" "#UnLoadCreature=Blackout"
		SendToModule "#General" "#LoadCreature=DroneArmouredCar"
		SendToModule "#General" "#LoadCreature=Barricade"

		SendToModule "#General" "#PlayerType=IronHide" "#SetPlayer=#SubMission4"

		CreateModule "#Creature" "#CreatureWaveA" "#Type=DronePickupTruck" "#Spline=Spawn4a" "#count=8" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" 
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DroneArmouredCar" "#Spline=Spawn4b" "#count=2" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=CACCombat"
		CreateModule "#Creature" "#CreatureWaveC" "#Type=Barricade" "#Spline=Spawn4b" "#count=4" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB" "#SumoCreatureModule=#CreatureWaveC"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=14" "#IconType=#Drone"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission4_Main4
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 and
				if module "CreatureWaveC GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
		if module "General ChapterProgress" >= 3.0 goto SubMission4_Main5
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission3_1 PLAY ACTION"
		
		;SendToModule "#General" "#UnLoadCreature=Blackout"
		SendToModule "#General" "#UnLoadCreature=DronePickupTruck"
		SendToModule "#General" "#LoadCreature=DroneCement"
		;SendToModule "#General" "#LoadCreature=Barricade"

		SendToModule "#General" "#PlayerType=OptimusPrime" "#SetPlayer=#SubMission4"

		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneTowTruck" "#Spline=Spawn4a" "#count=8" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" 
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DroneCement" "#Spline=Spawn4b" "#count=4" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=CACCombat"
		CreateModule "#Creature" "#CreatureWaveC" "#Type=Blackout" "#Spline=Spawn4b" "#count=4" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB" "#SumoCreatureModule=#CreatureWaveC"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=16" "#IconType=#Drone"
		CreateModule "#VehicleLevels" "#VehicleLevels" "#ResponseLv=0" "#TrafficLv=5" "#PatrolLv=1" "#RoadBlocks=RoadBlock1"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission4_Main5
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 and
				if module "CreatureWaveC GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
		
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Generic PLAY ACTION"
		DestroyModule "#VehicleLevels"
			
	}
}
state SubMission4_Finish
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission4_FinishWait
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission4_FinishWait
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=4"
		;SetState "SubMission4_Leave"
	}
}
state SubMission4_Death
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state SubMission4_Fail
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FailMission"
	}
}
state SubMission4_Leave
{
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		;
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission4"
	   	SendToModule "#General" "#UnLoadCreature=DronePickupTruck"
	   	SendToModule "#General" "#UnLoadCreature=DroneTowTruck"
		SendToModule "#General" "#UnLoadCreature=Barricade"
		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar"
		SendToModule "#General" "#UnLoadCreature=DroneCement"
		SendToModule "#General" "#UnLoadCreature=Scorponok"
	   	SendToModule "#General" "#LoadCreature=DroneDefault"
		SendToModule "#General" "#UnLoadCreature=Blackout"
		SendToModule "#General" "#FadeUp"		
		SetState "Exit"
	}
}


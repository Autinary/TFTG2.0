{
	conditions
	{

	}
	actions
	{
		
		SendToModule "#VehicleLevels" "#TrafficLv=0" "#PatrolLv=0"

		SendToModule "#General" "#ResponseLv_Mission"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 0"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 0"            ; lowest the response can reach
    		SendToModule "#General" "#ResponseLv_ClampMax   = 0"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"               ; update/set the scripted values for freeroaming
		
		SetState Chapter4_Escaping
	}

}
state Chapter4_AtFinalSection
{
	actions
	{
		SendToModule "#General" "#SetStateBit=2"
		SendToModule "#AAGunBoneCrusher" "#Vulnerable"
		SendToModule "#AAGunBrawl" "#Vulnerable"
		SetState "Chapter4_Escaping"
	}
}
state Chapter4_AtFinalSection2
{
	actions
	{
		SendToModule "#General" "#SetStateBit=3"
		SendToModule "#AAGunBoneCrusher" "#Vulnerable"
		SendToModule "#AAGunBrawl" "#Vulnerable"
		SetState "Chapter4_Escaping"
	}
}
state Chapter4_AtFinalSection3
{
	actions
	{
		SendToModule "#General" "#SetStateBit=4"
		SendToModule "#AAGunBoneCrusher" "#Vulnerable"
		SendToModule "#AAGunBrawl" "#Vulnerable"
		SetState "Chapter4_Escaping"
	}
}

state TurnOnBrawlKeyLoc 
{
	conditions
	{
		if module "D3C4KeyLocBrawl InArea" == 1.0 goto Chapter4_SetRespLV
	}
	actions 
	{
		SendToModule #D3C4KeyLocBrawl #Process #Render
		SendToModule #AAGunBrawl #AddToRadarAlways
		SendToModule #BrawlEscape #ClearTriggeredComplete
		SendToModule "#General" "#CountDInc"
		Idle 0.1
		SetState Chapter4_PrepareBrawlSpeech
	}
}

state TurnOnBoneyKeyLoc 
{	
	conditions
	{
		if module "D3C4KeyLocBoney InArea" == 1.0 and
			if module "General GetCountC" >= 2.0 goto Chapter4_SetRespLV
		if module "General GetCountC" == 1.0 and 
			if module "BoneCrusherEscape PlayerRange" < 120 goto Chapter4_SetRespLV
	}
	actions 
	{
		SendToModule #D3C4KeyLocBoney #Process #Render
		SendToModule #AAGunBoneCrusher #AddToRadarAlways
		SendToModule #BoneCrusherEscape #ClearTriggeredComplete
		SendToModule "#General" "#CountCInc"
		Idle 0.1
		SetState Chapter4_PrepareBoneySpeech
	}
}

state Chapter4_BoneCrusherNextCheckpoint
{
	conditions
	{
		;if module "General GetCountA" == 4.0 goto Chapter4_BrawlTanksAreActiveAtWrongTime
	}	
	actions 
	{
		SendToModule "#BoneCrusherEscape" "#ClearTriggeredComplete"
		SendToModule "#BoneCrusherEscape" "#TransformForceRobot"
		SendToModule "#General" "#ClearStateBit=1"
		
		SendToModule "#BoneCrusherEscape" "#Object=#RedMediumDot"
		SendToModule "#AAGunBoneCrusher" "#Vulnerable"
		
		
		SendToModule "#BoneCrusherHealth" "#StartLoseHealth"
		SetState TurnOnBoneyKeyLoc
	}
}
state Chapter4_BrawlTanksAreActiveAtWrongTime
{
		
	actions 
	{
		SendToModule "#AAGunBrawl" "#Vulnerable"
		
		SetState TurnOnBoneyKeyLoc
	}
}

state Chapter4_BoneCrusherCP2 
{
	actions 
	{
		SendToModule #D3C4KeyLocBoney #NoProcess #NoRender
		DestroyModule "#AAGunBoneCrusher"
        CreateModule "#AAGun" "#AAGunBoneCrusher"
		SendToModule "#AAGunBoneCrusher" #AddToRadarOff "#Type=AAGUNTYPE_LASER" "#Placement=D3C4BC2" "#Range=100.0" "#Delay=0.0" "#Energy=250.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusherEscape" "#IgnorePlayer" "#Create=Shilka"
		SendToModule "#AAGunBoneCrusher" "#InVulnerable"
		SendToModule "#BoneCrusherEscape" "#TransformForceCar"
		SendToModule "#General" "#SetStateBit=1"
		SendToModule "#BoneCrusherEscape" #RegenHealth=3 
		SendToModule "#BoneCrusherEscape" "#DirectSpline=D3C4_BoneCrusher2" "#Object=#GreenMediumDot" "#SplineStep=0" "#Invulnerable" "#Speed=40"
		SendToModule "#General" "#CountBSet=2"
		SetState Chapter4_Escaping
	}
}

state Chapter4_BoneCrusherCP3 
{
	actions 
	{
		SendToModule #D3C4KeyLocBoney #NoProcess #NoRender
	
		DestroyModule "#AAGunBoneCrusher"
        CreateModule "#AAGun" "#AAGunBoneCrusher"
		SendToModule "#AAGunBoneCrusher" #AddToRadarOff "#Type=AAGUNTYPE_LASER" "#Placement=D3C4BC3" "#Range=100.0" "#Delay=0.0" "#Energy=250.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusherEscape"  "#IgnorePlayer" "#Create=Shilka" 
		SendToModule "#AAGunBoneCrusher" "#InVulnerable"
		SendToModule "#BoneCrusherEscape" "#TransformForceCar"
		SendToModule "#General" "#SetStateBit=1"
		SendToModule "#BoneCrusherEscape" #RegenHealth=3
		SendToModule "#BoneCrusherEscape" "#DirectSpline=D3C4_BoneCrusher3" "Range=21.0" "#Object=#GreenMediumDot" "#SplineStep=0" "#Invulnerable" "#Speed=40"
		SendToModule "#General" "#CountBSet=3"
		SetState Chapter4_Escaping
	}
}


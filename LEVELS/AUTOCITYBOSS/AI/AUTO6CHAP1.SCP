state Chapter1_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" "#FadeUp"
		SetState GlobalActionRing
	}
}
state Chapter1_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_HubRestart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter1_Enter
{
	actions
	{
		DestroyAllModules 
		SetState Chapter1_IntroVideo
	}
}
state Chapter1_IntroVideo
{
	conditions
	{
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter1_LoadCreatures
	}
	actions
	{

		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#A6LevelIntro"
	}
}
state Chapter1_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_Main 
	}
	actions
	{
		;SendToModule "#ActionRing" "#RemoveCreatures"

		SendToModule "#General" "#UnLoadCreature=BumbleBee07"
		SendToModule "#General" "#UnLoadCreature=IronHide"
		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar_a"
		SendToModule "#General" "#LoadCreature=Megatron"
		SendToModule "#General" "#LoadCreature=DroneForklift_a"
		SendToModule "#General" "#LoadCreature=DroneDefault"
		
	}
}
ActionMacro CreateBR
{
	CreateModule "#CreatureBombingRun" "#CreatureBombingRun" "#ModuleTag=#Megatron" "#Spline=A6C1BR1" "#Spline=A6C1BR2" "#Spline=A6C1BR3" "#Spline=A6C1BR4"	
	SendToModule "#CreatureBombingRun" "#NumRuns=3" "#SpeedValueMin=250" "#SpeedValueMax=700" "#MeleeScript=Megatron_PH2"
}

ActionMacro CreateBRAttack
{
	CreateModule "#CreatureBombingRun" "#CreatureBombingRun" "#ModuleTag=#Megatron" "#Spline=A6C1Attack1" "#ArrivalSpline=A6C1MegaArrive1"
	SendToModule "#CreatureBombingRun" "#NumRuns=3" "#LandAtEndOfSpline" "#AttackFiringMode" "#UseFirstSpline" "#LookAtBias=1.0" "#SpeedValueMin=75" "#SpeedValueMax=300" "#MeleeScript=Megatron_PH2"
	CreateModule "#AreaRange" "#BREnd" "#Trigger=#BRAttackEndZone" "#AddToRadarOff" "#AllCreatures"
		
}
ActionMacro MigAction
{
	CreateModule "#Creature" "#M29DroneB" "#Type=DroneMig" "#Spline=A6C1Attack1" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsVehicle" "#Script=SpawnIntro" "#FollowSpline=A6C1MegaArrive1" "#SetEnergyMax=1500" "#SetEnergy=1500"
	CreateModule "#Creature" "#M29DroneC" "#Type=DroneMig" "#Spline=A6C1Spawn" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsVehicle" "#Script=SpawnIntro" "#FollowSpline=A6C1MegaArrive1" "#SetEnergyMax=1500" "#SetEnergy=1500"
	Idle 5.7 
	SendToModule "#CreatureWaveC" "#Script=Mig29Drone"
	SendToModule "#CreatureWaveD" "#Script=Mig29Drone"
	
} 
state Chapter1_Main
{
	actions
	{
		SetMusic "ACTION Mission1_1 Play Action"
		SetDeathPoint "Chapter1_DeathFailMission"
		SendToModule "#General" "#ResetCounters"
		SendToModule "#General" "#SetPlayer=#Chapter1Start" 
		CreateModule "#Goto" "#Megatron" "#SpawnSpline=A6C1Spawn" "#AddToRadarAlways" "#SpawnInLOSInit" "#SpawnAsCreature" "#ForcePlayerAsOpp" "#BlockDeath" "#Boss" "#Type=Megatron" "#SetPosition=#Megatron" "#SetEnergyMax=3000" "#SetEnergy=3000" "#SetEnergyMin=100" "#Protect" ;
		CreateModule "#Goto" "#RangeTracker" "#Spline=A6C1Spawn" "#SetPosition=#A6C1Phase1KeyLoc" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" 
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#RangeTracker" "#Radius=175" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key6Return" "#HeadType=#Optimus"
		
		SendToModule "#Megatron" "#SetPosition=#Megatron" "#Script=StandAndWait" "#MegatronToCombat" 
		CreateModule "#Speech" "#A6_ch1_obj1" "#speech=#A6_ch1_obj1" "#AutoDestroy" "#PlayDelay=2.0" "#Start" 
		CreateModule "#Speech" "#A6_ch1_obj10" "#speech=#A6_ch1_obj10" "#AutoDestroy" "#PlayDelay=5.5" "#Start"

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		Idle 0.1
		SendToModule "#Megatron" "#SetPosition=#Megatron" "#MegatronToCombat" "#Script=Megatron_PH1" 
		
		SendToModule "#General" "#FadeUp"
		SetState Chapter1_Phase1
	}
}
state Chapter1_Phase1
{
	conditions
	{
		;if Timer < 15.0 and 
		;	if module "Megatron Health" <= 0.50 goto Chapter1_Phase1OPTaunt
		if module "Megatron IsEnergyAtMin" == 1.0 goto Chapter1_Phase1End

		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
		
	}
	actions
	{
		ResetTimer
	}
}
;state Chapter1_Phase1OPTaunt
;{
;	conditions
;	{
;		if module "Megatron IsEnergyAtMin" == 1.0 goto Chapter1_Phase1End
;		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
;		
;	}
;	actions
;	{
;		CreateModule "#Speech" "#A6_ch1_obj4" "#speech=#A6_ch1_obj4" "#AutoDestroy" "#Start" 
;		
;	}
;}
state Chapter1_Phase1End
{
	conditions
	{
		if module "Megatron Complete" == 1.0 goto Chapter1_Phase2Init
		if module "RangeTracker GetLinkedDist" < 50 goto Chapter1_Phase2Init
	}
	actions
	{
		DestroyModule "#KeyLocation" 
		SendToModule "#RangeTracker" "#SetPosition=#A6C1RangeTracker" "#Link=#Megatron"
		SendToModule "#Megatron" "#FollowSpline=A6C1Spawn" "#Script=FollowSplineM" "#RemoveBoss" "#SetEnergy=2700"
		CreateModule "#Speech" "#A6_ch1_obj9" "#speech=#A6_ch1_obj9" "#AutoDestroy" "#Start" 
		
	}
}
state Chapter1_Phase2Init
{
	conditions
	{
		;if module "Megatron Complete" == 1.0 goto Chapter1_Phase2Init
	}
	actions
	{
		DestroyModule "#RangeTracker" 
		SendToModule "#General" "#BG_UnLoadCreature=DroneForklift_a"
		Idle 1.5
		SetState Chapter1_Phase2MegaWait
		
	}
}
state Chapter1_Phase2MegaWait
{
	conditions
	{
		if module "Megatron PlayerRange" < 30 goto Chapter1_Phase2
	}
	actions
	{
		
		SendToModule "#Megatron" "#Script=Megatron_PH2I" "#Unstoppable" "#SetEnergy=3000"
	}
}
state Chapter1_Phase2Enter
{
	actions
	{
		DestroyAllModules 
		SetState Chapter1_Phase2IntroVideo
	}
}
state Chapter1_Phase2IntroVideo
{
	conditions
	{
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter1_Phase2LoadCreatures
	}
	actions
	{

		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#A7LevelIntro"
	}
}
state Chapter1_Phase2LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_Phase2Main 
	}
	actions
	{
		;SendToModule "#ActionRing" "#RemoveCreatures"

		SendToModule "#General" "#UnLoadCreature=BumbleBee07"
		SendToModule "#General" "#UnLoadCreature=IronHide"
		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar_a"
		SendToModule "#General" "#LoadCreature=Megatron"
		SendToModule "#General" "#LoadCreature=DroneArmouredCar"
		SendToModule "#General" "#LoadCreature=DronePickupTruck"
		SendToModule "#General" "#LoadCreature=DroneDefault"
		
	}
}
state Chapter1_Phase2Main
{
	actions
	{
		SetMusic "ACTION Mission1_1 Play Action"
		SetDeathPoint "Chapter1_DeathFailMission"

		SendToModule "#General" "#SetPlayer=#Chapter2Start" 
		

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
		CreateModule "#Creature" "#AmbusherA" "#Spline=A6C1Attack1" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneDefault" "#SpawnInLosInit" "#SpawnAsCreature" "#SetEnergyMax=1000" "#SetEnergy=1000" "#Script=CarDrone"
		CreateModule "#Creature" "#AmbusherB" "#Spline=A6C1Attack1" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneDefault" "#SpawnInLosInit" "#SpawnAsCreature" "#SetEnergyMax=1000" "#SetEnergy=1000" "#Script=CarDrone"
		CreateModule "#Creature" "#AmbusherC" "#Spline=A6C1Attack1" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneDefault" "#SpawnInLosInit" "#SpawnAsCreature" "#SetEnergyMax=1000" "#SetEnergy=1000" "#Script=CarDrone"
		CreateModule "#Creature" "#AmbusherD" "#Spline=A6C1Attack1" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneDefault" "#SpawnInLosInit" "#SpawnAsCreature" "#SetEnergyMax=1000" "#SetEnergy=1000" "#Script=CarDrone"
		

		SendToModule "#General" "#FadeUp"
		SetState Chapter1_MegatronFlyA
	}
}
state Chapter1_Phase2
{
	conditions
	{
		if Timer > 5.0 and
			if module "Megatron PlayerRange" > 300 goto Chapter1_MegatronFlyA
        }
	actions
	{
		
		ResetTimer
		;SendToModule "#ActionRing" "#SetCompleted=#Chapter1" "#Unlock=#Chapter2"

		SendToModule "#Megatron" "#Script=FlyOff_M" "#Stoppable" "#AddToRadarOff"
		SendToModule "#General" "#BG_LoadCreature=DroneArmouredCar"
		SendToModule "#General" "#BG_LoadCreature=DronePickupTruck"
		
		CreateModule "#Creature" "#AmbusherA" "#Spline=A6C1Spawn" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneDefault" "#SpawnInLosInit" "#SpawnAsVehicle" "#SetPosition=#A6AmbushSpawn1" "#SetEnergyMax=1000" "#SetEnergy=1000"; "#SpawnAsleep" "#Script=Melee" 
		CreateModule "#Creature" "#AmbusherB" "#Spline=A6C1Spawn" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneDefault" "#SpawnInLosInit" "#SpawnAsVehicle" "#SetPosition=#A6AmbushSpawn2" "#SetEnergyMax=1000" "#SetEnergy=1000"; "#SpawnAsleep" "#Script=Melee"
		CreateModule "#Creature" "#AmbusherC" "#Spline=A6C1Spawn" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneDefault" "#SpawnInLosInit" "#SpawnAsVehicle" "#SetPosition=#A6AmbushSpawn3" "#SetEnergyMax=1000" "#SetEnergy=1000"; "#SpawnAsleep" "#Script=Melee"
		CreateModule "#Creature" "#AmbusherD" "#Spline=A6C1Spawn" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneDefault" "#SpawnInLosInit" "#SpawnAsCreature" "#SetPosition=#A6AmbushSpawn4" "#SetEnergyMax=1000" "#SetEnergy=1000"; "#SpawnAsleep" "#Script=Melee"
		
		Idle 1.3
		SendToModule "#AmbusherA" "#TransformForceRobot" "#Script=CarDrone"
		SendToModule "#AmbusherB" "#TransformForceRobot" "#Script=CarDrone"
		Idle 0.7
		SendToModule "#AmbusherC" "#TransformForceRobot" "#Script=CarDrone"
		SendToModule "#AmbusherD" "#TransformForceRobot" "#Script=CarDrone"
		Idle 3.0
	
		;SetState Chapter1_MegatronFlyA
	}
}
state Chapter1_MegatronFlyA
{
	conditions
	{
		if module "Megatron BeenHit" == 1.0 and
			if module "General GetCountB" == 1.0 goto Chapter1_OneShotCollectionA1

		if module "BREnd InArea" == 1.0 goto Chapter1_MegatronBombingRunA
		if module "CreatureBombingRun Finish" == 1.0 goto Chapter1_MegatronChargeA
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{

		DestroyModule "#Megatron"
		CreateModule "#Goto" "#Megatron" "#SpawnSpline=A6C1Spawn" "#AddToRadarAlways" "#SpawnInLOSInit" "#SpawnAsCreature" "#ForcePlayerAsOpp" "#BlockDeath" "#Type=Megatron" "#SetEnergyMax=16000" "#SetEnergy=16000" "#Protect" ;
		
		SendToModule "#General" "#SetMaxOpponents=18" "#SetMaxApproachers=18" "#SetAttackRingSize=20"

		SendToModule "#General" "#CountASet=1" "#CountBSet=1"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=A6C1KeyLoc" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key6Return" "#Protect"
		CreateModule "#Creature" "#ATDrone" "#Spline=A6C1Attack1" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneArmouredCar" "#SpawnAsCreature" "#Script=Arm_TruckDrone" "#SetEnergyMax=1200" "#SetEnergy=1200" "#KeyLocation=On" "#ForcePlayerAsOpp"
		CreateModule "#Creature" "#TDrone" "#Spline=A6C1Attack1" "#count=10000" "#maxalive=2" "#addtoradar" "#Type=DronePickupTruck" "#SpawnAsCreature" "#Script=TruckDrone" "#SetEnergyMax=1200" "#SetEnergy=1200" "#KeyLocation=On" "#ForcePlayerAsOpp"
		SendToModule "#Megatron" "#Script=DummyAircraft"

		CreateModule "#Speech" "#A6_ch1_obj2" "#speech=#A6_ch1_obj2" "#AutoDestroy" "#Protect"
		DoMacro CreateBRAttack
		
		SendToModule "#CreatureBombingRun" "#ForceTransformEnergy=0.95" 
	}
}
state Chapter1_MegatronBombingRunA
{
	conditions
	{
		if module "Megatron BeenHit" == 1.0 and
			if module "General GetCountB" == 1.0 goto Chapter1_OneShotCollectionA1

		if module "CreatureBombingRun Finish" == 1.0 goto Chapter1_MegatronChargeA
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		DestroyModule "#BREnd"
		DestroyModule "#CreatureBombingRun"
		SendToModule "#Megatron" "#Script=DummyAircraft" "#AddToRadar" "#SetEnergy=16000"

		DoMacro CreateBR
		
		SendToModule "#CreatureBombingRun" "#ForceTransformEnergy=0.99" 
	}
}
state Chapter1_OneShotCollectionA1
{
	conditions
	{
		if module "BREnd InArea" == 1.0 goto Chapter1_MegatronBombingRunA
		

		if module "CreatureBombingRun Finish" == 1.0 goto Chapter1_MegatronChargeA
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{	
		SendToModule "#General" "#CountBSet=2"
		SendToModule "#A6_ch1_obj2" "#StartOneShot"
	}
}
state Chapter1_MegatronChargeA
{
	conditions
	{
		if module "Megatron MegatronIsCharge" == 0.0 goto Chapter1_MegatronCombatA
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		DestroyModule "#BREnd" 
		
		SendToModule "#Megatron" "#Script=Megatron_PH2" "#MegatronToCharge" 
		;SendToModule "#ATDrone" "#count=3"
		
	}
}
state Chapter1_MegatronCombatA
{
	conditions
	{
		if module "Megatron IsEnergyAtMin" == 1.0 goto Chapter1_MegatronFlyAwayInitB
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission

		if Timer > 30 goto Chapter1_MegatronReturnToChargeA
	}
	actions
	{
		ResetTimer
		;CreateModule "#Speech" "#A6_ch1_obj3" "#speech=#A6_ch1_obj3" "#Start" "#AutoDestroy" 
		SendToModule "#Megatron" "#Boss" "#Type=Megatron"
		SendToModule "#Megatron" "#Script=Megatron_PH2" "#MegatronToCombat" "#SetEnergyMin=12000.0"
	}
}
state Chapter1_MegatronReturnToChargeA
{
	conditions
	{
		if module "Megatron MegatronIsCharge" == 0.0 goto Chapter1_MegatronReturnToCombatA
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		
		SendToModule "#Megatron" "#Script=Megatron_PH2" "#MegatronToCharge" 
		
	}
}
state Chapter1_MegatronReturnToCombatA
{
	conditions
	{
		if module "Megatron IsEnergyAtMin" == 1.0 goto Chapter1_MegatronFlyAwayInitB
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission

		if Timer > 30 goto Chapter1_MegatronReturnToChargeA
	}
	actions
	{
		ResetTimer
		SendToModule "#Megatron" "#Script=Megatron_PH2" "#MegatronToCombat" 
	}
}
state Chapter1_MegatronFlyAwayInitB
{
	conditions
	{
		if module "Megatron PlayerRange" > 300 and
			if module "ATDrone Energy" <= 0.0 and 
				if module "TDrone Energy" <= 0.0 and 
					if module "AmbusherA Energy" <= 0.0 and 
						if module "AmbusherB Energy" <= 0.0 and 
							if module "AmbusherC Energy" <= 0.0 and 
								if module "AmbusherD Energy" <= 0.0 goto Chapter1_MegatronFlyInitB
        if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
        ;ResetTimer
	
	;CreateModule "#Timer" "#Timer" "#Time=5" "#NoRender"
	SendToModule "#TDrone" "#count=2"
		
        SendToModule "#Megatron" "#Script=FlyOff_M" "#NoHealthBar" "#AddToRadarOff"
    }
}
state Chapter1_MegatronFlyInitB
{
	conditions
	{
		;if module "Timer Finished" == 1.0 goto Chapter1_MegatronFlyDoB
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
        DestroyAllModules
		DestroyModule "#CreatureBombingRun"
		SendToModule "#Megatron" "#Script=DummyAircraft" "#AddToRadar"

		DoMacro CreateBR
		

		SendToModule "#CreatureBombingRun" "#ForceTransformEnergy=0.74" 

		SendToModule "#General" "#BG_UnLoadCreature=DroneArmouredCar"
		;SendToModule "#General" "#BG_UnLoadCreature=DronePickupTruck"
		;SendToModule "#General" "#BG_UnLoadCreature=DroneDefault"
		;SendToModule "#General" "#BG_LoadCreature=StarScream"
		SendToModule "#General" "#BG_LoadCreature=DroneTowTruck"

		
		
		;CreateModule "#Speech" "#A6_ch1_obj4" "#speech=#A6_ch1_obj4" "#Start" "#AutoDestroy" 
		
		;CreateModule "#Timer" "#Timer" "#Time=3" "#NoRender"
		;SendToModule "#Megatron" 
		Idle 3.0 
		CreateModule "#Creature" "#TTDrone" "#Spline=A6C1Spawn" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneTowTruck" "#SpawnAsCreature" "#Script=TowTruckDrone" "#KeyLocation=On" "#ForcePlayerAsOpp"
		CreateModule "#Creature" "#CDrone" "#Spline=A6C1Attack1" "#count=10000" "#maxalive=2" "#addtoradar" "#Type=DroneDefault" "#SpawnAsCreature" "#Script=CarDrone" "#SetEnergyMax=1000" "#SetEnergy=1000" "#KeyLocation=On" "#ForcePlayerAsOpp"
		CreateModule "#Creature" "#TDrone" "#Spline=A6C1Attack1" "#count=2" "#maxalive=2" "#addtoradar" "#Type=DronePickupTruck" "#SpawnAsCreature" "#Script=TruckDrone" "#SetEnergyMax=1200" "#SetEnergy=1200" "#KeyLocation=On" "#ForcePlayerAsOpp"
		
		SetState Chapter1_MegatronFlyDoB
	}
}
state Chapter1_MegatronFlyDoB
{
	conditions
	{
		if module "Megatron BeenHit" == 1.0 and
			if module "General GetCountB" == 1.0 goto Chapter1_OneShotCollectionB1
		if module "CreatureBombingRun Finish" == 1.0 goto Chapter1_MegatronFlail
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		;DestroyModule "#Timer"
		SendToModule "#Megatron" "#SetEnergyMin=8000.0"
	}
}
state Chapter1_OneShotCollectionB1
{
	conditions
	{
		if module "CreatureBombingRun Finish" == 1.0 goto Chapter1_MegatronFlail
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{	
		SendToModule "#General" "#CountBSet=2"
		SendToModule "#A6_ch1_obj2" "#StartOneShot"
	}
}
state Chapter1_MegatronFlail
{
	conditions
	{
		if module "Megatron MegatronIsFlail" == 0.0 goto Chapter1_MegatronCombatB
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		;CreateModule "#Speech" "#A6_ch1_obj5" "#speech=#A6_ch1_obj5" "#Start" "#AutoDestroy" 
		;CreateModule "#Goto" "#AM29Drone" "#Type=StarScream" "#Spline=A6C1Spawn" "#addtoradar" "#Count=10000" "#MaxAlive=3" "#SpawnInLosInit" "#SpawnAsVehicle" "#Script=DummyAircraft"  "#SetEnergyMax=400" ; "#SetEnergyMin=1425"
	
		;CreateModule "#CreatureBombingRun" "#CreatureBombingRun2" "#ModuleTag=#AM29Drone" "#Spline=A6C1BR1" "#Spline=A6C1BR2" "#Spline=A6C1BR3" "#Spline=A6C1BR4"	
	;SendToModule "#CreatureBombingRun2" "#NumRuns=9999" "#SpeedValueMin=100" "#SpeedValueMax=500" "#MeleeScript=Mig29Drone"

		SendToModule "#Megatron" "#Script=Megatron_PH2" "#MegatronToFlail"

		;SendToModule "#TTDrone" "#count=3"
		
	}
}
state Chapter1_MegatronCombatB
{
	conditions
	{
		if module "Megatron IsEnergyAtMin" == 1.0 goto Chapter1_MegatronFlyAwayInitC
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
		
		if Timer > 30 goto Chapter1_MegatronReturnToFlailA
	}
	actions
	{
		ResetTimer
		SendToModule "#Megatron" "#Script=Megatron_PH2" "#MegatronToCombat" "#DrawHealthBar" 
	}
}
state Chapter1_MegatronReturnToFlailA
{
	conditions
	{
		if module "Megatron MegatronIsFlail" == 0.0 goto Chapter1_MegatronReturnToCombatB
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}

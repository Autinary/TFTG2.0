state Chapter2_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter3"
		SendToModule "#General" "#SetPlayerDeathPoint=#COMPPOINT3"
		
		SendToModule "#General" "#ResponseLvPlayerDetected=4"
		
		IncreasePlayerHealth max
		;SendToModule "#VehicleLevels" "#ResponseLv=0" "#TrafficLv=0" "#PatrolLv=0"
		SetMusic "ACTION Mission2_1 QUIET Generic"
		setstate "PickGoto"
	}
}

state Chapter1_MainCWaitTrigger
{
	conditions
	{
		if module "D2C1KeyLocationC InArea" == 1.0 goto Chapter1_MainC
		if module "D2C1KeyLocationC FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D2_ch1_obj3" "#AutoDestroy" "#Start"
		CreateModule "#AreaRange" "#D2C1TriggerC" "#Trigger=#D2C1TriggerC" "#Beacon" 
		CreateModule "#KeyLocation" "#D2C1KeyLocationC" "#Spline=D2C1KeyLocC" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#HeadType=#StarScream" "#Protect" "#NoProcess"
		CreateModule "#DelayedSend" "#DelayedSend" "#moduletag=#D2C1KeyLocationC" "#param=#Process" "#delay=4"
	}
}


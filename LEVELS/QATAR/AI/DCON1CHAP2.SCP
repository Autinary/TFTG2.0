state Chapter2_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter2_Restart
	}
	actions
	{
		DestroyModule "#DelayedSendReminder"
		SendToModule "#General" "#EndOfMission"  "#DeathFailMission"
	}
}
state Chapter2_FailMission
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter2_Restart
	}
	actions
	{
		DestroyModule "#DelayedSendReminder"
		SendToModule "#General" "#EndOfMission"  "#FailMission"
	}
}
state Chapter2_Restart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"

		
		SendToModule "#General" "#PlayerType=Blackout,Blackout,Scorponok,Blackout"
		SendToModule "#General" "#ResponseLvPlayerDetected=4"

		SendToModule "#General" "#ResetAll" "#SetPlayerAtDeathPoint" "#FadeUp"
		SetState "Exit"
	}
}
state Chapter2_CompleteDelay
{
	actions
	{
		;SendToModule "#General"  "#EndOfMission" 
		Idle 3.0
		;DestroyAllModules "#IncludeProtected"
		
		SetState Chapter2_Midtro ;Chapter2_Complete
	}
}
state Chapter2_CompleteDelay2
{
	actions
	{
		
		;SendToModule "#General"  "#EndOfMission" 
		
		Idle 3.0
		;SetMusic "ACTION Mission1_3 QUIET Generic Play Action"
		;DestroyAllModules "#IncludeProtected"
		
		SetState Chapter2_Midtro4 ; Chapter2_Complete2Start
	}
}
state Chapter2_Complete
{
	
	actions
	{
		SetMusic "ACTION Mission1_3 QUIET Generic Play Action"
		DestroyAllModules "#IncludeProtected"
		
		Idle 0.1
		SetState Chapter2_CompleteStart
	}
}
state Chapter2_CompleteStart
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter2_CompleteVideo
	}
	actions
	{
		
		SendToModule "#General" "#SetPosition=COMPPOINT3" "#Spline=COMCAM3" "#SetFocus=CAMFOCUS3"
		SendToModule "#General" "#CompleteMission" 
		SendToModule "#ActionRing" "#SetCompleted=#Chapter2" "#Unlock=#Chapter3"
		CreateModule "#Speech" "#PlayDelay=1.3" "#speech=#D1_ch3_obj5" "#AutoDestroy" "#Start"
	}
}
state Chapter2_Complete2Start
{
	
	actions
	{
		SetMusic "ACTION Mission1_3 QUIET Generic Play Action"
		DestroyAllModules "#IncludeProtected"
		
		Idle 0.1
		SetState Chapter2_Complete3Start
	}
}

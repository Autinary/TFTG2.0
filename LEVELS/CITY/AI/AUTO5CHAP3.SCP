		SendToModule "#ActionRing" "#SetCompleted=#Chapter3" "#Unlock=#Chapter4"
		
		CreateModule "#Speech" "#What" "#speech=#A5_ch3_cmplt" "#PlayDelay=1.2" "#AutoDestroy" "#Start"
 
	}
}

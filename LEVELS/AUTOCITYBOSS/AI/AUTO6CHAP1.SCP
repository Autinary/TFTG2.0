state Chapter1_MegatronFlyAwayInitE
{
	conditions
	{
		if module "Megatron PlayerRange" > 300 and
			if module "M29Drone Energy" <= 0.0 and 
				if module "TTDrone Energy" <= 0.0 and 
					if module "ATDrone Energy" <= 0.0 goto Chapter1_MegatronFlyInitE
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission

state Chapter4_BumbleBeeDead
{
	conditions
	{
		if module "creature getpercentagecomplete" == 1.0 goto Chapter4_Complete
		if module "D2C4KeyLocD FailMission" == 1.0 goto Chapter4_FailMission
	}
	actions
	{
		DestroyModule "#D2C4KeyLocD"
		SendToModule "#Creature" "#KeyLocation=Off"
		CreateModule "#KeyLocation" "#D2C4KeyLocD" "#Spline=KeyLoc1" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#HeadType=#StarScream"
		SendToModule "#General" "#SetMessage=BTranA1" "#SetMessageTimer=5"
	}

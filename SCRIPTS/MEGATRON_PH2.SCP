;		ResetTimer
;		CloseStrafe "MinAngle=50" "MaxAngle=140" "Range=7.0" "Time=4.0" "Roll"		; "Jump" "Slam"
;		SetState Alert
;	}
;}

state MeleeStrafeJump
{
	Conditions
	{
		if GotOpponent == 0.0 goto Alert
		if Timer > 4.0 goto Alert
	}
	Actions
	{
		ResetTimer
		CloseStrafe "MinAngle=80" "MaxAngle=140" "Range=6.5" "Time=4.0" "Jump"
		SetState Alert
	}
}

state MeleeStrafeSlam
{
	Conditions
	{
		if GotOpponent == 0.0 goto Alert
		if Timer > 4.0 goto Alert
	}
	Actions
	{
		ResetTimer
		CloseStrafe "MinAngle=80" "MaxAngle=140" "Range=6.5" "Time=4.0" "Jump" "Slam"
		SetState Alert
	}
}

state MeleeStrafeClose
{
	Conditions
	{
		if GotOpponent == 0.0 goto Alert
		if Timer > 4.0 goto Alert
	}
	Actions
	{
		ResetTimer
		CloseStrafe "MinAngle=80" "MaxAngle=140" "Range=5.5" "Time=4.0"
		SetState Alert
	}
}

state MeleeStrafeShoot
{
	Conditions
	{
		if GotOpponent == 0.0 goto Alert
		if Timer > 0.6 goto Alert
	}
	Actions
	{
		ResetTimer
		
		SetStrafe
		CloseStrafe "MinAngle=110" "MaxAngle=140" "Range=3000.0" "Time=5.0" "RollAway" "Roll" 
		SetState Alert
	}
}

state TakenHitMelee
{
	Conditions
	{
		if AlwaysTrue 0.75 < "ThrashedMelee" AND
		if Ability "Block" == 1.0 AND
		if BlockRequest == 1.0 AND
		if Param "Aggression" < 0.1 goto BlockAttackBegin

		if Ability "Block" == 1.0 AND
		if BlockRequest "forceonmelee" == 1.0 goto ForceBlock
		
		
		
		if AlwaysTrue == 1.0 goto Alert
	}
	Actions
	{
		ResetTimer
	}
}

state TakenHitPhysics
{
	Conditions
	{
		if BeenStruck == 1.0 goto BeenStruck
		if AlwaysTrue == 1.0 goto Alert
	}
	Actions
	{
		SetLocator "strikesource=20.0"
	}
}

state TakenHitReflect
{
	Conditions
	{
		if Ability "Block" == 0.0 goto Alert
		if AlwaysTrue == 1.0 goto ForceBlock
	}
}

state ForceBlock
{
	Conditions
	{
		if RobotForm == 0.0 goto BombingRun

		if AlwaysTrue > "RAND*4.0" goto HellFire
		if AlwaysTrue > "RAND*3.0" goto MeleeStrafeShoot
		

		;if Timer > 0.1 goto BlockAttackEnd
	}
	Actions
	{
		ResetTimer
		SetState BlockAttackEnd
	}
}
state Hellfire
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

				

		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttack

		if CanApproach == 0.0 goto Alert


		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll

		if Timer > 0.7 goto MeleeApproach
	}
	Actions
	{
		ResetTimer
		SetStrafe
		EngageOpponentTC "goalrange=1.0" "firerange=10.0" "RapidShootRange=10.0" "fireId=0" "firetimemin=0.3" "firetimemax=0.5"
		
	}
}
state BlockAttackBegin
{
	Conditions
	{
		if DistanceBetweenOpponent "ThirdScaleOnLargeCreature" > 6.0 goto BlockAttackEnd
	}
	Actions
	{
		SetBlocking "time=0.6" "attackatend" "faceopp"
		SetState BlockAttackEnd
	}
}

; Appears unused
;state BlockAttackDo
;{
;	Actions
;	{
;		Idle "frames=1"		; As SetStrafe cannot be easily undone
;		SetStrafe false
;		DoAttack "slammove"
;		SetState BlockAttackEnd
;	}
;}

state BlockAttackEnd
{
	Actions
	{
		
		SetState Alert
	}
}

state BeenStruck
{
	Conditions
	{
		if StuckTime > 1.0 goto BeenStruckExit
		if GotOpponent == 1.0 goto BeenStruckExit
	}
	Actions
	{
		SetFlag "TakeHitPhysics=true"
		SetWalkToLocatorTimer Max
		GoToLocator "run" "goalrange=3.0" "xz_rangecheck"
		SetState BeenStruckExit
	}
}

state BeenStruckExit
{
	Conditions
	{
		if GotOpponent == 1.0 goto Alert
	}
	Actions
	{
		Idle 3.0
		SetWalkToLocatorTimer 0.0
		SetState NoOpponent
	}
}

state StuckEscape
{
	Actions
	{
		SetFlag "TempBlock=true"
		SetStrafe false
		DoAttack "jumporkick"
		SetFlag "TempBlock=false"
		SetState Alert
	}
}

state StuckEscapeJump
{
	Actions
	{
		SetFlag "TempBlock=true"
		SetStrafe false
		DoAttack "jump"
		SetFlag "TempBlock=false"
		SetState Alert
	}
}

state StuckEscapeRoll
{
	Actions
	{
		SetFlag "TempBlock=true"
		SetStrafe false
		MoveSideways "MinDist=8.0" "MaxDist=10.0" "RayTime=0.4" 
		SetFlag "TempBlock=false"
		SetState Alert
	}
}


state AttackPOI
{
	Conditions
	{
		if BeenStruckTime <= 5.0 goto Alert
		if HasActivePOI == 0.0 goto Alert
	}
	Actions
	{
		AttackPOI
	}
}

state CarryOutSpecialMove
{
	Conditions
	{
		if Ability "SpecialThrow" == 1.0				goto SpecialPickupAttack
		if Ability "SpecialBlock" == 1.0				goto SpecialMoveHold
		if Ability "SpecialSapEnergy" == 1.0			goto SpecialMove
		if Ability "SpecialElectrocute" == 1.0			goto SpecialMove
		if Ability "SpecialFlameAttack" == 1.0			goto MigDroneChoose
		if Ability "SpecialMegatronFlame" == 1.0		goto SpecialMegatronFlame
		if Ability "SpecialCharge" == 1.0				goto SpecialMoveCharge
		if Ability "SpecialShootLikeAMadMan" == 1.0		goto SpecialMoveShootLikeAMadMan
		if Ability "SpecialSonicBoom" == 1.0			goto SpecialMoveSonicApproach
		if Ability "SpecialPickup" == 1.0				goto SpecialMove
		if Ability "SpecialReelIn" == 1.0				goto SpecialMove
		if Ability "SpecialFlail" == 1.0				goto SpecialMoveWalkApproach

		if AlwaysTrue == 1.0 goto Alert
	}
}

state MigDroneChoose
{
	Conditions
	{
		if SpecialPhase == 0.0 goto Alert

		if SpecialPhase == 1.0 goto SpecialMoveMigFlame
		if SpecialPhase == 2.0 goto SpecialMoveMigBlock
		if SpecialPhase == 3.0 goto SpecialMoveMigBlockVulnerable
		if SpecialPhase == 4.0 goto SpecialMoveMigFlyAway

		if AlwaysTrue == 1.0 goto Alert
	}
}

state SpecialThrow
{
	Actions
	{
		SetStrafe false
		EngageOpponentWithPickup "acquirerange=1.0" "throwrange=45.0"
		SetState Alert
	}
}

state SpecialMove
{
	Conditions
	{
		if CanOperateSpecialMove == 0.0 goto Alert
	}
	Actions
	{
		SpecialMove "HoldDownTime=max"
	}
}
;;;;mig Behaviour;;;;;
state SpecialMoveMigFlame
{
	Conditions
	{
		if SpecialPhase != 1.0 goto Alert 

		if Timer > 1.5 and
		if CanOperateSpecialMove == 0.0 goto Alert
	}
	Actions
	{
		ResetTimer
		SetStrafe false
		SetFlag "TakeHitReflect=false"
		SpecialMove "HoldDownTime=max" "faceopp"
		SetState Alert		; Probably unnecessary
	}
}

state SpecialMoveMigBlock
{
	Conditions
	{
		if SpecialPhase != 2.0 goto BlockAttackEnd 
		if CanOperateSpecialMove == 2.0 goto BlockAttackEnd
	}
	Actions
	{
		SetFlag "TakeHitReflect=false"
		SetBlocking "time=2000.0" "faceopp"
		SetState BlockAttackEnd
	}
}

state SpecialMoveMigBlockVulnerable
{
	Conditions
	{
		if SpecialPhase != 3.0 goto BlockAttackEnd 
		if CanOperateSpecialMove == 3.0 goto BlockAttackEnd
	}
	Actions
	{	
		SetFlag "TakeHitReflect=false"
		SetBlocking "time=5000.0" "faceopp"
		SetState BlockAttackEnd
	}
}

;;;;;;

state SpecialMoveMigFlyAway
{
	Conditions
	{
	}
	Actions
	{
		ResetTimer
		Transform Car UntilDone
		FlyAway goalrange=10.0 speed=250.0 distance=35.0 ;Time=3.0
		;FlyToPlayer goalrange=25.0 speed=100.0 ;alignplane ;Shadow
		Transform Robot UntilDone
		SetSpecialPhase Val=1.0
		SetState SpecialMoveMigLanding
	}
}

state SpecialMoveMigLanding
{
	Conditions
	{
		if OnGround == 1.0 goto Alert
		if Timer > 8.0 goto Alert
	}
	Actions
	{
		ResetTimer
	}
}

state SpecialMoveHold
{
	Conditions
	{
		if CanOperateSpecialMove == 0.0 goto Alert
	}
	Actions
	{
		SpecialMove "HoldDownTime=2.0"
		SetState Alert
	}
}

state SpecialMoveWalkApproach
{
	Conditions
	{
		if CanOperateSpecialMove == 0.0 goto Alert
		if AlwaysTrue > "RAND*3.0" goto SuckerPunch
		if Timer > 0.4 goto Phase1
		
	}
	Actions
	{
		ResetTimer
		SetPhysicsState "static=false" "immunetoshots=True" "immunetomelee=True"
	}
}
state Phase1
{
	Conditions
	{
		if CanOperateSpecialMove == 0.0 goto Alert
		if AlwaysTrue > "RAND*5.0" goto Shock_n'awe
		if DistanceBetweenOpponent < ShockNAweMin goto Shock_n'awe
		if Timer > 0.1 goto Phase2
		
	}
	Actions
	{
		ResetTimer
		EngageOpponentTC "goalrange=25.0" "RapidShootRange=25.0" "fireId=0" "firerange=7,0.0" "firetimemin=0.1" "firetimemax=0.1" 
	}
}
state Phase2
{
	Conditions
	{
		if CanOperateSpecialMove == 0.0 goto Alert
		if AlwaysTrue > "RAND*5.0" goto Shock_n'awe
		if DistanceBetweenOpponent < ShockNAweMin goto Shock_n'awe
		if Timer > 1.0 goto Phase1
		
	}
	Actions
	{
		ResetTimer
		SetStrafe
		EngageOpponent "goalrange=1.0" "fireinterval=((0.1-ThrashedMelee)/FIRERATE)" "firerange=90.0" "spread=0.0" 
	}
}
state SuckerPunch
{
	Conditions
	{
		if CanOperateSpecialMove == 0.0 goto Alert
		if AlwaysTrue > "RAND*5.0" goto Shock_n'awe
		if DistanceBetweenOpponent < ShockNAweMin goto Shock_n'awe
		if Timer > 3.0 goto Phase1
		
	}
	Actions
	{
		ResetTimer
		
		EngageOpponent "goalrange=25.0" "fireinterval=((0.1-ThrashedMelee)/FIRERATE)" "firerange=90.0" "spread=0.0" 
	}
}

state Shock_n'awe
{
	Conditions
	{
		if CanOperateSpecialMove == 0.0 goto Alert
		
		
	}
	Actions
	{
		SetFlag "TakeHitReflect=false"
		EngageOpponent "goalrange=1.0" "firerange=-1.0" "#Walk" "holdspecialflail" "holdspecialboom"
	}
}
state SpecialMegatronFlame
{
	Conditions
	{
		if CanOperateSpecialMove == 0.0 goto Alert
		if GotOpponent == 0.0 goto NoOpponent
		if DistanceBetweenOpponent > 40.0 goto SpecialMegatronFlameApproach
	}
	Actions
	{
		SetPhysicsState "static=false" "immunetoshots=True" 
		SpecialMove "HoldDownTime=max" "HoldMegatronFlame" "faceopp"
		SetState Alert		; Probably unnecessary
	}
}
state SpecialMegatronFlameApproach
{
	Conditions
	{
		if CanOperateSpecialMove == 0.0 goto Alert
		if GotOpponent == 0.0 goto NoOpponent
		if DistanceBetweenOpponent < 30.0 goto SpecialMegatronFlame
	}
	Actions
	{
		EngageOpponent "goalrange=1.0" "firerange=-1.0" "walk"
	}
}

state SpecialMoveCharge
{
	Conditions
	{
		if CanOperateSpecialMove == 0.0 goto Alert

		
		if OnPath == 0.0 AND
		if TimeOffPath > 5.0 goto SpecialMoveChargeReFindPath
	}
	Actions
	{
		SetPhysicsState "static=false" "immunetoshots=True" 
		SpecialCharge "delay=3" "range=10.0" "overshoot=3"
		SetState Alert		; Probably unnecessary
	}
}

state SpecialMoveChargeReFindPath
{
	Conditions
	{
		if OnPath == 1.0 AND
		if Timer > 0.2 goto SpecialMoveCharge
	}
	Actions
	{
		ResetTimer
		GoToNearestNode
	}
}

state SpecialMoveShootLikeAMadMan
{
	Conditions
	{
		if CanOperateSpecialMove == 0.0 goto Alert
	}
	Actions
	{
		SetFlag "TakeHitPhysics=false" "TakeHitMelee=false" "TakeHit=false" "TakeHitReflect=false"
		IronHideShoot Range=80 Tolerance=10
		SetState Alert
	}
}

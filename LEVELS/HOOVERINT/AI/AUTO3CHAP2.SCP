state Chapter2_Main
{
	;conditions
	;{
	;	if message "MissionMessage" == 1.0 goto Chapter2_Complete
	;	if message "MissionMessage" == 2.0 goto Chapter2_FailMission 
	;	if message "MissionMessage" == 3.0 goto Chapter2_FanAStart 
	;	;if module "FanA GetPercentageComplete" == 1.0 goto Chapter2_FanAStart
	;}
	actions
	{
		SetMusic "ACTION Mission2_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter3_DeathFailMission"
		SendToModule "#General" "#ResetCounters"
		
		SendToModule "#General" "#PhysObj" "#SetPlayer=#Chapter2Start" "#FadeUp" 
		CreateModule "#DroneCounter" "#DroneCounter" "#IgnoreDroneKills" "#DronesToDefeat=6" "#IconType=#FanItem"  "#Protect
		CreateModule "#SplineExplode" "#A3C2TunnelA" "#Spline=A3C2TunnelA" "#EnableSplineExplosions" "#Protect"
		CreateModule "#SplineExplode" "#A3C2TunnelB" "#Spline=A3C2TunnelB" "#EnableSplineExplosions" "#Protect"
		CreateModule "#SplineExplode" "#A3C2TunnelC" "#Spline=A3C2TunnelC" "#EnableSplineExplosions" "#Protect"
		CreateModule "#SplineExplode" "#A3C2TunnelD" "#Spline=A3C2TunnelD" "#EnableSplineExplosions" "#Protect"
		CreateModule "#SplineExplode" "#A3C2TunnelE" "#Spline=A3C2TunnelE" "#EnableSplineExplosions" "#Protect"
		CreateModule "#SplineExplode" "#A3C2TunnelF" "#Spline=A3C2TunnelF" "#EnableSplineExplosions" "#Protect"
	
		;;CreateModule "#SpecialObj" "#FanA" "#Placement=A3C2A" "#Protect" "#AttachFanSpecial=fan1"
		;CreateModule "#SpecialObj" "#FanB" "#Placement=A3C2B" "#Protect" "#AttachFanSpecial=fan2"
		;CreateModule "#SpecialObj" "#FanC" "#Placement=A3C2C" "#Protect" "#AttachFanSpecial=fan3"
		;CreateModule "#SpecialObj" "#FanD" "#Placement=A3C2D" "#Protect" "#AttachFanSpecial=fan4"
		;CreateModule "#SpecialObj" "#FanE" "#Placement=A3C2E" "#Protect" "#AttachFanSpecial=fan5"
		;CreateModule "#SpecialObj" "#FanF" "#Placement=A3C2F" "#Protect" "#AttachFanSpecial=fan6"

		CreateModule "#SpecialObj" "#FanA" "#Spline=A3C2FanA" "#Radius=8.0" "#PhysObjGlow" "#Breakable" "#SetRadarType=#FanDot" "#NoWeaponDamage" "#Protect" "#AttachFanSpecial=fan1"
		CreateModule "#SpecialObj" "#FanB" "#Spline=A3C2FanB" "#Radius=8.0" "#PhysObjGlow" "#Breakable" "#SetRadarType=#FanDot" "#NoWeaponDamage" "#Protect" "#AttachFanSpecial=fan2"
		CreateModule "#SpecialObj" "#FanC" "#Spline=A3C2FanC" "#Radius=8.0" "#PhysObjGlow" "#Breakable" "#SetRadarType=#FanDot" "#NoWeaponDamage" "#Protect" "#AttachFanSpecial=fan3"
		CreateModule "#SpecialObj" "#FanD" "#Spline=A3C2FanD" "#Radius=8.0" "#PhysObjGlow" "#Breakable" "#SetRadarType=#FanDot" "#NoWeaponDamage" "#Protect" "#AttachFanSpecial=fan4"
		CreateModule "#SpecialObj" "#FanE" "#Spline=A3C2FanE" "#Radius=8.0" "#PhysObjGlow" "#Breakable" "#SetRadarType=#FanDot" "#NoWeaponDamage" "#Protect" "#AttachFanSpecial=fan5"
		CreateModule "#SpecialObj" "#FanF" "#Spline=A3C2FanF" "#Radius=8.0" "#PhysObjGlow" "#Breakable" "#SetRadarType=#FanDot" "#NoWeaponDamage" "#Protect" "#AttachFanSpecial=fan6"
		
        CreateModule "#AAGun" "#AAGun" "#Protect"
		SendToModule "#AAGun" "#Type=AAGUNTYPE_BULLITS" "#Placement=TurretRocketGlobal" "#Range=100.0" "#Delay=5.0" "#Energy=100.0" "#RespawnDelay=30" "#Ammo=0" "#Create"

		SendToModule "#General" "#TrafficLv = 0"                        ; lock traffic level (1-5) (0=OFF)
		SendToModule "#General" "#PatrolLv = 0"                         ; patrol level (1=ON, 0=OFF)

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 2"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 2"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 2"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission

		SendToModule "#General" "#ClearPlayerChecks"


		
		CreateModule "#Speech" "#A3_ch2_obj5" "#speech=#A3_ch2_obj5" "#Protect"
		CreateModule "#Speech" "#A3_ch2_obj3" "#speech=#A3_ch2_obj3" "#Protect"
		CreateModule "#Speech" "#A3_ch2_obj4" "#speech=#A3_ch2_obj4" "#Protect"
		CreateModule "#Speech" "#A3_ch2_obj1" "#speech=#A3_ch2_obj1" "#Protect"
		CreateModule "#Speech" "#A3_ch2_obj2" "#speech=#A3_ch2_obj2" "#Protect"
		CreateModule "#AreaRange" "#A3C2FanA2" "#Trigger=#A3C2FanA2" "#Protect"

		CreateModule "#Timer" "#Timer" "Time=60.0" "#Protect"
		
		SetState "Chapter2_TunnelHub2"
	}
}
state Chapter2_FanAStart
{
	conditions
	{
		;if module "ProgressPoint AnyBeenTriggered" == 1.0 goto Chapter2_PlayCameraA
		if module "A3C2FanA InArea" == 1.0 goto Chapter2_PlayCameraA
		if module "A3C2TunnelA GetPlayerRange" < 250.0 goto Chapter2_TunnelDeathA ; Chapter2_FailMission
		if module "Timer Timer" < 0.0 goto Chapter2_FailMission
	}
	actions
	{
		SendToModule "#DroneCounter" "#Increment=1"
		SendToModule "#A3_ch2_obj1" "#StartOneShot"
		DestroyModule "#Timer1"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelADust1" "#SetSplineType=#DustSmall" "#SetBitRadius=330"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelADust2" "#SetSplineType=#DustMedium" "#SetBitRadius=300"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelADust2" "#SetSplineType=#DustLarge" "#SetBitRadius=270"

state Chapter3Alt_IntoStage3 
{
	conditions 
	{
		if module "BoneCrusher Complete" == 1.0 goto Chapter3Alt_Stage3
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		SendToModule "#BoneCrusher" "#TransformForceCar"

		SendToModule #BoneCrusherHealth #NoDraw

		SendToModule "#BoneCrusherHealth" "#Time=45.0" "#Stop"

		SendToModule "#BoneCrusher" "#DirectSpline=D3C3_BONECRUSHER3"
		SendToModule "#BoneCrusher" "#Object=#GreenMediumDot"

		DestroyModule "#AAGunLaser"
		DestroyModule "#AAGunRockets"
		
       		CreateModule "#AAGun" "#AAGunLaser"
		SendToModule "#AAGunLaser" "#Breakable" "#Type=AAGUNTYPE_LASER" "#Placement=AAGun_AD3C33L" "#Range=100.0" "#Delay=0.0" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"
		CreateModule "#AAGun" "#AAGunRockets"
		SendToModule "#AAGunRockets" "#Breakable" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAGun_AD3C33R" "#Range=100.0" "#Delay=0.7" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"
		CreateModule "#AAGun" "#AAGunBullets"
		SendToModule "#AAGunBullets" "#Breakable" "#Type=AAGUNTYPE_BULLITS" "#Placement=AAGun_AD3C33B" "#Range=100.0" "#Delay=0.0" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"

        }
}
state Chapter3Alt_Stage3 
{
	conditions 
	{
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission
		if module "AAGunLaser GetPercentageComplete" == 1.0 and
			if module "AAGunRockets GetPercentageComplete" == 1.0 and
				if module "AAGunBullets GetPercentageComplete" == 1.0 goto Chapter3Alt_IntoStage4
			
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
		;if Timer > 5 goto Chapter3Alt_IntoStage4
	}
	actions
	{
		;ResetTimer
		SendToModule "#BoneCrusherHealth" "#Time=30.0"
		SendToModule "#BoneCrusher" "#TransformForceRobot"
		SendToModule "#BoneCrusherHealth" "#StartLoseHealth" "#Draw"
		SendToModule "#BoneCrusher" "#Object=#RedMediumDot"
	}
}
state Chapter3Alt_IntoStage4 
{
	conditions {
		if module "BoneCrusher Complete" == 1.0 goto Chapter3Alt_Stage4
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		SendToModule "#BoneCrusher" "#TransformForceCar"

		SendToModule #BoneCrusherHealth #NoDraw

		SendToModule "#BoneCrusherHealth" "#Time=45.0" "#Stop"

		SendToModule "#BoneCrusher" "#DirectSpline=D3C3_BONECRUSHER4"
		SendToModule "#BoneCrusher" "#Object=#GreenMediumDot"

		DestroyModule "#AAGunLaser"
		DestroyModule "#AAGunRockets"
		
   		
	        CreateModule "#AAGun" "#AAGunRockets"
		SendToModule "#AAGunRockets" "#Breakable" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAGun_AD3C34R" "#Range=100.0" "#Delay=0.7" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#IgnorePlayer" "#Create"
		CreateModule "#AAGun" "#AAGunLaser"
		SendToModule "#AAGunLaser" "#Breakable" "#Type=AAGUNTYPE_LASER" "#Placement=AAGun_AD3C34L" "#Range=100.0" "#Delay=0.0" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"
		
	}
}
state Chapter3Alt_Stage4 
{
	conditions 
	{
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		if module "AAGunRockets GetPercentageComplete" == 1.0 and
			if module "AAGunLaser GetPercentageComplete" == 1.0 goto Chapter3Alt_IntoComplete
			
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission

		;if Timer > 5 goto Chapter3_IntoComplete
	}
	actions
	{
		;ResetTimer

		SendToModule "#BoneCrusherHealth" "#Time=50.0"
		SendToModule "#BoneCrusher" "#TransformForceRobot"
		SendToModule "#BoneCrusherHealth" "#StartLoseHealth" "#Draw"
		SendToModule "#BoneCrusher" "#Object=#RedMediumDot"
	}
}





state Chapter3_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter3_Restart
		
	}
	actions
	{
		SendToModule "#General" "#EndOfMission"  "#DeathFailMission"
	}
}
state Chapter3_FailMission
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter3_Restart
	}
	actions
	{
		SendToModule "#General" "#EndOfMission"  "#FailMission"
	}
}
state Chapter3_Restart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#UnLoadCreature=BoneCrusher"
		SendToModule "#General" "#UnLoadCreature=TripleC"
		SendToModule "#General" "#PlayerType=StarScream,StarScream,StarScream,StarScream,StarScream"
		SendToModule "#General" "#ResetLevelCharacters"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter3Restart" "#FadeUp"
		SetState "GlobalActionRing"
	}
}
state Chapter3_IntoComplete
{
	conditions 
	{
		if module "ShortDelay FailMission" == 1.0 goto Chapter3_Complete
	}
	actions 
	{
		CreateModule "#Timer" "#ShortDelay" "#Time=4.6" "#NoDraw"
		SendToModule "#Chatter3" "#StartOneShot" 
		SendToModule "#BoneCrusher" "#TransformForceCar"

		SendToModule #BoneCrusherHealth #NoDraw

		SendToModule "#BoneCrusherHealth" "#Time=45.0" "#Stop"

		SendToModule "#ArtilleryTurret" "#SetEnergy=0.0"
		
		SendToModule "#BoneCrusher" "#DirectSpline=D3C2BoneCrusher4"
		SendToModule "#BoneCrusher" "#Object=#GreenMediumDot"

		DestroyModule "#AAGunLaser"
		DestroyModule "#AAGunRockets"
	}
}
state Chapter3Alt_IntoComplete
{
	conditions 
	{
		if module "ShortDelay FailMission" == 1.0 goto Chapter3Alt_Complete
	}
	actions 
	{
		CreateModule "#Timer" "#ShortDelay" "#Time=4.6" "#NoDraw"
		SendToModule "#BoneCrusher" "#TransformForceCar"

		SendToModule #BoneCrusherHealth #NoDraw

		SendToModule "#BoneCrusherHealth" "#Time=45.0" "#Stop"


		SendToModule "#BoneCrusher" "#DirectSpline=D3C4_BoneCrusher4"
		SendToModule "#BoneCrusher" "#Object=#GreenMediumDot"

		DestroyModule "#AAGunLaser"
		DestroyModule "#AAGunRockets"
	}
}
state Chapter3_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter3_CompleteVideo
	}
	actions
	{
		SendToModule "#General" "#EndOfMission"  "#SetPosition=COMPPOINT2" "#Spline=COMCAM2" "#SetFocus=CAMFOCUS2"
		DestroyModule "#BoneCrusherHealth"
		SendToModule "#General" "#CompleteMission" "#Unlock=#Chapter4"
		SendToModule "#ActionRing" "#SetCompleted=#Chapter3" "#Unlock=#Chapter4"
	}
}
state Chapter3Alt_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter3_CompleteVideo
	}
	actions
	{
		SendToModule "#General" "#EndOfMission"  "#SetPosition=COMPPOINT4" "#Spline=COMCAM4" "#SetFocus=CAMFOCUS4"
		DestroyModule "#BoneCrusherHealth"
		SendToModule "#General" "#CompleteMission" "#Unlock=#Chapter4"
		SendToModule "#ActionRing" "#SetCompleted=#Chapter3" "#Unlock=#Chapter4"
	}
}
state Chapter3_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter3_CompleteVideoFinished
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartOutroVideo=#D3C3Outro2"
	}
}
state Chapter3_CompleteVideoFinished
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter3_Leave
	}
	actions
	{
		SendToModule "#General" "#UnLoadCreature=BoneCrusher"
		SendToModule "#General" "#UnLoadCreature=TripleC"
		
		SendToModule "#General" "#PlayerType=StarScream,StarScream,StarScream,StarScream,StarScream" 
		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter3_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		IncreasePlayerHealth max
		setstate "PickGoto"
	}
}

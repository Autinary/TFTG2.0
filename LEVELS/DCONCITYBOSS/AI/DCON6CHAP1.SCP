		Idle 3.0
		SetState Chapter1_GetToLoc1
	}

}

state Chapter1_GetToLoc1
{
	Conditions
	{
		if module "AreaRange InArea" == 1.0 goto Chapter1_Midtro1
		if module "Optimus BeenHit" == 1.0 goto Chapter1_Midtro1
		if module "Timer Timer" < 0.0 goto Chapter1_FailMission
	}
	Actions
	{
		DestroyModule "#KeyLocation" 
		DestroyModule "#SplineObj"
		DestroyModule "#Optimus"
		CreateModule "#Creature" "#Optimus" "#Spline=D6LOC1_Spawn" "#Script=Optimus_WI" "#count=1" "#maxalive=1" "#Type=OptimusPrime" "#Invulnerable" "#SpawnInLosInit" "#ADDTORADAROFF" "#ForcePlayerAsOpp"  "#SetEnergyMax=15000" "#SetEnergy=10500" "#SetEnergyMin=10500.0"
		
		CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6LOC1_ALLSPARK" "#Wobble=2.0" "#Creature=#Creature" "#Time=9999.0" "#NoDraw" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference" 
		
		SendToModule "#General" "#SetMessage=Find_The_Cube" "#SetMessageTimer=7"
		SendToModule "#General" "#SetMessageTimer=-1"
		
		;SendToModule "#General" "#SetMessage=A5_ch3_obj1" "#SetMessageTimer=7"
		DestroyModule "#Timer"
		CreateModule "#Timer" "#Timer" "Time=60.0"

		CreateModule "#AreaRange" "#AreaRange" "#Trigger=#D6LOC1_AREA" "#AddToRadarOff" "#DontClampRadar"
		;CreateModule "#AreaRange" "#AreaRange" "#KeyLocSpline=D6LOC1_KEYLOC" "#AddToRadar" "#DontClampRadar"
	}

}

state Chapter1_Midtro1
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_Fight1Start
	}
	actions
	{	
		SendToModule "#General" "#StartVideo=#D6C1Midtro1" "#FadeDown"
	}
}


;;end of Location 0


		DestroyModule "#CreatureWaveI"
		DestroyModule "#KeyLocation"
		SendToModule "#Ratchet" "#AddToRadar" "#SuppressShieldOff"
		SendToModule "#General" "#BG_UnLoadCreature=DroneTowTruck"
		SendToModule "#General" "#BG_UnLoadCreature=DroneForkLift"
		SendToModule "#General" "#BG_LoadCreature=DroneCement"
		SendToModule "#General" "#BG_LoadCreature=DroneDefault"
		
		;SendToModule "#JazzHealth" #Time=60.0 "#StartLoseHealth" "#Draw" 

		CreateModule "#Speech" "#A2_ch2_obj7" "#speech=#A2_ch2_obj9" "#AutoDestroy" "#Start"
		CreateModule "#Speech" "#A2_ch2_obj7" "#speech=#A2_ch2_obj14" "#PlayDelay=5" "#AutoDestroy" "#Start"
		;CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A2_ch2_obj12" "#AutoDestroy" 
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A2_ch2_obj8" "#AutoDestroy" 

		;CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=7" "#times=2"

		SendToModule "#RadarSplinePoint" "#SetAtEnd"
		CreateModule "#AreaRange" "#TriggerD" "#Trigger=#A2C2TriggerD" "#AddToRadar" "#ParticleRing" 
		
		;CreateModule "#Speech" "#DefeatDrones" "#speech=#A2_ch2_obj3" "#AutoDestroy" "#Start"
	}
}
state Chapter2_Heal6
{
	
	actions
	{
		DoMacro AutoHeal
		SetState Chapter2_PostMedicProcess6
		
		
	}
}

state Chapter2_FifthPartMidtro1
{
	conditions
	{
		if module "Timer FailMission" == 1.0 goto Chapter2_FifthPartMidtro
	}
	actions
	{
		DestroyAllModules
		

		
		CreateModule "#Timer" "#Timer" "#Time=1.5" "#NoRender" "#Start"
		
		CreateModule "#Speech" "#DefeatDrones" "#speech=#A2_ch2_obj13" "#AutoDestroy" "#Start"
		
	}
}
state Chapter2_FifthPartMidtro
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter2_FifthPart
	}
	actions
	{
		DestroyModule "#TriggerD"
		SendToModule "#General" "#StartVideo=#A2C2Midtro4"
		SendToModule #JazzHealth "#StopLoseHealth"
	}
}
state Chapter2_FifthPart
{
	conditions
	{
		if module "CreatureWaveH GetPercentageComplete" == 1.0 and
			if module "CreatureWaveA GetPercentageComplete" == 1.0 and 
				if module "CreatureWaveB GetPercentageComplete" == 1.0 goto Chapter2_FifthPart2

;		if module "JazzHealth Finished" == 1.0 goto Chapter2_FailMission 
		if module "KeyLocation FailMission" == 1.0 goto Chapter2_FailMission
		;if module "Timer FailMission" == 1.0 goto Chapter2_FifthPart2
	}
	actions
	{
		DestroyAllModules

;;    	SendToModule "#General" "#UnLoadCreature=DroneTowTruck"
;;    	SendToModule "#General" "#LoadCreature=DroneCement"

		SendToModule #JazzHealth "#StopLoseHealth" "#NoDraw" 
		DestroyAllModules "#IncludeProtected" 
		DestroyModule "#Ratchet"
		DestroyModule "#RadarSplinePoint"
		CreateModule "#Speech" "#DefeatDrones" "#speech=#A2_ch2_obj13" "#AutoDestroy" "#Start"
		CreateModule "#Creature" "#CreatureWaveH" "#Spline=A2C2SpawnH" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneCement" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=CACCombat"
		CreateModule "#Creature" "#CreatureWaveA" "#Spline=A2C2SpawnD" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneDefault" "#SpawnInLosInit" "#SpawnAsCreature" "#SetPosition=#A2C2FinalDroneSpawn1" "#KeyLocation=On" 
		CreateModule "#Creature" "#CreatureWaveB" "#Spline=A2C2SpawnF" "#count=1" "#maxalive=1" "#addtoradar" "#Type=DroneDefault" "#SpawnInLosInit" "#SpawnAsCreature" "#SetPosition=#A2C2FinalDroneSpawn2" "#KeyLocation=On" 
		
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=A2C2KeyLocD" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#Radius=125.0" ;"#Spline=A2C2KeyLocD" 
		SendToModule "#General" "#PhysObj" "#SetPlayer=#A2C2StartD" "#FadeUp"	
		CreateModule "#SpecialObj" "#SpecialObj" "#Placement=LO_A2C2" "#Pinned" "#Terrain"
		CreateModule "#SpecialObj" "#A2_ch2_obj1" "#Placement=GC_A2C2" "#Type=PHYSOBJTYPE_TRQ_GENERIC18" "#RespawnDelay=10"
		CreateModule "#SpecialObj" "#A2_ch2_obj2" "#Placement=LP_A2C2" "#Type=PHYSOBJTYPE_TRQ_GENERIC21" "#RespawnDelay=10"
	}
}
state Chapter2_FifthPart2
{
	conditions
	{
	
		if module "CheckPlayerPOS1 InArea" == 1.0 goto Chapter2_FinalRatSpawn1
		if module "CheckPlayerPOS2 InArea" == 1.0 goto Chapter2_FinalRatSpawn2
		if Timer > 1.5 goto Chapter2_FifthPart3

	}
	actions
	{
		ResetTimer
		CreateModule "#AreaRange" "#CheckPlayerPOS1" "#Trigger=#PlayerPositionTracker1" ; "#AddToRadar" 
		CreateModule "#AreaRange" "#CheckPlayerPOS2" "#Trigger=#PlayerPositionTracker2" ; "#AddToRadar" 
		
		
	}
}
state Chapter2_FinalRatSpawn1
{
	conditions
	{
	
		if module "Timer FailMission" == 1.0 goto Chapter2_CompleteIntro
	}
	actions
	{
		
		CreateModule "#Timer" "#Timer" "#Time=3.7" "#NoRender" "#Start"
		CreateModule "#Creature" "#Ratchet" "#SpawnSpline=A2C2SpawnD" "#type=DroneArmouredCar_a" "#AddToRadarOff" "#SpawnAsVehicle" "#Speed=120" "#Unstoppable" "#Friend" "#SetPosition=#BackupRatchetSpawn6" "#SetEnergyMax=1500" "#SetEnergy=1500" ; "#Invulnerable" 
		SendToModule "#Ratchet" "#TransformForceRobot"
		SendToModule "#Ratchet" "#SetEnergyMax=9000.0" "#SetEnergy=9000.0" 
		
		
	}
}

state Chapter1_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayerAtDeathPoint" "#FadeUp"
		SetState "Exit"
	}
}

state Chapter1_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_HubRestart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter1_InitGoto
{
	conditions
	{
		if module "General GetFinishedMissionStart" == 1.0 goto Chapter1_GotoWaitSpeech
                
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		
	
;		CreateModule "#VehicleLevels" "#VehicleLevels" "#ResponseLv=0" "#TrafficLv=1" "#PatrolLv=1" 

		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
    	SendToModule "#General" "#ResponseLv_ClampMax   = 4"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 4"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming



		DestroyModule "#AAGunLaser"
		CreateModule "#AAGun" "#AAGunLaser" "#Protect"
		SendToModule "#AAGunLaser" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAJL" "#Range=100.0" "#Delay=0.5" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"

		DestroyModule "#AAGunRockets"
		CreateModule "#AAGun" "#AAGunRockets" "#Protect"
		SendToModule "#AAGunRockets" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAJR" "#Range=100.0" "#Delay=2.0" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"

		DestroyModule "#AAGunBullets"
		CreateModule "#AAGun" "#AAGunBullets" "#Protect"
		SendToModule "#AAGunBullets" "#Type=AAGUNTYPE_BULLITS" "#Placement=AAJB" "#Range=100.0" "#Delay=0.1" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"
		
               	SendToModule "#General" "#StartMission" "#SetVehicle=#StartMission" "#SetPlayerDeathPoint=#StartMission" "#PlayerType=Blackout"
	}
}
state Chapter1_GotoWaitSpeech
{
	actions
	{
               
		SendToModule "#General" "#AllowPlayerMovement"
		
		Idle 2.0
		CreateModule "#Speech" "#MissionStartSpeech" "#speech=#D1_ch1_Goto" "#Start" "#AutoDestroy"
                CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_Goto2" "#AutoDestroy"           
                CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_Goto3" "#AutoDestroy"
                CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_Goto4" "#AutoDestroy"
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=60" "#times=3" 

   		Idle 3.0
		SetState Chapter1_Goto
	}
}
state Chapter1_Goto
{
	
	actions
	{
              	CreateModule "#AndSwitch" "#AndSwitchReminder" "#moduletag=#DelayedSendReminder" "#placement=#Chapter1Beacon" "#rangeoutside=75"
		SetState "GlobalActionRing"
		
	}
}
state Chapter1_Enter
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter1_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter1_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules "#IncludeProtected"
		
		;SendToModule "#VehicleLevels" "#ResponseLv=10" "#TrafficLv=10" "#PatrolLv=1" 

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission


		DestroyModule "#AAGunLaser"
		CreateModule "#AAGun" "#AAGunLaser" "#Protect"
		SendToModule "#AAGunLaser" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAJL" "#Range=100.0" "#Delay=0.5" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"

		DestroyModule "#AAGunRockets"
		CreateModule "#AAGun" "#AAGunRockets" "#Protect"
		SendToModule "#AAGunRockets" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAJR" "#Range=100.0" "#Delay=2.0" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"

		DestroyModule "#AAGunBullets"
		CreateModule "#AAGun" "#AAGunBullets" "#Protect"
		SendToModule "#AAGunBullets" "#Type=AAGUNTYPE_BULLITS" "#Placement=AAJB" "#Range=100.0" "#Delay=0.1" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"
		
		SendToModule "#General" "#StartMissionIntro=#D1C1Intro1" "#SetPlayerDeathPoint=#Chapter1Restart"
	}
}
state Chapter1_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_Main
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"
		SendToModule "#General" "#PlayerType=Blackout"

		SendToModule "#General" "#LoadCreature=DroneForklift"
		SendToModule "#General" "#LoadCreature=DroneDefault"
	}
}

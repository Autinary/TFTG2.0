		if module "CreatureWaveA Energy" <= 0.0 goto Chapter3_TowTruckC
		if Timer > 10.0 goto Chapter3_TowTruckC

		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountA" == 1.0 goto Chapter3_HealF3B2

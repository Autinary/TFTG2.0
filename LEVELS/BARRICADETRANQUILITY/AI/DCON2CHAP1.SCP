		;SendToModule "#D2C1WaveB1" "#WaitEmpty" "#NoRender" "#RemoveBoss"
		;SendToModule "#D2C1WaveB1" "#WaitLoaded" "#NoRender" "#RemoveBoss"
		
		CreateModule "#Creature" "#D2C1Drone1" "#Type=DronePickupTruck_a" "#Spline=D2C1WaveB" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementJ" "#SpawnAsVehicle" 
		CreateModule "#Creature" "#D2C1Drone2" "#Type=DronePickupTruck_a" "#Spline=D2C1WaveB" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementK" "#SpawnAsVehicle"

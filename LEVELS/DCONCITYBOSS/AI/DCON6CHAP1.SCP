		SendToModule "#General" "#LoadCreature=DroneCement_a"
		SendToModule "#General" "#LoadCreature=StarScream"
		
		;SendToModule "#ActionRing" "#SetCompleted=#Chapter1" "#Unlock=#Chapter2"

		SendToModule "#General" "#SetMaxOpponents=18" "#SetMaxApproachers=18" "#SetAttackRingSize=20"


	actions {
		SendToModule "#TimerB" "#Start" ;"#Render"
		SendToModule "#MegatronArm" "#CLEARTRIGGEREDCOMPLETE"
		SetState ActivateCanister 
	}
}

state ActivateCanister
{
	Conditions
	{
			if module "General GetCount" == 0.0 goto Chapter4_ActivateCanister1
			if module "General GetCount" == 1.0 goto Chapter4_ActivateCanister2
			if module "General GetCount" == 2.0 goto Chapter4_ActivateCanister3
			if module "General GetCount" == 3.0 goto Chapter4_ActivateCanister4
			if module "General GetCount" > 3.0 goto Chapter4_MegaTronAwakes
	}
	

}

state Chapter4_ActivateCanister1
{
	
	actions 
	{
		;turn on effect...
		;SendToModule "#A3C4ObjectA" "#PhysObjGlow" "#ResetDamageFlags" "#Breakable" 
		SendToModule "#MegatronThawTime" "#SetEnergy=61.0" 
		SendToModule "#A3C4RespawnTimer" "#ClearTriggeredComplete" "#Time=30.0" "#Stop"
		SendToModule "#HardBuildings" "#Scale=0.5" 
		SendToModule "#Hardbuildings" "#TurnOn=0"
		SendToModule "#General" "#SetMessage=HIntD13" "#SetMessageTimer=2.0" 
		SendToModule "#HereWeGo" "#StartOneShot"
		
		SetState Chapter4_MegaTronAwakes 
	}
}


		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar"
		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar_a"
		SendToModule "#General" "#UnLoadCreature=DroneTowTruck"
		SendToModule "#General" "#UnLoadCreature=Brawl"
		SendToModule "#General" "#PlayerType=IronHide,Jazz,IronHide,BumbleBee07,IronHide" "#SetVehicle=#COMPPOINT6" 

		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter3_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter4"
		SendToModule #General #ResetLevel
		IncreasePlayerHealth max
		SendToModule "#General" "#CountDSet=5"
		setstate "PickGoto"
	}
}

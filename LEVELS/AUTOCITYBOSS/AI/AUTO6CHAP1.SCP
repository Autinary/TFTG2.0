state Chapter1_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter1_CompleteVideo
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#SetPosition=COMPPOINT1" "#Spline=COMCAM1" "#SetFocus=CAMFOCUS1"
		SendToModule #General #UnlockBonus=Character_AutobotCampaign
		CreateModule "#ActionRing" "#ActionRing" "#ProtectSystem" "#AddToRadarOff"
		;SendToModule "#ActionRing" "#CreateChapter=#Chapter1"
		SendToModule "#ActionRing" "#SetCompleted=#Chapter1" ;"#Unlock=#Chapter1"
		SendToModule "#General" "#CompleteMission" "#LevelCompleteAchievement"
	}
}
state Chapter1_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_CompleteVideoFinished
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartCampaignOutro=#A6C1Outro"
		;SetState "Chapter1_CompleteVideoFinished"
	}
}
state Chapter1_CompleteVideoFinished
{
	conditions
	{
;		if module "General GetFinishedOutro" == 1.0 goto Chapter1_Leave
	}
	actions
	{
		SendToModule "#General" "#FinishedOutroVideo"
		SendToModule "#General" "#FinishedLevel"
		;SetState Chapter1_Leave	Go Back to front end so dont do this
	}
}
state Chapter1_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		IncreasePlayerHealth max
		SendToModule "#General" "#SetPlayerDeathPoint=#COMPPOINT1"
		SendToModule #General #AllowPlayerMovement
		SetState GlobalActionRing
	}
}

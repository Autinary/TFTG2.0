{
	conditions
	{
		if module "General GetCountA" <= 3.0 goto Chapter4_BoneyArrivedAtEndFirst
	}
	actions 
	{
		SendToModule #D3C4KeyLocBoney #NoProcess #NoRender
		SendToModule "#BoneCrusherEscape" "#TransformForceCar"
		SendToModule "#General" "#SetStateBit=1" 
		SendToModule "#BoneCrusherEscape" #RegenHealth=3
		SendToModule "#BoneCrusherEscape" "#DirectSpline=D3C4_BoneCrusher4" "Range=10.0" "#Object=#GreenMediumDot" "#SplineStep=0" "#Invulnerable" "#Speed=40"
		SendToModule "#General" "#CountBSet=4"
		Idle 0.1
		SetState Chapter4_Escaping
	}
}


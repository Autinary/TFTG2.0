	{
		DestroyModule "#Megatron"
		CreateModule "#Goto" "#Megatron" "#SpawnSpline=A6C1MegaArrive1" "#SpawnInLOSInit" "#SpawnAsCreature" "#ForcePlayerAsOpp" "#BlockDeath" "#Boss" "#Type=Megatron" "#SetEnergyMax=2500" "#SetEnergy=1500" "#Protect" "#Script=StandAndWait" "#AddToRadarOff"
		
		SetState Chapter1_Phase4ChooseMegaDropType
	}
}
state MegaHealth50
{
	actions
	{
		DestroyModule "#Megatron"
		CreateModule "#Goto" "#Megatron" "#SpawnSpline=A6C1MegaArrive1" "#SpawnInLOSInit" "#SpawnAsCreature" "#ForcePlayerAsOpp" "#BlockDeath" "#Boss" "#Type=Megatron" "#SetEnergyMax=2500" "#SetEnergy=1250" "#Protect" "#Script=StandAndWait" "#AddToRadarOff"
		
		SetState Chapter1_Phase4ChooseMegaDropType
	}
}
state MegaHealth40
{
	actions
	{
		DestroyModule "#Megatron"
		CreateModule "#Goto" "#Megatron" "#SpawnSpline=A6C1MegaArrive1" "#SpawnInLOSInit" "#SpawnAsCreature" "#ForcePlayerAsOpp" "#BlockDeath" "#Boss" "#Type=Megatron" "#SetEnergyMax=2500" "#SetEnergy=1000" "#Protect" "#Script=StandAndWait" "#AddToRadarOff"
		
		SetState Chapter1_Phase4ChooseMegaDropType
	}
}
state MegaHealth30
{
	actions
	{
		DestroyModule "#Megatron"
		CreateModule "#Goto" "#Megatron" "#SpawnSpline=A6C1MegaArrive1" "#SpawnInLOSInit" "#SpawnAsCreature" "#ForcePlayerAsOpp" "#BlockDeath" "#Boss" "#Type=Megatron" "#SetEnergyMax=2500" "#SetEnergy=750" "#Protect" "#Script=StandAndWait" "#AddToRadarOff"
		
		SetState Chapter1_Phase4ChooseMegaDropType
	}
}
state MegaHealth20
{
	actions
	{
		DestroyModule "#Megatron"

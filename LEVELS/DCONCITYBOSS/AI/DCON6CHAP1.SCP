		CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1SAM4" "#Wobble=2.0" "#Creature=#Creature" "#Time=10.0" "#NoDraw" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference" "#Protect"

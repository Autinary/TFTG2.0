	{
		;if module "General GetCountB" == 4.0 goto Chapter4_BoneyTanksAreActiveAtWrongTime
	}
	actions 
	{
		SendToModule "#BrawlEscape" "#ClearTriggeredComplete"
		SendToModule "#BrawlEscape" "#TransformForceRobot"
		SendToModule "#General" "#ClearStateBit=0"
		SendToModule "#BrawlHealth" "#StartLoseHealth"
		SendToModule "#BrawlEscape" "#Object=#RedMediumDot"
		SendToModule "#AAGunBrawl" "#Vulnerable"
		SetState TurnOnBrawlKeyLoc
	}
}
state Chapter4_BoneyTanksAreActiveAtWrongTime
{
		

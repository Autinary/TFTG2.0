state Chapter4_FourthPartIntro
{
	conditions
	{
		;if module "General ChapterProgress" == 3.0 goto Chapter4_FourthPartPreventCrash
		

		;if module "General ChapterProgress" == 4.0 goto Chapter4_FourthPartIntroPlayFMV
		

	}
	actions
	{
		SetState Chapter4_FourthPartIntroPlayFMV
	}
	
}
state Chapter4_FourthPartIntroPlayFMV
{
	conditions
	{
		

		if module "General VideoFinished" == 1.0 goto Chapter4_FourthPart
	}
	actions
	{
		
		SendToModule "#General" "#StartVideo=#A5C4Midtro3"
	}
}
state Chapter4_FourthPartPreventCrash
{
	
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SetState Chapter4_FourthPartInit

	}
}
state Chapter4_FourthPartInit
{
	
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#CountASet=1" "#CountBSet=0" "#CountCSet=0" "#CountDSet=0" "#CountSet=0"
		SetState Chapter4_FourthPartIntroPlayFMV

	}
}
state Chapter4_FourthPart
{
	conditions
	{
		if module "BarricadeCreature Complete" == 1.0 goto Chapter4_FailMission
		if module "Trigger InArea" == 1.0 goto Chapter4_FifthPartIntro
		if module "BarricadeCreature TransformMeter" == 1.0 goto Chapter4_AltFifthPart
	}
	actions
	{
		DestroyAllModules ;"#IncludeProtected"
		
		CreateModule "#Goto" "#BarricadeCreature" "#SpawnSpline=A5C4RaceB"  "#DirectSpline=A5C4RaceB"  "#Object=#GreenMediumDot" "#Warning" "#type=Barricade" "#UnStoppableAndTransform=3.0" "#TransformForceCar" "#SuppressShield" "#Speed=120" "#BlockDeath"

		CreateModule "#Speech" "#A5C4StopBarricade"  "#PlayDelay=2"  "#speech=#A5_ch4_obj5" "#Start" "#AutoDestroy" 
		
		SendToModule "#BarricadeCreature" "#SetEnergyMax=2399.0" "#SetEnergy=2399.0"
		
		CreateModule "#AreaRange" "#Trigger" "#Trigger=#A5C4TriggerB" "#AddToRadar" "#ParticleRing"
		SendToModule "#General" "#PhysObj" "#FadeUp" "#SetPlayer=#Chapter4StartRaceB"
	}
}
state Chapter4_FourthPartOnFire
{
	conditions
	{
		if module "Trigger InArea" == 1.0 goto Chapter4_FifthPartIntro
		if module "Timer FailMission" == 1.0 goto Chapter4_FailMission
	}
	actions
	{
		
		SendToModule "#General" "#SetMessage=KEY_LOC_WARNING" "#SetMessageTimer=20" "#DisplayTimerTime"
		CreateModule "#Timer" "#Timer" "#Time=30" "#NoRender"
		SendToModule "#BarricadeCreature" "#Script=StopAndSmoke" "#AddToRadarOff" "#SuppressShield"
	}
}
state Chapter4_FifthPartIntro
{

;	}
;}

state BlockAttackEnd
{
	Actions
	{
		SetPhysicsState "static=false" "immunetoshots=false" "immunetomelee=false" "immunetothrown=false"
		
		SetState Alert
	}
}

state BeenStruck
{
	Conditions
	{
		if StuckTime > 1.0 goto BeenStruckExit
		if GotOpponent == 1.0 goto BeenStruckExit
	}
	Actions
	{
		SetFlag "TakeHitPhysics=true"
		SetWalkToLocatorTimer Max
		GoToLocator "run" "goalrange=3.0" "xz_rangecheck"
		SetState BeenStruckExit
	}
}

state BeenStruckExit
{
	Conditions
	{
		if GotOpponent == 1.0 goto Alert
	}
	Actions
	{
		SetPhysicsState "static=false" "immunetoshots=false" "immunetomelee=false" "immunetothrown=false"
		
		Idle 3.0
		SetWalkToLocatorTimer 0.0
		SetState NoOpponent
	}
}

state StuckEscape
{
	Actions
	{
		SetFlag "TempBlock=true"
		SetStrafe false
		DoAttack "jumporkick"
		SetFlag "TempBlock=false"
		SetState Alert
	}
}

state StuckEscapeJump
{
	Actions
	{
		SetFlag "TempBlock=true"
		SetStrafe false
		DoAttack "jump"
		SetFlag "TempBlock=false"
		SetState Alert
	}
}

state StuckEscapeRoll
{
	Actions
	{
		SetFlag "TempBlock=true"
		SetStrafe false
		MoveSideways "MinDist=8.0" "MaxDist=10.0" "RayTime=0.4" 
		SetFlag "TempBlock=false"
		SetState Alert
	}
}


state AttackPOI
{
	Conditions
	{
		if BeenStruckTime <= 5.0 goto Alert
		if HasActivePOI == 0.0 goto Alert
	}
	Actions
	{
		AttackPOI
	}
}

state AlertS
{
	Conditions
	{
		if RobotForm == 0.0 goto Init

		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > 5.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 5.0 goto UnStickFromOpponent

		
		if HasPickup "Pole" == 1.0 AND
		if CanApproach == 1.0 goto MeleeApproachS

		if HasPickup == 1.0 goto PickupAttack

		
		

		if AlwaysTrue > "RAND*5.0" AND
		if CanApproach == 1.0 goto ChooseAttackStyle

		if AlwaysTrue > "RAND*4.0" AND
		if CanApproach == 1.0 goto PickupAttack

		if CanApproach == 1.0 goto MeleeApproachS
		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttackS

		

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		SetPhysicsState "immunetoshots=false" 
		SetFlag "TakeHitRestore"
		SetState AttackRanged
	}
}
state MeleeApproachS
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if HasPickup == 1.0 goto PickupAttack
		
		if DistanceBetweenOpponent < 10 goto GunnerAttack

		if DistanceBetweenOpponent < 5 goto GunnerBlowAway
		
		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttackS

		
		
		if AlwaysTrue > "RAND*5.0" AND
		if CanApproach == 1.0 goto ChooseAttackStyle

		if AlwaysTrue > "RAND*4.0" AND
		if CanApproach == 1.0 goto PickupAttack

		if CanApproach == 0.0 goto AlertS

		if PickupAvailable == 1.0 AND
		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent < 55 AND
		if DistanceBetweenOpponent > 10 AND
		if Timer > "(3.0+(RAND*3.0)-(6.0*PICKUPRATE))" AND
		if AlwaysTrue 0.8 > "ThrashedPhys" goto PickupAttack

		

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		SetPhysicsState "immunetoshots=false" 
		SetStrafe
		EngageOpponent "goalrange=0.0" "fireinterval=((0.1-ThrashedMelee)/FIRERATE)" "firerange=90.0" "spread=0.0"
	}
}
state GunnerAttack
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		
		if CanApproach == 0.0 AND
		if Timer > 1.5 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto AlertS

		if Timer > 1.5 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto MeleeApproachS

		if DistanceBetweenOpponent < 5 goto GunnerBlowAway
		
		if Timer > 0.3 AND
		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttackS


		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		ResetTimer
		EngageOpponentTC "goalrange=10.0" "firerange=20.0" "RapidShootRange=20.0" "fireId=0" "firetimemin=0.3" "firetimemax=0.5"
		;CloseStrafe "MinAngle=80" "MaxAngle=140" "Range=8.0" "Time=4.0" "Jump" "Slam"
		SetState GunnerBlowAway
	}
}
state GunnerBlowAway
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto Alert

		if CanApproach == 1.0 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto MeleeApproachS

		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttackS


		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		;DoAttack "slammove"
		SetStrafe
		CloseStrafe "MinAngle=80" "MaxAngle=140" "Range=8.0" "Time=4.0" "Jump" "Slam"
		SetState AttackCloseInit
	}
}
state MeleeAttackS
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto AlertS

		
		
		


		if CanApproach == 1.0 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto MeleeApproachS

		

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		SetStrafe false
		EngageOpponent "goalrange=1.0" "firerange=2.0" "instant" "chainwithdelay=0.8" "numshots=1"
		SetState AttackCloseInit
	}
}

state AlertA
{
	Conditions
	{
		if RobotForm == 0.0 goto Init

		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > 5.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 5.0 goto UnStickFromOpponent

		
		if HasPickup "Pole" == 1.0 AND
		if CanApproach == 1.0 goto MeleeApproachA

		if HasPickup == 1.0 goto PickupAttack

		
		

		if AlwaysTrue > "RAND*4.0" AND
		if CanApproach == 1.0 goto ChooseAttackStyle

		if AlwaysTrue > "RAND*5.0" AND
		if CanApproach == 1.0 goto PickupAttack

		if CanApproach == 1.0 goto MeleeApproachA
		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttackA

		

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		SetPhysicsState "immunetoshots=false" 
		SetFlag "TakeHitRestore"
		SetState AttackRanged
	}
}
state RollingAssaultA
{
	Conditions
	{
		if Timer > 3.0 goto MeleeApproachA
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if HasPickup == 1.0 goto PickupAttack


		if DistanceBetweenOpponent > 10 AND
		if DistanceBetweenOpponent < 12 goto RollingAssaultA

	

		
		if DistanceBetweenOpponent < 4 AND
		if DistanceBetweenOpponent > 2 goto BootA

		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttackA

		if CanApproach == 0.0 goto AlertA

		if PickupAvailable == 1.0 AND
		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent < 55 AND
		if DistanceBetweenOpponent > 10 AND
		if Timer > "(3.0+(RAND*3.0)-(6.0*PICKUPRATE))" AND
		if AlwaysTrue 0.8 > "ThrashedPhys" goto PickupAttack

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
		if Timer > 3.0 goto MeleeApproachA
	}
	Actions
	{
		ResetTimer
		SetStrafe
		CloseStrafe "MinAngle=110" "MaxAngle=140" "Range=13.0" "Time=5.0" "Roll" 
		;DoAttack "roll"
		;EngageOpponent "goalrange=1.0" 
		SetState MeleeApproachA
	}
}

state BootA
{
	Conditions
	{
		if Timer > 3.0 goto MeleeApproachA
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if HasPickup == 1.0 goto PickupAttack


		if Timer > 0.2 AND
		if AlwaysTrue < "RAND*2.0" goto FollowUpAttackA

		if DistanceBetweenOpponent > 10 AND
		if DistanceBetweenOpponent < 12 goto RollingAssaultA

	

		
		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttackA

		if CanApproach == 0.0 goto AlertA

		if PickupAvailable == 1.0 AND
		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent < 55 AND
		if DistanceBetweenOpponent > 10 AND
		if Timer > "(3.0+(RAND*3.0)-(6.0*PICKUPRATE))" AND
		if AlwaysTrue 0.8 > "ThrashedPhys" goto PickupAttack

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll

		
		if Timer == 0.6 goto MeleeApproachA
	}
	Actions
	{
		ResetTimer
		SetStrafe false
		DoAttack "kick"
		
		EngageOpponent "goalrange=1.0" 
		SetState MeleeApproachA
	}
}
state FollowUpAttackA
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if HasPickup == 1.0 goto PickupAttack


		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttackA

		if CanApproach == 0.0 goto AlertA

		if PickupAvailable == 1.0 AND
		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent < 55 AND
		if DistanceBetweenOpponent > 10 AND
		if Timer > "(3.0+(RAND*3.0)-(6.0*PICKUPRATE))" AND
		if AlwaysTrue 0.8 > "ThrashedPhys" goto PickupAttack

		
		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
		

		if Timer > 1.2 goto BootA

		
	}
	Actions
	{
		ResetTimer
		
		EngageOpponent "goalrange=25.0" "fireinterval=((0.1-ThrashedMelee)/FIRERATE)" "firerange=90.0" "spread=0.2" 
	}
}
state MeleeApproachA
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if HasPickup == 1.0 goto PickupAttack
		
		
		if DistanceBetweenOpponent > 10 AND
		if DistanceBetweenOpponent < 12 goto RollingAssaultA

		if DistanceBetweenOpponent > 2 AND
		if DistanceBetweenOpponent < 4 goto BootA
		
		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttackA

		
		
		if AlwaysTrue > "RAND*5.0" AND
		if CanApproach == 1.0 goto ChooseAttackStyle

		if AlwaysTrue > "RAND*4.0" AND
		if CanApproach == 1.0 goto PickupAttack

		if CanApproach == 0.0 goto AlertA

		if PickupAvailable == 1.0 AND
		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent < 55 AND
		if DistanceBetweenOpponent > 10 AND
		if Timer > "(3.0+(RAND*3.0)-(6.0*PICKUPRATE))" AND
		if AlwaysTrue 0.8 > "ThrashedPhys" goto PickupAttack

		

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		SetPhysicsState "immunetoshots=false" 
		SetStrafe
		EngageOpponent "goalrange=0.0" "fireinterval=((0.1-ThrashedMelee)/FIRERATE)" "firerange=90.0" "spread=0.0"
	}
}

state MeleeAttackA
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto AlertA

		
		


		if CanApproach == 1.0 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto MeleeApproachA

		

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		SetStrafe false
		EngageOpponent "goalrange=1.0" "firerange=2.0" "instant" "chainwithdelay=0.8" "numshots=1"
		SetState AttackCloseInit
	}
}

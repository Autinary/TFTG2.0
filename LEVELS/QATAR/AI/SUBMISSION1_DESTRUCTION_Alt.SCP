;Destroy all buildings and physobjs within the time limit

;requires:
;	Keylocation spline 	KeyLoc#
;	Spawn spline		Spawn#

;Changeable params:
;	120		time in which to complete the mission
;	16		total number of creatures that need to be killed
;	10000	amount of damage required
;	15			keylocation timeout
;	3		total active simultaneously
;	DroneTowTruck_a		type of creature to fight against

state SubMission1_Enter_Alt
{
	actions
	{
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission1_Death_Alt"
		SetState "SubMission1_Init_Alt"
	}
}
state SubMission1_Init_Alt
{
	conditions
	{
		if timer > 0.1 goto SubMission1_Main_Alt
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission1"
	    	SendToModule "#General" "#LoadCreature=DroneTowTruck_a"
		CreateModule "#Creature" "#Creature" "#Type=DroneTowTruck_a" "#Spline=Spawn1" "#count=16" "#maxalive=3" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=KeyLoc1" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#TimeOut=15" 
		CreateModule "#Timer" "#Timer" "#Time=130"
		;CreateModule "#DroneCounter" "#DroneCounter" "#ModuleTag=#Creature" "#IconType=#Drone"
	}
}
state SubMission1_Main_Alt
{
	conditions
	{
		if module "Destruction GetPercentageComplete" == 1.0 goto SubMission1_Finish_Alt
		;if module "creature getpercentagecomplete" == 1.0 goto SubMission1_Finish_Alt
		if module "KeyLocation FailMission" == 1.0 goto SubMission1_Fail_Alt
		if module "Timer FailMission" == 1.0 goto SubMission1_Fail_Alt
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#FadeUp"		
		CreateModule "#GABIChange" "#Destruction" "#GABIChange=-25000"
	}
}
state SubMission1_Finish_Alt
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission1_FinishWait_Alt
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission1_FinishWait_Alt
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission1_Leave_Alt
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=1"
		;SetState "SubMission1_Leave"
	}
}
state SubMission1_Death_Alt
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMission1_Leave_Alt
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state SubMission1_Fail_Alt
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission1_Leave_Alt
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state SubMission1_Leave_Alt
{
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		;
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission1" "#FadeUp"
	   	SendToModule "#General" "#UnLoadCreature=DroneTowTruck_a"
		SendToModule "#General" "#FadeUp"	
		SendToModule "#General" "#CountCSet=1"		
			
		SetState "Exit"
	}
}


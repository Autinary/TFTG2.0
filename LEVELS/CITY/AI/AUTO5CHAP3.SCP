		if module "BrawlCreature IsEnergyAtMin" == 1.0 goto Chapter3_BrawlDriveAwayToC

		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountA" == 1.0 goto Chapter3_HealF3A

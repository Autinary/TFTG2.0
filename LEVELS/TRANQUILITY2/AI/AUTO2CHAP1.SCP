state Chapter1_PlayCamera1
{
	conditions 
	{
		if module "SplineCamera GetPercentageComplete" == 1.0 goto Chapter1_RaceMain2
	}
	Actions
	{
		SendToModule "#ProgressPoint" "#ClearAnyBeenTriggered"
		CreateModule "#SplineCamera" "#SplineCamera" "#SetPosition=A2C1RaceCamA" "#SetFocus=A2C1RacePosA" "#CreatureMove=A2C1CARSP1" "#SetTime=3.5"
		;CreateModule "#DriverDrone" "#AmbushVehicle1" "#Spline=A2C1CARSP1" "#SpawnInLOSInit" "#FollowPlayer" "#type=suv" "#Count=5000" "#MaxAlive=5" "#spacing=-1.0" "#goalrange=3.0" "#CullRange=100.0" 		
		
	}
}

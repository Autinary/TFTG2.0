;hunt and destroy all the vehicles within the time limit

;requires:
;   Route spline 1		Route3a
;   Route spline 2		Route3b
;   Route spline 3		Route3c
;   Route spline 4		Route3d

;Changeable params:
;	TIMELIMIT		time in which to complete the mission
;	TYPE1			vehicle type 1
;	TYPE2			vehicle type 2
;	TYPE3			vehicle type 3
;	TYPE4			vehicle type 4
;						Jeep
;						Sector7Drone
;						CommTruck
;						Shilka
;						ShilkaTracer
;						SUV

state SubMission3_Enter
{
	actions
	{
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission3_Death"
		SetState "SubMission3_InitPre"
	}
}
state SubMission3_Enter2
{
	conditions
	{
		if timer > 0.1 goto SubMission3_Main2
		if module "General ChapterProgress" >= 3.0 goto SubMission3_Enter4
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#UnLoadCreature=DroneDefault"
		SendToModule "#General" "#UnLoadCreature=DroneForklift"
		SendToModule "#General" "#LoadCreature=DroneTowTruck"
		SendToModule "#General" "#LoadCreature=Barricade"
	}
}
state SubMission3_Enter3
{
	conditions
	{
		if timer > 0.1 goto SubMission3_Main3
		
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#UnLoadCreature=DronePickupTruck"
		;SendToModule "#General" "#UnLoadCreature=DroneDefault"
		SendToModule "#General" "#UnLoadCreature=DroneTowTruck"
		SendToModule "#General" "#LoadCreature=Barricade"
		SendToModule "#General" "#LoadCreature=DroneArmouredCar"
		SendToModule "#General" "#LoadCreature=DroneCement"
	}
}
state SubMission3_Enter4
{
	conditions
	{
		if timer > 0.1 goto SubMission3_Main4
		if module "General ChapterProgress" >= 4.0 goto SubMission3_Enter3
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#UnLoadCreature=Barricade"
		SendToModule "#General" "#LoadCreature=DroneDefault"
	}
}
state SubMission3_InitPre
{
	conditions
	{
		if timer > 0.1 goto SubMission3_NoShow
		
		if module "General ChapterProgress" >= 1.0 goto SubMission3_Init
	}
	actions
	{
		
		ResetTimer
		
	}
}
state SubMission3_NoShow
{
	conditions
	{
		if module "Timer FailMission" == 1.0 goto SubMission3_NoShow2
	}
	actions
	{
		
		
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission3" "#FadeUp"
		;SendToModule "#General" "#SetMessage=BBTranD1" "#SetMessageTimer=4"
		CreateModule "#Timer" "#Timer" "#Time=2" "#NoRender"
	}
}
state SubMission3_NoShow2
{
	conditions
	{
		if module "Timer1 FailMission" == 1.0 goto SubMission3_Fail
	}
	actions
	{
		
		
		;SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission3" "#FadeUp"
		SendToModule "#General" "#SetMessage=BBTranD1" "#SetMessageTimer=4"
		CreateModule "#Timer" "#Timer1" "#Time=4" "#NoRender"
	}
}
state SubMission3_Init
{
	conditions
	{
		if timer > 0.1 goto SubMission3_Main
		if module "General ChapterProgress" >= 2.0 goto SubMission3_Enter2
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#RemoveCreatures"
		SendToModule "#General" "#LoadCreature=DronePickupTruck"
		SendToModule "#General" "#LoadCreature=DroneDefault"
		SendToModule "#General" "#LoadCreature=DroneForklift"
		ResetTimer
		;SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission3"
		CreateModule "#Timer" "#Timer" "#Time=300" ;TIMELIMIT"
	}
}
state SubMission3_Main
{
	conditions
	{
		if module "DroneCounter Complete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail

		
		
	}
	actions
	{
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission3"
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		CreateModule "#Goto" "#GotoDroneA" "#SpawnSpline=Route3a" "#DirectSpline=Route3a" "#TransformBothWays=1.0" "#type=DroneForklift" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;;"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneB" "#SpawnSpline=Route3b" "#DirectSpline=Route3b" "#TransformBothWays=2.0" "#type=DroneDefault" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_Combat" ;"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneC" "#SpawnSpline=Route3c" "#DirectSpline=Route3c" "#TransformBothWays=2.0" "#type=DroneDefault" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_Combat" ;"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneD" "#SpawnSpline=Route3d" "#DirectSpline=Route3d" "#TransformBothWays=4.0" "#type=DronePickupTruck" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_Combat" ;"#DrawHealthBar"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=4" "#IconType=#Drone"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission3_Main2
{
	conditions
	{
		if module "GotoDroneC TransformMeter" == 1.0 goto SubMission3_ShieldOn
		

		if module "DroneCounter Complete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail
	}
	actions
	{
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission3"
		SetMusic "STOP INMISSION ACTION Mission3_2 PLAY ACTION"
		CreateModule "#Goto" "#GotoDroneA" "#SpawnSpline=Route3a" "#DirectSpline=Route3a" "#TransformBothWays=4.0" "#type=DronePickupTruck" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline"  ;"#Script=Early_Combat" ;"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneB" "#SpawnSpline=Route3b" "#DirectSpline=Route3b" "#TransformBothWays=4.0" "#type=DronePickupTruck" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneC" "#SpawnSpline=Route3c" "#DirectSpline=Route3c" "#TransformBothWays=5.0" "#type=DroneTowTruck" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneBoss" "#SpawnSpline=Route3d" "#DirectSpline=Route3d" "#TransformBothWays=9.0" "#type=Barricade" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_CombatBoss"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=4" "#IconType=#Drone"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission3_Main3
{
	conditions
	{
		if module "GotoDroneC TransformMeter" == 1.0 goto SubMission3_ShieldOn
		if module "DroneCounter Complete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail

		

		
	}
	actions
	{
		
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission3"
		CreateModule "#Goto" "#GotoDroneA" "#SpawnSpline=Route3a" "#DirectSpline=Route3a" "#TransformBothWays=6.0" "#type=DroneArmouredCar" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneB" "#SpawnSpline=Route3b" "#DirectSpline=Route3b" "#TransformBothWays=6.0" "#type=DroneArmouredCar" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneC" "#SpawnSpline=Route3c" "#DirectSpline=Route3c" "#TransformBothWays=8.0" "#type=DroneCement" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#SuppressShield" "#LoopSpline" ;"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneBoss" "#SpawnSpline=Route3d" "#DirectSpline=Route3d" "#TransformBothWays=9.0" "#type=Barricade" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_CombatBoss"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=4" "#IconType=#Drone"
		SendToModule "#General" "#FadeUp"
		SetMusic "STOP INMISSION ACTION Mission3_2 PLAY ACTION"		
	}
}
state SubMission3_Main4
{
	conditions
	{
		if module "DroneCounter Complete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail

		
	}
	actions
	{
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission3"
		SetMusic "STOP INMISSION ACTION Generic PLAY ACTION"
		CreateModule "#Goto" "#GotoDroneA" "#SpawnSpline=Route3a" "#DirectSpline=Route3a" "#TransformBothWays=4.0" "#type=DronePickupTruck" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneB" "#SpawnSpline=Route3b" "#DirectSpline=Route3b" "#TransformBothWays=4.0" "#type=DronePickupTruck" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneC" "#SpawnSpline=Route3c" "#DirectSpline=Route3c" "#TransformBothWays=5.0" "#type=DroneTowTruck" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_Combat";"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneD" "#SpawnSpline=Route3d" "#DirectSpline=Route3d" "#TransformBothWays=2.0" "#type=DroneDefault" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#Script=Early_Combat"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=4" "#IconType=#Drone"
		SendToModule "#General" "#FadeUp"		
	}
}

state SubMission3_ShieldOn
{
	conditions
	{
		if module "DroneCounter Complete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail
	}
	actions
	{
		
		SendToModule "#GotoDroneC" "#SuppressShieldOff" 
		Idle 0.1
		SetState HuntProcess
	}
}

state SubMission3_Finish
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission3_FinishWait
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission3_FinishWait
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission3_Leave
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=3"
		;SetState "SubMission3_Leave"
	}
}
state SubMission3_Death
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMission3_Leave
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state SubMission3_Fail
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission3_Leave
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FailMission"
	}
}
state SubMission3_Leave
{
	
	actions
	{
		
 		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#UnLoadCreature=DronePickupTruck"
		SendToModule "#General" "#UnLoadCreature=Barricade"
		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar"
		SendToModule "#General" "#UnLoadCreature=DroneCement"
		SendToModule "#General" "#UnLoadCreature=DroneForklift"
		SendToModule "#General" "#UnLoadCreature=DroneTowTruck"
		SendToModule "#General" "#LoadCreature=DroneDefault"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission3" "#FadeUp"
		SendToModule "#General" "#FadeUp"		
		SetState "GlobalActionRing"
	}
}


state Chapter3_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter3_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter3_FailMission
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter3_Restart
	}
	actions
	{
		
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}

state Chapter3_Restart
{
	conditions
	{
		if timer > 0.2 goto Chapter3_Restart3
		if module "General ChapterProgress" >= 3.0 goto GlobalActionRing
		if module "General ChapterProgress" >= 4.0 goto GlobalActionRing
		
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter3Restart" "#FadeUp"
	
		ResetTimer
	}
}

state Chapter3_Restart3
{
	conditions
	{
		
	}
	actions
	{
			

		CreateModule "#AAGun" "#AAGun"
		SendToModule "#AAGun" "#Type=AAGUNTYPE_ROCKETS" "#Placement=TurretRocketGlobal" "#Range=100.0" "#Delay=1.5" "#Energy=100.0" "#RespawnDelay=30" "#Ammo=0" "#Create"


		SetState "GlobalActionRing"
	}
}
state Chapter3_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter3_CompleteVideo
	}
	actions
	{
		SendToModule "#General" "#LevelSpecialOff=1" "#LevelSpecialOff=2" "#LevelSpecialOff=3" 
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT3" "#Spline=COMCAM3" "#SetFocus=CAMFOCUS3"
		SendToModule "#General" "#CompleteMission" 
		SendToModule "#ActionRing" "#SetCompleted=#Chapter3" "#Unlock=#Chapter4"
		CreateModule "#Speech" "Complete" "#speech=#A3_ch3_cmplt" "#AutoDestroy" "#Start"
		;SetState "Chapter3_CompleteVideo"
	}
}
state Chapter3_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter3_CompleteVideoFinished
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		;SendToModule "#General" "#StartOutroVideo=#A3C3Outro1"
	}
}
state Chapter3_Outro
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter3_Complete
	}
	actions
	{
	
		SendToModule "#General" "#StartVideo=#A3C3Outro1"
	}
}
state Chapter3_CompleteVideoFinished
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter3_Leave
	}
	actions
	{
		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter3_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter4"
		IncreasePlayerHealth max
		setstate "PickGoto"
	}
}

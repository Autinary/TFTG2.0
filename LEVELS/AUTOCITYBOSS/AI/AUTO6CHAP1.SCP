	{
		DestroyModule "#Megatron"
		CreateModule "#Goto" "#Megatron" "#SpawnSpline=A6C1MegaArrive1" "#SpawnInLOSInit" "#SpawnAsCreature" "#ForcePlayerAsOpp" "#BlockDeath" "#Boss" "#Type=Megatron" "#SetEnergyMax=2500" "#SetEnergy=2000" "#Protect" "#Script=StandAndWait" "#AddToRadarOff"
		
		SetState Chapter1_Phase4ChooseMegaDropType
	}
}

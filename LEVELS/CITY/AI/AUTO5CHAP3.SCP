		CreateModule "#KeyLocation" "#A5C3KeyLocA" "#Creature=#A5C3BrawlRaceA" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#HeadType=#Optimus" "#Radius=100"

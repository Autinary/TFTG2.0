state Chapter1_SkipToPH3
{
	
	actions
	{

		DestroyModule "#Megatron"
		CreateModule "#Goto" "#Megatron" "#SpawnSpline=A6C1Spawn" "#AddToRadarAlways" "#SpawnInLOSInit" "#SpawnAsVehicle" "#ForcePlayerAsOpp" "#BlockDeath" "#Type=Megatron" "#SetEnergyMax=20000" "#SetEnergy=2000" "#Protect" ;
		
		SendToModule "#Megatron" "#Boss" "#Type=Megatron" "#NoHealthBar" 
		SendToModule "#General" "#SetMaxOpponents=18" "#SetMaxApproachers=18" "#SetAttackRingSize=20" 

		SendToModule "#General" "#CountASet=1" "#CountBSet=1"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=A6C1KeyLoc" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key6Return" "#Protect"
		
		CreateModule "#Speech" "#A6_ch1_obj2" "#speech=#A6_ch1_obj2" "#AutoDestroy" "#Protect"
		;DoMacro CreateBR
		
		
		SetMusic "ACTION Mission1_1 Play Action"
		SetDeathPoint "Chapter1_DeathFailMission"

		SendToModule "#General" "#SetPlayer=#COMPPOINT1" 

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
		SendToModule "#General" "#FadeUp"
		SetState Chapter1_MegatronFlyInitE
	}
}
state Chapter1_MegatronFlyInitE
{
	conditions
	{
		if module "CreatureBombingRun Finish" == 1.0 goto Chapter1_MegatronCombatE
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		ResetTimer
       DestroyAllModules
		DestroyModule "#CreatureBombingRun"
		SendToModule "#Megatron" "#SetEnergyMin=100.0" "#AddToRadar" "#Script=DummyAircraft" 

		CreateModule "#CreatureBombingRun" "#CreatureBombingRun" "#ModuleTag=#Megatron" "#Spline=A6C1BR1" "#Spline=A6C1BR2" "#Spline=A6C1BR3" "#Spline=A6C1BR4"	
		SendToModule "#CreatureBombingRun" "#NumRuns=1" "#SpeedValueMin=250" "#SpeedValueMax=700" "#MeleeScript=Megatron_PH2"	
		;DoMacro CreateBRAttack
		
		;SendToModule "#Megatron" "#SetPosition=#MegatronParkHoverSpawn"
		SendToModule "#CreatureBombingRun" "#ForceTransformEnergy=0.09" 

		
		SendToModule "#General" "#BG_UnLoadCreature=DroneMig"
		SendToModule "#General" "#BG_UnLoadCreature=DroneTowTruck"
		SendToModule "#General" "#BG_UnLoadCreature=DroneArmouredCar"
		SendToModule "#General" "#BG_LoadCreature=DroneForklift_a"
		
		
		;Idle 3.0
		;
		;SetState Chapter1_MegatronFlyDoD
	}
}

state Chapter1_MegatronCombatE
{
	conditions
	{
		if module "Megatron IsEnergyAtMin" == 1.0 goto Chapter1_Phase2End
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		CreateModule "#Speech" "#A6_ch1_obj3" "#speech=#A6_ch1_obj3" "#Start" "#AutoDestroy" 
		SendToModule "#Megatron" "#Script=Megatron_PH2" "#MegatronToCombat" "#DrawHealthBar" 
	}
}
state Chapter1_Phase2End
{
	conditions
	{
		
		;if Timer > 5.0 goto Chapter1_Phase3Init
		if module "Megatron PlayerRange" > 300 goto Chapter1_Phase3Init
		
	}
	actions
	{
    ;  ResetTimer
	DestroyModule "#KeyLocation"
        SendToModule "#Megatron" "#Script=FlyOff_MI" "#Unstoppable" "#NoHealthBar" "#SetEnergy=6000" "#AddToRadarOff"
	Idle 1.5
	SetMusic "ACTION Mission1_2 Play Action"
	Idle 0.1
	CreateModule "#Speech" "#A6_ch1_obj6" "#speech=#A6_ch1_obj6" "#Start" "#AutoDestroy" 
	;Idle 0.9
	;DestroyModule "#Megatron"
		
	}
}
state Chapter1_Phase3Init
{
	conditions
	{
		if module "Area3 InArea" == 1.0 goto Chapter1_Phase3
		if module "Timer FailMission" == 1.0 goto Chapter1_FailMission2
	}
	actions
	{
		;SetMusic "ACTION Mission1_2 Play Action"
		SetDeathPoint "Chapter1_DeathFailMission2"

      		DestroyAllModules "#IncludeProtected"
		CreateModule "#AreaRange" "#Area3" "#Trigger=#A6C1TriggerPH3" "#AddToRadarAlways" "#SetRadarType=#DecepticonRadarIcon"
		CreateModule "#Timer" "#Timer" "#Time=40" "#Start"
		SendToModule "#General" "#SetMessage=Key11Goto" "#SetMessageTimer=40.0"
		CreateModule "#Speech" "#A6_ch1_obj2" "#speech=#A6_ch1_obj2" "#AutoDestroy" "#Protect"
		
		
	}
}
state Chapter1_Phase3Enter
{
	actions
	{
		DestroyAllModules 
		SendToModule "#General" "#ResetCounters"
		SetState Chapter1_Phase3IntroVideo
	}
}
state Chapter1_Phase3IntroVideo
{
	conditions
	{
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter1_Phase3LoadCreatures
	}
	actions
	{

		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#A7LevelIntro"
	}
}
state Chapter1_Phase3LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_Phase3Main 
	}
	actions
	{
		;SendToModule "#ActionRing" "#RemoveCreatures"

		SendToModule "#General" "#UnLoadCreature=BumbleBee07"
		SendToModule "#General" "#UnLoadCreature=IronHide"
		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar_a"
		SendToModule "#General" "#LoadCreature=Megatron"
		SendToModule "#General" "#LoadCreature=DroneForklift_a"
		
	}
}
state Chapter1_Phase3Main
{
	actions
	{
		SetMusic "ACTION Mission1_2 Play Action"
		SetDeathPoint "Chapter1_DeathFailMission2"

		SendToModule "#General" "#SetPlayer=#Chapter3Start" 
		

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
		CreateModule "#Speech" "#A6_ch1_obj2" "#speech=#A6_ch1_obj2" "#AutoDestroy" "#Protect"
		
		
		SendToModule "#General" "#FadeUp" "#CountASet=1" "#CountBSet=1"
		SetState Chapter1_Phase3
	}
}
state Chapter1_Phase3
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2
	}
	actions
	{
		;SendToModule "#ActionRing" "#SetCompleted=#Chapter2" "#Unlock=#Chapter3"
      		DestroyAllModules 
		CreateModule "#BombingRun" "#Megatron" \
			"#CentreSpline=A6C1BR1" \
			"#LoopSpline=A6C1BR1" \
			"#LoopSpline=A6C1BR2" \
			"#LoopSpline=A6C1BR3" \
			"#LoopSpline=A6C1BR4" \
			"#Boss=#Megatron" "#Type=Megatron" "#Invulnerable" "#Speed=240.0" "#BombLimit=3" "#AddToRadarOff" "#FlyHeight=-12.0" "#NoCast" "#ForceHoverHeight=4.0" "#SetEnergyMax=3500.0" "#SetEnergy=3500.0" "#SetEnergyMin=1750" "#BlockDeath" "#SpawnAsVehicle" "#SpawnInLOSInit"
		SendToModule "#Megatron" "#SetPosition=#A6C1Phase3HoverSpawn"
		Idle 0.1
		SendToModule "#Megatron" "#Path=None" "#Script=DummyAircraft" "#Vulnerable" "#ResetDamageFlags" "#ResetHealthDiff" "#AddToRadarAlways" 

		SendToModule "#General" "#SetMessageTimer=-1.0"
		CreateModule "#Goto" "#RangeTracker" "#Spline=A6C1Spawn" "#SetPosition=#A6C1Phase3KeyLoc" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" 
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#RangeTracker" "#Radius=175" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key6Return" "#HeadType=#Optimus"
		SendToModule "#RangeTracker" "#Link=#Megatron"
		SetState Chapter1_MegaJetAttack
		
	}
}
state Chapter1_MegaJetAttack
{
	actions
	{
		SendToModule "#General" "#CountASet=0" "#CountCSet=0" "#CountDSet=0"
		SetState Chapter1_MegaJetAttackHover
	}
}
state Chapter1_MegaJetAttackHover
{
	
	actions
	{
		SendToModule "#Megatron" "#Path=Special_Hover" "#AttackFiringMode" "#Script=Megatron_PH3" "#Invulnerable" "#BeenHitHard=0" "#TransformForceCar" "#ResetDamageFlags" "#ResetHealthDiff"
		SendToModule "#General" "#CountAInc" "#CountCInc"
		CreateModule "#Timer" "#AttackTime" "#Time=7" "#NoRender" "#Start"
		SetState Chapter1_MegaJetAttackHoverProcess
	}
}
state Chapter1_MegaJetAttackHoverProcess
{
	conditions
	{

		if module "Megatron BeenHit" == 1.0 and
			if module "General GetCountB" == 1.0 goto Chapter1_OneShotCollectionPH3H

		if module "AttackTime FailMission" == 1.0 goto Chapter1_MegaJetAttackBomb
		if module "Megatron GetCountAlive" == 0.0 goto Chapter1_Phase3MidtroInit
		if module "Megatron BeenHitHard" >= 2.0 goto Chapter1_MegaBeenHitJetAttackBomb
		
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2
		if module "Megatron IsEnergyAtMin" == 1.0 goto Chapter1_Phase3MidtroInit
		if module "Megatron PlayerRange" < 60 goto Chapter1_MegaJetAttackBomb

		if module "General GetCountA" == 9.0 goto Chapter1_PrePh4CountResetA

		if module "General GetCountC" >= 5.0 goto Chapter1_MegatronPH3ResetPos

		if Timer > 0.1 goto Chapter1_PrePh4CountA
	}
	actions
	{
		ResetTimer
		
		
	}
}
state Chapter1_OneShotCollectionPH3H
{
	
	actions
	{	
		SendToModule "#General" "#CountBSet=2"
		SendToModule "#A6_ch1_obj2" "#StartOneShot"
		SetState Chapter1_MegaJetAttackHoverProcess
	}
}
state Chapter1_MegatronPH3ResetPos
{
	conditions
	{
		if module "RangeTracker GetLinkedDist" > 400 goto Chapter1_MegaJetReset
		if module "Megatron GetCountAlive" == 0.0 goto Chapter1_Phase3MidtroInit
		if module "Megatron Complete" == 1.0 goto Chapter1_MegaJetAttackHover
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2
		
		if module "Megatron IsEnergyAtMin" == 1.0 goto Chapter1_Phase3MidtroInit
	}
	actions
	{
		DestroyModule "#AttackTime" 
		SendToModule "#Megatron" "#Script=DummyCar_M" 
		Idle 0.1
		SendToModule "#Megatron" "#Reset" "#Invulnerable" "#BombLimit=1" "#TransformForceCar" 
		SendToModule "#General" "#CountAInc" 
		
		
	}
}
state Chapter1_MegaJetReset
{
	conditions
	{
		if module "General GetCountD" == 2.0 goto Chapter1_MegaJetResetPos1
		if module "General GetCountD" == 1.0 goto Chapter1_MegaJetResetPos2
		
		if module "General GetCountA" >= 5.0 goto Chapter1_MegaJetResetPos1
		if module "General GetCountA" <= 5.0 goto Chapter1_MegaJetResetPos2
		if Timer > 0.1 goto Chapter1_MegaJetResetPos2
	}
	actions
	{
		ResetTimer
	}
}
state Chapter1_MegaJetResetPos1
{
	
	actions
	{
		DestroyModule "#AttackTime" 
		SendToModule "#Megatron" "#SetPosition=#A6C1Phase3HoverReset1" "#Path=Special_Hover" "#AttackFiringMode" "#Script=Megatron_PH3" "#Invulnerable" "#BeenHitHard=0" "#TransformForceCar" "#ResetDamageFlags" "#ResetHealthDiff"
		SendToModule "#General" "#CountCSet=0" "#CountDSet=1"
		CreateModule "#Timer" "#AttackTime" "#Time=10" "#NoRender" "#Start"
		SetState Chapter1_MegaJetAttackHoverProcess
	}
}
state Chapter1_MegaJetResetPos2
{
	
	actions
	{
		DestroyModule "#AttackTime" 
		SendToModule "#Megatron" "#SetPosition=#A6C1Phase3HoverReset2" "#Path=Special_Hover" "#AttackFiringMode" "#Script=Megatron_PH3" "#Invulnerable" "#BeenHitHard=0" "#TransformForceCar" "#ResetDamageFlags" "#ResetHealthDiff"
		SendToModule "#General" "#CountCSet=0" "#CountDSet=2"
		CreateModule "#Timer" "#AttackTime" "#Time=10" "#NoRender" "#Start"
		SetState Chapter1_MegaJetAttackHoverProcess
	}
}
state Chapter1_PrePh4CountA
{
	
	actions
	{
		SendToModule "#General" "#CountAInc"
		
		SetState Chapter1_MegaJetAttackHoverProcess
	}
}
state Chapter1_PrePh4CountResetA
{
	
	actions
	{
		SendToModule "#General" "#CountASet=0"
		
		SetState Chapter1_MegaJetAttackHoverProcess
	}
}
state Chapter1_MegaJetAttackBomb
{
	
	actions
	{
		DestroyModule "#AttackTime" 
		SendToModule "#Megatron" "#Script=DummyAircraft" 
		Idle 0.1
		SendToModule "#Megatron" "#Reset" "#Invulnerable" "#AttackFiringMode" "#Script=DummyCar" "#BombLimit=1" 
		SendToModule "#General" "#CountAInc" "#CountCInc"
		
		SetState Chapter1_MegaJetAttackBombProcess
	}
}
state Chapter1_MegaBeenHitJetAttackBomb
{
	
	actions
	{
		SendToModule "#Megatron" "#Script=HoverFlyOff" 
		Idle 0.5
		SendToModule "#Megatron" "#Script=DummyAircraft" 
		
		SetState Chapter1_MegaJetAttackBomb
	}
}
state Chapter1_MegaJetAttackBombProcess
{
	conditions
	{

		if module "Megatron BeenHit" == 1.0 and
			if module "General GetCountB" == 1.0 goto Chapter1_OneShotCollectionPH3B

		if module "RangeTracker GetLinkedDist" > 250 goto Chapter1_MegaJetTooFar
		if module "Megatron GetCountAlive" == 0.0 goto Chapter1_Phase3MidtroInit
		if module "Megatron Complete" == 1.0 goto Chapter1_MegaJetAttackHover
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2
		
		if module "Megatron IsEnergyAtMin" == 1.0 goto Chapter1_Phase3MidtroInit

		if module "General GetCountA" == 9.0 goto Chapter1_PrePh4CountResetB
	
		if Timer > 0.1 goto Chapter1_PrePh4CountB

		
		
	}
	actions
	{
		ResetTimer
	}
}
state Chapter1_OneShotCollectionPH3B
{
	
	actions
	{	
		SendToModule "#General" "#CountBSet=2"
		SendToModule "#A6_ch1_obj2" "#StartOneShot"
		SetState Chapter1_MegaJetAttackBombProcess
	}
}
state Chapter1_MegaJetTooFar
{
		
	actions
	{
	
		SendToModule "#Megatron" "#Reset" "#Invulnerable" "#Script=DummyCar" "#TransformForceRobot" "#BombLimit=1" 
		SendToModule "#General" "#CountAInc"
		Idle 1.0 
		SetState Chapter1_MegaJetAttackHover
	}
}

state Chapter1_PrePh4CountB
{
	
	actions
	{
		SendToModule "#General" "#CountAInc"
		
		SetState Chapter1_MegaJetAttackBombProcess
	}
}
state Chapter1_PrePh4CountResetB
{
	
	actions
	{
		SendToModule "#General" "#CountASet=0"
		
		SetState Chapter1_MegaJetAttackBombProcess
	}
}
state Chapter1_Phase3MidtroInit
{
	actions
	{
		SendToModule "#Megatron" "#Script=Megatron_PH2" "#MegatronToCombat" "#TransformForceRobot"
		SetState Chapter1_Phase3Midtro
	}
}
state Chapter1_Phase3Midtro
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_Phase3StreetFight
	}

	actions
	{
		SendToModule "#General" "#StartVideo=#A6C1Midtro1"
    }
}
state Chapter1_Phase3StreetFight
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2
		
		if module "Megatron IsEnergyAtMin" == 1.0 goto Chapter1_Phase3End
	}

	actions
	{
		SendToModule "#Megatron" "#Script=Megatron_PH3G" "#MegatronToCombat" "#SetPosition=#A6C1Phase3StreetMegatron" "#SetEnergyMin=100"
		SendToModule "#General" "#SetPlayer=#A6C1Phase3StreetStart" "#ResetLevel"
		IncreasePlayerHealth max
	}
}
state Chapter1_Phase3End
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2
		
		if module "Megatron PlayerRange" > 300 goto Chapter1_Phase4Init
	}

	actions
	{
		
		SendToModule "#Megatron" "#Script=FlyOff_M" "#SetEnergy=500" "#AddToRadarOff" "#RemoveBoss"
		;SendToModule "#ActionRing" "#SetCompleted=#Chapter3" "#Unlock=#Chapter4"

	}
}
state Chapter1_Phase4Init
{
	conditions
	{
		if module "RangeTracker PlayerRange" < 30.0 goto Chapter1_Phase4
		if module "Area4 InArea" == 1.0 goto Chapter1_Phase4
		if module "Timer FailMission" == 1.0 goto Chapter1_FailMission2
	}
	actions
	{
		
      		DestroyAllModules "#IncludeProtected"
		CreateModule "#AreaRange" "#Area4" "#Trigger=#A6C1TriggerPH4" "#AddToRadarAlways" "#SetRadarType=#DecepticonRadarIcon"
		CreateModule "#Timer" "#Timer" "#Time=60" "#Start"
		SendToModule "#General" "#SetMessage=Key11Goto" "#SetMessageTimer=60.0"
		CreateModule "#Goto" "#RangeTracker" "#Spline=A6C1Spawn" "#SetPosition=#A6C1Phase4KeyLoc" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" "#Protect"
		
		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 0"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 0"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 0"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
	}
}
state Chapter1_Phase4Enter
{
	actions
	{
		DestroyAllModules 
		SetState Chapter1_Phase4IntroVideo
	}
}
state Chapter1_Phase4IntroVideo
{
	conditions
	{
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter1_Phase4LoadCreatures
	}
	actions
	{

		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#A7LevelIntro"
	}
}
state Chapter1_Phase4LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_Phase4Main 
	}
	actions
	{
		;SendToModule "#ActionRing" "#RemoveCreatures"

		SendToModule "#General" "#UnLoadCreature=BumbleBee07"
		SendToModule "#General" "#UnLoadCreature=IronHide"
		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar_a"
		SendToModule "#General" "#LoadCreature=Megatron"
		SendToModule "#General" "#LoadCreature=DroneForklift_a"
		
	}
}
state Chapter1_Phase4Main
{
	conditions
	{
		if module "RangeTracker PlayerRange" < 30.0 goto Chapter1_Phase4
		if module "Area4 InArea" == 1.0 goto Chapter1_Phase4
		if module "Timer FailMission" == 1.0 goto Chapter1_FailMission2
	}
	actions
	{
		SetMusic "ACTION Mission1_2 Play Action"
		SetDeathPoint "Chapter1_DeathFailMission"

		SendToModule "#General" "#SetPlayer=#Chapter4Start" 
		

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 0"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 0"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 0"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
		CreateModule "#AreaRange" "#Area4" "#Trigger=#A6C1TriggerPH4" "#AddToRadarAlways" "#SetRadarType=#DecepticonRadarIcon"
		CreateModule "#Timer" "#Timer" "#Time=60" "#Start"
		SendToModule "#General" "#SetMessage=Key11Goto" "#SetMessageTimer=60.0"
		
		SendToModule "#General" "#FadeUp" "#CountASet=0" "#CountCSet=0" "#CountDSet=0"
		CreateModule "#Goto" "#RangeTracker" "#Spline=A6C1Spawn" "#SetPosition=#A6C1Phase4KeyLoc" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" "#Protect"
		
		IncreasePlayerHealth max

		;SetState Chapter1_Phase4
	}
}
state Chapter1_Phase4
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2
	}
	actions
	{
		DestroyAllModules 
		

		CreateModule "#Goto" "#Megatron" "#SpawnSpline=A6C1Spawn" "#AddToRadarOff" "#SpawnInLOSInit" "#SpawnAsCreature" "#ForcePlayerAsOpp" "#BlockDeath" "#Boss" "#Type=Megatron" "#SetEnergyMax=2500" "#SetEnergy=2500" "#Protect" "#SetPosition=#A6C1Phase4PrimaryPos3" "#Script=Megatron_PH4B"
		
		SendToModule "#General" "#SetMessageTimer=-1.0" "#CountBSet=0" "#CountCSet=0" "#CountDSet=3" "#CountSet=0"
		;CreateModule "#Goto" "#RangeTracker" "#Spline=A6C1Spawn" "#SetPosition=#A6C1Phase4KeyLoc" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" 
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#RangeTracker" "#Radius=150" "#String=Key15Return" "#ReEnterMsg=Key15Return" "#HeadType=#Optimus" "#UseHeight" "#Timeout=30"
		SendToModule "#RangeTracker" "#Link=#Megatron"
		CreateModule "#Timer" "#AttackTime" "#Time=20" "#NoRender" "#Start"
		CreateModule "#Speech" "#A6_ch1_obj5" "#speech=#A6_ch1_obj5" "#AutoDestroy" "#Protect"
		CreateModule "#AreaRange" "#StreetLevel" "#Trigger=#A6C1TriggerPH4G" "#AddToRadarOff" "#AllCreatures"
		
		Idle 0.1
		SendToModule "#Megatron" "#ResetDamageFlags" "#ResetHealthDiff" "#MegatronToCombat"
		Idle 1.7
		SendToModule "#Megatron" "#AddToRadar"
		SetState Chapter1_Phase4Process
		
	}
}
state Chapter1_Phase4Process
{
	conditions
	{
		if module "Megatron Dead" == 1.0 goto Chapter1_Complete
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2

		if module "Megatron PlayerRange" < 10.0 goto Chapter1_MegaRepel
		if module "Megatron HealthDiff" > 0.20 goto Chapter1_MegaFlyAway
		if module "AttackTime FailMission" == 1.0 goto Chapter1_MegaFlyAway

		if module "General GetCount" == 1.0 and
			if module "Megatron PlayerRange" < 80.0 goto Chapter1_MegaFlyAway

		if module "StreetLevel InArea" == 1.0 goto Chapter1_AtStreet

		if module "Megatron Health" < 0.25 goto Chapter1_Phase4Process2

		if module "General GetCountA" >= 9.0 goto Chapter1_Ph4CountResetA
		if module "General GetCountB" >= 9.0 goto Chapter1_Ph4CountResetB
		if module "General GetCountC" >= 9.0 goto Chapter1_Ph4CountResetC
		

	
		if Timer > 0.1 goto Chapter1_Ph4Count
	}
	actions
	{
		ResetTimer 
	}
}
state Chapter1_Phase4Process2
{
	conditions
	{
		if module "Megatron Dead" == 1.0 goto Chapter1_Complete
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2

		if module "Megatron PlayerRange" < 5.0 goto Chapter1_MegaRepel
		if module "Megatron HealthDiff" > 0.10 goto Chapter1_MegaFlyAway
		if module "AttackTime FailMission" == 1.0 goto Chapter1_MegaFlyAway

		if module "StreetLevel InArea" == 1.0 goto Chapter1_AtStreet


		if module "General GetCount" == 1.0 and
			if module "Megatron PlayerRange" < 130.0 goto Chapter1_MegaFlyAway

		
		if module "General GetCountA" >= 9.0 goto Chapter1_Ph4CountResetA
		if module "General GetCountB" >= 9.0 goto Chapter1_Ph4CountResetB
		if module "General GetCountC" >= 9.0 goto Chapter1_Ph4CountResetC
		
	
		if Timer > 0.1 goto Chapter1_Ph4Count
	}
	actions
	{
		ResetTimer 
		SendToModule "#A6_ch1_obj5" "#StartOneShot"
	}
}
state Chapter1_AtStreet
{
	conditions
	{
		if module "Megatron Dead" == 1.0 goto Chapter1_Complete
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2
		if module "Megatron PlayerRange" > 300 goto Chapter1_MoveMegaMarker

		if module "Area4 InArea" == 1.0 goto Chapter1_ReturnedToRoof
		
	}
	actions
	{
		SendToModule "#Megatron" "#Script=FlyOff_MI" "#AddToRadar" "#RemoveBoss"
		DestroyModule "#AttackTime"
		SendToModule "#General" "#CountAInc" "#CountBInc" "#CountCInc" "#CountSet=0"
		DestroyModule "#RangeTracker"
		DestroyModule "#KeyLocation" 
		CreateModule "#Goto" "#RangeTracker" "#Spline=A6C1Spawn" "#SetPosition=#A6C1Phase4KeyLoc" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" "#Protect"
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#RangeTracker" "#Radius=1" "#String=Key15Return" "#ReEnterMsg=Key15Return" "#HeadType=#Optimus" "#UseHeight" "#Timeout=30"
		SendToModule "#RangeTracker" "#Link=#Megatron"
		
		CreateModule "#AreaRange" "#Area4" "#Trigger=#A6C1TriggerPH4" "#AddToRadarOff" ; "#SetRadarType=#DecepticonRadarIcon"
		;SendToModule "#General" "#SetMessage=Key6Return" "#SetMessageTimer=30.0"
		
		
		;SetState Chapter1_Phase4
	}
}
state Chapter1_MoveMegaMarker
{
	conditions
	{
		if module "Megatron Dead" == 1.0 goto Chapter1_Complete
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2
		
		if module "Area4 InArea" == 1.0 goto Chapter1_ReturnedToRoof
		
	}
	actions
	{
		SendToModule "#Megatron" "#SetPosition=#A6C1Phase4KeyLocRadar" "#Script=FlyOff_MI"
				
		
		;SetState Chapter1_Phase4
	}
}
state Chapter1_ReturnedToRoof
{
	conditions
	{
		if module "Megatron PlayerRange" > 300 goto Chapter1_Phase4DetectMegaHealth


		if module "Megatron Dead" == 1.0 goto Chapter1_Complete
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2
		
	}
	actions
	{
		
		DestroyModule "#Area4"
		SendToModule "#KeyLocation" "#Radius=150" 
		SendToModule "#Megatron" "#AddToRadarOff"
		
		;SetState Chapter1_Phase4
	}
}
state Chapter1_MegaRepel
{
	conditions
	{
		if module "Megatron PlayerRange" > 300 goto Chapter1_Phase4DetectMegaHealth

		if module "Megatron Dead" == 1.0 goto Chapter1_Complete
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2

	}
	actions
	{
		Idle 0.8
		SendToModule "#Megatron" "#Script=FlyOff_MI" "#AddToRadarOff" "#RemoveBoss"
		DestroyModule "#AttackTime"
		SendToModule "#General" "#CountAInc" "#CountBInc" "#CountCInc" "#CountSet=0"
		DestroyModule "#RangeTracker"
		DestroyModule "#KeyLocation" 
		CreateModule "#Goto" "#RangeTracker" "#Spline=A6C1Spawn" "#SetPosition=#A6C1Phase4KeyLoc" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" "#Protect"
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#RangeTracker" "#Radius=150" "#String=Key15Return" "#ReEnterMsg=Key15Return" "#HeadType=#Optimus" "#UseHeight" "#Timeout=30"
		SendToModule "#RangeTracker" "#Link=#Megatron"
		
		;SetState Chapter1_Phase4Process
	}
}
state Chapter1_MegaFlyAway
{
	conditions
	{
		if module "Megatron PlayerRange" > 300 goto Chapter1_Phase4DetectMegaHealth

		if module "Megatron Dead" == 1.0 goto Chapter1_Complete
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2

	}
	actions
	{
		SendToModule "#Megatron" "#Script=FlyOff_MI" "#AddToRadarOff" "#RemoveBoss"
		DestroyModule "#AttackTime"
		SendToModule "#General" "#CountAInc" "#CountBInc" "#CountCInc" "#CountSet=0"

		DestroyModule "#RangeTracker"
		DestroyModule "#KeyLocation" 
		CreateModule "#Goto" "#RangeTracker" "#Spline=A6C1Spawn" "#SetPosition=#A6C1Phase4KeyLoc" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" "#Protect"
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#RangeTracker" "#Radius=150" "#String=Key15Return" "#ReEnterMsg=Key15Return" "#HeadType=#Optimus" "#UseHeight" "#Timeout=30"
		SendToModule "#RangeTracker" "#Link=#Megatron"
		
		;SetState Chapter1_Phase4Process
	}
}
state Chapter1_Phase4DetectMegaHealth
{
	conditions
	{
		if module "Megatron Health" > 0.90 goto MegaHealth100
		if module "Megatron Health" == 0.90 goto MegaHealth90
		if module "Megatron Health" > 0.80 goto MegaHealth90
		if module "Megatron Health" == 0.80 goto MegaHealth80
		if module "Megatron Health" > 0.70 goto MegaHealth80
		if module "Megatron Health" == 0.70 goto MegaHealth70
		if module "Megatron Health" > 0.60 goto MegaHealth70
		if module "Megatron Health" == 0.60 goto MegaHealth60
		if module "Megatron Health" > 0.50 goto MegaHealth60
		if module "Megatron Health" == 0.50 goto MegaHealth50
		if module "Megatron Health" > 0.40 goto MegaHealth50
		if module "Megatron Health" == 0.40 goto MegaHealth40
		if module "Megatron Health" > 0.30 goto MegaHealth40
		if module "Megatron Health" == 0.30 goto MegaHealth30
		if module "Megatron Health" > 0.20 goto MegaHealth30
		if module "Megatron Health" == 0.20 goto MegaHealth20
		if module "Megatron Health" > 0.10 goto MegaHealth20
		if module "Megatron Health" == 0.10 goto MegaHealth10
		if module "Megatron Health" >= 0.00 goto MegaHealth10
	}
	actions
	{
		
		
		
	}
}
state MegaHealth100
{
	actions
	{
		DestroyModule "#Megatron"
		CreateModule "#Goto" "#Megatron" "#SpawnSpline=A6C1MegaArrive1" "#SpawnInLOSInit" "#SpawnAsCreature" "#ForcePlayerAsOpp" "#BlockDeath" "#Boss" "#Type=Megatron" "#SetEnergyMax=2500" "#SetEnergy=2500" "#Protect" "#Script=StandAndWait" "#AddToRadarOff"
		
		SetState Chapter1_Phase4ChooseMegaDropType
	}
}

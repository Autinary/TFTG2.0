state InHubZoneC 
{
	conditions
	{
		if module "SubMissions GetSubMissionAnyBeenTriggered" == 1.0 goto SubMission_Init
		if module "ActionRing AnyBeenTriggered"  == 1.0 goto GlobalStartChapter

		
		if module "General GetCountA" <= 1.0 goto SetZoneCDroneGroup1Init
		if module "General GetCountA" <= 2.0 goto SetZoneCDroneGroup2Init
		if module "General GetCountA" <= 4.0 goto SetZoneCDroneGroup3Init
		if module "General GetCountA" <= 6.0 goto SetZoneCDroneGroup4Init
		if module "General GetCountA" <= 7.0 goto SetZoneCDroneGroup5Init
		if module "General GetCountA" <= 9.0 goto SetZoneCDroneGroup6Init
		

		
		if Timer > 0.2 goto SetZoneCDroneGroup1Init
		
	}
	actions
	{
		ResetTimer 
	}

}

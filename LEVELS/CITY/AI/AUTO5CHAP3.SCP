	{
		ResetTimer
		
		SendToModule "#BrawlCreature"  "#RemoveBoss" "#DirectSpline=A5C3BrawlRouteC" "#Script=FollowSplineVeh" "#Unstoppable" "#AddToRadarOff"
		SendToModule "#CreatureWaveA" "#count=1"
	}

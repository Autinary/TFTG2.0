;scavenger hunt, find all the nodes within the time limit

;requires:
;Scavenger spline		Scavenger#	;maximum 80 points
;KeyLocation spline		KeyLoc#

;Changeable params:
;	300		time in which to complete the mission
;	15			keylocation timeout
;	75		distance in which points are added to radar (75)

state SubMission2_Enter
{
	actions
	{
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission2_Death"
		;SendToModule "#General" "#PlayerType=Jazz"
		SendToModule "#General" "#ResetAll"
		SetState "SubMission2_Init"
	}
}
state SubMission2_Enter2
{
	conditions
	{
		if module "General ChapterProgress" >= 2.0 goto SubMission2_Enter3
		if timer > 0.1 goto SubMission2_Main3
	}
	actions
	{
		
	}
}
state SubMission2_Enter3
{
	conditions
	{
		if module "General ChapterProgress" >= 4.0 goto SubMission2_Main
		if timer > 0.1 goto SubMission2_Main4
	}
	actions
	{
		
	}
}
state SubMission2_Init
{
	conditions
	{
		if module "General ChapterProgress" >= 1.0 goto SubMission2_Enter2
		if timer > 0.1 goto SubMission2_Main2
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#SetPlayer=#SubMission2" "#ResetLevel"
		CreateModule "#Timer" "#Timer" "#Time=240"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=KeyLoc2" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#TimeOut=15" 
		CreateModule "#RaceNodes" "#RaceNodes" "#Spline=Scavenger2" "#MultiNode" "#RadarRange=75"
		CreateModule "#DroneCounter" "#DroneCounter" "#ModuleTag=#RaceNodes" "#GetPercentageComplete" "#IgnoreDroneKills" "#DronesToDefeat=10" "#BackwardsCount"
		SendToModule "#RaceNodes" "#SetupDroneCounter=#DroneCounter"
		SendToModule "#General" "#LoadCreature=Scorponok"
	}
}
state SubMission2_Main
{
	conditions
	{
		if module "RaceNodes getpercentagecomplete" == 1.0 goto SubMission2_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission2_Fail
		if module "Timer FailMission" == 1.0 goto SubMission2_Fail
		
	}
	actions
	{

		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#SetPlayer=#SubMission2EX" 
		CreateModule "#Timer" "#Timer" "#Time=240"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=A2C4KeyLoc3" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#TimeOut=15" "#Radius=260"
		CreateModule "#RaceNodes" "#RaceNodes" "#Spline=Nodes4" "#MultiNode" "#RadarRange=75"
		CreateModule "#DroneCounter" "#DroneCounter" "#ModuleTag=#RaceNodes" "#GetPercentageComplete" "#IgnoreDroneKills" "#DronesToDefeat=10" "#BackwardsCount"
		SendToModule "#RaceNodes" "#SetupDroneCounter=#DroneCounter"
		Idle 0.2 
		SetMusic "STOP INMISSION ACTION Generic PLAY ACTION"	
		SendToModule "#General" "#BG_LoadCreature=DroneDefault"	
		SendToModule "#General" "#FadeUp"		
	}
}

state SubMission2_Main2
{
	conditions
	{
		if module "RaceNodes getpercentagecomplete" == 1.0 goto SubMission2_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission2_Fail
		if module "Timer FailMission" == 1.0 goto SubMission2_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission1_1 PLAY ACTION"
		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
    	SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		CreateModule "#VehicleLevels" "#VehicleLevels" "#ResponseLv=5" "#TrafficLv=1" "#PatrolLv=1" "#RoadBlocks=A2C1RoadBlocks"
		SendToModule "#General" "#BG_LoadCreature=DroneDefault"	
		CreateModule "#Creature" "#Drones" "#Type=DroneDefault" "#Spline=RandomDronesA" "#count=10000" "#maxalive=1" "#addtoradaroff" "#SpawnInLosInit" "#SpawnAsCreature" "#FollowPlayer" "#rangemax=300" "#rangemin=200"
		CreateModule "#Creature" "#Drones" "#Type=DroneDefault" "#Spline=A2C4KeyLoc2" "#count=10000" "#maxalive=1" "#addtoradaroff" "#SpawnInLosInit" "#SpawnAsCreature" "#FollowPlayer"  "#rangemax=300" "#rangemin=200"
		CreateModule "#Creature" "#Scorp" "#Type=Scorponok" "#Spline=RandomDronesA" "#count=1" "#maxalive=1" "#addtoradaroff" "#SpawnInLosInit" "#SpawnAsCreature" "#SetPosition=#ScavengerSpawn1" "#FollowPlayer" "#BlockDeath" "#SetEnergyMax=3000" "#SetEnergy=3000"
		
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission2_Main3
{
	conditions
	{
		if module "RaceNodes getpercentagecomplete" == 1.0 goto SubMission2_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission2_Fail
		if module "Timer FailMission" == 1.0 goto SubMission2_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission2_1 PLAY ACTION"
		SendToModule "#General" "#UnLoadCreature=Scorponok"
		SendToModule "#General" "#LoadCreature=Barricade"
		SendToModule "#General" "#BG_LoadCreature=DroneDefault"		
		SendToModule "#General" "#PlayerType=IronHide" "#SetPlayer=#SubMission2"
		CreateModule "#Creature" "#Barr" "#Type=Barricade" "#Spline=RandomDronesA" "#count=1" "#maxalive=1" "#addtoradaroff" "#SpawnInLosInit" "#SpawnAsVehicle" "#SetPosition=#ScavengerSpawn3" "#FollowPlayer" "#BlockDeath" "#SetEnergyMax=3000" "#SetEnergy=3000" "#Script=BarrEarly"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission2_Main4
{
	conditions
	{
		if module "RaceNodes getpercentagecomplete" == 1.0 goto SubMission2_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission2_Fail
		if module "Timer FailMission" == 1.0 goto SubMission2_Fail
		if module "General ChapterProgress" >= 3.0 goto SubMission2_Main5
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission3_1 PLAY ACTION"
		SendToModule "#General" "#UnLoadCreature=Scorponok"	
		SendToModule "#General" "#LoadCreature=Blackout"	
		SendToModule "#General" "#BG_LoadCreature=DroneDefault"	
		SendToModule "#General" "#PlayerType=OptimusPrime" "#SetPlayer=#SubMission2"
		CreateModule "#VehicleLevels" "#VehicleLevels" "#ResponseLv=0" "#TrafficLv=5" "#PatrolLv=1" "#RoadBlocks=RoadBlock1"
		CreateModule "#Creature" "#Blackout" "#Type=Blackout" "#Spline=RandomDronesA" "#count=1" "#maxalive=1" "#addtoradaroff" "#SpawnInLosInit" "#SpawnAsVehicle" "#SetPosition=#ScavengerSpawn2" "#BlockDeath" "#SetEnergyMax=7000" "#SetEnergy=7000" 
		SendToModule "#Blackout" "#ForcePlayerAsOpp"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission2_Main5
{
	conditions
	{
		if module "RaceNodes getpercentagecomplete" == 1.0 goto SubMission2_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission2_Fail
		if module "Timer FailMission" == 1.0 goto SubMission2_Fail
		
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Generic PLAY ACTION"
		DestroyModule "#VehicleLevels"
			
	}
}
state SubMission2_Finish
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission2_FinishWait
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission2_FinishWait
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission2_Leave
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=2"
		;SetState "SubMission2_Leave"
	}
}
state SubMission2_Death
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMission2_Leave
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state SubMission2_Fail
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission2_Leave
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FailMission"
	}
}
state SubMission2_Leave
{
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		;
		SendToModule "#General" "#UnLoadCreature=Scorponok"
		SendToModule "#General" "#UnLoadCreature=Blackout"
		SendToModule "#General" "#UnLoadCreature=DronePickupTruck"
		SendToModule "#General" "#LoadCreature=DroneDefault"	
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission2" "#FadeUp"
		SendToModule "#General" "#FadeUp"		
		SetState "Exit"
	}
}


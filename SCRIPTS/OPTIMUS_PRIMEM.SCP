
state Base
{
	Actions
	{
		SetFlag "TakeHitPhysics=false" "TakeHitMelee=false" "TakeHit=false" "StuckEscape=false"
		SetState Randomizer
	}
}
state Randomizer
{
	conditions
	{

		if AlwaysTrue > "RAND*5.0" goto PrimeSlam

		;if AlwaysTrue > "RAND*4.0" goto PrimeTruck 

		if AlwaysTrue > "RAND*3.0" goto PrimeRange

		if AlwaysTrue > "RAND*2.0" goto PrimeAgile


		
		if AlwaysTrue == 1.0 goto Prime

		
		
	}
}

state Prime
{
    	ReferenceScript {
        Script=Optimus_Prime
        Source=Global
        Conditions {
        }
    }

	Conditions {
	}
	Actions {
	}
}


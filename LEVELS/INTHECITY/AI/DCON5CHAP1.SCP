state Chapter1_Advice
{
	actions
	{
		SendToModule "#RatArea" "#AddToRadarOff" 
		SendToModule "#General" "#CountASet=1"
		;CreateModule "#Speech" "#Speech" "#speech=#D5_ch3_obj6" "#AutoDestroy" "#Start"
		SetState Chapter1_FightProcess
	}
}
state Chapter1_RatchetHeal
{
	
	actions
	{
		ResetTimer
		SendToModule "#General" "#SetMessageTimer=-1"
		Idle 0.1
		SendToModule "#HealTheTroops" "#Time=20"
		SendToModule "#Ratchet" "#Script=Heal" 
		SendToModule "#RatArea" "#SetRadarType=#AutoBotRadarIcon"
		SendToModule "#Jazz" "#SetEnergy=1500" ; "#Script=Jazz"
		SendToModule "#Autobots" "#SetEnergy=1000" 
		SendToModule "#Autobots2" "#SetEnergy=800"
		SendToModule "#General" "#SetRadarInterference=0"
		SendToModule "#General" "#SetMessage=ITC2" "#SetMessageTimer=3.0"
		;CreateModule "#Speech" "#EWave" "#speech=#D5_ch1_obj2" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		SetMusic "ACTION Mission1_2 QUIET Generic Play Action"
		
		Idle 1.4
		
		SetState Chapter1_RadarIsStillJammed
	}
}
state Chapter1_RatchetHeal2
{
	
	actions
	{
		ResetTimer
		SendToModule "#HealTheTroops" "#Time=20"
		SendToModule "#Ratchet" "#Script=Heal" 
		SendToModule "#RatArea" "#SetRadarType=#AutoBotRadarIcon"
		SendToModule "#Jazz" "#SetEnergy=1500" ; "#Script=Jazz"
		SendToModule "#Autobots" "#SetEnergy=1000" 
		SendToModule "#Autobots2" "#SetEnergy=800"
		SendToModule "#General" "#SetRadarInterference=0"
		SendToModule "#General" "#SetMessage=ITC2" "#SetMessageTimer=3.0"
		SendToModule "#General" "#CountCInc"
		;CreateModule "#Speech" "#EWave" "#speech=#D5_ch1_obj2" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		SetMusic "ACTION Mission1_2 QUIET Generic Play Action"
		
		Idle 1.4
		
		SetState Chapter1_RadarIsStillJammed
	}
}


state Chapter1_RadarIsStillJammed
{
	
	actions
	{
		
		SendToModule "#General" "#SetRadarInterference=1"
		SendToModule "#Ratchet" "#Script=RatchetInit"
		Idle 0.6
		SetMusic "ACTION Mission1_1 QUIET Generic Play Action"
		 
		SetState Chapter1_FightProcess
	}
}


state Chapter1_ClearTheRadar
{
	conditions
	{

		;if module "Ratchet BeenHit" == 1.0 and
		;	if module "Ratchet Health" == 1.0 and 
		;		if module "General GetCountA" == 0.0 goto Chapter1_Advice

		if module "Jazz Energy" <= 0.50 goto Chapter1_RatchetHeal
		if module "HealTheTroops Timer" < 0.0 goto Chapter1_RatchetHeal

		if module "DroneBackUp FailMission" == 1.0 goto Chapter1_FightStage2
		if module "Ratchet IsEnergyAtMin" == 1.0 and
			if module "General GetCountB" == 1.0 goto Chapter1_FightStage5
		if module "Ratchet IsEnergyAtMin" == 1.0 and
			if module "General GetCountB" == 2.0 goto Chapter1_FightStage4
		if module "Ratchet PlayerRange" > 45 goto Chapter1_RadarIsStillJammed
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission

		;if module "Ratchet Energy" <= 0.89 and 
	;			if module "General GetCountA" == 1.0 goto RatchetHold1
	;	if module "Ratchet Energy" <= 0.78 and 
	;			if module "General GetCountA" == 2.0 goto RatchetHold2
	}
	actions
	{
		SendToModule "#General" "#CountCSet=5"
		SendToModule "#General" "#SetRadarInterference=0"
		SendToModule "#Ratchet" "#Script=RatchetCombat" 
		SendToModule "#RatArea" "#SetRadarType=#AutoBotRadarIcon"
		
	}
}


state Chapter1_FightStage2
{
	
	actions
	{
		DestroyModule "#DroneBackUp" 
		CreateModule "Timer" "#HealTheTroops" "#Time=20" "#NoRender" 
		SendToModule "#General" "#SetMaxOpponents=9" "#SetMaxApproachers=9" "#SetAttackRingSize=20" "#CountBSet=2"
		SendToModule "#General" "#BG_LoadCreature=DroneDefault_a"
		SendToModule "#General" "#BG_LoadCreature=DroneForklift_a"
		SendToModule "#General" "#SetMessage=ITC3" "#SetMessageTimer=3.0"
		SendToModule "#RatArea" "#SetRadarType=#AutoBotRadarIcon"
		SendToModule "#General" "#CountCSet=1"
		CreateModule "#Creature" "#Autobots" "#Spline=D5C4Spawn2A" "#count=10000" "#maxalive=1" "#addtoradar" "#Type=DroneDefault_a" "#SpawnAsVehicle" "#Script=CarDrone" "#SetEnergyMax=1000"
			CreateModule "#Creature" "#Autobots2" "#Spline=D5C4Spawn2A" "#count=20000" "#maxalive=2" "#addtoradar" "#Type=DroneForklift_a" "#SpawnAsVehicle" "#Script=ForkliftDrone" "#SetEnergyMax=800" "#ForcePlayerAsOpp"
		SetState Chapter1_FightProcess
		
	}
}
state Chapter1_FightStage4
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto Chapter1_FightAlmostOver
	}
	actions
	{
		SendToModule "#Ratchet" "#Script=DummyCar_I" "#TransformForceCar" "#SetEnergyMin=1000" ; "#DirectSpline=D5C3IronHide" 
		DestroyModule "#RatArea"
		SendToModule "#General" "#SetRadarInterference=0"
		SendToModule "#Jazz" "#Script=Jazz" 
		SendToModule "#Autobots" "#count=1"
		SendToModule "#Autobots2" "#count=2"
		;Idle 1.5 

		;SendToModule "#Ratchet" "#DirectSpline=D5C3IronHide" "#Script=FollowSplineTC"
		

		SendToModule "#General" "#FadeDown"
		Idle 5.0 
		SetState Chapter1_FightAlmostOver
		
		
	}
}
state Chapter1_FightAlmostOver
{
	conditions
	{
		if module "Autobots Energy" <= 0.0 and
			if module "Autobots2 Energy" <= 0.0 and 
				if module "Jazz Energy" <= 0.05 goto Chapter1_FightStage1Midtro
		if module "Jazz Dead" == 1.0 goto Chapter1_JazzIsKO'd
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	
	actions
	{
		DestroyModule "#Ratchet"
		CreateModule "#Goto" "#Ratchet" "#SpawnSpline=Spawn1" "#DirectSpline=D5C3IronHide" "#count=1" "#maxalive=1" "#addtoradaroff" "#Type=DroneArmouredCar" "#SpawnAsVehicle" "#SuppressShield" "#SetEnergyMax=1500" "#SetEnergy=1005" "#BlockDeath" "#SetPosition=#RatchetTransform1" "#SetEnergyMin=1005" "#Unstoppable"
		
		SendToModule "#General" "#FadeUp"
	}
}
state Chapter1_FightStage5
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto Chapter1_FightAlmostOver2
	}
	actions
	{
		SendToModule "#Ratchet" "#Script=DummyCar_I" "#TransformForceCar"  "#SetEnergyMin=1000" ; "#DirectSpline=D5C3IronHide" 
		DestroyModule "#RatArea"
		SendToModule "#General" "#SetRadarInterference=0"
		;Idle 0.7 
		;DestroyModule "#Ratchet"
		;CreateModule "#Goto" "#Ratchet" "#SpawnSpline=Spawn1" "#DirectSpline=D5C3IronHide" "#count=1" "#maxalive=1" "#addtoradaroff" "#Type=DroneArmouredCar" "#SpawnAsVehicle" "#SuppressShield" "#SetEnergyMax=1500" "#SetEnergy=1005" "#BlockDeath" "#SetPosition=#RatchetTransform1" "#SetEnergyMin=1005"
		SendToModule "#General" "#FadeDown"
		Idle 5.0 
		SetState Chapter1_FightAlmostOver2
		
		
	}
}
state Chapter1_FightAlmostOver2
{
	conditions
	{
		if module "Jazz Energy" <= 0.05 goto Chapter1_FightStage1Midtro
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		DestroyModule "#Ratchet"
		CreateModule "#Goto" "#Ratchet" "#SpawnSpline=Spawn1" "#DirectSpline=D5C3IronHide" "#count=1" "#maxalive=1" "#addtoradaroff" "#Type=DroneArmouredCar" "#SpawnAsVehicle" "#SuppressShield" "#SetEnergyMax=1500" "#SetEnergy=1005" "#BlockDeath" "#SetPosition=#RatchetTransform1" "#SetEnergyMin=1005" "#Unstoppable"
		
		SendToModule "#General" "#FadeUp"
	}
}
state Chapter1_JazzIsKO'd
{
	conditions
	{
	
		
		if module "Autobots Energy" <= 0.0 and
			if module "Autobots2 Energy" <= 0.0 goto Chapter1_FightStage1Midtro
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		;DestroyModule "#KeyLocation"
		SendToModule "#General" "#SetMessage=ITC4" "#SetMessageTimer=3.0"
		;CreateModule "#KeyLocation" "#KeyLocation" "#Spline=D5C4KeyLoc2" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#HeadType=#StarScream"
	}
}




state Chapter1_FightStage1Midtro
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_RaceInit
	}
	actions
	{
		SendToModule "#General" "#EndMissionIntro" "#StartVideo=#D5C1Midtro1"
	}
}

state Chapter1_RaceInit
{
	conditions
	{

	}
	actions
	{
		DestroyModule "#KeyLocation"
		DestroyModule "#Jazz"
		DestroyModule "#Ratchet"
		DestroyModule "#Autobots"
		DestroyModule "#Autobots2"
		CreateModule "#Timer" "#Timer" "#Time=60.0"

		CreateModule "#Speech" "#DefeatDrones" "#speech=#D5_ch1_obj10" "#AutoDestroy" "#Start"
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D5_ch1_obj5" "#AutoDestroy" 
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D5_ch1_obj7" "#AutoDestroy" 
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D5_ch1_obj6" "#AutoDestroy" 
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D5_ch1_obj9" "#AutoDestroy" 
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#DefeatDrones" "#param=#start" "#delay=20" "#times=4" 
		CreateModule "#ProgressPoint" "#ProgressPoint" "#spline=D5C1Race" "#Radius=5.0" "#Allowance=9.5" "#Index=RRRRRRRRRRRRRRR" "#LoopSpline"
		CreateModule "#Goto" "#Jazz" "#SpawnSpline=D5C1Jazz" "#DirectSpline=D5C1Goto" "#LoopSpline" "#Object=#RedMediumDot" "#type=Jazz" "#SplineStep=0" "#Invulnerable" "#Speed=150"  "#InhibitRubble" "#UnstoppableAndTransform=60.0" "#InhibitRubble" "#BlockDeath"
		;CreateModule "#Goto" "#Ratchet" "#SpawnSpline=Spawn1" "#DirectSpline=D5C1Goto" "#LoopSpline" "#Object=#RedMediumDot" "#type=DroneArmouredCar" "#UnStoppableAndTransform=30.0" "#Invulnerable" "#InhibitRubble" "#TransformForceCar" "#SuppressShield" "#Speed=120" "#BlockDeath" "#SetPosition=#Chapter1Start"

		SendToModule "#General" "#PhysObj" "#SetPlayer=#Chapter1StartB" "#FadeUp" "#CountASet=0"
		
		SetState "Chapter1_RaceMain"
	}
}

state Chapter1_RaceMain
{
	conditions
	{
		;if module "Jazz BeenHit" == 1.0 AND
		;	if module "General GetCountA" == 0.0 goto Chapter1_RatchetEscort
		;if module "Ratchet TransformMeter" == 1.0 goto Chapter1_RatchetStunned

		if module "Jazz Dead" == 1.0 goto Chapter1_Complete		; shouldn't be possible, but just in case
		if module "Jazz TransformMeter" == 1.0 goto Chapter1_FinalFight
		if module "ProgressPoint AnyBeenTriggered" == 1.0 goto Chapter1_PickCamera
		if module "Timer FailMission" == 1.0 goto Chapter1_FailMission
	}
	
	Actions
	{
		
	}
}

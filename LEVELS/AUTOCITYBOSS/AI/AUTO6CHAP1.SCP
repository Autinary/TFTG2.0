		SendToModule "#General" "#LoadCreature=BumbleBee07"
		SendToModule "#General" "#LoadCreature=IronHide"
		SendToModule "#General" "#LoadCreature=DroneArmouredCar_a"

		
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter1Restart" "#FadeUp"
		

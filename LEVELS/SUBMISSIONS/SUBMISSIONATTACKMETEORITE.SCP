;Destroy all drones within time limit

;requires:
;	Keylocation spline 				KeyLoc#
;	Spawn spline for meteorite impacts		Spawn#

;Changeable params:
;	TIMELIMIT		time in which to complete the mission
;	TIMEOUT			keylocation timeout
;	MAXALIVE		maximum alive
;	CREATURETYPE1	type of creature one to fight against
;	CREATURETYPE2	type of creature two to fight against
;	CREATURETYPE3	type of creature three to fight against
;						DroneForkLift
;						DroneTowTruck
;						DroneArmouredCar
;						DroneCement
;						DronePickupTruck
;						DroneMig
;						BumbleBee
;						Barricade


state SubMissionONE_Enter
{
	actions
	{
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMissionONE_Death"
;		SendToModule "#General" "#PlayerType="
		SetState "SubMissionONE_Init"
	}
}
state SubMissionONE_Init
{
	conditions
	{
		if timer > 0.1 goto SubMissionONE_Main
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMissionONE"
	    SendToModule "#General" "#LoadCreature=CREATURETYPE1"
	    SendToModule "#General" "#LoadCreature=CREATURETYPE2"
	    SendToModule "#General" "#LoadCreature=CREATURETYPE3"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=KeyLocONE" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#TimeOut=TIMEOUT" 
		CreateModule "#Timer" "#Timer" "#Time=TIMELIMIT"

	}
}
state SubMissionONE_Main
{
	conditions
	{
		if module "Meteorite GetPercentage" == 1.0 and
			if module "Creature GetCountAlive" == 0.0 goto SubMissionONE_Wave2
		if module "KeyLocation FailMission" == 1.0 goto SubMissionONE_Fail
		if module "Timer FailMission" == 1.0 goto SubMissionONE_Fail
	}
	actions
	{
		CreateModule "#Creature" "#Creature" "#count=0" "#maxalive=MAXALIVE" "#addtoradaralways" "#Type=CREATURETYPE1" "#TransformForceRobot" "#KeyLocation=On"
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#Creature" "#Spline=SpawnONE" "#Time=3" "#Time=6" "#Time=9,CREATURETYPE2" "#Time=12,CREATURETYPE2"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMissionONE_Wave2
{
	conditions
	{
		if module "Meteorite GetPercentage" == 1.0 and
			if module "Creature GetCountAlive" == 0.0 goto SubMissionONE_Wave3
		if module "KeyLocation FailMission" == 1.0 goto SubMissionONE_Fail
		if module "Timer FailMission" == 1.0 goto SubMissionONE_Fail
	}
	actions
	{
		DestroyModule "#Creature"
		DestroyModule "#Meteorite"
		CreateModule "#Creature" "#Creature" "#count=0" "#maxalive=4" "#addtoradaralways" "#Type=CREATURETYPE1" "#TransformForceRobot" "#KeyLocation=On"
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#Creature" "#Spline=SpawnONE" "#Time=3" "#Time=6,CREATURETYPE2" "#Time=9,CREATURETYPE2" "#Time=12,CREATURETYPE3"
	}
}
state SubMissionONE_Wave3
{
	conditions
	{
		if module "Meteorite GetPercentage" == 1.0 and
			if module "Creature GetCountAlive" == 0.0 goto SubMissionONE_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMissionONE_Fail
		if module "Timer FailMission" == 1.0 goto SubMissionONE_Fail
	}
	actions
	{
		DestroyModule "#Creature"
		DestroyModule "#Meteorite"
		CreateModule "#Creature" "#Creature" "#count=0" "#maxalive=4" "#addtoradaralways" "#Type=CREATURETYPE1" "#TransformForceRobot" "#KeyLocation=On"
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#Creature" "#Spline=SpawnONE" "#Time=3" "#Time=6,CREATURETYPE2" "#Time=9,CREATURETYPE2" "#Time=12,CREATURETYPE3"
	}
}

state SubMissionONE_Finish
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMissionONE_FinishWait
	}
	actions
	{
		SendToModule "#General" "#FadeDown"
	}
}
state SubMissionONE_FinishWait
{
	conditions
	{
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=ONE"
		SetState "SubMissionONE_Leave"
	}
}
state SubMissionONE_Death
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMissionONE_Leave
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#DeathFailMission"
	}
}
state SubMissionONE_Fail
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMissionONE_Leave
	}
	actions
	{
		SendToModule "#General" "#FailMission"
	}
}
state SubMissionONE_Leave
{
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#RevertPlayerType"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMissionONE" "#FadeUp"
	   	SendToModule "#General" "#UnLoadCreature=CREATURETYPE1"
	   	SendToModule "#General" "#UnLoadCreature=CREATURETYPE2"
	   	SendToModule "#General" "#UnLoadCreature=CREATURETYPE3"
		SendToModule "#General" "#FadeUp"		
		SetState "GlobalActionRing"
	}
}


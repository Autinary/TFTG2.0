state base
{
	conditions
	{
		;if CurrentUser "grichards" == 1.0 goto Empty
		;if CurrentUser "sharding" == 1.0 goto Empty
		;if CurrentUser "awhite" == 1.0 goto MainWithDebug
		;if CurrentUser "challiday" == 1.0 goto Empty
		;if CurrentUser "popdam" == 1.0 goto Empty
		;if CurrentUser "DWalker" == 1.0 goto MainWithDebug
		if AlwaysTrue == 1.0 goto StartLevelIntro
	}
	actions
	{
		DrawConditionsFromThisScript
	}
}
state EmptyDeath
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" "#FadeUp"
		SetState "Empty"
	}
}
state Empty
{
	Actions
	{
		CreateModule "#General" "#General" "#ProtectSystem"
		SendToModule "#General" "#FadeUp" "#SetPlayer=#StartMission"
		SetDeathPoint "EmptyDeath"
	}
}
state StartLevelIntro
{
	Actions
	{
		DestroyAllModules "#IncludeProtected"
		CreateModule "#ActionRing"  "#ActionRing" "#ProtectSystem" "#AddToRadarOff"
		SendToModule "#ActionRing" "#CreateChapter=#Chapter1" "#placement=#Chapter1Beacon" "#Title=Auto3Chap1" "#Ring=ActionRing" 
		SendToModule "#ActionRing" "#CreateChapter=#Chapter2" "#placement=#Chapter2Beacon" "#Title=Auto3Chap2" "#Ring=ActionRing"
		SendToModule "#ActionRing" "#CreateChapter=#Chapter3" "#placement=#Chapter3Beacon" "#Title=Auto3Chap3" "#Ring=ActionRing"
		SendToModule "#ActionRing" "#CreateChapter=#Chapter4" "#placement=#Chapter4Beacon" "#Title=Auto3Chap4" "#Ring=ActionRing"
		;SendToModule "#ActionRing" "#maxalive=3" "#spline=RandomDronesA" "#type=DroneDefault" "#rangemax=300" "#rangemin=200"
		;SendToModule "#ActionRing" "#Unlock=#Chapter1"
		SendToModule "#ActionRing" "#TurnOff"
		CreateModule "#General" "#General" "#ProtectSystem"
		
		CreateModule "#SubMissions" "#SubMissions" "#NodeSpline=SubMissionNodes" "#SubmissionSpline=SubMissionGates" "#ProtectSystem"
		SendToModule "#SubMissions" "#SetTitle=#Race"
		SendToModule "#SubMissions" "#SetTitle=#Scavenger"
		SendToModule "#SubMissions" "#SetTitle=#Hunt"
		SendToModule "#SubMissions" "#SetTitle=#Sumo"

		
		SendToModule "#General" "#LevelSpecial1=LASERBEAM_01" "#LevelSpecial2=LASERBEAM_02" "#LevelSpecial3=LASERBEAM_03"

		;CreateModule "#SubMissions" "#SubMissions" "#Spline=SubMissions" "#ProtectSystem"
		;SendToModule "#SubMissions" "#SetTitle=#Attack"
		;SendToModule "#SubMissions" "#SetTitle=#Race"
		;SendToModule "#SubMissions" "#SetTitle=#Collection"
		;SendToModule "#SubMissions" "#SetTitle=#Race"

		SendToModule "#General" "#LevelSpecialOn=1" "#LevelSpecialOn=2" "#LevelSpecialOn=3" 

		SetState "LevelSpecialInit"
	}
}

state LevelSpecialInit
{
	conditions
	{
		if module "General ChapterProgress" >= 3.0 goto LevelSpecialClear3
		if module "General ChapterProgress" >= 2.0 goto LevelSpecialClear2
		if module "General ChapterProgress" >= 1.0 goto LevelSpecialClear1
		if AlwaysTrue == 1.0 goto DoorDestroyInit
	}
}
state LevelSpecialClear3
{
	actions
	{
		SendToModule "#General" "#LevelSpecialOff=3" 
		SetState LevelSpecialClear2
	}
}
state LevelSpecialClear2
{
	actions
	{
		SendToModule "#General" "#LevelSpecialOff=2" 
		SetState LevelSpecialClear1
	}
}
state LevelSpecialClear1
{
	actions
	{
		SendToModule "#General" "#LevelSpecialOff=1" 
		SetState DoorDestroyInit
	}
}
state DoorDestroyInit
{
	conditions
	{
		if module "General ChapterProgress" >= 1.0 goto DoorDestroyDo
		if AlwaysTrue == 1.0 goto LevelIntro
	}
}
state DoorDestroyDo
{
	actions
	{
		CreateModule "#SpecialObj" "#DoorA" "#Spline=A3C1A" "#PhysObjGlow" "#Breakable" "#Radius=10" "#Protect" "#NoWeaponDamage"
		CreateModule "#SpecialObj" "#DoorB" "#Spline=A3C1B" "#PhysObjGlow" "#Breakable" "#Radius=10" "#Protect" "#NoWeaponDamage"
		CreateModule "#SpecialObj" "#DoorC" "#Spline=A3C1C" "#PhysObjGlow" "#Breakable" "#Radius=10" "#Protect" "#NoWeaponDamage"

		Idle "frames=3"

		DestroyModule "#DoorA"
		DestroyModule "#DoorB"
		DestroyModule "#DoorC"

		SetState LevelIntro
	}
}
state LevelSpecialInit2
{
	conditions
	{
		if timer > 0.2 goto SubMission1_InEarly
		if module "General ChapterProgress" >= 1.0 goto DoorDestroyInit2
		if module "General ChapterProgress" >= 2.0 goto DoorDestroyInit2
		if module "General ChapterProgress" >= 3.0 goto DoorDestroyInit2
		if module "General ChapterProgress" >= 4.0 goto DoorDestroyInit2
		;if AlwaysTrue == 1.0 goto DoorDestroyInit2
	}
	actions
	{
		ResetTimer
	}
}

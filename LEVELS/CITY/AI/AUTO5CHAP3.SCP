	{
		CreateModule "#Creature" "#CreatureWaveB" "#Spline=A5C3SpawnB" "#count=1" "#maxalive=1" "#Type=DroneTowTruck" "#SpawnAsCreature" "#IgnoreLOS" "#KeyLocation=On" "#Script=TowTruckDrone"
	}

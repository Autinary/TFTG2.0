	conditions
	{
		if module "GotoDroneE TransformMeter" == 1.0 goto SubMission_RatchetKO
		if module "DroneCounter Complete" == 1.0 and 
			if module "GotoDroneC GetPercentageComplete" == 1.0 and
					if module "GotoDroneD GetPercentageComplete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail1
		if module "Ratchet FailMission" == 1.0 goto SubMission3_Fail1
		if module "Ratchet InArea" == 1.0 goto SubMission3_UnScrambleRadar
	}
	actions
	{
		SendToModule "#General" "#DeleteRadarFreeInterferenceZones"
		SendToModule "#General" "#SetRadarInterference=1"
	}
}
state SubMission3_UnScrambleRadar
{
	conditions
	{
		if module "GotoDroneE TransformMeter" == 1.0 goto SubMission_RatchetKO
		if module "DroneCounter Complete" == 1.0 and 
			if module "GotoDroneC GetPercentageComplete" == 1.0 and
					if module "GotoDroneD GetPercentageComplete" == 1.0 goto SubMission3_Finish
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail1
		if module "Ratchet FailMission" == 1.0 goto SubMission3_Fail1
		if module "Ratchet InArea" == 0.0 goto SubMission3_RadarScrambled
	}
	actions
	{
		
		SendToModule "#General" "#SetRadarInterference=0"
	}
}
state SubMission3_Main0
{
	conditions
	{
		if module "GotoDroneE TransformMeter" == 1.0 goto SubMission_RatchetKO0
		if module "DroneCounter Complete" == 1.0 and 
			if module "GotoDroneC GetPercentageComplete" == 1.0 and
					if module "GotoDroneD GetPercentageComplete" == 1.0 goto SubMission3_Finish0
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail0
		if module "Ratchet FailMission" == 1.0 goto SubMission3_Fail0
		;if module "Ratchet InArea" == 0.0 goto SubMission3_RadarScrambled0
		if Timer > 3.0 goto SubMission3_RatchetKeyLocation0
		
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#LoadCreature=Jazz"
		SendToModule "#General" "#LoadCreature=DroneArmouredCar"
		SetMusic "STOP INMISSION ACTION Mission3_1 PLAY ACTION"
		CreateModule "#Goto" "#GotoDroneA" "#SpawnSpline=Route3b" "#DirectSpline=Route3b" "#TransformBothWays=7.0" "#type=Jazz" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#LoopSpline" ;"#DrawHealthBar"
		CreateModule "#Goto" "#GotoDroneE" "#SpawnSpline=Route3a" "#DirectSpline=Route3a" "#UnStoppableAndTransform=9.0" "#type=DroneArmouredCar" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#Speed=120" "#SuppressShield" "#AddToRadarOff" "#LoopSpline" ;"#DrawHealthBar"
		CreateModule "#DriverDrone" "#GotoDroneC" "#spline=Route3c" "#maxalive=1" "#count=1" "#FollowSpline=Route3c" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar" ; "#ModuleTag=#DroneCounter"
		CreateModule "#DriverDrone" "#GotoDroneD" "#spline=Route3d" "#maxalive=1" "#count=1" "#FollowSpline=Route3d" "#spacing=1.0" "#goalrange=8.0" "#type=HUNTSUV" "#Object=#GreenMediumDot" "#SpawnInLOSInit" "#IgnorePaths" "#DrawHealthBar" ; "#ModuleTag=#DroneCounter"
		;CreateModule "#KeyLocation" "#Ratchet" "#Creature=#GotoDroneE" "#Radius=150" "#String=Key1Find" "#ReEnterMsg=Key1Found" "#InitTimeOut=60" "#TimeOut=30" "#HeadType=#StarScream" 
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=2" "#IconType=#Drone"
		SendToModule "#General" "#DeleteRadarFreeInterferenceZones"
		SendToModule "#General" "#SetRadarInterference=1"
		
																																																				   
		SendToModule "#General" "#FadeUp"
				
	}
}

state SubMission_RatchetKO0
{
	conditions
	{
		if module "DroneCounter Complete" == 1.0 and 
			if module "GotoDroneC GetPercentageComplete" == 1.0 and
					if module "GotoDroneD GetPercentageComplete" == 1.0 goto SubMission3_Finish0
		if module "Timer FailMission" == 1.0 goto SubMission3_Fail0
	}
	actions
	{
		DestroyModule "#Ratchet"
		SendToModule "#DroneCounter" "#Increment=1"
		SendToModule "#GotoDroneE" "#Script=StopAndSmoke"  ; "#SuppressShield"
		SendToModule "#GotoDroneE" "#SetEnergy=0.01"
		SendToModule "#General" "#SetRadarInterference=0"
	}
}
state SubMission3_RatchetKeyLocation0
{
	conditions

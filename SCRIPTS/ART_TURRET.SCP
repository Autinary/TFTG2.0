
state Base
{
	Conditions
	{
		if AlwaysTrue == 1.0 goto Init
	}
}

state Init
{
	Actions
	{
		;Transform Secondary UntilDone
		Transform "Car" "Instant"
		SetPhysicsState "static=true" "immunetoshots=false" "immunetomelee=false"
		
		SetState AnnhilatePlayer
	}
}


state AnnhilatePlayer
{
	Conditions
	{
			if GetEnergy <= 0.05 goto Dead
	}
	Actions
	{
		ResetTimer
		EngageOpponentTC "RapidShootRange=1.0" "fireId=0" "firetimemin=0.1" "firetimemax=0.3" 
	}

}
state Dead
{
	Actions
	{
		SetStrafe False
		CarDrive "park" "smoke"
		
	}
}


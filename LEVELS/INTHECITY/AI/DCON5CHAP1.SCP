state Chapter1_PickCamera
{
	conditions
	{
		if module "ProgressPoint IndexBeenTriggered" == 1.0 goto Chapter1_NoPlay
		if module "ProgressPoint IndexBeenTriggered" == 2.0 goto Chapter1_NoPlay
		if module "ProgressPoint IndexBeenTriggered" == 3.0 goto Chapter1_NoPlay
		if module "ProgressPoint IndexBeenTriggered" == 4.0 goto Chapter1_NoPlay
		if module "ProgressPoint IndexBeenTriggered" == 5.0 goto Chapter1_NoPlay
		if module "ProgressPoint IndexBeenTriggered" == 6.0 goto Chapter1_NoPlay 
		if module "ProgressPoint IndexBeenTriggered" == 7.0 goto Chapter1_NoPlay
		if module "ProgressPoint IndexBeenTriggered" == 8.0 goto Chapter1_NoPlay 
		if module "ProgressPoint IndexBeenTriggered" == 9.0 goto Chapter1_NoPlay 
		if module "ProgressPoint IndexBeenTriggered" == 10.0 goto Chapter1_NoPlay
		if module "ProgressPoint IndexBeenTriggered" == 11.0 goto Chapter1_NoPlay
		if module "ProgressPoint IndexBeenTriggered" == 12.0 goto Chapter1_NoPlay
		if module "ProgressPoint IndexBeenTriggered" == 13.0 goto Chapter1_NoPlay
		if module "ProgressPoint IndexBeenTriggered" == 14.0 goto Chapter1_NoPlay
		if module "ProgressPoint IndexBeenTriggered" == 15.0 goto Chapter1_NoPlay
	}
	actions
	{
		DestroyModule "#SplineCamera"
	}
} 
state Chapter1_NoPlay
{
	actions
	{
		SendToModule "#ProgressPoint" "#ClearAnyBeenTriggered"
		SendToModule "#Timer" "#AddTime=4.0"
		SetState "Chapter1_RaceMain"
	}
}

state Chapter1_FinalFight
{
	
	actions
	{
		DestroyModule "#Timer"
		DestroyModule "#ProgressPoint"
		DestroyModule "#DelayedSendReminder"

		CreateModule "#Speech" "#D5_ch1_obj8" "#speech=#D5_ch1_obj8" "#AutoDestroy" "#Start"

		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#Jazz" "#Radius=125.0" "#String=Key9Goto" "#ReEnterMsg=KEY_LOC_REENTER" 
		SendToModule "#Jazz" "#Stoppable" "#Boss" "#Type=Jazz" "#HideTransformMeter" 
		Idle 0.2 
		SendToModule "#Jazz" "#Script=Jazz" 
		SetState Chapter1_WhereIsRatchet
	}
}
state Chapter1_WhereIsRatchet
{
	conditions
	{
		if module "General GetCountA" == 0.0 goto Chapter1_RatchetBail
		if module "General GetCountA" == 2.0 goto Chapter1_FinalFightProcess
	}
	
}
state Chapter1_RatchetBail
{
	
	actions
	{
		SendToModule "#Ratchet" "#Unstoppable" "#DirectSpline=Spawn1"
		SetState Chapter1_FinalFightProcess
	}
}
state Chapter1_FinalFightProcess
{
	conditions
	{
		if module "Jazz Dead" == 1.0 goto Chapter1_Complete
		if module "Jazz Energy" <= 0.25 goto Chapter1_JazzNearDeath
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	
}
state Chapter1_JazzNearDeath
{
	conditions
	{
		if module "Jazz Energy" <= 0.05 goto Chapter1_JazzMortallyWounded
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		

		CreateModule "#Speech" "#DefeatDrones" "#speech=#D5_ch1_obj4" "#AutoDestroy"  "#Start"

	}
}
state Chapter1_JazzMortallyWounded
{
	conditions
	{
		if module "Jazz Dead" == 1.0 goto Chapter1_Complete
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		
		
		

	}
}

;state Chapter1_InitComplete
;{
;	conditions
;	{
;	
;		if module "Timer FailMission" == 1.0 goto Chapter1_Complete
;	}
;	actions
;	{
;	
;		CreateModule "#Timer" "#Timer" "#Time=1.0" "#Start"
;	}
;}


state Chapter1_DeathFailMission
{
	
	actions
	{
		DestroyModule "#DelayedSendReminder" 
		SendToModule "#General" "#SetRadarInterference=0"

		SetState Chapter1_DeathFailMission2
	}
}
state Chapter1_DeathFailMission2
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_Restart
	}
	actions
	{
		SendToModule "#General" "#SetRadarInterference=0"

		SendToModule "#General" "#EndOfMission"  "#DeathFailMission"
	}
}
state Chapter1_FailMission
{
	conditions
	{
		
	}
	actions
	{
		DestroyModule "#DelayedSendReminder" 
		
		SendToModule "#General" "#SetRadarInterference=0"
		SetState "Chapter1_FailMission2"
	}
}
state Chapter1_FailMission2
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter1_Restart
	}
	actions
	{
		SendToModule "#General" "#EndOfMission"  "#FailMission"
	}
}
state Chapter1_Restart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"

    	SendToModule "#General" "#UnLoadCreature=Jazz"
		SendToModule "#General" "#UnLoadCreature=DroneDefault_a"
		SendToModule "#General" "#UnLoadCreature=DroneForklift_a"
		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar"


		SendToModule "#General" "#PlayerType=Barricade,Scorponok,Blackout,Megatron,Barricade"

		
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter1Restart" "#FadeUp"

		SendToModule "#General" "#SetRadarInterference=0"
		SetState "GlobalActionRing"
	}
}
state Chapter1_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter1_CompleteVideo
	}
	actions
	{
		SendToModule "#General" "#EndOfMission"  "#SetPosition=COMPPOINT1" "#Spline=COMCAM1" "#SetFocus=CAMFOCUS1"
		SendToModule #General #UnlockBonus=Character_Barricade
		SendToModule "#General" "#CompleteMission" 
		SendToModule "#ActionRing" "#SetCompleted=#Chapter1" "#Unlock=#Chapter2"
		CreateModule "#Speech" "#ItsOver" "#speech=#D5_ch1_obj11" "#PlayDelay=1.2" "#AutoDestroy" "#Start"
		
	}
}
state Chapter1_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_CompleteVideoFinished
	}
	actions
	{
		IncreasePlayerHealth max
		SendToModule "#General" "#StartOutroVideo=#D5C1Outro1"
	}
}
state Chapter1_CompleteVideoFinished
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter1_Leave
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
    	SendToModule "#General" "#UnLoadCreature=Jazz"
		SendToModule "#General" "#UnLoadCreature=DroneDefault_a"
		SendToModule "#General" "#UnLoadCreature=DroneForklift_a"
		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar"
		SendToModule "#General" "#PlayerType=Barricade,Scorponok,Blackout,Megatron,Barricade"

		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter1_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter2"
		SendToModule #General #ResetLevel
		IncreasePlayerHealth max
		setstate "PickGoto" ;goto next chapter
	}
}

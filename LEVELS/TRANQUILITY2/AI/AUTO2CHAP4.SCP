ActionMacro ARTILLERYTRANIN
{
	CreateModule "#Creature" "#TripleChanger" "#Boss=#TripleChanger" "#Type=TripleCTurret" "#count=1" "#maxalive=1" "#Spline=A2C4Spawn" "#Script=TC_TURRET" "#SpawnInLos" "#SetEnergyMax=7500"  "#SetEnergyMin=250" "#AddToRadarAlways"  "#ResetHealthDiff" "#BlockDeath" ; "#FollowSpline=TCTURRET_TARGETS"
	
}
ActionMacro ARTILLERYTRANOUT
{
	CreateModule "#Goto" "#A2C4Spawn" "#SpawnSpline=A2C4Spawn" "#Boss=#TripleChanger" "#type=TripleC" "#BlockDeath" "#SetEnergyMax=15000.0" "#InhibitRubble"
	SetMusic "ACTION Mission4_5 QUIET Generic Play Action"
}


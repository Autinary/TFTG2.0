state Chapter4_Escaped
{
	conditions
	{
		if module "AllSpark InArea" == 1.0 goto Chapter4_PreFinishThis
		if module "KeyLocation FailMission" == 1.0 goto Chapter4_FailMission
	}
	actions 
	{
		
		CreateModule "#AreaRange" "#AllSpark" "#Trigger=#AllSpark"  "#AddToRadar" "#Beacon"
		SendToModule "#General" "#SetMessage=HIntD11" "#SetMessageTimer=3.0"
		;SetState Chapter4_Complete
	}
}
state Chapter4_PreFinishThis
{
	conditions
	{
		
		if Timer > 1.0 goto Chapter4_FinishThis
	}
	actions 
	{
		ResetTimer
		DestroyModule "#AllSpark"
		SendToModule "#SplineObj" "#Creature=#Creature" "#MaxAlive=0"
		;SetState Chapter4_Complete
	}
}
state Chapter4_FinishThis
{
	conditions
	{
		;if module "Barricade Dead" == 1.0 and
			;if module "Creature GetCountAlive" == 0.0 and
				;if module "CreatureWaveD GetCountAlive" == 0.0 goto Chapter4_Escaped2
		if Timer > 0.7 goto Chapter4_FinishThis1
	}
	actions 
	{
		ResetTimer
		;SendToModule "#General" "#SetMessage=HIntD12" "#SetMessageTimer=3.0"
		;CreateModule "#Speech" "#HereWeGo5" "#speech=#A3_ch4_obj9" 
		;SendToModule "#HereWeGo5" "#StartOneShot"
		SendToModule "#CreatureWaveD" "#SetEnergy=0.0" "#count=0"
		SendToModule "#CreatureWaveE" "#SetEnergy=0.0" "#count=0"
		SendToModule "#CreatureWaveF" "#SetEnergy=0.0" "#count=0"
		SendToModule "#???" "#SetEnergy=0.0"
		SendToModule "#Barricade" "#SetEnergy=0.1"
		SendToModule "#MegatronArm" "#Freeze=920.0"
		SendToModule "#Creature" "#SetEnergy=0.0"
		SendToModule "#SplineObj" "#Creature=#Creature" "#MaxAlive=0"
		;SetState Chapter4_Complete
	}
}
state Chapter4_FinishThis1
{
	conditions
	{
		if module "Barricade Dead" == 1.0 and
			if module "??? Dead" == 1.0 and
				if module "Creature Energy" <= 0.0 and
					if module "CreatureWaveD Energy" <= 0.0 and
						if module "CreatureWaveF Energy" <= 0.0 goto Chapter4_Escaped2
		if Timer > 2.0 goto Chapter4_FinishThis2
	}
	actions 
	{
		ResetTimer
		;SetMusic "ACTION Mission4_2 QUIET Generic Play Action"
		;SendToModule "#General" "#SetMessage=HIntD12" "#SetMessageTimer=3.0"
		CreateModule "#Speech" "#HereWeGo5" "#speech=#A3_ch4_obj9"
		SendToModule "#HereWeGo5" "#StartOneShot"
		;SetState Chapter4_Complete
	}
}
state Chapter4_FinishThis2
{
	conditions
	{
		if module "Barricade Dead" == 1.0 and
			if module "??? Dead" == 1.0 and
				if module "Creature Energy" <= 0.0 and
					if module "CreatureWaveD Energy" <= 0.0 and
						if module "CreatureWaveF Energy" <= 0.0 goto Chapter4_Escaped2
		if module "KeyLocation FailMission" == 1.0 goto Chapter4_FailMission
		
	}
	actions 
	{
		;SetMusic "ACTION Mission4_1 QUIET Generic Play Action"
		SendToModule "#General" "#SetMessage=HIntD12" "#SetMessageTimer=3.0"
		DestroyModule "#KeyLocation"
		SendToModule "#CreatureWaveD" "#AddToRadar"
		SendToModule "#CreatureWaveE" "#AddToRadar"
		SendToModule "#CreatureWaveF" "#AddToRadar"
		SendToModule "#???" "#AddToRadar"
		SendToModule "#Barricade" "#AddToRadar"
		SendToModule "#Creature" "#AddToRadar"
		
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=A3C4KeyLoc" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#HeadType=#Optimus" 
		
	}
}
state Chapter4_Escaped2
{
	conditions
	{
		if Timer > 5.0 goto Chapter4_Complete
	}
	actions 
	{
		ResetTimer	
		
		;SetState Chapter4_Complete
	}
}



state Chapter4_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter4_Restart
	}
	actions
	{
		DestroyModule "#DelayedSendReminder"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter4_FailMission
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter4_Restart
	}
	actions
	{
		DestroyModule "#DelayedSendReminder"
		SendToModule "#General"  "#EndOfMission"  "#FailMission"
	}
}
state Chapter4_FailMission2
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter4_Midtro
	}
	actions
	{
		DestroyModule "#DelayedSendReminder"
		SendToModule "#General"  "#EndOfMission"  "#FailMission"
		CreateModule "#MegatronArm" "#MegatronArm" "#Spline=MegatronArm" "#String=Smegatron_arm" "#InstantThaw" ; "#Boss=#Megatron" 
	}
}
state Chapter4_Restart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#UnLoadCreature=Barricade"
		SendToModule "#General" "#UnLoadCreature=Brawl"
		SendToModule "#General" "#UnLoadCreature=Megatron" 
		SendToModule "#General" "#UnLoadCreature=DroneDefault"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter4Restart" "#FadeUp"
		SetState "GlobalActionRing"
	}
}
state Chapter4_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter4_CompleteVideo
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT4" "#Spline=COMCAM4" "#SetFocus=CAMFOCUS4"
		SendToModule #General #UnlockBonus=Mission_ThirdMission
		SendToModule "#General" "#CompleteMission" "#LevelCompleteAchievement"
		;CreateModule "#Speech" "#A3C1BlastDoors" "#speech=#A3_ch4_cmplt" "#PlayDelay=1.2" "#AutoDestroy" "#Start"
		SendToModule "#ActionRing" "#SetCompleted=#Chapter4" "#Unlock=#Chapter4"
	}
}
state Chapter4_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter4_CompleteVideoLink
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartOutroVideo=#A3C4Outro1"
	}
}
state Chapter4_CompleteVideoLink
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter4_CompleteVideoFinished
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		;SendToModule "#General" "#StartOutroVideo=#A3C4Outro2"
	}
}
state Chapter4_CompleteVideoFinished
{
	conditions
	{
;		if module "General GetFinishedOutro" == 1.0 goto Chapter4_Leave
	}
	actions
	{
		SendToModule "#General" "#FinishedOutroVideo"
		SendToModule "#General" "#FinishedLevel"
		SetState Chapter4_Leave
	}
}
state Chapter4_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		IncreasePlayerHealth max
		SendToModule "#General" "#SetPlayerDeathPoint=#COMPPOINT4"
		SendToModule "#General" "#UnLoadCreature=Barricade"
		SendToModule "#General" "#UnLoadCreature=Brawl"
		SendToModule "#General" "#UnLoadCreature=Megatron" 
		SendToModule "#General" "#UnLoadCreature=DroneDefault"
		SendToModule #General #ResetAll #AllowPlayerMovement
		SetState PickGoto
	}
}

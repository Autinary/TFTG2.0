		DestroyModule "#ArtilleryTurret"
		CreateModule "#Creature" "#ArtilleryTurret" "#Type=TripleCTurret" "#count=1" "#maxalive=1" "#ForcePlayerAsOpp" "#Spline=Spawn4b" "#Script=Art_Turret" "#SpawnInLos" "#SetEnergyMax=800" "#AddToRadarOff" "#SuppressShield" "#SetPosition=#Art_Turret3" "#Protect" 
		

	}
}


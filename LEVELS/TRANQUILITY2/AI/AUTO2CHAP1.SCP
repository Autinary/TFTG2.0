state Chapter1_Main
{
	conditions
	{
		if timer > 0.2 goto Chapter1_MainDelay
	}
	actions
	{
		ResetTimer
		SetMusic "ACTION Mission1_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter1_DeathFailMission"
		SendToModule "#General" "#PhysObj" "#SetVehicle=#Chapter1Start" "#FadeUp"
		
		CreateModule "#VehicleLevels" "#VehicleLevels" "#ResponseLv=5" "#TrafficLv=2" "#PatrolLv=0" "#RoadBlocks=A2C1RoadBlocks"
				
		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
	    CreateModule "#SpecialObj" "#SpecialObj" "#Placement=A2C1"
	}
}
state Chapter1_MainDelay
{
	actions
	{
		CreateModule "#ProgressPoint" "#ProgressPoint" "#spline=A2C1RacePoints" "#Radius=5.0" "#Allowance=6.5" "#Index=RRRD0D0D0RD0RRRD0RRD0RR"; "#Index=RRRRD99RRRRD99RRRD99RRRRD99"
		SendToModule "#ProgressPoint" "#SuperDamage=8" "#SuperDamage=12" 
		CreateModule "#DriverDrone" "#DriverDrone" "#Spline=A2C1Spawn" "#FollowPlayer" "#type=suv" "#Count=5000" "#MaxAlive=5" "#spacing=-1.0" "#goalrange=3.0" "#SpawnMinRange=15.0" "#CullRange=100.0" 		;CreateModule "#Speech" "#DefeatDrones" "#speech=#A2_ch1_obj1" "#AutoDestroy" "#Start"
		CreateModule "#Timer" "#TimerA" "#time=30"
		
		CreateModule "#Speech" "#A2_ch1_Obj1" "#speech=#A2_ch1_Obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"

		SetState "Chapter1_RaceMain"
	}
}
state Chapter1_RaceMain
{
	conditions
	{
		if module "TimerA FailMission" == 1.0 goto Chapter1_FailMission
		if module "ProgressPoint AnyBeenTriggered" == 1.0 goto Chapter1_PickCamera
		if module "Trigger InArea" == 1.0 goto Chapter1_Shortcut1
		if module "Trigger2 InArea" == 1.0 goto Chapter1_Shortcut2
		if module "ProgressPoint GetCompleteTime" > 1.0 goto Chapter1_Complete
	}
}
state Chapter1_RaceMain2
{
	conditions
	{
		if module "TimerA FailMission" == 1.0 goto Chapter1_FailMission
		if module "ProgressPoint AnyBeenTriggered" == 1.0 goto Chapter1_PickCamera2
		if module "Trigger InArea" == 1.0 goto Chapter1_Shortcut12
		if module "Trigger2 InArea" == 1.0 goto Chapter1_Shortcut22
		if module "ProgressPoint GetCompleteTime" > 1.0 goto Chapter1_Complete
	}
}
state Chapter1_PickCamera
{
	conditions
	{
		if module "Trigger InArea" == 1.0 goto Chapter1_Shortcut1
		if module "Trigger2 InArea" == 1.0 goto Chapter1_Shortcut2

		if module "ProgressPoint IndexBeenTriggered" == 1.0 goto Chapter1_SayDialog2
		if module "ProgressPoint IndexBeenTriggered" == 2.0 goto Chapter1_SetTime40; Chapter1_PlayCamera1
		if module "ProgressPoint IndexBeenTriggered" == 3.0 goto Chapter1_SayDialog3
		if module "ProgressPoint IndexBeenTriggered" == 4.0 goto Chapter1_SetTime20
		if module "ProgressPoint IndexBeenTriggered" == 5.0 goto Chapter1_SetTime201; Chapter1_PlayDestructCameraA
		if module "ProgressPoint IndexBeenTriggered" == 6.0 goto Chapter1_SayDialog4; 
		if module "ProgressPoint IndexBeenTriggered" == 7.0 goto Chapter1_SetTime40; Chapter1_PlayCamera2
		if module "ProgressPoint IndexBeenTriggered" == 8.0 goto Chapter1_SayDialog5
		if module "ProgressPoint IndexBeenTriggered" == 9.0 goto Chapter1_SetTime303
		if module "ProgressPoint IndexBeenTriggered" == 10.0 goto Chapter1_SetTime401; Chapter1_PlayDestructCameraB
		if module "ProgressPoint IndexBeenTriggered" == 11.0 goto Chapter1_SetTime30
		if module "ProgressPoint IndexBeenTriggered" == 12.0 goto Chapter1_SetTime404
		if module "ProgressPoint IndexBeenTriggered" == 13.0 goto Chapter1_SetTime302
		if module "ProgressPoint IndexBeenTriggered" == 14.0 goto Chapter1_SetTime20; Chapter1_PlayDestructCameraC
		if module "ProgressPoint IndexBeenTriggered" == 15.0 goto Chapter1_SetTime304; Chapter1_PlayDestructCameraC
		if module "ProgressPoint IndexBeenTriggered" == 16.0 goto Chapter1_SetTime30; Chapter1_PlayDestructCameraC
		if module "ProgressPoint IndexBeenTriggered" == 17.0 goto Chapter1_Complete
		;if module "ProgressPoint IndexBeenTriggered" == 15.0 goto Chapter1_NoPlay
		;if module "ProgressPoint IndexBeenTriggered" == 16.0 goto Chapter1_NoPlay
		;if module "ProgressPoint IndexBeenTriggered" == 17.0 goto Chapter1_NoPlay
		;if module "ProgressPoint IndexBeenTriggered" == 18.0 goto Chapter1_NoPlay
		;if module "ProgressPoint IndexBeenTriggered" == 19.0 goto Chapter1_NoPlay


		if module "ProgressPoint IndexBeenTriggered" == 19.0 goto Chapter1_Complete

	}
	actions
	{
		DestroyModule "#SplineCamera"
	}
} 
state Chapter1_PickCamera2
{
	conditions
	{
		if module "Trigger InArea" == 1.0 goto Chapter1_Shortcut12
		if module "Trigger2 InArea" == 1.0 goto Chapter1_Shortcut22

		if module "ProgressPoint IndexBeenTriggered" == 1.0 goto Chapter1_SayDialog2
		if module "ProgressPoint IndexBeenTriggered" == 2.0 goto Chapter1_SetTime40; Chapter1_PlayCamera1
		if module "ProgressPoint IndexBeenTriggered" == 3.0 goto Chapter1_SayDialog3
		if module "ProgressPoint IndexBeenTriggered" == 4.0 goto Chapter1_SetTime20
		if module "ProgressPoint IndexBeenTriggered" == 5.0 goto Chapter1_SetTime201; Chapter1_PlayDestructCameraA
		if module "ProgressPoint IndexBeenTriggered" == 6.0 goto Chapter1_SayDialog4; 
		if module "ProgressPoint IndexBeenTriggered" == 7.0 goto Chapter1_SetTime40; Chapter1_PlayCamera2
		if module "ProgressPoint IndexBeenTriggered" == 8.0 goto Chapter1_SayDialog5
		if module "ProgressPoint IndexBeenTriggered" == 9.0 goto Chapter1_SetTime303
		if module "ProgressPoint IndexBeenTriggered" == 10.0 goto Chapter1_SetTime401; Chapter1_PlayDestructCameraB
		if module "ProgressPoint IndexBeenTriggered" == 11.0 goto Chapter1_SetTime305
		if module "ProgressPoint IndexBeenTriggered" == 12.0 goto Chapter1_SetTime404
		if module "ProgressPoint IndexBeenTriggered" == 13.0 goto Chapter1_SetTime302
		if module "ProgressPoint IndexBeenTriggered" == 14.0 goto Chapter1_SetTime20; Chapter1_PlayDestructCameraC
		if module "ProgressPoint IndexBeenTriggered" == 15.0 goto Chapter1_SetTime304; Chapter1_PlayDestructCameraC
		if module "ProgressPoint IndexBeenTriggered" == 16.0 goto Chapter1_SetTime30; Chapter1_PlayDestructCameraC
		if module "ProgressPoint IndexBeenTriggered" == 17.0 goto Chapter1_Complete
		;if module "ProgressPoint IndexBeenTriggered" == 15.0 goto Chapter1_NoPlay
		;if module "ProgressPoint IndexBeenTriggered" == 16.0 goto Chapter1_NoPlay
		;if module "ProgressPoint IndexBeenTriggered" == 17.0 goto Chapter1_NoPlay
		;if module "ProgressPoint IndexBeenTriggered" == 18.0 goto Chapter1_NoPlay
		;if module "ProgressPoint IndexBeenTriggered" == 19.0 goto Chapter1_NoPlay


		if module "ProgressPoint IndexBeenTriggered" == 19.0 goto Chapter1_Complete

	}
	actions
	{
		DestroyModule "#SplineCamera"
	}
} 
state Chapter1_Shortcut1
{
	actions
	{
		IncreasePlayerHealth 6.25
		DestroyModule "Trigger"
		CreateModule "#Speech" "#A2_ch1_Obj6" "#speech=#A2_ch1_Obj9" "#AutoDestroy" "#Start" 
		;CreateModule "#AreaRange" "#Trigger2" "#Trigger=#JazzRace2" "#AddToRadar" "#Radar=#Jazz" "#DontDrawBeacon"
		SendToModule "#General" "#SetMessage=SecCam1" "#SetMessageTimer=3"
		SendToModule "#ProgressPoint" "#ClearAnyBeenTriggered"
		SendToModule "#TimerA" "#Time=40"
		;SetState "Chapter1_RaceMain"
		SetState "Chapter1_PlayCamera1"
	}
}

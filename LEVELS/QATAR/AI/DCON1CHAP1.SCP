	actions
	{
		SendToModule "#General" "#CountInc" "#CountASet=9"
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj7" "#AutoDestroy" 
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=30" "#times=1" 
	

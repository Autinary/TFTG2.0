state HubZoneInit
{
	actions
	{
				
		
		;SendToModule "#General" "#LoadCreature=DroneForklift_a"
		SendToModule "#General" "#BG_LoadCreature=DroneDefault"
		SendToModule "#General" "#BG_LoadCreature=DroneForklift"
		SendToModule "#General" "#CountASet=0" "#CountBSet=10" "#CountCSet0" "#CountDSet=0" "#CountSet=0"
		SendToModule "#General" "#SetMaxOpponents=9" "#SetMaxApproachers=9" "#SetAttackRingSize=20"
		
		CreateModule "#AreaRange" "#HubZoneA" "#Trigger=#HubRangeTrackerA" "#AddToRadarOff"
		CreateModule "#AreaRange" "#HubZoneB" "#Trigger=#HubRangeTrackerB" "#AddToRadarOff"
		CreateModule "#AreaRange" "#HubZoneC" "#Trigger=#HubRangeTrackerC" "#AddToRadarOff"
		CreateModule "#AreaRange" "#HubZoneD" "#Trigger=#HubRangeTrackerD" "#AddToRadarOff"
		;CreateModule "#Goto" "#HubZoneA" "#Spline=A5C2KeyLocCentre" "#SetPosition=#HubRangeTrackerA" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" ; "#Radius=250"
		;CreateModule "#Goto" "#HubZoneB" "#Spline=A5C2KeyLocCentre" "#SetPosition=#HubRangeTrackerB" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" ; "#Radius=170" 
		;CreateModule "#Goto" "#HubZoneC" "#Spline=A5C2KeyLocCentre" "#SetPosition=#HubRangeTrackerC" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" ; "#Radius=170"
		;CreateModule "#Goto" "#HubZoneD" "#Spline=A5C2KeyLocCentre" "#SetPosition=#HubRangeTrackerD" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" ; "#Radius=250"
		
		SetState TrackHubZone


	}

}
state TrackHubZone
{
	conditions
	{

		;;; GlobalActionRing
		if module "SubMissions GetSubMissionAnyBeenTriggered" == 1.0 goto SubMission_Init
		if module "ActionRing AnyBeenTriggered"  == 1.0 goto GlobalStartChapter
		if module "CreatureSwap InArea" == 1.0 goto PrepareSwap	
		if module "AltChapter3 InArea" == 1.0 goto Chapter3Alt_Enter
		

		;;;No Active Zone
		if module "HubZoneA InArea" == 1.0 and        
			if module "HubZoneB InArea" == 0.0 and
				if module "HubZoneC InArea" == 0.0 and 
					if module "HubZoneD InArea" == 0.0 and        
						if module "General GetCountC" == 0.0 goto SetCToZoneA
		if module "HubZoneB InArea" == 1.0 and         
			if module "HubZoneA InArea" == 0.0 and        
				if module "HubZoneC InArea" == 0.0 and 
					if module "HubZoneD InArea" == 0.0 and         
						if module "General GetCountC" == 0.0 goto SetCToZoneB
		if module "HubZoneC InArea" == 1.0 and         
			if module "HubZoneA InArea" == 0.0 and        
				if module "HubZoneB InArea" == 0.0 and 
					if module "HubZoneD InArea" == 0.0 and        
						if module "General GetCountC" == 0.0 goto SetCToZoneC
		if module "HubZoneD InArea" == 1.0 and        
			if module "HubZoneB InArea" == 0.0 and
				if module "HubZoneC InArea" == 0.0 and 
					if module "HubZoneA InArea" == 0.0 and        
						if module "General GetCountC" == 0.0 goto SetCToZoneD


		;;;Zone Entry		
		if module "General GetCountC" == 1.0 and
			if module "General GetCountD" == 0.0 and
				if module "HubZoneA InArea" == 1.0 goto InHubZoneA ;;; Near NotBurgerKing
		if module "General GetCountC" == 2.0 and
			if module "General GetCountD" == 0.0 and
				if module "HubZoneB InArea" == 1.0 goto InHubZoneB ;;; Near BeeCrashSite
		if module "General GetCountC" == 3.0 and
			if module "General GetCountD" == 0.0 and
				if module "HubZoneC InArea" == 1.0 goto InHubZoneC ;;; Near Second D5C4 Fight area
		if module "General GetCountC" == 4.0 and
			if module "General GetCountD" == 0.0 and
				if module "HubZoneD InArea" == 1.0 goto InHubZoneD ;;; Downtown



		;;;Zone Exit
		if module "ZoneDrones Energy" <= 0.0 and
			if module "ZoneDrones2 Energy" <= 0.0 and
				if module "ZoneDrones3 Energy" <= 0.0 and
					if module "ZoneDrones4 Energy" <= 0.0 and
						if module "General GetCountD" == 1.0 goto SetCToNoZone
		if module "HubZoneA InArea" == 0.0 and        
			if module "General GetCountC" == 1.0 and
				if module "ZoneDrones PlayerRange" > 185 and
					if module "ZoneDrones2 PlayerRange" > 185 and
						if module "ZoneDrones3 PlayerRange" > 185 and
							if module "ZoneDrones4 PlayerRange" > 185 goto SetCToNoZone
		if module "HubZoneB InArea" == 0.0 and        
			if module "General GetCountC" == 2.0 and
				if module "ZoneDrones PlayerRange" > 185 and
					if module "ZoneDrones2 PlayerRange" > 185 and
						if module "ZoneDrones3 PlayerRange" > 185 and
							if module "ZoneDrones4 PlayerRange" > 185 goto SetCToNoZone
		if module "HubZoneC InArea" == 0.0 and         
			if module "General GetCountC" == 3.0 and
				if module "ZoneDrones PlayerRange" > 185 and
					if module "ZoneDrones2 PlayerRange" > 185 and
						if module "ZoneDrones3 PlayerRange" > 185 and
							if module "ZoneDrones4 PlayerRange" > 185 goto SetCToNoZone
		if module "HubZoneD InArea" == 0.0 and        
			if module "General GetCountC" == 4.0 and
				if module "ZoneDrones PlayerRange" > 185 and
					if module "ZoneDrones2 PlayerRange" > 185 and
						if module "ZoneDrones3 PlayerRange" > 185 and
							if module "ZoneDrones4 PlayerRange" > 185 goto SetCToNoZone


				 
		
		
		
		
		if module "General GetCount" == 9.0 goto CycleReset2
		if module "General GetCountA" == 9.0 goto CycleReset

		
		if Timer > 0.2 goto CycleCount
		
	}
	actions
	{
		ResetTimer 
	}

}
state SetCToNoZone
{
	actions
	{
		DestroyModule "#ZoneDrones"
		DestroyModule "#ZoneDrones2"
		DestroyModule "#ZoneDrones3"
		DestroyModule "#ZoneDrones4"
		
		DestroyModule "#HubZoneA"
		DestroyModule "#HubZoneB"
		DestroyModule "#HubZoneC"
		DestroyModule "#HubZoneD"
		CreateModule "#AreaRange" "#HubZoneA" "#Trigger=#HubRangeTrackerA" "#AddToRadarOff"
		CreateModule "#AreaRange" "#HubZoneB" "#Trigger=#HubRangeTrackerB" "#AddToRadarOff"
		CreateModule "#AreaRange" "#HubZoneC" "#Trigger=#HubRangeTrackerC" "#AddToRadarOff"
		CreateModule "#AreaRange" "#HubZoneD" "#Trigger=#HubRangeTrackerD" "#AddToRadarOff"
		
		;CreateModule "#Goto" "#HubZoneA" "#Spline=A5C2KeyLocCentre" "#SetPosition=#HubRangeTrackerA" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" ; "#Radius=250"
		;CreateModule "#Goto" "#HubZoneB" "#Spline=A5C2KeyLocCentre" "#SetPosition=#HubRangeTrackerB" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" ; "#Radius=170" 
		;CreateModule "#Goto" "#HubZoneC" "#Spline=A5C2KeyLocCentre" "#SetPosition=#HubRangeTrackerC" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" ; "#Radius=170"
		;CreateModule "#Goto" "#HubZoneD" "#Spline=A5C2KeyLocCentre" "#SetPosition=#HubRangeTrackerD" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" ; "#Radius=250"
		
		SendToModule "#General" "#CountCSet=0" "#CountDSet=0" 
		SetState TrackHubZone

	}
}
state SetCToZoneA
{
	actions
	{
		SendToModule "#General" "#CountCSet=1" "#CountInc"
		DestroyModule "#HubZoneB"
		DestroyModule "#HubZoneC"
		DestroyModule "#HubZoneD"
		SetState TrackHubZone

	}
}
state SetCToZoneB
{
	actions
	{
		SendToModule "#General" "#CountCSet=2" "#CountInc"
		DestroyModule "#HubZoneA"
		DestroyModule "#HubZoneC"
		DestroyModule "#HubZoneD"
		SetState TrackHubZone

	}

state Chapter1_ComServer
{
	conditions
	{
		if module "ComServer FoundRand" == 1.0 goto Chapter1_Complete


		if module "DestructTime FailMission" == 1.0 goto Chapter1_FailMission
		if message "MissionMessage" == 2.0 goto Chapter1_FailMission 
	}
	actions
	{
		
		CreateModule "#BuildingSecret" "#ComServer" "#Spline=DestroyServer" "#FuzzyRange=20" "#MinRand=0.3" "#MaxRand=0.4" ;"#DrawHealthBar"
		Idle 2.5
		DestroyModule "#Destruction"
		CreateModule "#AreaRange" "#Server" "#Trigger=#ServerBuilding" "#Beacon"
		CreateModule "#SplineExplode" "#ComServer2" "#Spline=DSSecrets" "#AddToRadar=#RedMediumDot"
		;CreateModule "#DriverDrone" "#CreatureWaveL" "#spline=DSGuns" "#maxalive=4" "#count=4" "#SpawnInLOSInit" "#type=ShilkaTracer" "#spacing=20.0" "#GoalRange=40.0" "#RapidInitFire" #IgnorePaths #WaitEnd
		
		SendToModule "#General" "#SetMessage=QS2" "#SetMessageTimer=3.0" 
		
		
	}
}
state Chapter1_DestroyComServerEarly
{
	conditions
	{
		if module "ComServer FoundRand" == 1.0 goto Chapter1_FinishDestruction
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter1_Complete

		if module "DestructTime FailMission" == 1.0 goto Chapter1_FailMission
		if message "MissionMessage" == 2.0 goto Chapter1_FailMission 
	}
	actions
	{
		DestroyModule "#AirAttack"
		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 3"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 3"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 3"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		CreateModule "#BuildingSecret" "#ComServer" "#Spline=DestroyServer" "#FuzzyRange=20" "#MinRand=0.3" "#MaxRand=0.4" ;"#DrawHealthBar"
		Idle 2.5
		CreateModule "#AreaRange" "#Server" "#Trigger=#ServerBuilding" "#Beacon"
		CreateModule "#SplineExplode" "#ComServer2" "#Spline=DSSecrets" "#AddToRadar=#RedMediumDot"
		CreateModule "#DriverDrone" "#CreatureWaveL" "#spline=DSGuns" "#maxalive=4" "#count=4" "#FollowPlayer" "#type=ShilkaTracer" "#spacing=20.0" "#GoalRange=40.0" "#RapidInitFire" 
		
		SendToModule "#General" "#SetMessage=QS2" "#SetMessageTimer=3.0" 
		
		SendToModule "#DestructTime" "#AddTime=30.0"
		
	}
}
state Chapter1_FinishDestruction
{
	conditions
	{
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter1_Complete

		if module "CreatureWaveL GetPercentageComplete" == 1.0 goto Chapter1_AllObjectivesComplete
		
		if module "DestructTime FailMission" == 1.0 goto Chapter1_FailMission
		if message "MissionMessage" == 2.0 goto Chapter1_FailMission 
	}
	actions
	{
		
		DestroyModule "#Server"
		DestroyModule "#ComServer"
		DestroyModule "#ComServer2"

		;SendToModule "#General" "#DangerZoneOff"
		SetMusic "ACTION Mission1_1 QUIET Generic Play Action"

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 2"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 2"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 2"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission


		
		SendToModule "#CreatureWaveL" "#Object=#RedSmallDot" "#AddToRadarAlways"
		
		Idle 1.0 
		SendToModule "#General" "#SetMessage=QS5" "#SetMessageTimer=3.0" 
		SendToModule "#DestructTime" "#AddTime=90.0"
		
	}
}
state Chapter1_AllObjectivesComplete
{
	conditions
	{
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter1_Complete

		;if module "DestructTime FailMission" == 1.0 goto Chapter1_FailMission
		if message "MissionMessage" == 2.0 goto Chapter1_FailMission 
	}
	actions
	{
		;SendToModule "#General" "#DangerZoneOff"
		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 1"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		SendToModule "#General" "#SetMessage=QS6" "#SetMessageTimer=3.0" 
		SendToModule "#DestructTime"  "#AddTime=10.0"
		
	}
}
state Chapter1_Chatter
{
	conditions
	{
		
		if module "Timer FailMission" == 1.0 goto Chapter1_Complete
	}
	actions
	{
		DestroyAllModules

		
		;CreateModule "#Timer" "#Timer" "#Time=3.0" "#NoRender" "#Start"
                CreateModule "#Speech" "#PlayDelay=1.3" "#speech=#D1_ch1_cmplt" "#AutoDestroy"
	}
}
state Chapter1_Death_LowResponseLevel
{
	Actions 
	{
		SendToModule "#VehicleLevels" "#ResponseLv=0" "#TrafficLv=1" "#PatrolLv=1" 
		SetState "Chapter1_Restart"
	}
}

state Chapter1_Death_HighResponseLevel
{
	Actions 
	{
		SendToModule "#VehicleLevels" "#ResponseLv=4" "#TrafficLv=5" "#PatrolLv=1" 
		SetState "Chapter1_Restart"
	}
}



state Chapter1_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 and 
		if module "General ChapterProgress" == 0.0 goto Chapter1_Death_LowResponseLevel
		
		if module "General GetFinishedMissionDeathFail" == 1.0 and 
		if module "General ChapterProgress" > 0.0 goto Chapter1_Death_LowResponseLevel
 
	}
	actions
	{
		DestroyModule "#DelayedSendReminder"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}

state Chapter1_FailMission
{
	conditions
	{
		if module "General ChapterProgress" == 0.0 goto Chapter1_LowResponseLevel
		if module "General ChapterProgress" > 0.0 goto Chapter1_HighResponseLevel
	}
	actions
	{
		DestroyModule "#DelayedSendReminder"
		SendToModule "#General"  "#EndOfMission" 
	}

}

state Chapter1_LowResponseLevel
{
	Actions 
	{
		SendToModule "#VehicleLevels" "#ResponseLv=0" "#TrafficLv=1" "#PatrolLv=1" 
		SetState Chapter1_FailMissionPartB
	}
}

state Chapter1_HighResponseLevel
{
	Actions 
	{
		SendToModule "#VehicleLevels" "#ResponseLv=4" "#TrafficLv=5" "#PatrolLv=1" 
		SetState Chapter1_FailMissionPartB
	}
}

state Chapter1_FailMissionPartB
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter1_Restart
	}
	actions
	{
		
		SendToModule "#General" "#FailMission"
	}
}


state Chapter1_Restart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"

		SendToModule "#General" "#UnLoadCreature=DroneForklift"
		SendToModule "#General" "#UnLoadCreature=DroneDefault"
		
		SendToModule "#General" "#PlayerType=Blackout,Blackout,Scorponok,Blackout"
		SendToModule "#General" "#ResetAll" "#SetPlayerAtDeathPoint" "#FadeUp"

		SetState "Exit"
	}
}

state Chapter1_Complete
{
	
	actions
	{       
		DestroyModule "#Destruction"
		DestroyModule "#DestructTime"
		DestroyModule "#DelayedSend"
		DestroyModule "#DelayedSendReminder"
		DestroyModule "#Server"
		DestroyModule "#ComServer"
		DestroyModule "#ComServer2"
		SetMusic "ACTION Mission1_3 QUIET Generic Play Action"
		Idle 0.1
		SetState Chapter1_CompleteStart
		
		
	}
}
state Chapter1_CompleteStart
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter1_CompleteVideo
	}
	actions
	{       
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT1" "#Spline=COMCAM1" "#SetFocus=CAMFOCUS1"
		SendToModule "#General" "#CompleteMission" "#DangerZoneOff"
		SendToModule "#ActionRing" "#SetCompleted=#Chapter1" "#Unlock=#Chapter2"
		
 		CreateModule "#Speech" "#PlayDelay=1.2" "#speech=#D1_ch1_cmplt" "#AutoDestroy" "#Start"
		
		
	}
}
state Chapter1_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_CompleteVideoFinished
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartOutroVideo=#D1C2Outro1" ;#D1C1Outro1"
		;SetState "Chapter1_CompleteVideoFinished"
	}
}
state Chapter1_CompleteVideoFinished
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter1_Leave
	}
	actions
	{

		SendToModule "#General" "#UnLoadCreature=DroneForklift"
		SendToModule "#General" "#UnLoadCreature=DroneDefault"
		SendToModule "#General" "#PlayerType=Blackout,Blackout,Scorponok,Blackout"
		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter1_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter2"
		SendToModule "#General" "#SetPlayerDeathPoint=#COMPPOINT1"
		IncreasePlayerHealth max
		setstate "PickGoto" ;goto next chapter		
	}
}

state Chapter4_FifthPart
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter4_FailMission
		if module "BarricadeCreature Dead" == 1.0 goto Chapter4_CheckDrones
			
	}
	actions
	{
		SetMusic "ACTION Mission4_1 QUIET Generic Play Action"
		DestroyAllModules
		CreateModule "#Creature" "#BarricadeCreature" "#Spline=A5C4BarricadeC" "#count=1" "#maxalive=1" "#addtoradar" "#Boss=#Barricade" "#Type=Barricade" "#SpawnInLosInit" "#BlockDeath" "#Script=Barricade"
		SendToModule "#BarricadeCreature" "#SetEnergyMax=2399.0" "#SetEnergy=2399.0"
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#BarricadeCreature" "#Radius=125" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" 
		;CreateModule "#Speech" "#MissionStartSpeech"  "#PlayDelay=2"  "#speech=#A5_ch4_obj3" "#Start" "#AutoDestroy"
		SendToModule "#General" "#PhysObj" "#FadeUp" "#SetPlayer=#Chapter4StartC" "#BarricadeHelpOn"

		
		SendToModule "#CreatureWaveA" "#SetPosition=#ForkDroneSpawn5"
		SendToModule "#CreatureWaveB" "#SetPosition=#TruckDroneSpawn5"
		SendToModule "#CreatureWaveC" "#SetPosition=#ForkDroneSpawn6"
		SendToModule "#CreatureWaveD" "#SetPosition=#TruckDroneSpawn6"
	}
}
state Chapter4_AltFifthPart
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter4_FailMission
		if module "BarricadeCreature Dead" == 1.0 goto Chapter4_CheckDrones
			
	}
	actions
	{
		SetMusic "ACTION Mission4_1 QUIET Generic Play Action"
		DestroyModule "#Trigger"
		SendToModule "#BarricadeCreature" "#SetEnergyMax=2399.0" "#SetEnergy=2399.0" "#Boss=#Barricade" "#Type=Barricade" "#BlockDeath" "#TransformForceRobot" "#Script=Barricade" "#SuppressShieldOff" "#Stoppable" "#HideTransformMeter" 
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#BarricadeCreature" "#Radius=125" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" 
		
	}
}
state Chapter4_CheckDrones
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and 
				if module "CreatureWaveB GetCountAlive" == 0.0 and
					if module "CreatureWaveC GetCountAlive" == 0.0 and 
						if module "CreatureWaveD GetCountAlive" == 0.0 goto Chapter4_CompleteDelay
		if Timer > 1.0 goto Chapter4_KillDrones
	}
	actions
	{
		ResetTimer
		SendToModule "#BarricadeCreature" "#RemoveBoss"
	}
}
state Chapter4_KillDrones
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and 
				if module "CreatureWaveB GetCountAlive" == 0.0 and
					if module "CreatureWaveC GetCountAlive" == 0.0 and 
						if module "CreatureWaveD GetCountAlive" == 0.0 goto Chapter4_CompleteDelay
		
	}
	actions
	{
		DestroyModule "#KeyLocation"
		SendToModule "#General" "#SetMessage=FinishThem" "#SetMessageTimer=3"
		
	}
}
state Chapter4_MainAlt
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter4_FailMission
		if module "BarricadeCreature IsEnergyAtMin" == 1.0 goto Chapter4_SecondPartIntroPC
		
	}
	actions
	{
		SetMusic "ACTION Mission4_2 QUIET Generic Play Action"
		SetDeathPoint "Chapter4_DeathFailMission"
		CreateModule "#Creature" "#BarricadeCreature" "#Spline=A5C4BarricadeA" "#count=1" "#maxalive=1" "#addtoradar" "#Boss=#Barricade" "#Type=Barricade" "#SpawnInLosInit" "#Script=Barricade" "#SetPosition=#BarricadeSpawn1"
		SendToModule "#BarricadeCreature" "#SetEnergyMax=1199.0" "#SetEnergy=1199.0" "#SetEnergyMin=2.0"
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#BarricadeCreature" "#Radius=125" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key14Return" "#HeadType=#Ironhide"
		CreateModule "#Speech" "#MissionStartSpeech"  "#PlayDelay=2"  "#speech=#A5_ch4_obj1" "#Start" "#AutoDestroy" "#GermanWiiAudioFudge"
		CreateModule "#SplineExplode" "#RadarSplinePoint" "#Spline=A5C4SamA" "#MilesPerHour=60" "#AddToRadar" "#Start" ; "#moduletag=#healthmeter" "#param=#stopped"

		

		SendToModule "#General" "#ResetLevel" "#SetPlayer=#Chapter4Start" "#FadeUp" "#PlayerType=BumbleBee07" 

		
		SendToModule "#General" "#TrafficLv = 4"                        ; lock traffic level (1-5) (0=OFF)
		SendToModule "#General" "#PatrolLv = 0"                         ; patrol level (1=ON, 0=OFF)

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 2"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 2"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 4"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission

		
	}
}

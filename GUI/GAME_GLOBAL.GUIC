Display 640,480
Path "gui"
Language ENGLISH "gui/strings_bio.csv" LABEL ENGLISH
Language AMERICAN "gui/strings_bio.csv" LABEL AMERICAN
Language FRENCH "gui/strings_bio.csv" LABEL FRENCH
Language GERMAN "gui/strings_bio.csv" LABEL GERMAN
Language SPANISH "gui/strings_bio.csv" LABEL SPANISH
Language ITALIAN "gui/strings_bio.csv" LABEL ITALIAN
Language DANISH "gui/strings_bio.csv" LABEL DANISH
Language RUSSIAN "gui/strings_bio.csv" LABEL RUSSIAN
Language POLISH "gui/strings_bio.csv" LABEL POLISH
Allocate window 20
Allocate button 20
Allocate action 65
Allocate query 60
Allocate done
PakFile 0 "gui/game_global_#SKU_#LAN.fpk" 1
Begin Font
Name default
File "gui/fonts/newTransformerFont"
End
Begin Image
Name TransLogoGfx
File "gui/gfx/transformersBanner"
Alpha 1
End
Begin Image
Name ScrollyHeadGfx
File "gui/gfx/transformerIcon"
Alpha 1
End

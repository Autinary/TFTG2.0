state Chapter1_Enter
{
	Conditions
	{
		if timer > 1.0 goto Chapter1_Main
	}
	actions
	{
		ResetTimer
		DestroyAllModules
		SendToModule "#General" "#StartMissionWithNoHub"
	}
}


state Chapter1_Heal
{
	actions
	{
		DoMacro AutoHeal
	}
}
state Chapter1_Main
{
	conditions
	{
		if Timer > 2.2 goto Chapter1_MainDelay
	}
	actions
	{
		DestroyAllModules 
		ResetTimer
		SetDeathPoint "Chapter1_DeathFailMission"
		CreateModule "#Speech" "#A7_ch1_obj1" "#speech=#A7_ch1_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		SendToModule "#General" "#SetMessage=A7_ch1_obj1" "#SetMessageTimer=3" 
	}
}
state Chapter1_MainDelay
{
	conditions
	{
		;if module "A7C1Counter Complete" == 1.0 goto Chapter1_Phase2
		if module "Boss GetPercentageComplete" == 1.0 and
			if module "CreatureWaveA GetPercentageComplete" == 1.0 and
				if module "CreatureWaveB GetPercentageComplete" == 1.0 and
					if module "CreatureWaveC GetPercentageComplete" == 1.0 goto Chapter1_PhaseComplete

		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal1
	}
	actions
	{
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=12" "#IconType=#Drone"
		CreateModule "#Creature" "#CreatureWaveA" "#Spline=A7C1SpawnA" "#Type=DroneDefault"  "#count=7" "#maxalive=2" "#addtoradar" "#SpawnInLos" "#TransformForceRobot" "#Script=Early_Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Spline=A7C1SpawnA" "#Type=DroneArmouredCar"  "#count=2" "#maxalive=2" "#addtoradar" "#SpawnInLos"  "#TransformForceRobot" "#Script=Early_Combat"
		CreateModule "#Creature" "#CreatureWaveC" "#Spline=A7C1SpawnA" "#Type=DroneCement"  "#count=2" "#maxalive=1" "#addtoradar" "#SpawnInLos"  "#TransformForceRobot" "#Script=Early_Combat"
		CreateModule "#Creature" "#Boss"          "#Spline=A7C1SpawnA" "#Type=Barricade" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLos"  "#TransformForceRobot" "#Script=Barricade" "#SetEnergyMax=2399.0" "#SetEnergy=2399.0" "#SetPosition=#BossEntrance_T1"
		SendToModule "#CreatureWaveA" "#ForcePlayerAsOpp"
		SendToModule "#CreatureWaveB" "#ForcePlayerAsOpp"
		SendToModule "#CreatureWaveC" "#ForcePlayerAsOpp"
		SendToModule "#Boss" "#ForcePlayerAsOpp"
		SendToModule "#General" "#SetMaxOpponents=18" "#SetMaxApproachers=18" "#SetAttackRingSize=20"
		SendToModule "#General" "#InhibitCreatureDWRespawn"
	}
}
state Chapter1_Heal1
{
	actions
	{
		;DoMacro AutoHeal
		IncreasePlayerHealth 65.0
		SendToModule "#Ratchet" "#Script=Heal" "#SuppressShield"
		SendToModule "#General" "#CountDSet=0"
		Idle 2.8
		SendToModule "#Ratchet" "#AddToRadarOff" "#SuppressShieldOff"
		Idle 7.0
		SendToModule "#Ratchet" "#AddToRadar"	
		SendToModule "#General" "#CountDSet=1"	
		SetState Chapter1_PH1Process
	}
}
state Chapter1_PH1Process
{
	conditions
	{
		;if module "A7C1Counter Complete" == 1.0 goto Chapter1_Phase2
		if module "Boss GetPercentageComplete" == 1.0 and
			if module "CreatureWaveA GetPercentageComplete" == 1.0 and
				if module "CreatureWaveB GetPercentageComplete" == 1.0 and
					if module "CreatureWaveC GetPercentageComplete" == 1.0 goto Chapter1_PhaseComplete

		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal1
	}
	
}
state Chapter1_Phase2Start
{
	conditions
	{
		;if module "A7C1Counter Complete" == 1.0 goto Chapter1_Phase2
		if module "Creature GetPercentageComplete" == 1.0 and
			if module "CreatureWaveA GetPercentageComplete" == 1.0 goto Chapter1_Phase2

		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal2
	}
	actions
	{
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=26" "#IconType=#Drone"
		CreateModule "#Creature" "#CreatureWaveA" "#Spline=A7C1SpawnA" "#Type=DroneDefault"  "#count=2" "#maxalive=2" "#addtoradar" "#SpawnInLos" "#TransformForceRobot"
		CreateModule "#Creature" "#Creature"      "#Spline=A7C1SpawnA" "#Type=DroneForkLift" "#count=2" "#maxalive=2" "#addtoradar" "#SpawnInLos" "#TransformForceRobot"
		SendToModule "#CreatureWaveA" "#ForcePlayerAsOpp"
		
	}
}
state Chapter1_Heal2
{
	actions
	{
		;DoMacro AutoHeal
		IncreasePlayerHealth 65.0
		SendToModule "#Ratchet" "#Script=Heal" "#SuppressShield"
		SendToModule "#General" "#CountDSet=0"
		Idle 2.8
		SendToModule "#Ratchet" "#AddToRadarOff" "#SuppressShieldOff"
		Idle 7.0
		SendToModule "#Ratchet" "#AddToRadar"	
		SendToModule "#General" "#CountDSet=1"	
		SetState Chapter1_PH2ProcessA
	}
}
state Chapter1_PH2ProcessA
{
	conditions
	{
		if module "Creature GetPercentageComplete" == 1.0 and
			if module "CreatureWaveA GetPercentageComplete" == 1.0 goto Chapter1_Phase2


		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal2
	}
	
}
state Chapter1_Phase2
{
	conditions
	{
		if module "Meteorite GetPercentage" == 1.0 and
			if module "CreatureWaveA GetCountAlive" == 0.0 and
				if module "CreatureWaveB GetCountAlive" == 0.0 goto Chapter1_Phase2W3

		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal2B
	}
	actions
	{
		DestroyModule "#Meteorite"
		DestroyModule "#Creature"
		CreateModule "#Creature" "#CreatureWaveC" "#Spline=A7C1SpawnA" "#Type=DroneDefault"  "#count=3" "#maxalive=3" "#addtoradar" "#SpawnInLos" "#TransformForceRobot" 
		
		CreateModule "#Creature" "#CreatureWaveB" "#count=0" "#maxalive=5" "#addtoradaralways" "#Type=DroneForkLift" "#TransformForceRobot" "#KeyLocation=On"
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#CreatureWaveB" "#Spline=MeteorSpawn" "#Time=2" "#Time=3,DronePickupTruck" "#Time=8,DroneArmouredCar" "#Time=9,DroneTowTruck" "#Time=13,DroneCement" 
		SendToModule "#CreatureWaveB" "#ForcePlayerAsOpp"
	}
}
state Chapter1_Heal2B
{
	actions
	{
		;DoMacro AutoHeal
		IncreasePlayerHealth 65.0
		SendToModule "#Ratchet" "#Script=Heal" "#SuppressShield"
		SendToModule "#General" "#CountDSet=0"
		Idle 2.8
		SendToModule "#Ratchet" "#AddToRadarOff" "#SuppressShieldOff"
		Idle 7.0
		SendToModule "#Ratchet" "#AddToRadar"	
		SendToModule "#General" "#CountDSet=1"	
		SetState Chapter1_PH2ProcessB
	}
}
state Chapter1_PH2ProcessB
{
	conditions
	{
		if module "Meteorite GetPercentage" == 1.0 and
			if module "CreatureWaveA GetCountAlive" == 0.0 and
				if module "CreatureWaveB GetCountAlive" == 0.0 goto Chapter1_Phase2W3


		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal2B
	}
	
}
state Chapter1_Phase2W3
{
	conditions	
	{
		

		if module "Boss Complete" == 1.0 goto Chapter1_Shockwave
	}
	actions
	{
		DestroyModule "#CreatureWaveA"
		DestroyModule "#Meteorite"
		SendToModule "#Ratchet" "#AddToRadarOff" 
		CreateModule "#Creature" "#CreatureWaveA" "#count=0" "#maxalive=7" "#addtoradaralways" "#Type=DroneForkLift" "#TransformForceRobot" "#KeyLocation=On"
		CreateModule "#Goto" "#Boss"          "#SpawnSpline=A7C1SpawnA" "#DirectSpline=COMCAM1" "#Type=TripleC" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsVehicle" "#SetEnergyMax=7500.0" "#SetEnergy=7500.0" "#SetPosition=#BossEntrance_A1" "#Script=FollowSplineTC" "#Speed=150" "#ResetHealthDiff"; "#Script=Cybertron_TC"
		
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#CreatureWaveA" "#Spline=MeteorSpawn" "#Time=1" "#Time=2,DronePickupTruck" "#Time=7,DroneDefault" "#Time=9,DronePickupTruck" "#Time=4,DroneTowTruck" "#Time=16,DroneArmouredCar" "#Time=17,DroneArmouredCar"
		SendToModule "#CreatureWaveA" "#ForcePlayerAsOpp"
		SendToModule "#General" "#CountBSet=0" "#CountCSet=0"
	}
}
state Chapter1_Shockwave
{
	conditions
	{
		if module "Meteorite GetPercentage" == 1.0 and
			if module "CreatureWaveA GetCountAlive" == 0.0 and
				if module "CreatureWaveB GetCountAlive" == 0.0 and
					if module "CreatureWaveC GetCountAlive" == 0.0 and
						if module "Boss GetCountAlive" == 0.0 and
							if module "General GetCountC" == 1.0 goto Chapter1_PhaseComplete

		if module "Boss Energy" < 0.75 and
			if module "General GetCountB" == 0.0 goto Chapter1_ShockwaveFallBack
		if module "Boss Energy" < 0.50 and
			if module "General GetCountB" == 1.0 goto Chapter1_ShockwaveFallBack
		if module "Boss Energy" < 0.25 and
			if module "General GetCountB" == 2.0 goto Chapter1_ShockwaveFallBack

		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal2C1
	}
	actions
	{
		ResetTimer
		SendToModule "#Ratchet" "#AddToRadar" "#CountDSet=1"
		
		SendToModule "#Boss" "#Script=Shockwave" "#ForcePlayerAsOpp" 
	}
}
state Chapter1_Heal2C1
{
	actions
	{
		;DoMacro AutoHeal
		IncreasePlayerHealth 65.0
		SendToModule "#Ratchet" "#Script=Heal" "#SuppressShield"
		SendToModule "#General" "#CountDSet=0"
		Idle 2.8
		SendToModule "#Ratchet" "#AddToRadarOff" "#SuppressShieldOff"
		Idle 7.0
		SendToModule "#Ratchet" "#AddToRadar"	
		SendToModule "#General" "#CountDSet=1"	
		SetState Chapter1_PH2ProcessC
	}
}
state Chapter1_PH2ProcessC
{
	conditions
	{
		if module "Meteorite GetPercentage" == 1.0 and
			if module "CreatureWaveA GetCountAlive" == 0.0 and
				if module "CreatureWaveB GetCountAlive" == 0.0 and
					if module "CreatureWaveC GetCountAlive" == 0.0 and
						if module "Boss GetCountAlive" == 0.0 and
							if module "General GetCountC" == 1.0 goto Chapter1_PhaseComplete

		if module "Boss Energy" < 0.75 and
			if module "General GetCountB" == 0.0 goto Chapter1_ShockwaveFallBack
		if module "Boss Energy" < 0.50 and
			if module "General GetCountB" == 1.0 goto Chapter1_ShockwaveFallBack
		if module "Boss Energy" < 0.25 and
			if module "General GetCountB" == 2.0 goto Chapter1_ShockwaveFallBack



		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal2C1
	}
	
}
state Chapter1_ShockwaveFallBack
{
	conditions	
	{
		
		if module "Boss PlayerRange" > 100 goto Chapter1_ShockwaveGoto
	}
	actions
	{
		
		SendToModule "#Boss" "#Script=FlyOff_M" "#Unstoppable"
		 
		SendToModule "#Ratchet" "#AddToRadarOff" 
		


	}
	
}
state Chapter1_ShockwaveGoto
{
	conditions	
	{
		

		if module "Boss Complete" == 1.0 goto Chapter1_ShockwaveTransform
		
	}
	actions
	{
		
		 
		SendToModule "#Boss" "#Script=FollowSplineTC" "#TransformForceCar" "#DirectSpline=COMCAM1" "#Speed=150" 
		SendToModule "#General" "#CountBInc"


	}
	
}
state Chapter1_ShockwaveTransform
{
	Conditions
	{
		if module "General FadeDown" == 1.0 goto Chapter1_TripleChangerArtillerySetHealthLevel
	}
	actions
	{
		SendToModule "#General" "#FadeDown" 
		SendToModule "#Boss" "#Script=Shockwave" "#TransformForceRobot" 
		
		;Idle 1.5
		


	}
	
}
state Chapter1_TripleChangerArtillerySetHealthLevel
{
	conditions
	{
		if module "General GetCountB" == 1.0 goto TripleCArtHealth75
		if module "General GetCountB" == 2.0 goto TripleCArtHealth50
		if module "General GetCountB" == 3.0 goto TripleCArtHealth25
		
	}
	
}

state TripleCArtHealth75
{
	conditions
	{
		
	}
	actions
	{
		
		DestroyModule "#Boss"
		CreateModule "#Creature" "#TripleChanger" "#Type=TripleCTurret" "#count=1" "#maxalive=1" "#Spline=MeteorSpawn" "#Script=TC_TURRETC" "#SpawnInLosInit" "#SetEnergyMax=7500"  "#SetEnergyMin=5625" "#AddToRadarAlways"  "#ResetHealthDiff" "#BlockDeath" ; "#FollowSpline=TCTURRET_TARGETS"
		SendToModule "#TripleChanger" "#SetEnergy=5625" "#SetPosition=#TripleCPoint" 
		SetState Chapter1_TripleChangerArtilleryPosition
		
		
	}
}


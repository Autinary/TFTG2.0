state FinishedLevel
{
	conditions
	{
	}
	actions
	{
		
		SetState GlobalActionRing
	}
}
state GlobalActionRing
{
	conditions
	{
		if module "SubMissions GetSubMissionAnyBeenTriggered" == 1.0 goto SubMission_Init
		if module "ActionRing AnyBeenTriggered"  == 1.0 goto GlobalStartChapter
		if module "General ChapterProgress" >= 3.0 goto Onslaught_AreYouSure?
	}
	actions
	{
		SendToModule "#General" "#StartHUB"
		SendToModule "#ActionRing" "#ClearAnyBeenTriggered"
		SendToModule "#ActionRing" "#ClearAllChaptersTriggered"
		SendToModule "#ActionRing" "#AllowCreatures"
		SendToModule "#ActionRing" "#TurnOn"
		SendToModule "#SubMissions" "#TurnOn"
	}
}
state Onslaught_AreYouSure?
{
	conditions
	{
		if Timer > 0.1 goto Onslaught 
		if module "General ChapterProgress" >= 4.0 goto GlobalActionRing3
	}
	actions
	{
		ResetTimer
	}
}
state Onslaught
{
	conditions
	{
		if module "SubMissions GetSubMissionAnyBeenTriggered" == 1.0 goto SubMission_Init
		if module "ActionRing AnyBeenTriggered"  == 1.0 goto GlobalStartChapter
	}
	actions
	{
		SetMusic "ACTION Mission2_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter4_HubDeath"
		
		SendToModule "#General" "#SetMaxOpponents=29" "#SetMaxApproachers=29" "#SetAttackRingSize=20"
		SendToModule "#General" "#BG_LoadCreature=DroneDefault"
		SendToModule "#General" "#BG_LoadCreature=DroneCement"
		CreateModule "#Creature" "#Drones" "#Type=DroneDefault" "#Spline=A3C1SS7Drone3" "#count=1000" "#maxalive=3" "#addtoradaroff" "#SpawnInLosInit" "#SpawnAsCreature" "#rangemax=200" "#rangemin=150" "#Script=AdvDefault"
		CreateModule "#Creature" "#Drones0" "#Type=DroneDefault" "#Spline=A3C1SS7Drone3" "#count=1000" "#maxalive=2" "#addtoradaroff" "#SpawnInLosInit" "#SpawnAsCreature" "#rangemax=200" "#rangemin=150" "#Script=AdvDefault"
		CreateModule "#Creature" "#Drones1" "#Type=DroneCement" "#Spline=A3C1SS7Drone3" "#count=1000" "#maxalive=2" "#addtoradaroff" "#SpawnInLosInit" "#SpawnAsCreature" "#rangemax=200" "#rangemin=150" "#Script=CAgile"
		CreateModule "#Creature" "#Drones2" "#Type=DroneDefault" "#Spline=Spawn4b" "#count=4000" "#maxalive=4" "#addtoradaroff" "#SpawnInLosInit" "#SpawnAsCreature" "#rangemax=200" "#rangemin=150" "#Script=AdvDefault"
		CreateModule "#Creature" "#Drones3" "#spline=Route3a" "#maxalive=2" "#count=1000" "#type=DroneDefault" "#SpawnInLOSInit" "#addtoradaroff" "#rangemax=200" "#rangemin=150" "#Script=AdvDefault"
		CreateModule "#Creature" "#Drones4" "#spline=Route3b" "#maxalive=2" "#count=1000" "#type=DroneDefault" "#SpawnInLOSInit" "#addtoradaroff" "#rangemax=200" "#rangemin=150" "#Script=AdvDefault"
		CreateModule "#Creature" "#Drones5" "#spline=Route3c" "#maxalive=2" "#count=1000" "#type=DroneDefault" "#SpawnInLOSInit" "#addtoradaroff" "#rangemax=200" "#rangemin=150" "#Script=AdvDefault"
		CreateModule "#Creature" "#Drones6" "#spline=Route3d" "#maxalive=2" "#count=1000" "#type=DroneDefault" "#SpawnInLOSInit" "#addtoradaroff" "#rangemax=200" "#rangemin=150" "#Script=AdvDefault"
		
		
	}
}

state GlobalActionRing2
{
	conditions
	{
		if module "SubMissions GetSubMissionAnyBeenTriggered" == 1.0 goto SubMission_Init
		if module "ActionRing AnyBeenTriggered"  == 1.0 goto GlobalStartChapter
	}
	actions
	{
		SendToModule "#General" "#StartHUB"
		SendToModule "#ActionRing" "#ClearAnyBeenTriggered"
		SendToModule "#ActionRing" "#ClearAllChaptersTriggered"
		SendToModule "#ActionRing" "#AllowCreatures"
		SendToModule "#ActionRing" "#TurnOn"
		SendToModule "#SubMissions" "#TurnOn"
		SetMusic "ACTION Mission1_1 QUIET Generic Play Action"
	}
}
state GlobalActionRing3
{
	conditions
	{
		if module "SubMissions GetSubMissionAnyBeenTriggered" == 1.0 goto SubMission_Init
		if module "ActionRing AnyBeenTriggered"  == 1.0 goto GlobalStartChapter
		if module "SubRace InArea" == 1.0 goto SubMissionEX_Init
		
	}
	actions
	{
		CreateModule "#AreaRange" "#SubRace" "#Trigger=#ExtraRace" "#AddToRadar" "#ParticleRing" 
		
	}
}
state GlobalStartChapter
{
	conditions
	{
		if module "ActionRing Chapter1"  == 1.0 goto Chapter1_Enter
		if module "ActionRing Chapter2"  == 1.0 goto Chapter2_Enter
		if module "ActionRing Chapter3"  == 1.0 goto Chapter3_Enter
		if module "ActionRing Chapter4"  == 1.0 goto Chapter4_Enter
	}
	actions
	{
		SendToModule "#General" "#BG_UnLoadCreature=DroneDefault"
		SendToModule "#General" "#BG_UnLoadCreature=DroneCement"
		SendToModule "#General" "#StartChapter"
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#TurnOff"
		SendToModule "#SubMissions" "#TurnOff"
	}
}
state SubMission_Init
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission_Start
	}
	actions
	{
		SendToModule "#General" "#BG_UnLoadCreature=DroneDefault"
		SendToModule "#General" "#BG_UnLoadCreature=DroneCement"
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#FadeDown"
	}
}
State SubMission_StartTest
{
	actions
	{
		SendToModule "#General" "#FadeUp" "#AllowPlayerMovement"
		SetState "SubMission_Start"
	}
}
state SubMission_Start
{
	conditions
	{
		if module "SubMissions GetSubMissionTriggered" == 1.0 goto SubMission1_Enter
		if module "SubMissions GetSubMissionTriggered" == 2.0 goto SubMission2_Enter
		if module "SubMissions GetSubMissionTriggered" == 3.0 goto SubMission3_Enter
		if module "SubMissions GetSubMissionTriggered" == 4.0 goto SubMission4_Enter
	}
	actions
	{
		SendToModule "#General" "#StartSubMission"
		SendToModule "#ActionRing" "#TurnOff"
	}
}
state SkipLevel
{
	conditions
	{
		if message "MissionMessage" == 1.0 goto Chapter1_InitGoto 
		if message "MissionMessage" == 2.0 goto Chapter2_InitGoto
		if message "MissionMessage" == 3.0 goto Chapter3_InitGoto
		if message "MissionMessage" == 4.0 goto Chapter4_InitGoto
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Start"
		SendToModule "#General" "#FadeDown"
	}
}
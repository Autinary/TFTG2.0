state Adv_Tutorial
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto Adv_Tutorial1
	}
	actions
	{
		SendToModule "#General" "#FadeDown"
		SendToModule "#ActionRing" "#TurnOff"
		SendToModule "#SubMissions" "#TurnOff"
		;DestroyAllModules "#IncludeProtected"
		

		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 0"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 0"            ; lowest the response can reach
    		SendToModule "#General" "#ResponseLv_ClampMax   = 0"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming
	}



}

state Adv_Tutorial1
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto LeaveAdv_Tutorial3
		;if module "Dummy1 GetCountAlive" == 0.0 and
		;	if module "Dummy2 GetCountAlive" == 0.0 and
		;		if module "Dummy3 GetCountAlive" == 0.0 goto Adv_Tutorial2
	
		;if Timer > 1.0 and
		;	if module "General FadeDown" == 1.0 goto Adv_Tutorial2
	}
	actions
	{
		ResetTimer
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		
		SendToModule "#General" "#LoadCreature=DronePickupTruck_a"
		DestroyAllModules "#IncludeProtected"
		;CreateModule "#Creature" "#Dummy" "#Type=DroneDefault" "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#SubMission4" "#Count=1" "#MaxAlive=1" "#Script=StandAndWait" "#AddToRadarOff" "#SetEnergyMax=300" "#SetEnergy=300"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=KeyLoc4" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key17Return" "#Protect" "#TimeOut=5"
		SendToModule "#General "#SetPlayer=#PlayerTutorial"
		SendToModule "#General" "#FadeUp"
		SendToModule "#General" "#CountBSet=1"

		SendToModule "#General" "#SetMessage=ADVCOMT1" "#SetMessageTimer=7"

		Idle 9.0
		SendToModule "#General" "#SetMessage=ADVCOMT6" "#SetMessageTimer=7"

		Idle 9.0
		SendToModule "#General" "#SetMessage=ADVCOMT6a" "#SetMessageTimer=7"
		Idle 9.0
		SendToModule "#General" "#SetMessageTimer=-1"
		;Idle 1.0
		;SendToModule "#General" "#SetMessage=ADVCOMT4" "#SetMessageTimer=7"
		;Idle 9.0
		;SendToModule "#General" "#SetMessage=ADVCOMT4a" "#SetMessageTimer=7" ;(Insert Midtro after this)
		;Idle 9.0 
		;SendToModule "#General" "#SetMessage=ADVCOMT5" "#SetMessageTimer=7" ;(Insert Midtro after this)
		;Idle 9.0
		;SendToModule "#General" "#SetMessage=ADVCOMT5a" "#SetMessageTimer=7"
		;Idle 9.0
		;SendToModule "#General" "#FadeDown"
		SetState Adv_TutorialMidtro

	}



}
state Adv_TutorialMidtro
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Adv_Tutorial2
	}
	actions
	{
		SendToModule "#General" "#SetMessageTimer=-1"
		SendToModule "#General" "#StartVideo=#A1Tutorial"
	}
}
state Adv_Tutorial2
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto LeaveAdv_Tutorial3
		if module "Dummy1 GetCountAlive" == 0.0 and
			if module "Dummy2 GetCountAlive" == 0.0 and
				if module "Dummy3 GetCountAlive" == 0.0 goto Adv_Tutorial3
	

	}
	actions
	{
		DestroyAllModules

		SendToModule "#General "#SetPlayer=#PlayerTutorial"
		;SendToModule "#General" "#CountASet=1"

		SendToModule "#General "#SetPlayer=#PlayerTutorial"
		
		SendToModule "#General" "#FadeUp"
		CreateModule "#Creature" "#Dummy1" "#Type=DroneRedVeryWeak"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy1" "#Count=1" "#MaxAlive=1" "#Script=Early_Combat" "#AddToRadarOff" "#SuppressShield" "#KeyLocation=On"
		CreateModule "#Creature" "#Dummy2" "#Type=DroneRedVeryWeak"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy2" "#Count=1" "#MaxAlive=1" "#Script=Early_Combat" "#AddToRadarOff" "#SuppressShield" "#KeyLocation=On"
		CreateModule "#Creature" "#Dummy3" "#Type=DroneRedVeryWeak"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy3" "#Count=1" "#MaxAlive=1" "#Script=Early_Combat" "#AddToRadarOff" "#SuppressShield" "#KeyLocation=On"
		Idle 0.1 
		;SendToModule "#Dummy1" "#Script=StandAndWait"
		;SendToModule "#Dummy2" "#Script=StandAndWait"
		;SendToModule "#Dummy3" "#Script=StandAndWait"


		SendToModule "#General" "#SetMessage=ADVCOMT14" "#SetMessageTimer=3"
		

		;CreateModule "#Creature" "#Dummy1" "#Type=DroneRedWeak"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy1" "#Count=1" "#MaxAlive=1" "#Script=Combat" "#AddToRadarOff" "#SuppressShield"
		;CreateModule "#Creature" "#Dummy2" "#Type=DroneRedWeak"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy2" "#Count=1" "#MaxAlive=1" "#Script=Combat" "#AddToRadarOff" "#SuppressShield"
		;CreateModule "#Creature" "#Dummy3" "#Type=DroneRedWeak"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy3" "#Count=1" "#MaxAlive=1" "#Script=Combat" "#AddToRadarOff" "#SuppressShield"
		;Idle 0.1 
		;SendToModule "#Dummy1" "#Script=StandAndWait"
		;SendToModule "#Dummy2" "#Script=StandAndWait"
		;SendToModule "#Dummy3" "#Script=StandAndWait"

		

	}



}

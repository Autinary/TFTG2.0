;scavenger hunt, find all the nodes within the time limit

;requires:
;Scavenger spline		Scavenger#	;maximum 80 points
;KeyLocation spline		KeyLoc#

;Changeable params:
;	300		time in which to complete the mission
;	15			keylocation timeout
;	75		distance in which points are added to radar (75)

state SubMission2_Enter
{
	actions
	{
		DestroyModule "#CreatureFreeRoamA"
		DestroyModule "#CreatureFreeRoamB"
		DestroyModule "#CreatureFreeRoamC"
		DestroyModule "#CreatureFreeRoamD"
		SendToModule "#ActionRing" "#RemoveCreatures"
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission2_Death"
;		SendToModule "#General" "#PlayerType=Brawl"
		SendToModule "#General" "#ResetAll"
		SendToModule "#General" "#UnLoadCreature=DroneDefault_a"
		SetState "SubMission2_Init"
	}
}

state SubMission2_Enter0
{
	actions
	{
		DestroyModule "#CreatureFreeRoamA"
		DestroyModule "#CreatureFreeRoamB"
		DestroyModule "#CreatureFreeRoamC"
		DestroyModule "#CreatureFreeRoamD"
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission2_Death"
		SendToModule "#General" "#PlayerType=Blackout" "#CountASet=0"
		SendToModule "#General" "#ResetAll"
		SendToModule "#ActionRing" "#RemoveCreatures"
		SendToModule "#General" "#UnLoadCreature=DroneDefault_a"
		SetState "SubMission2_Init"
	}
}
state SubMission2_Enter2
{
	conditions
	{
		
		if timer > 0.1 goto SubMission2_Enter3
		if module "General ChapterProgress" >= 3.0 goto SubMission2_Enter5
	}
	actions
	{
		ResetTimer
	}
}

state SubMission2_Enter3
{
	
	actions
	{
		SendToModule "#General" "#UnLoadCreature=Jazz"
		SendToModule "#General" "#UnLoadCreature=IronHide"
		SendToModule "#General" "#LoadCreature=BumbleBee"
		SetState "SubMission2_Main3"
	}
}
state SubMission2_Enter4
{
	
	actions
	{
		SendToModule "#General" "#UnLoadCreature=BumbleBee"
		SendToModule "#General" "#LoadCreature=Jazz"
		SetState "SubMission2_Main4"
	}
}
state SubMission2_Enter5
{
	conditions
	{
		if timer > 0.1 goto SubMission2_Main
		if module "General ChapterProgress" >= 4.0 goto SubMission2_Enter4
	}
	actions
	{
		SendToModule "#General" "#UnLoadCreature=Jazz"
		SendToModule "#General" "#LoadCreature=BumbleBee"
		ResetTimer
	}
}
state SubMission2_Init
{
	conditions
	{
		if timer > 0.1 goto SubMission2_Main2
		if module "General ChapterProgress" >= 2.0 goto SubMission2_Enter2
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#SetPlayer=#SubMission2" "#ResetLevel"
		CreateModule "#Timer" "#Timer" "#Time=150"
		SendToModule "#General" "#LoadCreature=Jazz"
		SendToModule "#General" "#LoadCreature=IronHide"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=KeyLoc2" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#TimeOut=15" 
		CreateModule "#RaceNodes" "#RaceNodes" "#Spline=Scavenger2" "#MultiNode" "#RadarRange=75"
		CreateModule "#DroneCounter" "#DroneCounter" "#ModuleTag=#RaceNodes" "#GetPercentageComplete" "#IgnoreDroneKills" "#DronesToDefeat=10" "#BackwardsCount"
		SendToModule "#RaceNodes" "#SetupDroneCounter=#DroneCounter"
	}
}

state SubMission2_Main4
{
	conditions
	{
		if module "RaceNodes getpercentagecomplete" == 1.0 goto SubMission2_Finish1
		if module "KeyLocation FailMission" == 1.0 goto SubMission2_Fail1
		if module "Timer FailMission" == 1.0 goto SubMission2_Fail1
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission2_1 PLAY ACTION"
		CreateModule "#AttackWave" "#IronHide"
		SendToModule "#IronHide" "#CreateWave=#Wave1"
		SendToModule "#IronHide" "#Creature=IronHide"		"#Spline=D2C1WaveA" "#SplineStep=10" "#KeyLocation=On"
		CreateModule "#Creature" "#Jazz" "#Type=Jazz" "#Spline=D2C4SpawnC" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#FollowPlayer" "#BlockDeath"
		;CreateModule "#Creature" "#IronHide" "#Type=IronHide" "#Spline=D2C1WaveA" "#SplineStep=6" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#FollowPlayer"
		;SendToModule "#Jazz" "#SetEnergyMax=9000.0" "#SetEnergy=9000.0"
		SendToModule "#General" "#FadeUp"
		
	}
}
state SubMission2_Main
{
	conditions
	{
		if module "RaceNodes getpercentagecomplete" == 1.0 goto SubMission2_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission2_Fail
		if module "Timer FailMission" == 1.0 goto SubMission2_Fail
		if module "DesperateBee FailMission" == 1.0 goto SubMission2_Main5
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission2_1 PLAY ACTION"
		DestroyAllModules
		SendToModule "#General" "#SetPlayer=#COMPPOINT1" 
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=KeyLoc7" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#TimeOut=15" 
		CreateModule "#Timer" "#Timer" "#Time=180"
		CreateModule "#RaceNodes" "#RaceNodes" "#Spline=Nodes7" "#MultiNode" "#RadarRange=75"
		CreateModule "#DroneCounter" "#DroneCounter" "#ModuleTag=#RaceNodes" "#GetPercentageComplete" "#IgnoreDroneKills" "#DronesToDefeat=10" "#BackwardsCount"
		SendToModule "#RaceNodes" "#SetupDroneCounter=#DroneCounter"
		CreateModule "#AttackWave" "#IronHide"
		SendToModule "#IronHide" "#CreateWave=#Wave1"
		SendToModule "#IronHide" "#Creature=IronHide"		"#Spline=D2C1WaveC" "#SplineStep=6" "#KeyLocation=On"
		CreateModule "#Creature" "#BumbleBee" "#Type=BumbleBee" "#Spline=Spawn4b" "#count=10" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsVehicle" "#FollowPlayer" "#BlockDeath" "#Script=Advanced"
		CreateModule "#Timer" "#DesperateBee" "#Time=90" "#NoRender"
		SendToModule "#General" "#FadeUp"
		
	}
}
state SubMission2_Main2
{
	conditions
	{
		if module "RaceNodes getpercentagecomplete" == 1.0 goto SubMission2_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission2_Fail
		if module "Timer FailMission" == 1.0 goto SubMission2_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#FadeUp"
		
	}
}
state SubMission2_Main3
{
	conditions
	{
		if module "RaceNodes getpercentagecomplete" == 1.0 goto SubMission2_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission2_Fail
		if module "Timer FailMission" == 1.0 goto SubMission2_Fail
		if module "DesperateBee FailMission" == 1.0 goto SubMission2_Main5
		
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission3_1 PLAY ACTION"
		DestroyAllModules
		SendToModule "#General" "#SetPlayer=#COMPPOINT2" "#ResetLevel"
		CreateModule "#Timer" "#Timer" "#Time=300"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=KeyLoc3" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#TimeOut=15" 
		CreateModule "#RaceNodes" "#RaceNodes" "#Spline=Nodes3" "#MultiNode" "#RadarRange=75"
		CreateModule "#DroneCounter" "#DroneCounter" "#ModuleTag=#RaceNodes" "#GetPercentageComplete" "#IgnoreDroneKills" "#DronesToDefeat=10" "#BackwardsCount"
		SendToModule "#RaceNodes" "#SetupDroneCounter=#DroneCounter"
		CreateModule "#AttackWave" "#BumbleBee"
		SendToModule "#BumbleBee" "#CreateWave=#Wave1"
		SendToModule "#BumbleBee" "#Creature=BumbleBee"		"#Spline=D2C1WaveA" "#SplineStep=10" "#KeyLocation=On" "#BlockDeath" "#Script=Advanced" "#SpawnAsVehicle" "#FollowPlayer" "#addtoradar"
		CreateModule "#Timer" "#DesperateBee" "#Time=90" "#NoRender"
		SendToModule "#General" "#FadeUp"

		
	}
}
state SubMission2_Main5
{
	conditions
	{
		if module "RaceNodes getpercentagecomplete" == 1.0 goto SubMission2_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission2_Fail
		if module "Timer FailMission" == 1.0 goto SubMission2_Fail
		
	}
	actions
	{
		SendToModule "#BumbleBee" "#Script=Combat"
		
		
	}
}

state SubMission2_Finish
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission2_FinishWait
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission2_FinishWait
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission2_Leave
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=2"
		;SetState "SubMission2_Leave"
	}
}
state SubMission2_Finish1
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission2_FinishWait1
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission2_FinishWait1
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission2_Leave1
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=2"
		;SetState "SubMission2_Leave"
	}
}
state SubMission2_FinishTC
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission2_FinishWaitTC
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission2_FinishWaitTC
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission2_LeaveTC
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=2"
		;SetState "SubMission2_Leave"
	}
}
state SubMission2_Death
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMission2_Leave
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state SubMission2_Fail
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission2_Leave
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state SubMission2_Fail1
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission2_Leave1
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state SubMission2_FailTC
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission2_LeaveTC
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state SubMission2_Leave
{
	conditions
	{
		if module "General ChapterProgress" >= 4.0 goto GlobalActionRing
	}
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		;
		SendToModule "#General" "#UnLoadCreature=Jazz"
		SendToModule "#General" "#UnLoadCreature=IronHide"
		SendToModule "#General" "#UnLoadCreature=BumbleBee"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission2" 
		Idle 0.2
		SendToModule "#General" "#PlayerType=Barricade,Barricade,Barricade,Barricade,Barricade"
		
		SendToModule "#General" "#FadeUp"		
		SetState "GlobalActionRing"
	}
}
state SubMission2_Leave1
{
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		;
		SendToModule "#General" "#UnLoadCreature=Jazz"
		SendToModule "#General" "#UnLoadCreature=IronHide"
		SendToModule "#General" "#UnLoadCreature=BumbleBee"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission2" "#FadeUp"
		SendToModule "#General" "#FadeUp"		
		SetState "GlobalActionRing"
	}
}
state SubMission2_LeaveTC
{
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#UnLoadCreature=Jazz"
		SendToModule "#General" "#UnLoadCreature=IronHide"
		SendToModule "#General" "#UnLoadCreature=BumbleBee"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission2" "#FadeUp"
		SendToModule "#General" "#FadeUp"		
		SetState "GlobalActionRing"
	}
}



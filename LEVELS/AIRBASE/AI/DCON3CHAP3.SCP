;used to be mission 3

state Chapter3_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" "#FadeUp"
		SetState "Chapter3_Goto"
	}
}
state Chapter3_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter3_HubRestart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter3_InitGoto
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#SetRadarInterference=0"
		SetState "Chapter3_Goto"
	}
}
state Chapter3_Goto
{
	actions
	{
		SendToModule "#General" "#AllowPlayerMovement"
		DestroyModule "#MissionStartSpeech"
		
		Idle 2.0
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D3_ch3_Goto" "#Start"
		SendToModule "#General" "#SetMessage=Frenzy5" "#SetMessageTimer=5"
		Idle 3.0
		
		CreateModule "#AndSwitch" "#AndSwitchReminder" "#moduletag=#DelayedSendReminder" "#placement=#Chapter3Beacon" "#rangeoutside=75"
		SetState "GlobalActionRing"
	}
}
state Chapter3_Enter
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter3_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter3_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro"
	}
}
state Chapter3_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter3_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter3_Main
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"

``
		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 3"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
		SendToModule "#General" "#PlayerType=StarScream" "#ResetLevelCharacters"
		SendToModule "#General" "#LoadCreature=BoneCrusher" 
		SendToModule "#General" "#LoadCreature=TripleC" 
		
		
	}
}

state Chapter3_Main
{
	actions
	{
		SetMusic "ACTION Mission2_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter2_DeathFailMission"
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D3_ch3_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		CreateModule "#Speech" "#Chatter1" "#speech=#D3_ch3_obj6" "#AutoDestroy"
		CreateModule "#Speech" "#Chatter2" "#speech=#D3_ch3_obj7" "#AutoDestroy"
		CreateModule "#Speech" "#Chatter3" "#speech=#D3_ch3_obj5" "#AutoDestroy"
		SendToModule "#General" "#SetMessage=Frenzy6" "#SetMessageTimer=3"
		SendToModule "#General" "#PhysObj" "#SetPlayer=#Chapter3Start" "#FadeUp" "#CountCSet=0"

		;; Create a health meter for BoneCrusher and set it to deteriorate
		CreateModule "#Timer" "#BoneCrusherHealth" "#HeadType=#BoneCrusher" "#Time=45.0" "#DrawHealthBar" "#Protect" "#Random" "#StartLoseHealth" ;"#CREATURERECOIL=#BoneCrusher" ; DON'T PUT RECOIL BACK IN UNLESS YOU FIX THE FACT THAT HE WILL MOVE BACKWARDS ALSO!
		CreateModule "#Goto" "#BoneCrusher" "#Script=D3Follow" "#SpawnSpline=D3C2Bone_Spawn" "#Object=#RedMediumDot" "#type=BoneCrusher" "#SplineStep=0" "#Speed=50" "#Health=#BoneCrusherHealth" "#Unstoppable" "#SuppressShield" "#Friend" ; "#Invulnerable" 
		
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#BoneCrusher" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key7Return" "#HeadType=#Megatron" "#Radius=140.0"

        CreateModule "#AAGun" "#AAGunLaser"
		SendToModule "#AAGunLaser" "#Breakable" "#Type=AAGUNTYPE_LASER" "#Placement=AAGun_D3C31L" "#Range=100.0" "#Delay=0.0" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"

        CreateModule "#AAGun" "#AAGunRockets"
		SendToModule "#AAGunRockets" "#Breakable" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAGun_D3C31R" "#Range=100.0" "#Delay=0.7" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"

		CreateModule "#VehicleLevels" "#VehicleLevels" "#ResponseLv=4" "#TrafficLv=1" "#PatrolLv=1" "#RoadBlocks=D3C2ROADBLOCKS"

		SetState "Chapter3_Stage1"
	}
}
;state Chapter3_IntoStage1 
;{
;	conditions 
;	{
;		if module "AAGunLaser GetPercentageComplete" == 1.0 and
;			if module "AAGunRockets GetPercentageComplete" == 1.0 goto Chapter3_IntoStage2		
;		if module "BoneCrusher Complete" == 1.0 goto Chapter3_Stage1
;		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission
;		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
;	}
;}
state Chapter3_Stage1 
{
	conditions {
		if module "AAGunLaser GetPercentageComplete" == 1.0 and
			if module "AAGunRockets GetPercentageComplete" == 1.0 goto Chapter3_IntoStage2
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission

		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions 
	{
		SendToModule "#BoneCrusherHealth" "#Time=90.0"
		SendToModule "#BoneCrusher" "#TransformForceRobot"
	}
}
state Chapter3_IntoStage2 
{
	conditions 
	{
		if module "BoneCrusher Complete" == 1.0 goto Chapter3_Stage2
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		if module "AAGunLaser GetPercentageComplete" == 1.0 and
			if module "AAGunRockets GetPercentageComplete" == 1.0 goto Chapter3_AADestroyedEarly1
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		SendToModule "#BoneCrusher" "#TransformForceCar"
		
		SendToModule #BoneCrusherHealth #NoDraw

		SendToModule "#BoneCrusherHealth" "#Time=45.0" "#Stop"


		SendToModule "#BoneCrusher" "#DirectSpline=D3C2BONECRUSHER1"
		SendToModule "#BoneCrusher" "#Object=#GreenMediumDot"
	
		DestroyModule "#AAGunLaser"
		DestroyModule "#AAGunRockets"

		CreateModule "#Creature" "#ArtilleryTurret1" "#Type=TripleCTurret" "#count=1" "#maxalive=1" "#ForcePlayerAsOpp" "#Spline=Spawn4b" "#Script=Art_Turret" "#SpawnInLos" "#SetEnergyMax=800" "#AddToRadarOff" "#SuppressShield" "#SetPosition=#Art_Turret31"
	

       	CreateModule "#AAGun" "#AAGunLaser"
		SendToModule "#AAGunLaser" "#Breakable" "#Type=AAGUNTYPE_LASER" "#Placement=AAGun_D3C32L" "#Range=100.0" "#Delay=0.0" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"

       	CreateModule "#AAGun" "#AAGunRockets"
		SendToModule "#AAGunRockets" "#Breakable" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAGun_D3C32M" "#Range=100.0" "#Delay=0.7" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"
	}
}
state Chapter3_AADestroyedEarly1
{
	conditions
	{
		if module "BoneCrusher Complete" == 1.0 goto Chapter3_IntoStage3
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		SendToModule "#ArtilleryTurret1" "#SetEnergy=0.0"
		SendToModule "#Chatter1" "#StartOneShot" 
		Idle 3.0 
		DestroyModule "#ArtilleryTurret1"
	}
} 
state Chapter3_AADestroyedEarly2
{
	conditions
	{
		if module "BoneCrusher Complete" == 1.0 goto Chapter3_IntoStage4
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		SendToModule "#ArtilleryTurret2" "#SetEnergy=0.0"
		
		SendToModule "#Chatter2" "#StartOneShot" 
		Idle 3.0
		DestroyModule "#ArtilleryTurret2"
	}
} 
state Chapter3_AADestroyedEarly3
{
	conditions
	{
		if module "BoneCrusher Complete" == 1.0 goto Chapter3_IntoComplete
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		;SendToModule "#ArtilleryTurret" "#SetEnergy=0.0"
		
		;SendToModule "#Chatter3" "#StartOneShot" 

		SetState Chapter3_IntoComplete
	}
} 
state Chapter3_Stage2 
{
	conditions 
{
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission
		if module "AAGunLaser GetPercentageComplete" == 1.0 and
			if module "AAGunRockets GetPercentageComplete" == 1.0 goto Chapter3_IntoStage3
			
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		SendToModule "#BoneCrusherHealth" "#Time=90.0"
		SendToModule "#BoneCrusher" "#TransformForceRobot"	
		SendToModule "#BoneCrusherHealth" "#StartLoseHealth" "#Draw"
		SendToModule "#BoneCrusher" "#Object=#RedMediumDot"
	}
}
state Chapter3_IntoStage3 
{
	conditions 
	{
		if module "BoneCrusher Complete" == 1.0 goto Chapter3_Stage3
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission 
		if module "AAGunLaser GetPercentageComplete" == 1.0 and
			if module "AAGunRockets GetPercentageComplete" == 1.0 goto Chapter3_AADestroyedEarly2
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{
		SendToModule "#Chatter1" "#StartOneShot" 
		SendToModule "#BoneCrusher" "#TransformForceCar"

		SendToModule #BoneCrusherHealth #NoDraw

		SendToModule "#BoneCrusherHealth" "#Time=45.0" "#Stop"

		SendToModule "#BoneCrusher" "#DirectSpline=D3C2BONECRUSHER2"
		SendToModule "#BoneCrusher" "#Object=#GreenMediumDot"

		DestroyModule "#AAGunLaser"
		DestroyModule "#AAGunRockets"
		
		SendToModule "#ArtilleryTurret1" "#SetEnergy=0.0"
		
		CreateModule "#Creature" "#ArtilleryTurret2" "#Type=TripleCTurret" "#count=1" "#maxalive=1" "#ForcePlayerAsOpp" "#Spline=Spawn4b" "#Script=Art_Turret" "#SpawnInLos" "#SetEnergyMax=800" "#AddToRadarOff" "#SuppressShield" "#SetPosition=#Art_Turret33"
	
       	CreateModule "#AAGun" "#AAGunLaser"
		SendToModule "#AAGunLaser" "#Breakable" "#Type=AAGUNTYPE_LASER" "#Placement=AAGun_D3C33L" "#Range=100.0" "#Delay=0.0" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"

       	CreateModule "#AAGun" "#AAGunRockets"
		SendToModule "#AAGunRockets" "#Breakable" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAGun_D3C33R" "#Range=100.0" "#Delay=0.7" "#Energy=450.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusher" "#IgnorePlayer" "#Create"

		Idle 3.0
		DestroyModule "#ArtilleryTurret1"
	}
}
state Chapter3_Stage3 
{
	conditions 
	{
		if module "BoneCrusherHealth FailMission" == 1.0 goto Chapter3_FailMission
		if module "AAGunLaser GetPercentageComplete" == 1.0 and
			if module "AAGunRockets GetPercentageComplete" == 1.0 goto Chapter3_IntoStage4
			
		if module "Keylocation FailMission" == 1.0 goto Chapter3_FailMission
	}
	actions
	{

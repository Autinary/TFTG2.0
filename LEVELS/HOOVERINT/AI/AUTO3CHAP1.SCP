		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=A3C1SS7Drone1" "#Radius=190" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#InitTimeOut=60"
	
		Idle "frames=3"
		DestroyModule "#DoorA"
		DestroyModule "#DoorB"
		
	}


}

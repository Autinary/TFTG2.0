state Chapter1_PlayDestructCameraB
{
	conditions 
	{
		if module "SplineCamera GetPercentageComplete" == 1.0 goto Chapter1_RaceMainReturn
	}
	Actions
	{
		SendToModule "#ProgressPoint" "#ClearAnyBeenTriggered"

		SendToModule "#General" "#SetPlayer=#A2C1Reset"
		CreateModule "#SplineCamera" "#SplineCamera" "#SetPosition=A2C1DestructCamB" "#SetFocus=A2C1DestructPosB" "#SetTime=4" "#PauseGame=1.0"
	}
}
state Chapter1_PlayDestructCameraC
{
	conditions 
	{
		if module "SplineCamera GetPercentageComplete" == 1.0 goto Chapter1_RaceMain
	}
	Actions
	{
		SendToModule "#ProgressPoint" "#ClearAnyBeenTriggered"
		CreateModule "#SplineCamera" "#SplineCamera" "#SetPosition=A2C1DestructCamC" "#SetFocus=A2C1DestructPosC" "#SetTime=4" "#PauseGame=1.0"

		
	}
}
state Chapter1_RaceMainReturn
{
	
	Actions
	{
		
		SendToModule "#General" "#SetVehicle=#A2C1Reset"

		SetState Chapter1_RaceMain
	}
}




state Chapter1_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter1_FailMission
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter1_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state Chapter1_Restart
{
	actions
	{
		SendToModule "#VehicleLevels" "#RoadBlocks=Off"
		DestroyAllModules "#IncludeProtected"

		
		SendToModule "#General" "#PlayerType=Jazz,Ironhide,OptimusPrime,OptimusPrime,Jazz"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter1Restart" "#FadeUp"
		
		SetState "Chapter1_RestartPolice"
	}
}

state Chapter1_RestartPolice
{
	conditions
	{
		; need to keep the police response high after failing the first mission, if not already completed...
		if module "General ChapterProgress" == 0.0 goto Chapter1_PoliceResponseCheck
		if module "General ChapterProgress" > 0.0 goto GlobalActionRing
	}

}

state Chapter1_PoliceResponseCheck
{
	conditions
	{
		if module "General ChapterProgress" == 0.0 goto Chapter1_PoliceResponseHigh
		if module "General ChapterProgress" > 0.0 goto GlobalActionRing
	}
}

state Chapter1_PoliceResponseHigh
{
	actions
	{
		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
    	SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
		SetState GlobalActionRing2
	}
}

state Chapter1_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter1_CompleteVideo
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT1" "#Spline=COMCAM1" "#SetFocus=CAMFOCUS1"
		DestroyModule "#TimerA"
		SendToModule "#General" "#CompleteMission" 
		SendToModule "#ActionRing" "#SetCompleted=#Chapter1" 
		CreateModule "#Speech" "#DefeatDrones" "#PlayDelay=1.2" "#speech=#A2_ch1_cmplt" "#AutoDestroy" "#Start"
	}
}
state Chapter1_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_CompleteVideoFinished
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartOutroVideo=#A2C1Outro1"
	}
}
state Chapter1_CompleteVideoFinished
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter1_Leave
	}
	actions
	{
		SendToModule "#General" "#PlayerType=Jazz,Ironhide,OptimusPrime,OptimusPrime,Jazz"

		SendToModule "#General" "#FinishedOutroVideo" "#Radar"
	}
}
state Chapter1_Leave
{
	actions
	{
		SendToModule "#VehicleLevels" "#RoadBlocks=Off"
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter2"
		SendToModule "#General" "#SetVehicle=#COMPPOINT1" 
		SetMusic "ACTION Mission2_1 QUIET Generic"
		IncreasePlayerHealth max
		setstate "PickGoto" ;goto next chapter
	}
}

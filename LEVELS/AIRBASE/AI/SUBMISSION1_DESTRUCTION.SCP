;Destroy all buildings and physobjs within the time limit

;requires:
;	Keylocation spline 	KeyLoc#
;	Spawn spline		Spawn#

;Changeable params:
;	300		time in which to complete the mission
;	15		total number of creatures that need to be killed
;	10000	amount of damage required
;	15			keylocation timeout
;	2		total active simultaneously
;	DroneTowTruck_a		type of creature to fight against

state SubMission1_Enter
{
	actions
	{
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission1_Death"
		;SendToModule "#General" "#PlayerType=Brawl"
		SetState "SubMission1_Enter2"
	}
}
state SubMission1_Enter2
{
	conditions
	{
		if timer > 0.2 goto SubMission1_Init
		if module "General ChapterProgress" >= 4.0 goto SubMission1_Init3
		if module "General ChapterProgress" >= 3.0 goto SubMission1_Init2
		if module "General ChapterProgress" >= 1.0 goto SubMission1_Enter3
	}
	actions
	{
		ResetTimer
		;SetState "SubMission1_Init"
	}
}
state SubMission1_Enter3
{
	conditions
	{
		if timer > 0.2 goto SubMission1_Init
		if module "General ChapterProgress" >= 4.0 goto SubMission1_Init3
	}
	actions
	{
		ResetTimer
		;SetState "SubMission1_Init"
	}
}
state SubMission1_Init3
{
	conditions
	{
		if timer > 0.1 goto SubMission1_Main3
		if module "General GetCountC" == 1.0 goto SubMission1_Main4
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission1""
	    	SendToModule "#General" "#LoadCreature=DroneTowTruck_a"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		CreateModule "#Creature" "#Creature" "#Type=DroneTowTruck_a" "#Spline=Spawn1" "#count=15" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Advanced"
		CreateModule "#Creature" "#Creature2" "#Type=DroneDefault_a" "#Spline=Spawn1" "#count=15" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=AdvDefault" 
		;CreateModule "#Creature" "#Creature" "#Type=DroneArmouredCar_a" "#Spline=Spawn1" "#count=15" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=KeyLoc1" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#TimeOut=15" 
		CreateModule "#Timer" "#Timer" "#Time=120"
		;CreateModule "#DroneCounter" "#DroneCounter" "#ModuleTag=#Creature" "#IconType=#Drone"
	}
}
state SubMission1_Main3
{
	conditions
	{
		if module "Destruction GetPercentageComplete" == 1.0 goto SubMission1_Finish
		;if module "creature getpercentagecomplete" == 1.0 goto SubMission1_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission1_Fail
		if module "Timer FailMission" == 1.0 goto SubMission1_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission4_1 Play Action"
		SendToModule "#General" "#FadeUp"		
		CreateModule "#GABIChange" "#Destruction" "#GABIChange=-50000"

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 4"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
	}
}
state SubMission1_Main4
{
	conditions
	{
		if module "Destruction GetPercentageComplete" == 1.0 goto SubMission1_Finish
		;if module "creature getpercentagecomplete" == 1.0 goto SubMission1_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission1_Fail
		if module "Timer FailMission" == 1.0 goto SubMission1_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission4_1 Play Action"
		SendToModule "#General" "#FadeUp"		
		CreateModule "#GABIChange" "#Destruction" "#GABIChange=-25000"
		SendToModule "#Creature2" "#Script=ShotGunner" 
		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 4"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
	}
}
state SubMission1_Init2
{
	conditions
	{
		if timer > 0.1 goto SubMission1_Main2
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#PlayerType=BoneCrusher" "#SetPlayer=#SubMission1"
		
	    	SendToModule "#General" "#LoadCreature=DroneForklift_a"
		CreateModule "#Creature" "#Creature" "#Type=DroneForklift_a" "#Spline=Spawn1" "#count=15" "#maxalive=4" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=ShotGunner" 
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=KeyLoc1" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#TimeOut=15" 
		CreateModule "#Timer" "#Timer" "#Time=120"
		;CreateModule "#DroneCounter" "#DroneCounter" "#ModuleTag=#Creature" "#IconType=#Drone"
	}
}
state SubMission1_Main2
{
	conditions
	{
		if module "Destruction GetPercentageComplete" == 1.0 goto SubMission1_Finish
		;if module "creature getpercentagecomplete" == 1.0 goto SubMission1_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission1_Fail
		if module "Timer FailMission" == 1.0 goto SubMission1_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION Mission4_1 Play Action"
		SendToModule "#General" "#FadeUp"		
		CreateModule "#GABIChange" "#Destruction" "#GABIChange=-20000"
		
		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 4"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
	}
}
state SubMission1_Init
{
	conditions
	{
		if timer > 0.1 goto SubMission1_Main
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission1"
	    	SendToModule "#General" "#LoadCreature=DroneTowTruck_a"
		CreateModule "#Creature" "#Creature" "#Type=DroneTowTruck_a" "#Spline=Spawn1" "#count=15" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Advanced"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=KeyLoc1" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#TimeOut=15" 
		CreateModule "#Timer" "#Timer" "#Time=120"
		;CreateModule "#DroneCounter" "#DroneCounter" "#ModuleTag=#Creature" "#IconType=#Drone"
	}
}
state SubMission1_Main
{
	conditions
	{
		if module "Destruction GetPercentageComplete" == 1.0 goto SubMission1_Finish
		;if module "creature getpercentagecomplete" == 1.0 goto SubMission1_Finish
		if module "KeyLocation FailMission" == 1.0 goto SubMission1_Fail
		if module "Timer FailMission" == 1.0 goto SubMission1_Fail
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#FadeUp"		
		CreateModule "#GABIChange" "#Destruction" "#GABIChange=-105000" ; -60000"

		
		
		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 4"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
	}
}
state SubMission1_Finish
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission1_FinishWait
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission1_FinishWait
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission1_Leave
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=1"
		;SetState "SubMission1_Leave"
	}
}

state SubMission1_Death
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMission1_Leave
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state SubMission1_Fail
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission1_Leave
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state SubMission1_Leave
{	
	conditions
	{
		if module "General ChapterProgress" >= 4.0 goto GlobalActionRing
	}
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission1" "#FadeUp"
	   	SendToModule "#General" "#UnLoadCreature=DroneTowTruck_a"
		SendToModule "#General" "#UnLoadCreature=DroneDefault_a"
		SendToModule "#General" "#UnLoadCreature=DroneForklift_a"
		;SendToModule "#General" "#UnLoadCreature=DroneArmouredCar_a"
		SendToModule "#General" "#FadeUp"
		Idle 0.2	
		SendToModule "#General" "#PlayerType=StarScream" 	
		SetState "GlobalActionRing"
	}
}


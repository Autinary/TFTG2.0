state Chapter3_Main
{

	actions
	{
		SetMusic "ACTION Mission2_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter2_DeathFailMission"

		
		CreateModule "#DriverDrone" "#GotoDroneA" "#spline=D1C2RouteA" "#maxalive=1" "#count=1" "#FollowSpline=D1C2RouteA" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=2500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		CreateModule "#DriverDrone" "#GotoDroneB" "#spline=D1C2RouteB" "#maxalive=1" "#count=1" "#FollowSpline=D1C2RouteB" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=2500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		CreateModule "#DriverDrone" "#GotoDroneC" "#spline=D1C2RouteC" "#maxalive=1" "#count=1" "#FollowSpline=D1C2RouteC" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=2500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		CreateModule "#DriverDrone" "#GotoDroneD" "#spline=D1C2RouteD" "#maxalive=1" "#count=1" "#FollowSpline=D1C2RouteD" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=2500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		CreateModule "#DriverDrone" "#GotoDroneE" "#spline=D1C2RouteE" "#maxalive=1" "#count=1" "#FollowSpline=D1C2RouteE" "#WaitEnd" "#spacing=20.0" "#goalrange=25.0" "#AddToRadarAlways" "#type=CommTruck" "#CanShoot=0" "#object=#RedMediumDot" "#IgnorePaths" "#Energy=2500" #DeathVFX=VFX_EMP "#Critical" #DrawHealthBar #DistanceScale
		
		CreateModule "#DriverDrone" "#CreatureWaveA" "#spline=D1C2ProtectA" "#maxalive=2" "#count=2" "#FollowSpline=D1C2ProtectA" "#spacing=25.0" "#goalrange=25.0" #type=Jeep #IgnorePaths #WaitEnd
		CreateModule "#DriverDrone" "#CreatureWaveB" "#spline=D1C2ProtectB" "#maxalive=2" "#count=2" "#FollowSpline=D1C2ProtectB" "#spacing=25.0" "#goalrange=25.0" #type=Jeep #IgnorePaths #WaitEnd
		CreateModule "#DriverDrone" "#CreatureWaveC" "#spline=D1C2ProtectC" "#maxalive=2" "#count=2" "#FollowSpline=D1C2ProtectC" "#spacing=25.0" "#goalrange=25.0" #type=Jeep #IgnorePaths #WaitEnd
		CreateModule "#DriverDrone" "#CreatureWaveD" "#spline=D1C2ProtectD" "#maxalive=2" "#count=2" "#FollowSpline=D1C2ProtectD" "#spacing=25.0" "#goalrange=25.0" #type=Jeep #IgnorePaths #WaitEnd
		CreateModule "#DriverDrone" "#CreatureWaveE" "#spline=D1C2ProtectE" "#maxalive=2" "#count=2" "#FollowSpline=D1C2ProtectE" "#spacing=25.0" "#goalrange=25.0" #type=Jeep #IgnorePaths #WaitEnd

		

		CreateModule "#AAGun" "#AAGunA" "#Protect"
		SendToModule "#AAGunA" "#Type=AAGUNTYPE_ROCKETS" "#Placement=D1C2AAA" "#Range=100.0" "#Delay=1.0" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"
		CreateModule "#AAGun" "#AAGunB" "#Protect"
		SendToModule "#AAGunB" "#Type=AAGUNTYPE_ROCKETS" "#Placement=D1C2AAB" "#Range=100.0" "#Delay=1.0" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"
		CreateModule "#AAGun" "#AAGunC" "#Protect"
		SendToModule "#AAGunC" "#Type=AAGUNTYPE_ROCKETS" "#Placement=D1C2AAC" "#Range=100.0" "#Delay=1.0" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"
		CreateModule "#AAGun" "#AAGunD" "#Protect"
		SendToModule "#AAGunD" "#Type=AAGUNTYPE_ROCKETS" "#Placement=D1C2AAD" "#Range=100.0" "#Delay=1.0" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"
		CreateModule "#AAGun" "#AAGunE" "#Protect"
		SendToModule "#AAGunE" "#Type=AAGUNTYPE_ROCKETS" "#Placement=D1C2AAE" "#Range=100.0" "#Delay=1.0" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"

		CreateModule "#DroneCounter" "#DroneCounter"  "#DronesToDefeat=5" "#IconType=#CommTower" 
		
		CreateModule "#Timer" "#Timer" "#Time=120.0" "#Start"
 
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D1_ch2_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		SendToModule "#General" "#PhysObj" "#SetPlayer=#Chapter2Start" "#FadeUp"  "#CountBSet=0"		

		SetState Chapter3_Watch
	}
}


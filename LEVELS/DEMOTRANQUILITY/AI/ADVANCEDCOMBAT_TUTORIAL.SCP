state Adv_Tutorial5
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto LeaveAdv_Tutorial3
		
	
		if Timer > 1.0 and
			if module "General FadeDown" == 1.0 goto Adv_Tutorial6
	}
	actions
	{

		ResetTimer
		DestroyAllModules
		SendToModule "#General" "#ResetAll"

		SendToModule "#General" "#SetMessage=ADVCOMT10" "#SetMessageTimer=7"

		Idle 9.0
		SendToModule "#General" "#SetMessage=ADVCOMT11" "#SetMessageTimer=7"

		Idle 9.0
		
		SendToModule "#General" "#FadeDown"

		;CreateModule "#Creature" "#Dummy1" "#Type=DroneRedMedium"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy1" "#Count=1" "#MaxAlive=1" "#Script=Combat" "#AddToRadarOff" "#SuppressShield"
		;CreateModule "#Creature" "#Dummy2" "#Type=DroneRedMedium"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy2" "#Count=1" "#MaxAlive=1" "#Script=Combat" "#AddToRadarOff" "#SuppressShield"
		;CreateModule "#Creature" "#Dummy3" "#Type=DroneRedMedium"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy3" "#Count=1" "#MaxAlive=1" "#Script=Combat" "#AddToRadarOff" "#SuppressShield"
		;Idle 0.1 
		;SendToModule "#Dummy1" "#Script=StandAndWait"
		;SendToModule "#Dummy2" "#Script=StandAndWait"
		;SendToModule "#Dummy3" "#Script=StandAndWait"

		

	}



}
state Adv_Tutorial6
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto LeaveAdv_Tutorial3
		if module "Dummy1 GetCountAlive" == 0.0 and
			if module "Dummy2 GetCountAlive" == 0.0 and
				if module "Dummy3 GetCountAlive" == 0.0 goto Adv_Tutorial7
	
		
	}
	actions
	{

		ResetTimer
		DestroyAllModules
		SendToModule "#General" "#FadeUp" "#ResetAll"

		

		CreateModule "#Creature" "#Dummy1" "#Type=DroneRedMedium"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy1" "#Count=1" "#MaxAlive=1" "#Script=Combat" "#AddToRadarOff" "#SuppressShield"
		CreateModule "#Creature" "#Dummy2" "#Type=DroneRedMedium"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy2" "#Count=1" "#MaxAlive=1" "#Script=Combat" "#AddToRadarOff" "#SuppressShield"
		CreateModule "#Creature" "#Dummy3" "#Type=DroneRedMedium"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy3" "#Count=1" "#MaxAlive=1" "#Script=Combat" "#AddToRadarOff" "#SuppressShield"
		Idle 0.1 
		SendToModule "#Dummy1" "#Script=StandAndWait"
		SendToModule "#Dummy2" "#Script=StandAndWait"
		SendToModule "#Dummy3" "#Script=StandAndWait"

		

	}



}
state Adv_Tutorial7
{
	conditions
	{
		;if module "KeyLocation FailMission" == 1.0 goto LeaveAdv_Tutorial3
		
	
		;if Timer > 1.0 and
		;	if module "General FadeDown" == 1.0 goto Adv_Tutorial6
	}
	actions
	{

		ResetTimer
		DestroyAllModules "#IncludeProtected"

		;SendToModule "#General" "#CountASet=1"

		SendToModule "#General" "#SetMessage=ADVCOMT12" "#SetMessageTimer=7"

		Idle 9.0
		
		;Idle 3.0
		
		
		SetState LeaveAdv_Tutorial
		

	}



}
state LeaveAdv_Tutorial
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto LeaveAdv_Tutorial2
	}
	actions
	{


		SendToModule "#General" "#CountASet=1"

		
		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
    		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming

		SendToModule "#General" "#StartSubMission"
		Idle 0.3
		SendToModule "#General" "#EndOfMission" 

		SendToModule "#General" "#FadeDown"

	}



}
state LeaveAdv_Tutorial2
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto LeaveAdv_Tutorial22
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=5"	
		

	}



}
state LeaveAdv_Tutorial22
{
	
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#UnLoadCreature=DronePickupTruck_a"
		

		SendToModule "#General" "#FadeUp" "#SetPlayer=#PlayerTutorialEnd"



		SendToModule "#General" "#SetMessage=ADVCOMT13" "#SetMessageTimer=3"

		SetState GlobalActionRing

	}



}
state LeaveAdv_Tutorial3
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto LeaveAdv_Tutorial33
		;if module "General GetFinishedMissionFail" == 1.0 goto LeaveAdv_Tutorial4
	}
	actions
	{


		SendToModule "#General" "#SetMessageTimer=-1"

		
		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
    		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming

		SendToModule "#General" "#StartSubMission" 
		Idle 0.3
		SendToModule "#General" "#EndOfMission" 

		SendToModule "#General" "#FadeDown"

	}



}
state LeaveAdv_Tutorial33
{
	conditions
	{
		;if module "General GetFinishedMissionFail" == 1.0 goto LeaveAdv_Tutorial4
		if module "General GetSubMissionComplete" == 1.0 goto LeaveAdv_Tutorial4
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=5"	
		;SendToModule "#General" "#FadeDown"

	}



}
state LeaveAdv_Tutorial4
{
	
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#UnLoadCreature=DronePickupTruck_a"
		

		SendToModule "#General" "#FadeUp" "#SetPlayer=#PlayerTutorialEnd"


		
		
		SetState GlobalActionRing

	}



}
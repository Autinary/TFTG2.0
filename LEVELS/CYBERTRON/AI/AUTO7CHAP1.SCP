{
	conditions
	{
		
	}
	actions
	{
		
		DestroyModule "#Boss"
		CreateModule "#Creature" "#TripleChanger" "#Type=TripleCTurret" "#count=1" "#maxalive=1" "#Spline=MeteorSpawn" "#Script=TC_TURRETC" "#SpawnInLosInit" "#SetEnergyMax=7500"  "#SetEnergyMin=3750" "#AddToRadarAlways"  "#ResetHealthDiff" "#BlockDeath" ; "#FollowSpline=TCTURRET_TARGETS"
		SendToModule "#TripleChanger" "#SetEnergy=3750" "#SetPosition=#TripleCPoint" 
		SetState Chapter1_TripleChangerArtilleryPosition
		
		
	}
}

state TripleCArtHealth25
{
	conditions
	{
		
	}
	actions
	{
		
		DestroyModule "#Boss"
		CreateModule "#Creature" "#TripleChanger" "#Type=TripleCTurret" "#count=1" "#maxalive=1" "#Spline=MeteorSpawn" "#Script=TC_TURRETC" "#SpawnInLosInit" "#SetEnergyMax=7500"  "#SetEnergyMin=1875" "#AddToRadarAlways"  "#ResetHealthDiff" "#BlockDeath" ; "#FollowSpline=TCTURRET_TARGETS"
		SendToModule "#TripleChanger" "#SetEnergy=1875" "#SetPosition=#TripleCPoint" 
		SendToModule "#General" "#CountCSet=1" 
		SetState Chapter1_TripleChangerArtilleryPosition
		
		
	}
}
state Chapter1_TripleChangerArtilleryPosition
{
	conditions
	{
		;if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter1_FailMission		
		;if module "Ratchet Dead" == 1.0 goto Chapter1_FailMission

		if Timer > 10 goto Chapter1_TripleChangerRobotPrep
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#FadeUp"
	}
}

state Chapter1_TripleChangerRobotPrep
{
	conditions
	{
		
		if module "General GetCountB" == 1.0 goto TripleCRobHealth75
		if module "General GetCountB" == 2.0 goto TripleCRobHealth50
		if module "General GetCountB" == 3.0 goto TripleCRobHealth25
		
	}
	
}

state TripleCRobHealth75
{
	conditions
	{
		
	}
	actions
	{
		
		DestroyModule "#TripleChanger"
		CreateModule "#Goto" "#Boss" "#SpawnSpline=MeteorSpawn" "#type=TripleC" "#SetEnergyMax=7500.0" 
		SendToModule "#Boss" "#SetEnergy=5625" "#SetPosition=#TripleCPoint" "#ResetHealthDiff"
		SetState Chapter1_Shockwave
		
		
	}
}
state TripleCRobHealth50
{
	conditions
	{
		
	}
	actions
	{
		
		DestroyModule "#TripleChanger"
		CreateModule "#Goto" "#Boss" "#SpawnSpline=MeteorSpawn" "#type=TripleC" "#SetEnergyMax=7500.0" 
		SendToModule "#Boss" "#SetEnergy=3750" "#SetPosition=#TripleCPoint" "#ResetHealthDiff"
		SetState Chapter1_Shockwave
		
		
	}
}

state TripleCRobHealth25
{
	conditions
	{
		
	}
	actions
	{
		
		DestroyModule "#TripleChanger"
		CreateModule "#Goto" "#Boss" "#SpawnSpline=MeteorSpawn" "#type=TripleC" "#SetEnergyMax=7500.0" 
		SendToModule "#Boss" "#SetEnergy=1875" "#SetPosition=#TripleCPoint" "#ResetHealthDiff"
		SetState Chapter1_Shockwave
		
		
	}
}




state Chapter1_Phase3Start
{
	conditions
	{
		;if module "A7C1Counter Complete" == 1.0 goto Chapter1_Phase2
		if module "CreatureWaveB Energy" <= 0.0 and
			if module "CreatureWaveA Energy" <= 0.0 goto Chapter1_Phase3

		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal3
	}
	actions
	{
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=26" "#IconType=#Drone"
		CreateModule "#Creature" "#CreatureWaveA" "#Spline=MeteorSpawn" "#Type=DronePickupTruck"  "#count=9" "#maxalive=4" "#addtoradar" "#TransformForceRobot" "#Script=AdvDefault"
		CreateModule "#Creature" "#CreatureWaveB"      "#Spline=A7C1SpawnA" "#Type=DroneDefault" "#count=9" "#maxalive=2" "#addtoradar" "#SpawnInLos" "#TransformForceRobot" "#Script=AdvDefault"
		SendToModule "#CreatureWaveA" "#ForcePlayerAsOpp"
		
	}
}
state Chapter1_Heal3
{
	actions
	{
		;DoMacro AutoHeal
		IncreasePlayerHealth 65.0
		SendToModule "#Ratchet" "#Script=Heal" "#SuppressShield"
		SendToModule "#General" "#CountDSet=0"
		Idle 2.8
		SendToModule "#Ratchet" "#AddToRadarOff" "#SuppressShieldOff"
		Idle 7.0
		SendToModule "#Ratchet" "#AddToRadar"	
		SendToModule "#General" "#CountDSet=1"	
		SetState Chapter1_PH3ProcessA
	}
}
state Chapter1_PH3ProcessA
{
	conditions
	{
		if module "CreatureWaveB Energy" <= 0.0 and
			if module "CreatureWaveA Energy" <= 0.0 goto Chapter1_Phase3


		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal3
	}
	
}
state Chapter1_Phase3
{
	conditions
	{
		if module "Meteorite GetPercentage" == 1.0 and
			if module "CreatureWaveA GetCountAlive" == 0.0 and
				if module "CreatureWaveB GetCountAlive" == 0.0 and
					if module "CreatureWaveC GetCountAlive" = 0.0 and
						if module "CreatureWaveD GetCountAlive" == 0.0 and
							if module "CreatureWaveE GetCountAlive" = 0.0 and
								if module "Boss GetCountAlive" == 0.0 goto Chapter1_PhaseComplete

		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal3B
	}
	actions
	{
		DestroyModule "#Meteorite"
		CreateModule "#Creature" "#CreatureWaveC" "#count=0" "#maxalive=4" "#addtoradaralways" "#Type=DroneDefault" "#TransformForceRobot" "#KeyLocation=On" "#Script=AdvDefault"
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#CreatureWaveC" "#Spline=MeteorSpawn" "#Time=2" "#Time=6,DronePickupTruck" "#Time=8,DroneForklift" "#Time=13,DronePickupTruck" 
		CreateModule "#Creature" "#CreatureWaveD" "#count=0" "#maxalive=2" "#addtoradaralways" "#Type=DroneTowTruck" "#TransformForceRobot" "#KeyLocation=On" "#Script=Advanced"
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#CreatureWaveD" "#Spline=MeteorSpawn" "#Time=4" "#Time=12" 
		CreateModule "#Creature" "#CreatureWaveE" "#count=0" "#maxalive=1" "#addtoradaralways" "#Type=DroneCement" "#TransformForceRobot" "#KeyLocation=On" "#Script=CAgile"
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#CreatureWaveE" "#Spline=MeteorSpawn"  "#Time=14"
		CreateModule "#Creature" "#Boss"          "#Spline=A7C1SpawnA" "#Type=Brawl" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLos" "#TransformForceRobot" "#Script=Brawl" "#SetEnergyMax=8000" "#SetHealth=8000" "#SetPosition=#BossEntrance_T2"
		
		SendToModule "#CreatureWaveC" "#ForcePlayerAsOpp"
		SendToModule "#CreatureWaveD" "#ForcePlayerAsOpp"
		SendToModule "#CreatureWaveE" "#ForcePlayerAsOpp"
	}
}
state Chapter1_Heal3B
{
	actions
	{
		;DoMacro AutoHeal
		IncreasePlayerHealth 65.0
		SendToModule "#Ratchet" "#Script=Heal" "#SuppressShield"
		SendToModule "#General" "#CountDSet=0"
		Idle 2.8
		SendToModule "#Ratchet" "#AddToRadarOff" "#SuppressShieldOff"
		Idle 7.0
		SendToModule "#Ratchet" "#AddToRadar"	
		SendToModule "#General" "#CountDSet=1"	
		SetState Chapter1_PH3ProcessB
	}
}
state Chapter1_PH3ProcessB
{
	conditions
	{
		if module "Meteorite GetPercentage" == 1.0 and
			if module "CreatureWaveA GetCountAlive" == 0.0 and
				if module "CreatureWaveB GetCountAlive" == 0.0 and
					if module "CreatureWaveC GetCountAlive" = 0.0 and
						if module "CreatureWaveD GetCountAlive" == 0.0 and
							if module "CreatureWaveE GetCountAlive" = 0.0 and
								if module "Boss GetCountAlive" == 0.0 goto Chapter1_PhaseComplete


		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountD" == 1.0 goto Chapter1_Heal3B
	}
	
}
state Chapter1_Phase4Start
{
	conditions
	{
		;if module "A7C1Counter Complete" == 1.0 goto Chapter1_Phase2
		
		if module "Boss2 Complete" == 1.0 goto Chapter1_Starscream
	}
	actions
	{
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=28" "#IconType=#Drone"
		CreateModule "#Creature" "#CreatureWaveA" "#Spline=MeteorSpawn" "#Type=DroneForklift"  "#count=12" "#maxalive=3" "#addtoradar" "#SpawnInLos" "#TransformForceRobot" "#Script=ForkliftDrone" "#SetEnergyMax=800" "#SetEnergy=800"
		CreateModule "#Creature" "#CreatureWaveB" "#Spline=A7C1SpawnA" "#Type=DroneMig"  "#count=2" "#maxalive=1" "#addtoradar" "#SpawnInLos" "#TransformForceRobot" "#Script=Mig29Drone" "#SetEnergyMax=1500" "#SetEnergy=1500"
		CreateModule "#Creature" "#CreatureWaveC" "#Spline=MeteorSpawn" "#Type=DronePickupTruck"  "#count=12" "#maxalive=2" "#addtoradar" "#TransformForceRobot" "#Script=TruckDrone" "#SetEnergyMax=1200" "#SetEnergy=1200"
		;CreateModule "#Creature" "#CreatureWaveD" "#Spline=A7C1SpawnA" "#Type=DroneDefault"  "#count=12" "#maxalive=1" "#addtoradar" "#TransformForceRobot" "#Script=CarDrone" "#SetEnergyMax=1000" "#SetEnergy=1000"
		;CreateModule "#Creature" "#CreatureWaveE" "#Spline=A7C1SpawnA" "#Type=DroneArmouredCar"  "#count=1" "#maxalive=1" "#addtoradar" "#TransformForceRobot" "#Script=Arm_TruckDrone" "#SetEnergyMax=1200" "#SetEnergy=1200"
		CreateModule "#Creature" "#Boss"          "#Spline=A7C1SpawnA" "#Type=Bonecrusher" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLos" "#TransformForceRobot" "#Script=Bonecrusher" "#SetPosition=#BossEntrance_T3"

state Chapter3_PlayerDriveToBrawlCEarly
{
	conditions
	{
		if module "BrawlCreature PlayerRange" <= 60.0 goto Chapter3_PlayerReachedBrawlC
		if module "Timer Timer" < 0.0 goto Chapter3_FailMission
		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		
	}
	actions
	{
		SetMusic "ACTION Mission3_2 QUIET Generic Play Action"
		SendToModule "#Ratchet" "#Script=FollowSplineTC" "#TransformForceCar" "#AddToRadarOff"

		

		SendToModule "#BrawlCreature" "#SetPosition=#BrawlSpawn3" "#Script=TurnToShoot" 
		Idle 1.6 
		CreateModule "#Timer" "#Timer" "#Time=45" "#Start" 
		
		SendToModule "#BrawlCreature" "#AddToRadar" "#SetEnergy=4000" "#SetEnergyMin=-1"

		SendToModule "#General" "#SetMessage=AC2" "#SetMessageTimer=7"
		
		DestroyModule "#KeyLocation"
	}
}
state Chapter3_PlayerDriveToBrawlC
{
	conditions
	{
		if module "BrawlCreature PlayerRange" <= 60.0 goto Chapter3_PlayerReachedBrawlC
		if module "Timer Timer" < 0.0 goto Chapter3_FailMission
		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter3_FailMission
		
	}
	actions
	{
		SetMusic "ACTION Mission3_2 QUIET Generic Play Action"
		SendToModule "#Ratchet" "#Script=FollowSplineTC" "#TransformForceCar" "#AddToRadarOff"
		

		CreateModule "#Timer" "#Timer" "#Time=45" "#Start" 
		SendToModule "#BrawlCreature" "#AddToRadar" "#SetEnergy=4000" "#SetEnergyMin=-1"

		SendToModule "#General" "#SetMessage=AC2" "#SetMessageTimer=7"
		
		DestroyModule "#KeyLocation"
	}
}

state Chapter3_PlayerReachedBrawlC
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter3_FailMission
		;if module "BrawlCreature Complete" == 1.0 goto Chapter3_Complete
		if module "BrawlCreature Dead" == 1.0 goto Chapter3_Complete
	}
	actions
	{
		SetMusic "ACTION Mission3_1 QUIET Generic Play Action"
		SendToModule "#General" "#SetMessageTimer=-1"
		DestroyModule "#Timer"
		DestroyModule "#Ratchet"
		DestroyModule "#KeyLocation"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=A5C3KeyLocC"  "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#HeadType=#Optimus" "#Timeout=30"
		SendToModule "#BrawlCreature" "#Script=Brawl" "#Stoppable"  "#EnableBoss" 
		
	}
}
state Chapter3Alt_Enter
{
	
	actions
	{

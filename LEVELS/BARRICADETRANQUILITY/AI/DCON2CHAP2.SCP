         
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;used to be mission 2 		  ;
;only chapters have been renamed  ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

state Chapter2_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" "#FadeUp"
		SetState "Chapter2_Goto"
	}
}
state Chapter2_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter2_HubRestart
	}
	actions
	{
		SendToModule "#General" "#EndOfMission"  "#DeathFailMission"
	}
}
state Chapter2_InitGoto
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SetState "Chapter2_Goto"
	}
}
state Chapter2_Goto
{
	actions
	{
		SendToModule "#General" "#AllowPlayerMovement"
		DestroyModule "#MissionStartSpeech"
		
		Idle 2.0
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D2_ch2_Goto" "#AutoDestroy" "#Start"	
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D2_ch2_Goto2" "#AutoDestroy" "#Start"

		Idle 3.0

		SendToModule "#ActionRing" "#maxalive=1" "#spline=D2C1WaveA" "#type=DroneDefault_a" "#rangemax=300" "#rangemin=200"
		
		
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=60" "#times=1" 
		CreateModule "#AndSwitch" "#AndSwitchReminder" "#moduletag=#DelayedSendReminder" "#placement=#Chapter3Beacon" "#rangeoutside=75"
		SetState "GlobalActionRing"
	}
}
state Chapter2_Enter
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter2_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter2_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#D2C2Intro"
	}
}
state Chapter2_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter2_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter2_Main
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"
  	  	;SendToModule "#General" "#UNLoadCreature=DroneDefault_a"
    	SendToModule "#General" "#LoadCreature=BumbleBee"
    	SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#PlayerType=Barricade"
	}
}
;;state Chapter2_VideoIntro
;;{
;;	conditions
;;	{
;;		if module "General VideoFinished" == 1.0 goto Chapter2_Main
;;	}
;;	actions
;;	{
;;		DestroyAllModules 
;;		SendToModule "#General" "#EndMissionIntro" "#StartIntroVideo=#D2C2Intro"
;;	}
;;}

state Chapter2_Main
{
	conditions
	{
		if module "D2C2DefeatBumbleBee Complete" == 1.0 goto Chapter2_FailMission 
		if module "D2C2DefeatBumbleBee TransformMeter" == 1.0 goto Chapter2_AIsRobot
	}
	actions
	{
		SetMusic "ACTION Mission2_3 QUIET Generic Play Action"
		SetDeathPoint "Chapter2_DeathFailMission"
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D2_ch2_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		;CreateModule "#Speech" "#Speech" "#GotoReminderSpeech" "#speech=#A2_ch2_obj2" "#AutoDestroy" 
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D2_ch2_obj2" "#AutoDestroy" 
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D2_ch2_obj3" "#AutoDestroy" 
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=25" "#times=2"

		CreateModule "#Goto" "#D2C2DefeatBumbleBee" "#SpawnSpline=D2C2RouteA" "#DirectSpline=D2C2RouteA" "#TransformBothWays=15.0" "#Location=#GreenMediumDot" "#Object=#RedMediumDot" "#Warning=D2C2HurryReachedPolice" "#type=BumbleBee" "#splinestep=0" "#speed=120" "#DontClampRadar" "#SuppressShield" "#InhibitRubble" "#HeadType=#Starscream"
		SendToModule "#D2C2DefeatBumbleBee" "#SetEnergyMin=2.0"
		SendToModule "#General" "#PhysObj" "#SetVehicle=#Chapter2Start" "#FadeUp" "#CountASet=0"
	}
}

state Chapter2_AIsRobot
{
	conditions
	{
		if module "D2C2DefeatBumbleBee Complete" == 1.0 goto Chapter2_FailMission 
		if module "D2C2DefeatBumbleBee IsEnergyAtMin" == 1.0 goto Chapter2_MainBEnter
		;if Timer > 10 goto Chapter2_AIsCar
	}
	Actions
	{
		;ResetTimer 
		SetMusic "ACTION Mission3_1 QUIET Generic Play Action"
		DestroyModule "#DelayedSend"
		DestroyModule "#DelayedSendReminder"

		SendToModule #D2C2DefeatBumbleBee #Boss #Type=BumbleBee #SuppressShieldOff 
	}
}

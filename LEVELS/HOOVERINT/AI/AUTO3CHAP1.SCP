		CreateModule "#Creature" "#DroneScout4" "#Type=DroneCement" "#Spline=A3C1SS7Drone3" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=CAgile"
		SendToModule "Barricade" "#NoHealthBar" "#DirectSpline=A3C2TunnelA" "#Script=FollowSplineCre" "#Unstoppable" "#AddToRadarOff" "#InhibitRubble"


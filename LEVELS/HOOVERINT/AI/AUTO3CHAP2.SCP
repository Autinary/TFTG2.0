state Chapter2_TunnelHub
{
	conditions
	{
		if module "A3C2TunnelA GetPercentageComplete" == 1.0 and
			if module "A3C2TunnelB GetPercentageComplete" == 1.0 and
				if module "A3C2TunnelC GetPercentageComplete" == 1.0 and
					if module "A3C2TunnelD GetPercentageComplete" == 1.0 and
						if module "A3C2TunnelE GetPercentageComplete" == 1.0 and
							if module "A3C2TunnelF GetPercentageComplete" == 1.0 goto Chapter2_Outro
		if module "A3C2TunnelA GetPercentageComplete" == 0.0 and
			if module "FanA GetPercentageComplete" == 1.0 goto Chapter2_FanAStart	
		if module "A3C2TunnelB GetPercentageComplete" == 0.0 and
			if module "FanB GetPercentageComplete" == 1.0 goto Chapter2_FanBStart
		if module "A3C2TunnelC GetPercentageComplete" == 0.0 and
			if module "FanC GetPercentageComplete" == 1.0 goto Chapter2_FanCStart
		if module "A3C2TunnelD GetPercentageComplete" == 0.0 and
			if module "FanD GetPercentageComplete" == 1.0 goto Chapter2_FanDStart
		if module "A3C2TunnelE GetPercentageComplete" == 0.0 and
			if module "FanE GetPercentageComplete" == 1.0 goto Chapter2_FanEStart
		if module "A3C2TunnelF GetPercentageComplete" == 0.0 and
			if module "FanF GetPercentageComplete" == 1.0 goto Chapter2_FanFStart
		if module "Timer Timer" < 0.0 goto Chapter2_FailMission
		if module "A3C2FanA2 InArea" == 1.0 goto Chapter2_TunnelHubSpeech0
		if module "Timer1 FailMission" == 1.0 goto Chapter2_TunnelHubSpeech6
	}
	actions
	{
		SetMusic "ACTION Mission2_1 QUIET Generic Play Action"
		DestroyAllModules
		CreateModule "#Timer" "#Timer1" "#Time=60" "#NoRender"
		SendToModule "#A3C2TunnelA" "#DrawTunnelIcon"
		SendToModule "#A3C2TunnelB" "#DrawTunnelIcon"
		SendToModule "#A3C2TunnelC" "#DrawTunnelIcon"
		SendToModule "#A3C2TunnelD" "#DrawTunnelIcon"
		SendToModule "#A3C2TunnelE" "#DrawTunnelIcon"
		SendToModule "#A3C2TunnelF" "#DrawTunnelIcon"
	}
}
state Chapter2_TunnelHub2
{
	conditions
	{
		if module "A3C2TunnelA GetPercentageComplete" == 1.0 and
			if module "A3C2TunnelB GetPercentageComplete" == 1.0 and
				if module "A3C2TunnelC GetPercentageComplete" == 1.0 and
					if module "A3C2TunnelD GetPercentageComplete" == 1.0 and
						if module "A3C2TunnelE GetPercentageComplete" == 1.0 and
							if module "A3C2TunnelF GetPercentageComplete" == 1.0 goto Chapter2_Outro
		if module "A3C2TunnelA GetPercentageComplete" == 0.0 and
			if module "FanA GetPercentageComplete" == 1.0 goto Chapter2_FanAStart2	
		if module "A3C2TunnelB GetPercentageComplete" == 0.0 and
			if module "FanB GetPercentageComplete" == 1.0 goto Chapter2_FanBStart2
		if module "A3C2TunnelC GetPercentageComplete" == 0.0 and
			if module "FanC GetPercentageComplete" == 1.0 goto Chapter2_FanCStart2
		if module "A3C2TunnelD GetPercentageComplete" == 0.0 and
			if module "FanD GetPercentageComplete" == 1.0 goto Chapter2_FanDStart2
		if module "A3C2TunnelE GetPercentageComplete" == 0.0 and
			if module "FanE GetPercentageComplete" == 1.0 goto Chapter2_FanEStart2
		if module "A3C2TunnelF GetPercentageComplete" == 0.0 and
			if module "FanF GetPercentageComplete" == 1.0 goto Chapter2_FanFStart2
		if module "Timer Timer" < 0.0 goto Chapter2_FailMission
		if module "A3C2FanA2 InArea" == 1.0 goto Chapter2_TunnelHubSpeech0
		if module "Timer1 FailMission" == 1.0 goto Chapter2_TunnelHubSpeech62
	}
	actions
	{
		SetMusic "ACTION Mission2_1 QUIET Generic Play Action"
		DestroyAllModules
		CreateModule "#Timer" "#Timer1" "#Time=60" "#NoRender"
		SendToModule "#A3_ch2_obj5" "#StartOneShot"
		SendToModule "#A3C2TunnelA" "#DrawTunnelIcon"
		SendToModule "#A3C2TunnelB" "#DrawTunnelIcon"
		SendToModule "#A3C2TunnelC" "#DrawTunnelIcon"
		SendToModule "#A3C2TunnelD" "#DrawTunnelIcon"
		SendToModule "#A3C2TunnelE" "#DrawTunnelIcon"
		SendToModule "#A3C2TunnelF" "#DrawTunnelIcon"
	}
}
state Chapter2_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter2_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter2_FailMission
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter2_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission"  "#FailMission"
	}
}

state Chapter2_Restart
{
	conditions
	{
		if timer > 0.2 goto Chapter2_Restart3
		if module "General ChapterProgress" >= 3.0 goto GlobalActionRing
		if module "General ChapterProgress" >= 4.0 goto GlobalActionRing
		
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter2Restart" "#FadeUp"
		;SetState "GlobalActionRing"
	
		ResetTimer
	}
}

state Chapter2_Restart3
{
	conditions
	{
		
	}
	actions
	{
			

		CreateModule "#AAGun" "#AAGun"
		SendToModule "#AAGun" "#Type=AAGUNTYPE_ROCKETS" "#Placement=TurretRocketGlobal" "#Range=100.0" "#Delay=1.5" "#Energy=100.0" "#RespawnDelay=30" "#Ammo=0" "#Create"


		SetState "GlobalActionRing"
	}
}

state Chapter2_Complete
{
	actions
	{
		SetState "Chapter2_CheckForAchievement"
	}
}
state Chapter2_CheckForAchievement
{
	conditions
	{
		if module "General CheckNoBoost" == 1.0 goto Chapter2_DidAchievement
		if AlwaysTrue == 1.0 goto Chapter2_Complete2
	}
}
state Chapter2_DidAchievement
{
	actions
	{
		SendToModule "#General" "#TurboAchievementDone"
		SetState "Chapter2_Complete2"
	}
}
state Chapter2_Complete2
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter2_CompleteVideo
	}
	actions
	{
		SendToModule "#General" "#LevelSpecialOff=2"
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT2" "#Spline=COMCAM2" "#SetFocus=CAMFOCUS2"
		SendToModule "#General" "#CompleteMission" 
		SendToModule "#ActionRing" "#SetCompleted=#Chapter2" "#Unlock=#Chapter3"
		CreateModule "#Speech" "#A3C1BlastDoors" "#speech=#A3_ch2_cmplt" "#PlayDelay=1.2" "#AutoDestroy" "#Start"
		;SetState "Chapter2_CompleteVideo"
	}
}
state Chapter2_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter2_CompleteVideoFinished
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		;SendToModule "#General" "#StartOutroVideo=#A3C2Outro1"
	}
}
state Chapter2_Outro
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter2_PreComplete
	}
	actions
	{
	
		SendToModule "#General" "#StartVideo=#A3C2Outro1"
	}
}
state Chapter2_PreComplete
{
	actions
	{
		Idle 3.0 
		SetState Chapter2_Complete
	}
	
}
state Chapter2_CompleteVideoFinished
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter2_Leave
	}
	actions
	{
		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter2_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter3"
		IncreasePlayerHealth max
		setstate "PickGoto"
	}
}

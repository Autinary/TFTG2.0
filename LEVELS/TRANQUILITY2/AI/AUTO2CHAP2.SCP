state Chapter2_FourthPartFodderDead
{
	conditions
	{
		if module "CreatureWaveE GetPercentageComplete" == 1.0 goto Chapter2_FourthPartKilledTowTruck
			
		if module "KeyLocation FailMission" == 1.0 goto Chapter2_FailMission
		if module "Ratchet PlayerRange" < 30 and 
			if module "General GetCountA" == 1.0 goto Chapter2_Heal3

		if Timer > 10 goto Chapter2_FourthPartFodderDeadA
	}
	actions
	{

		ResetTimer
		SendToModule "#General" "#CountDSet=2"
		
		Idle 10.0 
		SetState Chapter2_FourthPartFodderDeadA
		
	}
}

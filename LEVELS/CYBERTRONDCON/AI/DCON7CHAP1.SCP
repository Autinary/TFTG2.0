state Chapter1_Enter
{
	Conditions
	{
		if timer > 1.0 goto Chapter1_Main
	}
	actions
	{
		ResetTimer
		DestroyAllModules
		SendToModule "#General" "#StartMissionWithNoHub"
	}
}




state Chapter1_Main
{
	conditions
	{
		if Timer > 2.2 goto Chapter1_MainDelay
	}
	actions
	{
		ResetTimer
		SetDeathPoint "Chapter1_DeathFailMission"
		CreateModule "#Speech" "#D7_ch1_obj1" "#speech=#D7_ch1_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" 
	}
}
state Chapter1_MainDelay
{
	
	actions
	{
		SetDeathPoint "Chapter1_DeathFailMission"
		CreateModule "#Creature" "#CreatureWaveA" "#Spline=SpawnLower" "#Type=DroneDefault_a"  "#count=4" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#TransformForceRobot" "#Script=Early_Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Spline=Spawn" "#Type=DroneDefault_a"  "#count=4" "#maxalive=4" "#addtoradar" "#SpawnInLosInit" "#TransformForceRobot" "#Script=Early_Combat"
		CreateModule "#Creature" "#Creature"      "#Spline=SpawnLower" "#Type=DroneForkLift_a" "#count=5" "#maxalive=3" "#addtoradar" "#SpawnInLosInit" "#TransformForceRobot" "#Script=Early_Combat"
		SendToModule "#CreatureWaveA" "#ForcePlayerAsOpp"
		SendToModule "#CreatureWaveB" "#ForcePlayerAsOpp"
		SendToModule "#Creature" "#ForcePlayerAsOpp"
		SendToModule "#General" "#SetMaxOpponents=18" "#SetMaxApproachers=18" "#SetAttackRingSize=20"
		SendToModule "#General" "#InhibitCreatureDWRespawn"
		
		;SendToModule "#General" ;"#CountBSet=1"
		Idle 1.0
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=13" "#IconType=#Drone"
		SendToModule "#General" "#SetMessage=D7_Ch1_Obj1" "#SetMessageTimer=3"
		SetState Chapter1_Process
	}
}

state Chapter1_Phase2
{
	
	actions
	{
		DestroyModule "#Meteorite"
		DestroyModule "#Creature"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=9" "#IconType=#Drone"
		
		CreateModule "#Creature" "#CreatureWaveA" "#count=0" "#maxalive=4" "#addtoradaralways" "#Type=DroneForkLift_a" "#TransformForceRobot" "#KeyLocation=On"
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#CreatureWaveA" "#Spline=MeteorSpawnMid" "#Time=1" "#Time=6,DronePickupTruck_a" "#Time=7,DronePickupTruck_a" "#Time=8,DroneDefault_a"
		SendToModule "#CreatureWaveA" "#ForcePlayerAsOpp"
		SendToModule "#General" ;;"#CountBSet=2"

		SetState Chapter1_Phase2Wave2
	}
}
state Chapter1_Phase2Wave2
{
	
	actions
	{
		CreateModule "#Creature" "#CreatureWaveB" "#count=0" "#maxalive=4" "#addtoradaralways" "#Type=DroneCement_a" "#TransformForceRobot" "#KeyLocation=On"
		CreateModule "#Meteorite" "#Meteorite2" "#ModuleTag=#CreatureWaveB" "#Spline=MeteorSpawnMid" "#Time=2" "#Time=5,DroneDefault_a" "#Time=5,DroneArmouredCar_a" "#Time=9,DroneMig_a"
		CreateModule "#Creature" "#Boss"          "#Spline=Spawn" "#Type=Bumblebee" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit"  "#TransformForceRobot" "#Script=Bumblebee" "#SetPosition=#BossEntrance_T1"
		
		SendToModule "#Boss" "#ForcePlayerAsOpp"

		;CreateModule "#Timer" "#TimerD" "#Time=9.0" "#NoRender" "#Start"
		SendToModule "#CreatureWaveB" "#ForcePlayerAsOpp"
		
		SendToModule "#General" ;"#CountBSet=3"

		SetState Chapter1_Process
	}
}
state Chapter1_Phase3
{
	
	actions
	{
		
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=28" "#IconType=#Drone"
		
		CreateModule "#Creature" "#CreatureWaveE" "#count=0" "#maxalive=5" "#addtoradaralways" "#Type=DroneDefault_a" "#TransformForceRobot" "#KeyLocation=On" "#Script=AdvDefault" 
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#CreatureWaveE" "#Spline=MeteorSpawnUpper" "#Time=1,DroneDefault_a" "#Time=2,DronePickupTruck_a" "#Time=5,DroneDefault_a" "#Time=6,DronePickupTruck_a" "#Time=8,DroneDefault_a" 
		
		CreateModule "#Creature" "#CreatureWaveC" "#Spline=Spawn" "#Type=DroneDefault_a"  "#count=2" "#maxalive=1" "#addtoradar" "#TransformForceRobot" "#Script=AdvDefault" 
		CreateModule "#Creature" "#CreatureWaveD" "#Spline=Spawn" "#Type=DronePickupTruck_a"  "#count=2" "#maxalive=1" "#addtoradar" "#TransformForceRobot" "#Script=AdvDefault" 
		CreateModule "#Creature" "#Boss"          "#Spline=SpawnLower" "#Type=Jazz" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#TransformForceRobot" "#Script=Jazz" "#SetPosition=#BossEntrance_T2"
		CreateModule "#Creature" "#IronHide"          "#Spline=Spawn" "#Type=Ironhide" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Ironhide" "#AntinodeRadius=75.0" "#SetEnergyMax=4500" "#SetEnergy=4500"  "#SetPosition=#BossEntrance_T3" 
		SendToModule "#CreatureWaveE" "#ForcePlayerAsOpp"
		
		SendToModule "#CreatureWaveC" "#ForcePlayerAsOpp"
		SendToModule "#CreatureWaveD" "#ForcePlayerAsOpp"
		SendToModule "#Boss" "#ForcePlayerAsOpp"
		SendToModule "#IronHide" "#ForcePlayerAsOpp"
		Idle 0.1
		SendToModule "#IronHide" "#IronhideToCharge"
		;Idle 8.0
		CreateModule "#Timer" "#TimerA" "#Time=8.0" "#NoRender" "#Start"
		

		SendToModule "#General" "#CountSet=0" "#CountDSet=2"

		SetState Chapter1_Process
		
	}
}
state Chapter1_IronCombat
{
	conditions
	{
		if AlwaysTrue < 0.5 goto Chapter1_IronStatic
		if Timer > 0.1 goto Chapter1_IronCharge
		
	}
	actions
	{
		ResetTimer
	}
}
state Chapter1_IronCharge
{
	actions
	{
		DestroyModule "#TimerI"
		SendToModule "#IronHide" "#IronHideToCharge" 
		SendToModule "#General" "#CountSet=1"
		
		SetState Chapter1_Process
	}
}
state Chapter1_IronStatic
{
	actions
	{
		DestroyModule "#TimerI"
		
		CreateModule "#Timer" "#TimerI" "#Time=15" "#NoRender" "#Start"
		SendToModule "#General" "#CountSet=2"
		SetState Chapter1_Process
	}
}
state Chapter1_IronHideDead
{
	actions
	{
		SendToModule "#General" "#CountSet=4"
		SetState Chapter1_Process
	}
}
state Chapter1_IronCombatReset
{
	actions
	{
		SendToModule "#General" "#CounASet=1"
		SetState Chapter1_Process
	}
}


state Chapter1_Phase4
{
	
	actions
	{
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=20" "#IconType=#Drone"
		
		CreateModule "#Creature" "#CreatureWaveA" "#Spline=SpawnLower" "#Type=DroneForklift_a"  "#count=12" "#maxalive=3" "#addtoradar" "#TransformForceRobot" "#Script=ForkliftDrone" "#SetEnergyMax=800" "#SetEnergy=800" 
		;;CreateModule "#Creature" "#CreatureWaveC" "#Spline=Spawn" "#Type=DronePickupTruck_a"  "#count=2" "#maxalive=2" "#addtoradar" "#TransformForceRobot" "#Script=TruckDrone" "#SetEnergyMax=1200" "#SetEnergy=1200"

		CreateModule "#Creature" "#CreatureWaveB" "#count=0" "#maxalive=2" "#addtoradaralways" "#Type=DroneDefault_a" "#TransformForceRobot" "#KeyLocation=On" "#Script=CarDrone" "#SetEnergyMax=1000" "#SetEnergy=1000" 
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#CreatureWaveB" "#Spline=MeteorSpawnMid" "#Time=1,DroneDefault_a"  "#Time=6,DroneDefault_a" 
		CreateModule "#Creature" "#CreatureWaveC" "#count=0" "#maxalive=1" "#addtoradaralways" "#Type=DronePickupTruck_a" "#TransformForceRobot" "#KeyLocation=On" "#Script=TruckDrone" "#SetEnergyMax=1200" "#SetEnergy=1200" 
		CreateModule "#Meteorite" "#Meteorite2" "#ModuleTag=#CreatureWaveC" "#Spline=MeteorSpawnMid" "#Time=2,DronePickupTruck_a" ;"#Time=3,DronePickupTruck_a" 
		
		CreateModule "#Creature" "#Ratchet"          "#Spline=SpawnLower" "#Type=DroneArmouredCar" "#count=1" "#maxalive=1" "#addtoradaroff" "#SpawnInLosInit" "#Script=RatchetInit" "#SetEnergyMax=1500.0" "#SetEnergy=1500.0" "#SetPosition=#BossEntrance_R" "#SuppressShield"
		CreateModule "#Creature" "#Boss2"          "#Spline=SpawnLower" "#Type=Bumblebee07" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#Script=Bumblebee" "#SetPosition=#BossEntrance_T1"
		CreateModule "#Creature" "#BodyGuard" "#Spline=SpawnLower" "#Type=DronePickupTruck_a"  "#count=1" "#maxalive=1" "#addtoradar" "#TransformForceRobot" "#SpawnInLosInit" "#Script=StandAndWait" "#SetEnergyMax=1200" "#SetEnergy=1200" "#SetPosition=#BossEntrance_R2" 
		;CreateModule "#AreaRange" "#RatArea" "#Trigger=#Ratchet" "#AddToRadarOff" "#SetRadarType=#AutoBotRadarIcon"
		
		SendToModule "#CreatureWaveA" "#ForcePlayerAsOpp"
		SendToModule "#CreatureWaveB" "#ForcePlayerAsOpp"
		SendToModule "#CreatureWaveC" "#ForcePlayerAsOpp"
		SendToModule "#Ratchet" "#ForcePlayerAsOpp"
		SendToModule "#Boss2" "#ForcePlayerAsOpp"
		;Idle 7.0 
		CreateModule "#Timer" "#TimerB" "#Time=7.0" "#NoRender" "#Start"
		SendToModule "#General" "#SetRadarInterference=1"
		SendToModule "#General" "#SetMessage=ITC1" "#SetMessageTimer=3.0"
		
		
		SendToModule "#General" "#CountSet=1"

		SetState Chapter1_Process
		
	}
}

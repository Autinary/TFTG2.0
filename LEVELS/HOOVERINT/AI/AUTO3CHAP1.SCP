		CreateModule "#DriverDrone" "#GotoDroneB" "#spline=A3C1SS7Drone2" "#maxalive=1" "#count=1" "#FollowSpline=A3C1SS7Drone2" "#WaitEnd" "#spacing=1.0" "#goalrange=8.0" "#type=Sector7Drone" "#Location=#AlarmDot" "#DontClampRadar" "#Object=#Sector7Dot" "#Warning=A3C1BlastDoors" "#SpawnInLOSInit" "#DrawHealthBar" "#Speed=15" "#IgnorePaths"  "#energy=100"

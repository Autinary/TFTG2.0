;Agile Script
; Note: Can always take a melee hit, physics flip/flops though

CONST AutoMeleeRangeMin				1.0
CONST AutoMeleeRangeMax				2.0
CONST ClosestApproachRangedMin		30.0
CONST ClosestApproachRangedMax		32.0
CONST RollingAssaultMin				10.0
CONST RollingAssaultMax				12.0
CONST BootMin				2.0
CONST BootMax				4.0

ConditionMacro StuckTime
{
	if StuckTime > 1.0 AND
	if GetFlag "StuckByPickup" == 1.0 AND
	if GetFlag "StuckEscape" == 1.0
}

ConditionMacro StuckJump
{
	if GetFlag "StuckByObstacle" == 1.0
}

ConditionMacro StuckRoll
{
	if GetFlag "StuckByObstacle" == 2.0
}

ConditionMacro AttackPOI
{
	if BeenStruckTime > 5.0 and
	if HasActivePOI == 1.0
}

state Base
{
	Conditions
	{
		if AlwaysTrue == 1.0 goto AmIAwakeYet
	}
}

state AmIAwakeYet
{
	Conditions
	{
		if Awake == 1.0 goto Init

		if GotOpponent == 1.0 AND
		if DistanceBetweenOpponent < 10.0 goto WakeUp
	}
	Actions
	{
		CarDrive "park"
	}
}

state WakeUp
{
	Actions
	{
		WakeUp
		SetState AmIAwakeYet
	}
}

state Init
{
	Conditions
	{
		if RobotForm == 1.0 goto Alert
		if CarForm == 1.0 goto TransformInit
		if SecondaryForm == 1.0 goto TransformInit
	}
	Actions
	{
		SetFlag "TakeHitPhysics=false" "TakeHitMelee=true" "TakeHit=false" "StuckEscape=true"
		SetFlag "TakeHitSave"
		SetPhysicsState "static=false" 
	}
}



state TransformInit
{
	Conditions
	{
		if RobotForm == 1.0 goto Alert
	}
	Actions
	{
		Transform UntilDone
	}
}

state NoOpponent
{
	Conditions
	{
		if RobotForm == 0.0 goto Init
		if GotOpponent == 1.0 goto Alert
		if BeenStruckTime < 2.0 goto BeenStruck
		if WalkToLocatorTime > 0.0 goto BeenStruck

		OnMacro StuckTime goto StuckEscape
	}
	Actions
	{
		SetStrafe false
		SetFlag "TakeHitPhysics=true"
		GoToOrigin "xz_rangecheck" "goalrange=2.0" "turntime=5.0"
	}
}

state ReEnterKeyLocation
{
	Actions
	{
		SetFlag "TakeHitPhysics=false"
		GoToKeyLocation "rangeInside=0.5"
		SetState Alert
	}
}

state Alert
{
	Conditions
	{
		if RobotForm == 0.0 goto Init

		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > 5.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 5.0 goto UnStickFromOpponent

		if HasPickup "Pole" == 1.0 AND
		if CanApproach == 1.0 goto MeleeApproach

		if HasPickup == 1.0 goto PickupAttack

		if CanApproach == 1.0 goto MeleeApproach
		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttack

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		SetFlag "TakeHitRestore"
		
		SetPhysicsState "static=false" 
		SetState AttackRanged
	}
}

state AttackRanged
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > 5.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if DistanceBetweenOpponent > RollingAssaultMin AND
		if DistanceBetweenOpponent < RollingAssaultMax AND goto RollingAssault

		if DistanceBetweenOpponent > BootMin AND
		if DistanceBetweenOpponent < BootMax goto Boot
		
		if CanApproach == 1.0 goto Alert

		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttack

		if CanApproach == 0.0 AND
		if LOSTimer > 1.0 AND
		if DistanceBetweenOpponent < ClosestApproachRangedMin goto Retreat

		if PickupAvailable == 1.0 AND
		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent < 80 AND
		if DistanceBetweenOpponent > 10 AND
		if Timer > "(3.0+(RAND*3.0)-(6.0*PICKUPRATE))" AND
		if AlwaysTrue 0.8 > "ThrashedPhys" goto PickupAttack

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		ResetTimer
		SetStrafe
		EngageOpponent "goalrange=1.0" 
	}
}

state UnStickFromOpponent
{
	Conditions
	{
		if Timer > 3.0 goto Alert
		if GotOpponent == 0.0 goto NoOpponent
	}
	Actions
	{
		ResetTimer
		Retreat "goalrange=1.0" "retreatrange=40.0"
		SetState Alert
	}
}

state PickupAttack
{
	Conditions
	{
		if StuckTime > 1.0 goto Alert
		if Timer > 4.0 goto Alert

		if PickupAvailable == 0.0 AND
		if HasPickup == 0.0 goto Alert

		if HasPickup == 0.0 AND
		if CanApproach == 1.0 goto Alert

		if HasPickup == 0.0 AND
		if DistanceBetweenOpponent < 15 goto Alert

		if DistanceBetweenOpponent > 45 goto PickupForceThrow
		if PickupHot == 1.0 goto PickupForceThrow
	}
	Actions
	{
		ResetTimer
		SetStrafe false
		EngageOpponentWithPickup "acquirerange=1.0" "throwrange=45.0"
		SetState Alert
	}
}

state PickupForceThrow
{
	Conditions
	{
		if HasPickup == 0.0 goto Alert
	}
	Actions
	{
		EngageOpponentWithPickup "throwrange=1000000.0" "dontpickup"
		; Attempt to catch error cases
		Idle 1.0
		SetState PickupForceThrow
	}
}
state RollingAssault
{
	Conditions
	{
		if Timer > 3.0 goto MeleeApproach
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if HasPickup == 1.0 goto PickupAttack


		if DistanceBetweenOpponent > RollingAssaultMin AND
		if DistanceBetweenOpponent < RollingAssaultMax goto RollingAssault

	

		
		if DistanceBetweenOpponent < BootMax AND
		if DistanceBetweenOpponent > BootMin goto Boot

		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttack

		if CanApproach == 0.0 goto Alert

		if PickupAvailable == 1.0 AND
		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent < 55 AND
		if DistanceBetweenOpponent > 10 AND
		if Timer > "(3.0+(RAND*3.0)-(6.0*PICKUPRATE))" AND
		if AlwaysTrue 0.8 > "ThrashedPhys" goto PickupAttack

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
		if Timer > 3.0 goto MeleeApproach
	}
	Actions
	{
		ResetTimer
		SetStrafe
		SetPhysicsState "static=false" 
		CloseStrafe "MinAngle=110" "MaxAngle=140" "Range=13.0" "Time=5.0" "Roll" 
		;DoAttack "roll"
		;EngageOpponent "goalrange=1.0" 
		SetState MeleeApproach
	}
}
state RollingFlank
{
	Conditions
	{
		if Timer > 3.0 goto MeleeApproach
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if HasPickup == 1.0 goto PickupAttack


	
		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttack

		if CanApproach == 0.0 goto Alert

		if PickupAvailable == 1.0 AND
		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent < 55 AND
		if DistanceBetweenOpponent > 10 AND
		if Timer > "(3.0+(RAND*3.0)-(6.0*PICKUPRATE))" AND
		if AlwaysTrue 0.8 > "ThrashedPhys" goto PickupAttack

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
		if Timer > 3.0 goto MeleeApproach
	}
	Actions
	{
		ResetTimer
		SetStrafe
		CloseStrafe "MinAngle=110" "MaxAngle=140" "Range=13.0" "Time=5.0" "Roll" 
		;DoAttack "roll"
		EngageOpponent "goalrange=1.0" 
		SetState MeleeApproach
	}
}
state Boot
{
	Conditions
	{
		if Timer > 3.0 goto MeleeApproach
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if HasPickup == 1.0 goto PickupAttack


		if DistanceBetweenOpponent > RollingAssaultMin AND
		if DistanceBetweenOpponent < RollingAssaultMax goto RollingAssault

	

		
		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttack

		if CanApproach == 0.0 goto Alert

		if PickupAvailable == 1.0 AND
		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent < 55 AND
		if DistanceBetweenOpponent > 10 AND
		if Timer > "(3.0+(RAND*3.0)-(6.0*PICKUPRATE))" AND
		if AlwaysTrue 0.8 > "ThrashedPhys" goto PickupAttack

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
		
		if Timer == 0.6 goto MeleeApproach
	}
	Actions
	{
		ResetTimer
		DoAttack "kick"
		SetPhysicsState "static=false" 
		
		EngageOpponent "goalrange=1.0" 
		SetState MeleeApproach
	}
}

state MeleeApproach
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0.0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if HasPickup == 1.0 goto PickupAttack


		if DistanceBetweenOpponent > RollingAssaultMin AND
		if DistanceBetweenOpponent < RollingAssaultMax goto RollingAssault

		if DistanceBetweenOpponent > BootMin AND
		if DistanceBetweenOpponent < BootMax goto Boot

		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttack

		if CanApproach == 0.0 goto Alert

		if PickupAvailable == 1.0 AND
		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent < 55 AND
		if DistanceBetweenOpponent > 10 AND
		if Timer > "(3.0+(RAND*3.0)-(6.0*PICKUPRATE))" AND
		if AlwaysTrue 0.8 > "ThrashedPhys" goto PickupAttack

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		SetStrafe
		SetPhysicsState "static=false" 
		EngageOpponent "goalrange=0.0" 
	}
}

state MeleeAttack
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0 goto NoOpponent

		if OpponentOverlapTime > 10.0 goto UnStickFromOpponent

		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto Alert

		if CanApproach == 1.0 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto MeleeApproach

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		SetStrafe false
		SetPhysicsState "static=false" 
		EngageOpponent "goalrange=1.0" "firerange=2.0" "instant" "chainwithdelay=0.8" "numshots=1"
		SetState AttackCloseInit
	}
}

state Retreat
{
	Conditions
	{
		if RobotForm == 0.0 goto Init
		OnMacro StuckTime goto StuckEscape
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0 goto NoOpponent

		if CanApproach == 1.0 goto Alert

		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttack

		if DistanceBetweenOpponent > ClosestApproachRangedMax goto AttackRanged
	}
	Actions
	{
		Retreat "goalrange=1.0" 
	}
}

state AttackCloseInit
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0 goto NoOpponent

		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttack

		if Timer == 0.0 AND
		if AlwaysTrue > "RAND*2.0" goto MeleeStrafeClose

		if Timer > 2.0 AND
		if AlwaysTrue > "RAND*2.0" goto MeleeStrafeShoot

		;;;JUMPING taken out at JB request
		if Timer == 0.0 AND
		if AlwaysTrue > "RAND*4.0" goto MeleeStrafeJump

		if Timer == 0.0 AND
		if AlwaysTrue > "RAND*4.0" goto MeleeStrafeSlam

		if Timer > 2.0 goto AttackCloseWait

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}
	Actions
	{
		ResetTimer
		SetStrafe
		CloseStrafe "MinAngle=110" "MaxAngle=140" "Range=13.0" "Time=5.0" "RollAway" "Roll" 
		MoveAwayFromPlayer "face" "100.0"
	}
}

state AttackCloseWait
{
	Conditions
	{
		OnMacro AttackPOI goto AttackPOI

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto ReEnterKeyLocation

		if GotOpponent == 0 goto NoOpponent

		

		if CanApproach == 0.0 goto Alert

		if CanApproach == 1.0 AND
		if Timer > 2.0 goto MeleeApproach

		if Timer > 2.0 goto AttackRanged

		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttack

		OnMacro StuckTime goto StuckEscape
		OnMacro StuckJump goto StuckEscapeJump
		OnMacro StuckRoll goto StuckEscapeRoll
	}

	Actions
	{
		ResetTimer
		SetStrafe
		EngageOpponent "goalrange=12.0" "retreat"
	}
}


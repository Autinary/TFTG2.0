		SendToModule "Barricade" "#NoHealthBar" "#DirectSpline=A3C2TunnelA" "#Script=FollowSplineCre" "#Unstoppable" "#AddToRadarOff" "#InhibitRubble"

		Idle 3.5
		SendToModule "Barricade" "#DirectSpline=A3C2TunnelA" "#Script=FollowSplineVeh" "#TransformForceCar" "#Speed=150" "#Unstoppable" "#AddToRadarOff" "#InhibitRubble"
	}
}

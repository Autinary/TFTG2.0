state Chapter2_PickupMessageA
{
	actions
	{
		SendToModule "#D1C3SpecialA" "#ClearTriggeredPickup" "#AddToRadar=0" "#PhysObjGlow=0"
		SendToModule "#DroneCounter" "#Increment=1"
		SetMessage Name=PickupA Value=1
		SetState Chapter2_SpeechMain
	}
}


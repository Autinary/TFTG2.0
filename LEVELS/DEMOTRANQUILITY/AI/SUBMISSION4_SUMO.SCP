;push all drones out of key location within time limit
;player and drones are invincible
;if anyone leaves area instant death

;requires:
;	Keylocation spline 						KeyLoc#
;	Spawn spline for type 1 creatures		Spawn#a
;	Spawn spline for type 2 creatures		Spawn#b

;Changeable params:
;	300		time in which to complete the mission
;	10	total number of creature type 1 that need to be killed
;	10	total number of creature type 2 that need to be killed
;	2		total creature type 1 that are simultaneously active 
;	2		total creature type 2 that are simultaneously active 
;	DroneCement	type of creature one to fight against
;	DronePickupTruck	type of creature two to fight against
;						DroneForkLift
;						DroneTowTruck
;						DroneArmouredCar
;						DroneCement
;						DronePickupTruck
;						DroneMig
;						BumbleBee
;						Barricade


state SubMission4_Enter
{
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission4_Death"
		SetState "SubMission4_InitPre"
	}
}
state SubMission4_InitPre
{
	conditions
	{
		if timer > 0.1 goto SubMission4_NoShow
		
		if module "General ChapterProgress" >= 1.0 goto SubMission4_Init
	}
	actions
	{
		
		ResetTimer
		
	}
}
state SubMission4_NoShow
{
	conditions
	{
		if module "Timer FailMission" == 1.0 goto SubMission4_NoShow2
	}
	actions
	{
		
		
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission4" "#FadeUp"
		;SendToModule "#General" "#SetMessage=BBTranD1" "#SetMessageTimer=4"
		CreateModule "#Timer" "#Timer" "#Time=2" "#NoRender"
	}
}
state SubMission4_NoShow2
{
	conditions
	{
		if module "Timer1 FailMission" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		
		
		;SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission3" "#FadeUp"
		SendToModule "#General" "#SetMessage=BBTranD1" "#SetMessageTimer=4"
		CreateModule "#Timer" "#Timer1" "#Time=4" "#NoRender"
	}
}
state SubMission4_Enter2
{
	conditions
	{
		if timer > 1.0 goto SubMission4_Main3
		if module "General ChapterProgress" >= 3.0 goto SubMission4_Enter3
	}
	actions
	{
		ResetTimer
	}
}
state SubMission4_Enter3
{
	conditions
	{
		if timer > 1.0 goto SubMission4_Main
		if module "General ChapterProgress" >= 4.0 goto SubMission4_Main2
	}
	actions
	{
		ResetTimer
	}
}
state SubMission4_Init
{
	conditions
	{
		if timer > 1.0 goto SubMission4_Main
		if module "General ChapterProgress" >= 2.0 goto SubMission4_Enter2
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#SubMission4" 
		SendToModule "#General" "#LoadCreature=DroneCement"
		SendToModule "#General" "#LoadCreature=DronePickupTruck"
		CreateModule "#Timer" "#Timer" "#Time=300"
	}
}
state SubMission4_Main
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneCement" "#Spline=Spawn4a" "#count=2" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Early_Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DronePickupTruck" "#Spline=Spawn4b" "#count=16" "#maxalive=3" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Early_Combat"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=18" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission4_Main2
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 and 
				if module "CreatureWaveC GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		SendToModule "#General" "#LoadCreature=Scorponok"
		
		
		SendToModule "#General" "#SetMaxOpponents=5" "#SetMaxApproachers=5" 
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneCement" "#Spline=Spawn4a" "#count=2" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Early_Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DronePickupTruck" "#Spline=Spawn4b" "#count=16" "#maxalive=2" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Early_Combat"
		CreateModule "#Creature" "#CreatureWaveC" "#Type=Scorponok" "#Spline=Spawn4b" "#count=6" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Early_CombatBoss"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB" "#SumoCreatureModule=#CreatureWaveC" "#SumoCreatureModule=#CreatureWaveD"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=24" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION Mission3_1 PLAY ACTION"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission4_Main3
{
	conditions
	{
		if module "CreatureWaveC Dead" == 1.0 goto SubMission4_Main4
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		SendToModule "#General" "#LoadCreature=Barricade"
		SendToModule "#General" "#SetMaxOpponents=5" "#SetMaxApproachers=5"
		CreateModule "#Creature" "#CreatureWaveA" "#Type=DroneCement" "#Spline=Spawn4a" "#count=2" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Early_Combat"
		CreateModule "#Creature" "#CreatureWaveB" "#Type=DronePickupTruck" "#Spline=Spawn4b" "#count=16" "#maxalive=3" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Early_Combat"
		CreateModule "#Creature" "#CreatureWaveC" "#Type=Barricade" "#Spline=Spawn4b" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Early_CombatBoss" "#BlockDeath"
		SendToModule "#General" "#SumoKeyLoc=KeyLoc4" "#SumoCreatureModule=#CreatureWaveA"  "#SumoCreatureModule=#CreatureWaveB" "#SumoCreatureModule=#CreatureWaveC"
		CreateModule "#DroneCounter" "#DroneCounter" "#DronesToDefeat=21" "#IconType=#Drone"
		SetMusic "STOP INMISSION ACTION Mission3_1 PLAY ACTION"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission4_Main4
{
	conditions
	{
		if module "CreatureWaveC Dead" == 1.0 goto SubMission4_Main5
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		DestroyModule "#CreatureWaveC"
		CreateModule "#Creature" "#CreatureWaveC" "#Type=Barricade" "#Spline=Spawn4b" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnAsCreature" "#Script=Early_CombatBoss" "#BlockDeath"
		
	}
}
state SubMission4_Main5
{
	conditions
	{
		if module "CreatureWaveC Dead" == 1.0 goto SubMission4_Main6
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		DestroyModule "#CreatureWaveC"
		CreateModule "#Creature" "#CreatureWaveC" "#Type=Barricade" "#Spline=Spawn4b" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnAsCreature" "#Script=Early_CombatBoss" "#BlockDeath"
		
	}
}
state SubMission4_Main6
{
	conditions
	{
		if module "CreatureWaveA GetCountAlive" == 0.0 and
			if module "CreatureWaveB GetCountAlive" == 0.0 goto SubMission4_Finish
		if module "Timer FailMission" == 1.0 goto SubMission4_Fail
		if module "General SumoCheck" == 1.0 goto SubMission4_Fail
	}
	actions
	{
		DestroyModule "#CreatureWaveC"
		
	}
}
state SubMission4_Finish
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission4_FinishWait
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission4_FinishWait
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=4"
		;SetState "SubMission4_Leave"
	}
}
state SubMission4_Death
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state SubMission4_Fail
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission4_Leave
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FailMission"
	}
}
state SubMission4_Leave
{
	
	actions
	{
		
 		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#PlayerTutorialEnd" "#FadeUp"
	   	SendToModule "#General" "#UnLoadCreature=DroneCement"
	   	SendToModule "#General" "#UnLoadCreature=DronePickupTruck"
		SendToModule "#General" "#UnLoadCreature=Scorponok"
		SendToModule "#General" "#UnLoadCreature=Blackout"
		SendToModule "#General" "#UnLoadCreature=Barricade"
		
		
		SendToModule "#General" "#FadeUp"		
		SetState "GlobalActionRing"
	}
}


state InHubZoneB 
{
	conditions
	{
		if module "SubMissions GetSubMissionAnyBeenTriggered" == 1.0 goto SubMission_Init
		if module "ActionRing AnyBeenTriggered"  == 1.0 goto GlobalStartChapter

		
		if module "General GetCountA" <= 1.0 goto SetZoneBDroneGroup1Init
		if module "General GetCountA" <= 2.0 goto SetZoneBDroneGroup2Init
		if module "General GetCountA" <= 4.0 goto SetZoneBDroneGroup3Init
		if module "General GetCountA" <= 6.0 goto SetZoneBDroneGroup4Init
		if module "General GetCountA" <= 7.0 goto SetZoneBDroneGroup5Init
		if module "General GetCountA" <= 8.0 goto SetZoneBDroneGroup6Init
		if module "General GetCountA" <= 9.0 goto SetZoneBDroneGroup7Init
		

		
		if Timer > 0.2 goto SetZoneBDroneGroup1Init
		
	}
	actions
	{
		ResetTimer 
	}

}

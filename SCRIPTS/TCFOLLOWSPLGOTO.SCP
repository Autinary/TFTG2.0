
INCLUDE "Rules.scp"

state Base
{
	Actions
	{
		SetFlag "TakeHitPhysics=false" "TakeHitMelee=false" "TakeHit=false" "StuckEscape=false"
		SetState Main
	}
}

state Main
{
	ReferenceScript
	{
		Script=TCFollowSpline
		Source=Global
		ReturnState=Main
		Conditions
		{
			if TolsRemainAsCar == 1.0
		}
	}

	ReferenceScript
	{
		Script=RoofCombat
		Source=Global
		ReturnState=Main
		Conditions
		{
			if TolsRemainAsCar == 0.0
		}
	}



	
}

	
{
	actions {
		SendToModule "#GotoDroneE" 
		SetState Chapter3_Watch
	}
}

state Chapter3_Watch
{
	conditions
	{
		;;;LEVEL COMPLETE STATES;;;; --- if all dead ----
		if module "GotoDroneA GetPercentageComplete" == 1.0 and
			if module "GotoDroneB GetPercentageComplete" == 1.0 and
				if module "GotoDroneC GetPercentageComplete" == 1.0 and
					if module "GotoDroneD GetPercentageComplete" == 1.0 and
						if module "GotoDroneE GetPercentageComplete" == 1.0 goto Chapter3_Chatter

		if module "DroneCounter DronesDefeated" == 5.0 goto Chapter3_Chatter
						
		;;;GAME OVER STATES;;;;; --- if timer reaches end -----		
		if module "Timer FailMission" == 1.0 goto Chapter3_FailMission						

		;;STOP TIMER STATES;;;;; -- if dead add time on
		if module "GotoDroneA CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeA
		if module "GotoDroneB CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeB
		if module "GotoDroneC CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeC
		if module "GotoDroneD CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeD
		if module "GotoDroneE CompleteTrigger" == 1.0 goto Chapter3_AddOnTimeE
	}

}
state Chapter3_Chatter
{
	conditions
	{
		
		if module "Timer FailMission" == 1.0 goto Chapter3_Complete
	}
	actions
	{
		DestroyAllModules

		;SetMusic "ACTION Mission1_1 QUIET Tag1 Play Quiet"
		CreateModule "#Timer" "#Timer" "#Time=7.0" "#NoRender" "#Start"
                CreateModule "#Speech"  "#DefeatDrones" "#AutoDestroy" "#speech=#D1_ch2_cmplt" "#Start"
	}
}
state Chapter3_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter3_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter3_FailMission
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter3_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state Chapter3_Restart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"

		SendToModule "#General" "#UnLoadCreature=DronePickupTruck" 
				


		SendToModule "#General" "#PlayerType=Blackout,Blackout,Scorponok,Blackout"
		SendToModule "#General" "#ResetAll" "#SetPlayerAtDeathPoint" "#FadeUp"
		
		SendToModule "#General" "#ResponseLvPlayerDetected=4"

		SetState "Exit"
	}
}
state Chapter3_Complete
{
	
	actions
	{
		DestroyModule "#Timer"
		SetMusic "ACTION Mission1_3 QUIET Generic Play Action"
		Idle 0.1
		SetState Chapter3_CompleteStart
	}
}
state Chapter3_CompleteStart
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter3_CompleteVideo
	}
	actions
	{
		
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT2" "#Spline=COMCAM2" "#SetFocus=CAMFOCUS2"
		SendToModule "#General" "#CompleteMission" 
		SendToModule "#ActionRing" "#SetCompleted=#Chapter3" "#Unlock=#Chapter4"
                CreateModule "#Speech" "#PlayDelay=1.3" "#speech=#D1_ch4_Goto" "#Start"
	}
}
state Chapter3_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter3_CompleteVideoFinished
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartOutroVideo=#D1C3Outro1" ;#D1C2Outro1"
	}
}
state Chapter3_CompleteVideoFinished
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter3_Leave
	}
	actions
	{
		SendToModule "#General" "#UnLoadCreature=DronePickupTruck" 
		

		SendToModule "#General" "#PlayerType=Blackout,Blackout,Scorponok,Blackout"
		SendToModule "#General" "#SetPlayer=#Chapter2Finish"
		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter3_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter4"
		SendToModule "#General" "#SetPlayerDeathPoint=#COMPPOINT2"
		
		SendToModule "#General" "#ResponseLvPlayerDetected=4"

		IncreasePlayerHealth max
		setstate "PickGoto"
	}
}

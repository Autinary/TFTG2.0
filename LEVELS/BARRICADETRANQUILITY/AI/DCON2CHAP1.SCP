state Chapter1_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" "#FadeUp"
		SetState "GlobalActionRing"
	}
}
state Chapter1_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_HubRestart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission"  "#DeathFailMission"
	}
}
state Chapter1_InitGoto
{
	conditions
	{
		if module "General GetFinishedMissionStart" == 1.0 goto Chapter1_GotoWaitSpeech
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartMission" "#SetVehicle=#StartMission" "#VEHICLEROLLINGSTART_MPH=60.0" "#SetPlayerDeathPoint=#StartMission" 
	}
}
state Chapter1_GotoWaitSpeech
{
	actions
	{
		SendToModule "#General" "#AllowPlayerMovement"
		
		Idle 2.0
		SendToModule "#General" "#SetMessage=BT1" "#SetMessageTimer=3"
		Idle 1.7
		CreateModule "#Speech" "#MissionStartSpeech" "#speech=#D2_ch1_intro" "#AutoDestroy" "#Start"
		;CreateModule "#Speech" "#MissionStartSpeech2" "#speech=#D2_ch1_Goto" "#PlayDelay=5" "#AutoDestroy" "#Start"
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D2_ch1_Goto2" "#AutoDestroy"
		CreateModule "#Timer" "#StarScreamSpeech" "Time=11" "#NoRender" 
		Idle 3.0
		
		setstate Chapter1_Goto
	}
}

state Chapter1_Goto
{

	actions
	{
				
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=60" "#times=1" 
		CreateModule "#AndSwitch" "#AndSwitchReminder" "#moduletag=#DelayedSendReminder" "#placement=#Chapter1Beacon" "#rangeoutside=75"
		SetState "GlobalActionRing"
	}
}
state Chapter1_Enter
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter1_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter1_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro"
	}
}
state Chapter1_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_Main
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"

    	;SendToModule "#General" "#LoadCreature=DroneCement_a"
	;SendToModule "#General" "#LoadCreature=DroneArmouredCar_a"
    	SendToModule "#General" "#LoadCreature=DroneTowTruck_a"
    	SendToModule "#General" "#LoadCreature=DronePickupTruck_a"
		SendToModule "#General" "#PlayerType=Barricade"
    	SendToModule "#General" "#LoadCreature=DroneDefault_a"
	}
}

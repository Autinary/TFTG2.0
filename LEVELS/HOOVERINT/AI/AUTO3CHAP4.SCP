		SendToModule "#A3C4RespawnTimer" "#ClearTriggeredComplete" "#Time=30.0" "#Stop"
		SendToModule "#General" "#SetMessage=HIntD13" "#SetMessageTimer=2.0" 
		SendToModule "#Hardbuildings" "#TurnOn=1"
		SetState Chapter4_MegaTronAwakes 
	}
}


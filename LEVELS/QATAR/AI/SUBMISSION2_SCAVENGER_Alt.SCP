;scavenger hunt, find all the nodes within the time limit

;requires:
;Scavenger spline		Scavenger#	;maximum 80 points
;KeyLocation spline		KeyLoc#

;Changeable params:
;	300		time in which to complete the mission
;	15			keylocation timeout
;	75		distance in which points are added to radar (75)

state SubMission2_Enter_Alt
{
	actions
	{
		SendToModule "#SubMissions" "#TurnOff"
		SetDeathPoint "SubMission2_Death_Alt"
		SendToModule "#General" "#ResetAll"
		SetState "SubMission2_Init_Alt"
	}
}
state SubMission2_Init_Alt
{
	conditions
	{
		if timer > 0.1 goto SubMission2_Main_Alt
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#SetPlayer=#COMPPOINT25" "#ResetLevel"
		CreateModule "#Timer" "#Timer" "#Time=300"
		;CreateModule "#KeyLocation" "#KeyLocation" "#Spline=KeyLoc2" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#TimeOut=15" 
		CreateModule "#RaceNodes" "#RaceNodes" "#Spline=Nodes2" "#MultiNode" "#RadarRange=280"
		CreateModule "#DroneCounter" "#DroneCounter" "#ModuleTag=#RaceNodes" "#GetPercentageComplete" "#IgnoreDroneKills" "#DronesToDefeat=10" "#BackwardsCount"
		SendToModule "#RaceNodes" "#SetupDroneCounter=#DroneCounter"
	}
}
state SubMission2_Main_Alt
{
	conditions
	{
		if module "RaceNodes getpercentagecomplete" == 1.0 goto SubMission2_Finish_Alt
		if module "KeyLocation FailMission" == 1.0 goto SubMission2_Fail_Alt
		if module "Timer FailMission" == 1.0 goto SubMission2_Fail_Alt
	}
	actions
	{
		SetMusic "STOP INMISSION ACTION generic PLAY ACTION"
		SendToModule "#General" "#FadeUp"		
	}
}
state SubMission2_Finish_Alt
{
	conditions
	{
		if module "General FadeDown" == 1.0 goto SubMission2_FinishWait_Alt
	}
	actions
	{
		SendToModule "#General" "#EndOfMission" "#FadeDown"
	}
}
state SubMission2_FinishWait_Alt
{
	conditions
	{
		if module "General GetSubMissionComplete" == 1.0 goto SubMission2_Leave_Alt
	}
	actions
	{
		SendToModule "#SubMissions" "#SetCompleted=2"
		;SetState "SubMission2_Leave"
	}
}
state SubMission2_Death_Alt
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto SubMission2_Leave_Alt
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state SubMission2_Fail_Alt
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto SubMission2_Leave_Alt
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state SubMission2_Leave_Alt
{
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		;
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission2" "#FadeUp"
		SendToModule "#General" "#FadeUp"
		SendToModule "#General" "#CountCSet=1"		
				
		SetState "Exit"
	}
}


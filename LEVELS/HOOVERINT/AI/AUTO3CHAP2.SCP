		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelAExp3" "#SetSplineType=#ExplosionLarge" "#SetBitRadius=280"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelAExp1" "#SetSplineType=#ExplosionSmall" "#SetBitRadius=250"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelAExp2" "#SetSplineType=#ExplosionMedium" "#SetBitRadius=230"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelAExp3" "#SetSplineType=#ExplosionLarge" "#SetBitRadius=210"

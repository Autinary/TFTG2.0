state Chapter1_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" "#FadeUp"
		SetState GlobalActionRing
	}
}
state Chapter1_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_HubRestart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter1_Part2Enter
{
	conditions
	{
	
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SetState Chapter1_Part2IntroVideo
	}
}
state Chapter1_Part2IntroVideo
{
	conditions
	{
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter1_Part2LoadCreatures
	}
	actions
	{

		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#D6C1Midtro1"
	}
}
state Chapter1_Part2LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_Fight1Start
	}
	actions
	{
		;SendToModule "#ActionRing" "#RemoveCreatures"

		
		SendToModule "#General" "#LoadCreature=OptimusPrime"
		SendToModule "#General" "#LoadCreature=DroneCement_a"
		SendToModule "#General" "#LoadCreature=StarScream"
		SendToModule "#General" "#LoadCreature=DronePickupTruck_a"
		
	}
}
state Chapter1_Enter
{
	conditions
	{
	
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SetState Chapter1_IntroVideo
	}
}
state Chapter1_EnterInstantly
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_IntroVideo2
	}
	actions
	{

		DestroyAllModules "#IncludeProtected"
		;SendToModule "#General" "#StartIntroVideo=#D6C1LevelIntro"
	}
}
state Chapter1_StartMission
{
	actions
	{
		SendToModule "#General" "#StartChapter"
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#TurnOff"
		SendToModule "#General" "#ResetCounters"
		SetState Chapter1_IntroVideo2
	}
}
state Chapter1_IntroVideo2
{
	conditions
	{
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter1_LoadCreatures
	}
	actions
	{

		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#D7C1LevelIntro"
	}
}
state Chapter1_IntroVideo
{
	conditions
	{
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter1_LoadCreatures
	}
	actions
	{

		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#D6C1LevelIntro"
	}
}
state Chapter1_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter1_Main 
	}
	actions
	{
		;SendToModule "#ActionRing" "#RemoveCreatures"

		
		SendToModule "#General" "#LoadCreature=OptimusPrime"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#LoadCreature=DronePickupTruck_a"
		
	}
}
state LevelIntroAfterDeath
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_DeathMain
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SetDeathPoint "Chapter1_DeathMain"
		SendToModule "#General" "#StartIntroVideo=#D6C1LevelIntro"
	}
}

state Chapter1_DeathMain
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#LoadCreature=DronePickupTruck_a"
		SendToModule "#General" "#AllowPlayerMovement"
		SetState "Chapter1_Main"
	}
}


state Chapter1_Main
{
	conditions
	{
		if Timer > 0.0 goto Chapter1_MainDelay
	}
	actions
	{
		ResetTimer
		SetDeathPoint "Chapter1_DeathFailMission"		
	}
}


state Chapter1_MainDelay
{
	actions
	{		
		;SendToModule "#General" "#LoadCreature=DroneDefault_a"
		;SendToModule "#General" "#LoadCreature=DronePickupTruck_a"

		SetMusic "ACTION Mission1_1 Play Action"
		
		CreateModule "#VehicleLevels" "#VehicleLevels" "#ResponseLv=3" "#TrafficLv=2" "#PatrolLv=0" 
		SendToModule "#General" "#PhysObj" "#SetPlayer=#Chapter1Start" "#FadeUp" "#PlayerType=Megatron"

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 5"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 5"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission

		SetState "Chapter1_Fight0Start"
		;SetState "Chapter1_Fight0StartDelay"
	}
}


;;Location 0
state Chapter1_Fight0StartDelay
{
	conditions
	{
		if Timer > 2.0 goto Chapter1_Fight0Start
	}
	actions
	{
		
	}	
}

state Chapter1_Fight0Start
{
	Conditions
	{
		if module "Optimus Health" <= 0.80 goto Chapter1_Meteors0Start
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
		if module "General ChapterFadeScreenFinished" == 1.0 and
			if Timer > 2.0 goto Chapter1_Fight0StartBWait
	}
	Actions
	{
		ResetTimer
		DestroyAllModules
		CreateModule "#Speech" "#D6_ch1_obj11" "#speech=#D6_ch1_obj11" "#PlayDelay=2.0" "#AutoDestroy" "#Start"
		CreateModule "#Goto" "#Optimus" "#Spline=D6C1Spawn" "#Script=Optimus_PrimeM" "#count=1" "#maxalive=1" "#Type=OptimusPrime" "#SpawnAsCreature" "#SpawnInLOSInit" "#KeyLocation=On" "#SetEnergyMax=15000" "#SetEnergy=15000" "#SetEnergyMin=12000.0" "#ForcePlayerAsOpp" 
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=D6LOC0_KEYLOC" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#GreyKeyLoc"

		;Move AllSpark	
		CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1SAM1" "#Wobble=2.0" "#Time=99999.0" "#NoDraw" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference"
	}
}

state Chapter1_Fight0StartBWait
{
	Conditions
	{
		if module "Optimus Health" <= 0.80 goto Chapter1_Meteors0Start
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		
		SendToModule "#Optimus" "#Boss" "#Type=OptimusPrime"
	}
}

state Chapter1_Meteors0Start
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
		
		if module "Meteorite GetPercentage" == 1.0 and
			if module "Creature GetCountAlive" == 0.0 and
				if module "Meteorite2 GetPercentage" == 1.0 and
					if module "Creature2 GetCountAlive" == 0.0 goto Chapter1_AllSparkHunt1
	}
	actions
	{
		
		SendToModule "#General" "#AllowPlayerMovement"
		
		SendToModule "#Optimus" "#DirectSpline=D6LOC0_OPTIMUSGOTO" "#Script=FollowSplineM" "#AddToRadarOff" "#NoHealthBar" "#KeyLocation=Off"
		
		CreateModule "#Creature" "#Creature" "#count=0" "#maxalive=2" "#addtoradaralways" "#Type=DroneDefault_a" "#TransformForceRobot" "#KeyLocation=On" "#SetEnergyMax=1000" "#Script=CarDrone"
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#Creature" "#Spline=D6LOC0_Meteors" "#Time=3" "#Time=6" 
		CreateModule "#Creature" "#Creature2" "#count=0" "#maxalive=2" "#addtoradaralways" "#Type=DronePickupTruck_a" "#TransformForceRobot" "#KeyLocation=On" "#SetEnergyMax=1200" "#Script=TruckDrone"
		CreateModule "#Meteorite" "#Meteorite2" "#ModuleTag=#Creature2" "#Spline=D6LOC0_Meteors" "#Time=10" "#Time=13"
	}
}

state Chapter1_OptimusArrived0
{
	conditions
	{
		;if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		DestroyModule "#Optimus"
		CreateModule "#Creature" "#Optimus" "#Spline=D6LOC1_Spawn" "#Script=Optimus_WI" "#count=1" "#maxalive=1" "#Type=OptimusPrime" "#Invulnerable" "#SpawnInLosInit" "#ADDTORADAROFF" "#ForcePlayerAsOpp"
		SetState Chapter1_GetToLoc1
	}
}
state Chapter1_GlobalRadarJam
{
	conditions
	{	
		if module "General GetCountA" == 1.0 and
			if module "Optimus IsEnergyAtMin" == 1.0 goto Chapter1_GlobalRadarClear 
		if module "CubeSecret FoundRand" == 1.0 goto Chapter1_GlobalRadarClear
		
		if module "KeyLocation InArea" == 1.0 goto Chapter1_GlobalRadarClear
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		SendToModule "#General" "#SetRadarInterference=1"
		
	}
}
state Chapter1_GlobalRadarClear
{
	conditions
	{	
		if module "General GetCountA" == 1.0 and
			if module "Optimus IsEnergyAtMin" == 1.0 goto Chapter1_EnergonDroneAssault 
		if module "General GetCountA" == 1.0 and
			if module "EnergonDrone Energy" <= 0.0 goto Chapter1_AllSparkHunt3
		if module "General GetCountA" == 2.0 and
			if module "CubeSecret FoundRand" == 1.0 goto Chapter1_AllSparkHunt5
		if module "General GetCountA" == 3.0 and
			if module "CubeSecret FoundRand" == 1.0 goto Chapter1_AllSparkHunt7
		if module "General GetCountA" == 4.0 and
			if module "CubeSecret FoundRand" == 1.0 goto Chapter1_Meteors1Start
		if module "General GetCountA" == 5.0 and
			if module "CubeSecret FoundRand" == 1.0 goto Chapter1_AllSparkHunt11
		if module "General GetCountA" == 6.0 and
			if module "CubeSecret FoundRand" == 1.0 goto Chapter1_Midtro2
		if module "General GetCountA" == 7.0 and
			if module "CubeSecret FoundRand" == 1.0 goto Chapter1_Meteors3Start
		if module "General GetCountA" == 8.0 and
			if module "CubeSecret FoundRand" == 1.0 goto Chapter1_AllSparkHunt17
		if module "General GetCountA" == 9.0 and
			if module "CubeSecret FoundRand" == 1.0 goto Chapter1_AllSparkHunt19
		if module "General GetCountA" == 10.0 and
			if module "CubeSecret FoundRand" == 1.0 goto Chapter1_Midtro4
		

		;if module "General GetCountB" == 1.0 and
		;	if module "Optimus GetLinkedDist" < 123 goto Chapter1_OptimusFollowPath
		;if module "General GetCountB" == 2.0 and
		;	if module "Optimus GetLinkedDist" < 485 goto Chapter1_OptimusStop
		if module "KeyLocation InArea" == 0.0 goto Chapter1_GlobalRadarJam
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		SendToModule "#General" "#SetRadarInterference=0"
		
	}
}
state Chapter1_AllSparkHunt1
{
	Conditions
	{
		if module "AreaRange InArea" == 1.0 goto Chapter1_AllSparkHunt2
		if module "Optimus BeenHit" == 1.0 goto Chapter1_AllSparkHunt2
		if module "Timer Timer" < 0.0 goto Chapter1_FailMission
	}
	Actions
	{
		DestroyModule "#KeyLocation" 
		DestroyModule "#SplineObj"
		DestroyModule "#Optimus"
		CreateModule "#Goto" "#Optimus" "#Spline=D6LOC2_Spawn" "#Script=Optimus_W" "#count=1" "#maxalive=1" "#Type=OptimusPrime" "#Invulnerable" "#SpawnInLosInit" "#ADDTORADAROFF" "#ForcePlayerAsOpp" "#SetEnergyMax=15000" "#SetEnergy=12000" "#SetEnergyMin=12000.0" "#SetPosition=#D6C1_SAM1" "#Protect"
		
		SendToModule "#General" "#BG_UnLoadCreature=DroneDefault_a"

		SendToModule "#General" "#BG_LoadCreature=DroneCement_a"
		SendToModule "#General" "#BG_LoadCreature=StarScream"

		
		;CreateModule "#Speech" "#D6_ch1_goto" "#speech=#D6_ch1_obj1" "#AutoDestroy" "#Start"
		
		
			
		SendToModule "#General" "#SetMessage=DCB1" "#SetMessageTimer=7" 
		DestroyModule "#Timer"
		CreateModule "#Timer" "#Timer" "Time=60.0"
	
		;CreateModule "#AreaRange" "#AreaRange" "#Trigger=#D6LOC2_AREA" "#AddToRadarOff" "#DontClampRadar"
		CreateModule "#AreaRange" "#AreaRange" "#KeyLocSpline=D6C1KEYLOC1" "#AddToRadarOff" "#DontClampRadar"
		CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1SAM1" "#Wobble=2.0" "#Creature=#Creature" "#Time=9999.0" "#NoDraw" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference"
		
	}

}
state Chapter1_AllSparkHunt2
{
	Conditions
	{

		if module "Optimus IsEnergyAtMin" == 1.0 goto Chapter1_EnergonDroneAssault ;Chapter1_AllSparkHunt3
		
		if module "KeyLocation InArea" == 0.0 goto Chapter1_GlobalRadarJam
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	Actions
	{
		
		;DestroyModule "#SplineObj"
		
		DestroyAllModules 
		CreateModule "#Creature" "#EnergonDrone" "#Spline=D6C1BUILD10" "#Count=10000" "#MaxAlive=1" "#Type=EnergonDrone" "#SpawnInLosInit" "#SpawnAsCreature" "#AddToRadarOff" "#DontClampRadar" "#Script=EnergonDrone" ; "#SetEnergyMax=350"
		
		SendToModule "#Optimus" "#SetEnergyMin=10500.0" "#Script=Optimus_PrimeM" "#Vulnerable" "#Boss" "#Type=OptimusPrime" "#KeyLocation=On" "#AddToRadar"
		CreateModule "#Speech" "#D6_ch1_obj13" "#speech=#D6_ch1_obj13" "#PlayDelay=2.0" "#AutoDestroy" "#Start"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=D6C1KEYLOC1" "#String=Key12Goto" "#ReEnterMsg=Key16Return" "#GreyKeyLoc" 
		SendToModule "#General" "#ResetLevel" "#CountASet=1" "#CountBSet=0"
		SendToModule "#General" "#ForceHealthSpawnMin=0.8" "#ForceHealthSpawnMed=0.45" "#ForceHealthSpawnMax=0.1"
		
		SendToModule "#General" "#SetMessageTimer=-1"
		Idle 0.1 
		SendToModule "#General" "#SetMessage=DCB2" "#SetMessageTimer=3"
		
		SendToModule "#SplineObj" "#AddToRadarOff"
		;SetState Chapter1_AllSparkHunt3
	}

}
state Chapter1_EnergonDroneAssault
{
	Conditions
	{
		if module "EnergonDrone Energy" <= 0.0 goto Chapter1_AllSparkHunt3

		
		;if module "KeyLocation InArea" == 0.0 goto Chapter1_GlobalRadarJam
		


		
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	Actions
	{
		ResetTimer 
		
		SendToModule "#General" "#SetMaxOpponents=19" "#SetMaxApproachers=19" "#SetAttackRingSize=20" "#CountBSet=1"
		SendToModule "#EnergonDrone" "#Count=25" "#MaxAlive=15" "#KeyLocation=On" ;"#AddToRadarOff"
		SendToModule "#Optimus" "#DirectSpline=D6LOC3_OPTIMUSGOTO" "#Script=FollowSplineM" "#AddToRadarOff" "#NoHealthBar" "#KeyLocation=Off"
		
		;CreateModule "#BuildingSecret" "#CubeSecret" "#Spline=D6C1BUILD1" "#FuzzyRange=1" "#MinRand=0.3" "#MaxRand=0.4" ;"#DrawHealthBar"
		
		CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1KEYLOC1" "#Wobble=2.0" "#Creature=#EnergonDrone" "#SpawnTime=0.0" "#Radar" "#NoDraw"
		
		;Idle 0.1
		;SendToModule "#SplineObj" "#Creature=#EnergonDrone" "#MaxAlive=19" "#StartSpawn=7" "#SpawnSpline=D6C1BUILD1" "#ForcePlayerAsOpp"

		
	}

}

state Chapter1_AllSparkHunt3
{
	Conditions
	{
		if module "AreaRange InArea" == 1.0 goto Chapter1_AllSparkHunt4
		if module "Optimus BeenHit" == 1.0 goto Chapter1_AllSparkHunt4
		if module "Optimus PlayerRange" < 50 goto Chapter1_AllSparkHunt4
		if module "Starscream BeenHit" == 1.0 goto Chapter1_AllSparkHunt4
		if module "Starscream PlayerRange" < 50 goto Chapter1_AllSparkHunt4
		
		if module "Timer Timer" < 0.0 goto Chapter1_FailMission
	}
	Actions
	{
		
		DestroyModule "#SplineObj"
		DestroyModule "#KeyLocation" 
		DestroyModule "#CubeSecret"
		DestroyModule "#EnergonDrone"
		DestroyModule "#Optimus" 
		SendToModule "#General" "#SetMessage=Find_The_Cube" "#SetMessageTimer=7"
		DestroyModule "#Timer"
		CreateModule "#Timer" "#Timer" "Time=60.0"
	

		CreateModule "#Goto" "#Optimus" "#Spline=D6C1FIGHT1OPTIMUS" "#Script=Megatron_PH2I" "#count=1" "#maxalive=1" "#Type=OptimusPrime"  "#SpawnAsCreature" "#SpawnInLOSInit" "#SetEnergyMax=15000" "#SetEnergy=10500" "#SetEnergyMin=10500.0" "#Protect" "#AddToRadarOff"
		CreateModule "#Creature" "#Starscream" "#Spline=D6C1FIGHT1STARSCREAM" "#Script=Megatron_PH2I" "#count=1" "#maxalive=1" "#Type=Starscream" "#SpawnAsCreature" "#SpawnInLOSInit" "#SetEnergyMax=4000" "#SetEnergy=4000" "#SetEnergyMin=1000" "#Friend" "#Protect" "#AddToRadarOff"
		
		CreateModule "#AreaRange" "#AreaRange" "#KeyLocSpline=D6C1KEYLOC2" "#AddToRadarOff" "#DontClampRadar"
		CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1SAM1" "#Wobble=2.0" "#Creature=#Creature" "#Time=5.0" "#NoDraw" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference" 
		;CreateModule "#Creature" "#EnergonDrone" "#Count=0" "#MaxAlive=10" "#Type=EnergonDrone" "#SpawnInLosInit" "#SpawnAsCreature" "#AddToRadar" "#Script=EnergonDrone" "#DontClampRadar" "#Protect" ; "#SetEnergyMax=350"
		
		;CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1SAM1" "#Wobble=2.0" "#Creature=#EnergonDrone" "#Time=5.0" "#SpawnTime=0.0" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference" "#NoDraw"
		
	}

}
state Chapter1_AllSparkHunt4
{
	Conditions
	{
		;if module "Destruction GetPercentageComplete" >= 1.0 goto Chapter1_AllSparkHunt5
		if module "CubeSecret FoundRand" == 1.0 goto Chapter1_AllSparkHunt5

		if module "KeyLocation InArea" == 0.0 goto Chapter1_GlobalRadarJam
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
		
	}
	Actions
	{
		
		
		DestroyAllModules ;"#IncludeProtected" 
		
		;CreateModule "#GABIChange" "#Destruction" "#GABIChange=-15000"
		
		SendToModule "#Starscream" "#Script=D6Allies" 
		SendToModule "#Optimus" "#Script=D6Allies" 
		CreateModule "#Speech" "#D6_ch1_obj1" "#speech=#D6_ch1_obj1" "#AutoDestroy" "#Start"
		
		;SendToModule "#Optimus" "#KeyLocation=On" "#Script=Optimus_PrimeM" "#AddToRadarOff"
		SendToModule "#General" "#SetMessageTimer=-1" "#CountAInc"
		
		CreateModule "#BuildingSecret" "#CubeSecret" "#Spline=D6C1BUILD2" "#FuzzyRange=20" "#MinRand=0.3" "#MaxRand=0.4" ;"#DrawHealthBar"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=D6C1KEYLOC2" "#String=Key12Goto" "#ReEnterMsg=Key16Return" "#GreyKeyLoc" 
		SendToModule "#SplineObj" "#AddToRadarOff"
		
		
	}

}
state Chapter1_AllSparkHunt5
{
	Conditions
	{
		if module "AreaRange InArea" == 1.0 goto Chapter1_AllSparkHunt6
		
		if module "Timer Timer" < 0.0 goto Chapter1_FailMission
	}
	Actions
	{
		
		DestroyModule "#SplineObj"
		DestroyModule "#KeyLocation" 
		DestroyModule "#CubeSecret"
				
			
		SendToModule "#General" "#SetMessage=Find_The_Cube" "#SetMessageTimer=7"
		DestroyModule "#Timer"
		CreateModule "#Timer" "#Timer" "Time=60.0"
		;SendToModule "#Optimus" "#DirectSpline=D6LOC0_OPTIMUSGOTO" "#Script=FollowSplineM" "#AddToRadarOff" "#NoHealthBar" "#KeyLocation=Off"
		
		;CreateModule "#Creature" "#Lure" "#Spline=D6LOC1_Spawn" "#Script=StandAndWait" "#count=10000" "#maxalive=1" "#Type=DronePickupTruck_a" "#SpawnAsCreature" "#SpawnInLOSInit" "#SetEnergyMax=1200" "#SetEnergy=1200" "#Invulnerable"
		;SendToModule "#Optimus" "#Script=StandAndShoot" "#TargetLinkedMod=#Lure" "#AddToRadarOff" "#NoHealthBar" "#KeyLocation=Off"
		SendToModule "#Optimus" "#DirectSpline=D6LOC1_OPTIMUSGOTO" "#Script=FollowSplineM" "#AddToRadarOff" "#NoHealthBar" "#KeyLocation=Off"
		SendToModule "#Starscream" "#KeyLocation=Off"
		CreateModule "#AreaRange" "#AreaRange" "#KeyLocSpline=D6C1KEYLOC3" "#AddToRadarOff" "#DontClampRadar"
		CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1SAM2" "#Wobble=2.0" "#Creature=#Creature" "#Time=5.0" "#NoDraw" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference" 
		;CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1SAM2" "#Wobble=2.0" "#Creature=#EnergonDrone" "#Time=5.0" "#SpawnTime=0.0" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference" "#NoDraw"
		
	}

}
state Chapter1_AllSparkHunt6
{
	Conditions
	{
		;if module "Destruction GetPercentageComplete" >= 1.0 goto Chapter1_AllSparkHunt7
		if module "CubeSecret FoundRand" == 1.0 goto Chapter1_AllSparkHunt7
		if module "KeyLocation InArea" == 0.0 goto Chapter1_GlobalRadarJam
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
		
	}
	Actions
	{
		
		
		DestroyAllModules ;"#IncludeProtected"
		
		;CreateModule "#GABIChange" "#Destruction" "#GABIChange=-15000"
		
		SendToModule "#General" "#SetMessageTimer=-1" "#CountAInc"
		
		CreateModule "#BuildingSecret" "#CubeSecret" "#Spline=D6C1BUILD3" "#FuzzyRange=20" "#MinRand=0.3" "#MaxRand=0.4" ;"#DrawHealthBar"
		
		;CreateModule "#GABIChange" "#Destruction" "#GABIChange=-15000"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=D6C1KEYLOC3" "#String=Key12Goto" "#ReEnterMsg=Key16Return" "#GreyKeyLoc" 
		SendToModule "#SplineObj" "#AddToRadarOff"
		
		
	}

}
state Chapter1_AllSparkHunt7
{
	Conditions
	{
		;if module "AreaRange InArea" == 1.0 goto Chapter1_AllSparkHunt8
		
		if module "Timer Timer" < 0.0 goto Chapter1_FailMission
	}
	Actions
	{
		DestroyAllModules
		DestroyModule "#SplineObj"
		DestroyModule "#KeyLocation" 
		DestroyModule "#CubeSecret"
				
			
		;SendToModule "#General" "#SetMessage=Find_The_Cube" "#SetMessageTimer=7"
		;DestroyModule "#Timer"
		;CreateModule "#Timer" "#Timer" "Time=60.0"
	
		;CreateModule "#AreaRange" "#AreaRange" "#KeyLocSpline=D6C1KEYLOC4" "#AddToRadar" "#DontClampRadar"
		CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1SAM3" "#Wobble=2.0" "#Creature=#Creature" "#Time=3.0" "#NoDraw" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference" 
		;CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1SAM3" "#Wobble=2.0" "#Creature=#EnergonDrone" "#Time=3.0" "#SpawnTime=0.0" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference" "#NoDraw"
		
		DestroyModule "#Optimus"

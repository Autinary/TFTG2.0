state Chapter2_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" "#FadeUp"
		SetState "Chapter2_Goto"
	}
}
state Chapter2_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter2_HubRestart
	}
	actions
	{
		SendToModule "#General" "#EndOfMission"  "#DeathFailMission"
	}
}
state Chapter2_PostC1InitGoto
{
	actions
	{

		DestroyAllModules "#IncludeProtected"

		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
    	SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming

		SendToModule "#General" "#SetPlayer=#COMPPOINT5" 
		

		SetState "Chapter2_Goto"
	}
}
state Chapter2_InitGoto
{
	actions
	{
		DestroyAllModules "#IncludeProtected"

		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
    	SendToModule "#General" "#ResponseLv_ClampMax   = 5"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming

		SetState "Chapter2_Goto"
	}
}
state Chapter2_Goto
{
	actions
	{
		SendToModule "#General" "#AllowPlayerMovement"
		
		Idle 2.0
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A5_ch2_Goto" "#AutoDestroy" "#Start" 
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A5_ch2_Goto2" "#AutoDestroy"
		
		Idle 3.0
		
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=60" "#times=1" 
		CreateModule "#AndSwitch" "#AndSwitchReminder" "#moduletag=#DelayedSendReminder" "#placement=#Chapter2Beacon" "#rangeoutside=75"
		SetState "GlobalActionRing"
	}
}
state Chapter2_Enter
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter2_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter2_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro=#A5C2Intro"
	}
}
state Chapter2_LoadCreatures
{
	conditions
	{
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter2_Main
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"
		SendToModule "#General" "#PlayerType=Jazz"
		SendToModule "#General" "#UnLoadCreature=EnergonDrone"
		SendToModule "#General" "#UnLoadCreature=DroneForklift"
		SendToModule "#General" "#UnLoadCreature=DroneDefault"
		SendToModule "#General" "#LoadCreature=StarScream"
        SendToModule "#General" "#LoadCreature=DroneMig"
	
	SendToModule "#General" "#LoadCreature=DroneArmouredCar_a"
	SendToModule "#General" "#LoadCreature=DroneForklift_a"
       ; SendToModule "#General" "#LoadCreature=Blackout"
	}
}
ActionMacro MigAction
{
	CreateModule "#Creature" "#CreatureWaveC" "#Type=DroneMig" "#Spline=A5C2MigJetStart1" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsVehicle" "#Script=SpawnIntro" "#FollowSpline=A5C2MigJetLand1" "#SetEnergyMax=1500" "#SetEnergy=1500"
	CreateModule "#Creature" "#CreatureWaveD" "#Type=DroneMig" "#Spline=A5C2MigJetStart2" "#SetPosition=#MigSpawn2" "#count=1" "#maxalive=1" "#addtoradar" "#SpawnInLosInit" "#SpawnAsVehicle" "#Script=SpawnIntro" "#FollowSpline=A5C2MigJetLand2" "#SetEnergyMax=1500" "#SetEnergy=1500"
	Idle 0.7
	SendToModule "#A5C2DefeatStarscream" "#StartOneShot"  
	Idle 5.0 
	SendToModule "#CreatureWaveC" "#Script=Mig29Drone"
	SendToModule "#CreatureWaveD" "#Script=Mig29Drone"
	SendToModule "#General" "#CountCSet=1"

} 


state Chapter2_Main
{
	conditions
	{
		if Timer > 4.0 goto Chapter2_StarScreamBombingRun_Enter

		if module "A5C2KeyLoc FailMission" == 1.0 goto Chapter2_FailMission
    }

	actions
	{
		SetMusic "ACTION Mission2_1 QUIET Generic Play Action"
		ResetTimer
		SetDeathPoint "Chapter2_DeathFailMission"

        DestroyModule "#GotoReminderSpeech" 
		CreateModule "#Speech" "#A5C2DefeatStarscream" "#speech=#A5_ch2_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"

		SendToModule "#General" "#ResetLevel" "#SetPlayer=#Chapter2Start" "#FadeUp"
		SendToModule "#General" "#SetMaxOpponents=9" "#SetMaxApproachers=9" "#SetAttackRingSize=20"
		CreateModule "#KeyLocation" "#A5C2KeyLoc" "#Spline=A5C2KeyLocCentre" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#HeadType=#Optimus" ; "#UseHeight"

		
		CreateModule "#Creature" "#Ratchet" "#Spline=A5C1KeyLoc" "#Type=DroneArmouredCar_a" "#count=1" "#maxalive=1" "#AddToRadar" "#SpawnAsCreature" "#Script=Ratchet"  "#InVulnerable" "#SetEnergyMax=1500" "#SetEnergy=1500" "#SetEnergyMin=899.0" "#SetPosition=#RatchetSpawn2"
		CreateModule "#Goto" "#RangeTracker" "#Spline=A5C2KeyLocCentre" "#SetPosition=#A5C2RangeTracker" "#count=1" "#maxalive=1" "#Type=DroneForklift_a" "#AddToRadarOff" "#Unstoppable" "#SuppressShield" "#Friend" "#Script=StandAndWait" 
		

		SendToModule "#General" "#CountSet=0" "#CountASet=0" "#CountBSet=0" "#CountCSet=0" "#CountDSet=1"

		SendToModule "#General" "#TrafficLv = 0"                        ; lock traffic level (1-5) (0=OFF)
		SendToModule "#General" "#PatrolLv = 0"                         ; patrol level (1=ON, 0=OFF)

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 2"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 2"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 2"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
	}
}


state Chapter2_StarScreamBombingRun_Enter
{
	conditions
	{
		if module "A5C2KeyLoc FailMission" == 1.0 goto Chapter2_FailMission
    }

	actions
	{
		CreateModule "#Goto" "#Creature" "#Type=StarScream" "#Spline=A5C2StarScreamStart" "#addtoradar" "#Count=1" "#MaxAlive=1" "#SpawnInLosInit" "#SpawnAsVehicle" "#Script=DummyAircraft" "#SetEnergyMin=100" "#BlockDeath" ; "#SetEnergyMin=1425"

		
		SendToModule "#RangeTracker" "#Link=#Creature"

		CreateModule "#CreatureBombingRun" "#CreatureBombingRun" "#ModuleTag=#Creature" "#Spline=A5C2brun_sn" "#Spline=A5C2brun_ns" "#Spline=A5C2brun_ew" "#Spline=A5C2brun_we1"  "#DrawHealthBar" "#HeadType=#Starscream" "#SetHealthHeadIndex=1" "#NoDraw"
 
        ;; spline roll points
		SendToModule "#CreatureBombingRun" "#AddSplineRollPoint=A5C2brun_sn 400  360"
		SendToModule "#CreatureBombingRun" "#AddSplineRollPoint=A5C2brun_sn 800 -360"

        ;; spline roll points
		SendToModule "#CreatureBombingRun" "#AddSplineRollPoint=A5C2brun_ns 500  360"
	
        ;; spline roll points
		SendToModule "#CreatureBombingRun" "#AddSplineRollPoint=A5C2brun_ew 600  -360"

        ;; spline roll points
		SendToModule "#CreatureBombingRun" "#AddSplineRollPoint=A5C2brun_we1 600 360"

        SetState "Chapter2_StarScreamBombingRun"
	}
}

state Chapter2_StarScreamBombingRun
{
	

	actions
	{
		SendToModule "#Creature" "#SetEnergy=#Maximum"
		SendToModule "#CreatureBombingRun" "#NumRuns=9999" "#UseFirstSpline" "#SpeedValueMin=225" "#SpeedValueMax=600" "#MeleeScript=StarScream" "#MeleeTime=45" "#MeleeEnergyLeave=0.1" "#MeleeLeaveScript=FlyOff_I" "#ForceTransformEnergy=0.80"
   		CreateModule "#Speech" "#StarScreamStillInAir1" "#speech=#A5_ch2_obj6" "#AutoDestroy" 
		CreateModule "#Speech" "#StarScreamStillInAir2" "#speech=#A5_ch2_obj3" "#AutoDestroy" 	
		SetState Chapter2_StarScreamFlightProcess
	 }
}
state Chapter2_StarScreamFlightProcess
{
	conditions
	{

		;;;Bombing Run Process

		if module "Creature Health" < 0.79 and
				if module "General GetCountA" == 0.0 goto StarscreamRobotMode

		if module "RangeTracker GetLinkedDist" < 70 and 
			if module "General GetCountB" == 0.0 and
				if module "General GetCountA" == 0.0 goto StarscreamFlyingIn
		if module "RangeTracker GetLinkedDist" > 200 and 
			if module "General GetCountB" == 1.0 and
				if module "General GetCountA" == 0.0 goto StarscreamFlewBy

		if module "General GetCountC" == 2.0 and
				if module "General GetCountA" == 0.0 goto Chapter2_ShootHimDown

		if module "General GetCountC" == 6.0 and
				if module "General GetCountA" == 0.0 goto Chapter2_ShootHimDownAlready

		;if module "Creature IsEnergyAtMin" == 1.0 and
		;	if module "General GetCountA" == 0.0 goto CheckStarScreamHealth

		;;;Ratchet
		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter2_FailMission
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountD" == 1.0 goto Chapter2_HealP1A
		


		if module "A5C2KeyLoc FailMission" == 1.0 goto Chapter2_FailMission
	}
}
ActionMacro AutoHeal2
{
	
	SendToModule "#Ratchet" "#Script=Heal" "#SuppressShield"
	SendToModule "#General" "#CountDSet=0"
	IncreasePlayerHealth 65.0
	Idle 2.8
	SendToModule "#Ratchet" "#AddToRadarOff" "#SuppressShieldOff"
	Idle 7.0
	SendToModule "#Ratchet" "#AddToRadar" 
	SendToModule "#General" "#CountDSet=1"	

}
state Chapter2_HealP1A
{
	
	actions
	{
		DoMacro AutoHeal2
		SetState Chapter2_StarScreamFlightProcess
		
	}
}
state Chapter2_StarScreamBossProcess
{
	conditions
	{

		;;;Boss Process

		

		if module "MigIncoming FailMission" == 1.0 goto Chapter2_MigJetAction
		

		if module "CreatureBombingRun Finish" == 1.0 and
				if module "General GetCountA" == 1.0 goto Chapter2_StarscreamBail
		if module "CreatureWaveC Complete" == 1.0 and
				if module "CreatureWaveD Complete" == 1.0 and
					if module "General GetCountC" == 1.0 goto Chapter2_MigDead

		if module "General GetCount" == 2.0 goto Chapter2_StarScreamBombingRunSurvive

		
		if module "A5C2KeyLoc FailMission" == 1.0 goto Chapter2_FailMission

		;;;Ratchet
		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter2_FailMission
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountD" == 1.0 and
				if module "General GetCountC" == 1.0 goto Chapter2_HealP1B
		if module "Ratchet PlayerRange" < 30 and  
			if module "General GetCountD" == 1.0 and
				if module "General GetCountC" == 2.0 goto Chapter2_HealP1B

	}
}
state Chapter2_HealP1B
{
	
	actions
	{
		DoMacro AutoHeal2
		SetState Chapter2_StarScreamBossProcess
		
	}
}

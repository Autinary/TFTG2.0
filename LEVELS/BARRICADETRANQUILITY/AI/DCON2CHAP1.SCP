		;SendToModule "#D2C1WaveC1" "#CreateWave=#Wave1"
		;SendToModule "#D2C1WaveC1" "#Creature=DroneDefault_a"		"#Spline=D2C1WaveC" "#KeyLocation=On" 
		;SendToModule "#D2C1WaveC1" "#Creature=DronePickupTruck_a"	"#Spline=D2C1WaveC" "#SplineStep=2" "#KeyLocation=On" 
		;SendToModule "#D2C1WaveC1" "#Creature=DronePickupTruck_a"	"#Spline=D2C1WaveC" "#SplineStep=4" "#KeyLocation=On" 
		;SendToModule "#D2C1WaveC1" "#Creature=DroneDefault_a"		"#Spline=D2C1WaveC" "#SplineStep=6" "#KeyLocation=On" 
		;SendToModule "#D2C1WaveC1" "#WaitEmpty" "#NoRender" "#RemoveBoss"
		;SendToModule "#D2C1WaveC1" "#WaitLoaded" "#NoRender" "#RemoveBoss"
		
		
	}
}
state Chapter1_MainCWave1
{
	conditions
	{
		;if module "D2C1WaveC2 Complete" == 1.0 goto Chapter1_Wait
		if module "D2C1Drone1 GetCountAlive" == 0.0 and
			if module "D2C1Drone2 GetCountAlive" == 0.0 and
				if module "D2C1Drone3 GetCountAlive" == 0.0 and
					if module "D2C1Drone4 GetCountAlive" == 0.0 goto Chapter1_Wait
		if module "D2C1KeyLocationC FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		SendToModule "#General" "#BG_UnLoadCreature=DroneDefault_a"
		SendToModule "#General" "#BG_LoadCreature=DroneArmouredCar_a"
		SendToModule "#General" "#BG_LoadCreature=DroneTowTruck_a"
		
		DestroyModule "#D2C1WaveC1"
		DestroyAllModules

		CreateModule "#Creature" "#D2C1Drone1" "#Type=DroneArmouredCar_a" "#Spline=D2C1WaveC" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementV" "#Script=Combat"  
		CreateModule "#Creature" "#D2C1Drone2" "#Type=DroneTowTruck_a" "#Spline=D2C1WaveC" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementX" "#Script=Combat" 
		CreateModule "#Creature" "#D2C1Drone3" "#Type=DronePickupTruck_a" "#Spline=D2C1WaveC" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementU" "#Script=Combat" 
		CreateModule "#Creature" "#D2C1Drone4" "#Type=DronePickupTruck_a" "#Spline=D2C1WaveC" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementW" "#Script=Combat" 

		Idle 0.1
		SendToModule "#D2C1Drone1" "#ForcePlayerAsOpp"
		SendToModule "#D2C1Drone2" "#ForcePlayerAsOpp"
		SendToModule "#D2C1Drone3" "#ForcePlayerAsOpp"
		SendToModule "#D2C1Drone4" "#ForcePlayerAsOpp"


		;CreateModule "#AttackWave" "#D2C1WaveC2" "#NoRender" "#RemoveBoss"
		;SendToModule "#D2C1WaveC2" "#CreateWave=#Wave1"
		;SendToModule "#D2C1WaveC2" "#Creature=DroneArmouredCar_a"	"#Spline=D2C1WaveC" "#SplineStep=8" "#KeyLocation=On"  "#Script=Combat" 
		;SendToModule "#D2C1WaveC2" "#Creature=DronePickupTruck_a"	"#Spline=D2C1WaveC" "#SplineStep=10" "#KeyLocation=On"  "#Script=Combat" 
		;SendToModule "#D2C1WaveC2" "#Creature=DroneTowTruck_a"		"#Spline=D2C1WaveC" "#SplineStep=12" "#KeyLocation=On"   "#Script=Combat" 
		;SendToModule "#D2C1WaveC2" "#Creature=DronePickupTruck_a"	"#Spline=D2C1WaveC" "#SplineStep=14" "#KeyLocation=On"  "#Script=Combat" 
		;SendToModule "#D2C1WaveC2" "#WaitEmpty" "#NoRender" "#RemoveBoss"
		;SendToModule "#D2C1WaveC2" "#WaitLoaded" "#NoRender" "#RemoveBoss"
		;Idle 0.1
		;CreateModule "#Timer" "#Destruction" "#Time=150.0" "#DrawHealthBar" "#HeadType=#Destruction" "#Index=2" "#Random"
		;CreateModule "#Timer" "#Destruction2" "#Time=150.0" "#DrawHealthBar" "#HeadType=#Destruction" "#Random"
		;DestroyModule "#Destruction"
		;DestroyModule "#Destruction2"
		
	}
}
state Chapter1_Wait
{
	conditions
	{
		
		if module "Timer FailMission" == 1.0 goto Chapter1_MainCWave2
	}
	actions
	{
		DestroyAllModules
		;SendToModule "#General" "#BG_LoadCreature=DroneCement_a"
		SendToModule "#General" "#BG_UnLoadCreature=DronePickupTruck_a"
    		SendToModule "#General" "#BG_UnLoadCreature=DroneTowTruck_a"
    		SendToModule "#General" "#BG_UnLoadCreature=DroneArmouredCar_a"	
		SendToModule "#General" "#BG_LoadCreature=DroneCement_a"	
		CreateModule "#Timer" "#Timer" "#Time=4.0" "#NoRender" "#Start"
                
	}
}
state Chapter1_MainCWave2
{
	conditions
	{
		if module "D2C1WaveC3 GetPercentageComplete" == 1.0 goto Chapter1_Complete
		if module "D2C1Drone1 GetCountAlive" == 0.0 goto Chapter1_Complete
		if module "D2C1KeyLocationC FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{
		DestroyModule "#D2C1WaveC2"
		SendToModule "#General" "#UnLoadCreature=DronePickupTruck_a"
    		SendToModule "#General" "#UnLoadCreature=DroneTowTruck_a"
    		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar_a"	
		SendToModule "#General" "#LoadCreature=DroneCement_a"

		CreateModule "#Creature" "#D2C1Drone1" "#Type=DroneCement_a" "#Spline=D2C1WaveC" "#MaxAlive=1" "#Count=1" "#SpawnInLOSInit" "#KeyLocation=On" "#SetPosition=#D2C1PlacementY" "#Script=CACCombat"

		Idle 0.1
		SendToModule "#D2C1Drone1" "#ForcePlayerAsOpp"
		


		;CreateModule "#AttackWave" "#D2C1WaveC3" "#NoRender" "#RemoveBoss"
		;SendToModule "#D2C1WaveC3" "#CreateWave=#Wave1"
		;SendToModule "#D2C1WaveC3" "#Creature=DroneCement_a"    "#Spline=D2C1WaveC" "#SplineStep=16" "#KeyLocation=On" "#Script=CACCombat"
		;SendToModule "#D2C1WaveC3" "#WaitEmpty" "#NoRender" "#RemoveBoss"
		;Idle 0.1
		;CreateModule "#Timer" "#Destruction" "#Time=150.0" "#DrawHealthBar" "#HeadType=#Destruction" "#Index=2" "#Random"
		;CreateModule "#Timer" "#Destruction2" "#Time=150.0" "#DrawHealthBar" "#HeadType=#Destruction" "#Random"
		;DestroyModule "#Destruction"
		;DestroyModule "#Destruction2"
	
	}
}
state Chapter1_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter1_FailMission
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter1_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state Chapter1_Restart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"

    	SendToModule "#General" "#UnLoadCreature=DroneCement_a"
    	SendToModule "#General" "#UnLoadCreature=DronePickupTruck_a"
    	SendToModule "#General" "#UnLoadCreature=DroneTowTruck_a"
    	SendToModule "#General" "#UnLoadCreature=DroneArmouredCar_a"
    	SendToModule "#General" "#LoadCreature=DroneDefault_a"
		
		SendToModule "#General" "#PlayerType=Barricade,Barricade,Barricade,Barricade,Barricade"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter1Restart" "#FadeUp"
		SetState "GlobalActionRing"
	}
}
state Chapter1_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter1_CompleteVideo
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT1" "#Spline=COMCAM1" "#SetFocus=CAMFOCUS1"
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#CompleteMission" 
		SendToModule "#ActionRing" "#SetCompleted=#Chapter1" "#Unlock=#Chapter2"
	}
}
state Chapter1_CompleteVideo
{
	conditions
	{
		;if module "General VideoFinished" == 1.0 goto Chapter1_CompleteVideoFinished
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		;SendToModule "#General" "#StartOutroVideo=#D2C1Outro"
		SetState "Chapter1_CompleteVideoFinished"
	}
}
state Chapter1_CompleteVideoFinished
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter1_Leave
	}
	actions
	{
    	SendToModule "#General" "#UnLoadCreature=DroneCement_a"
    	SendToModule "#General" "#UnLoadCreature=DronePickupTruck_a"
    	SendToModule "#General" "#UnLoadCreature=DroneTowTruck_a"
    	SendToModule "#General" "#UnLoadCreature=DroneArmouredCar_a"
    	SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#PlayerType=Barricade,Barricade,Barricade,Barricade,Barricade"

		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter1_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter2"
		IncreasePlayerHealth max
		setstate "PickGoto" ;goto next chapter
	}
}

		;CreateModule "#DriverDrone" "#GotoDroneD" "#spline=A3C1SS7Drone4old" "#splinestep=6" "#maxalive=1" "#count=1" "#FollowSpline=A3C1SS7Drone4old" "#WaitEnd" "#spacing=1.0" "#goalrange=8.0" "#type=Sector7Drone" "#Location=#AlarmDot" "#DontClampRadar" "#Object=#Sector7Dot" "#Warning=A3C1BlastDoors" "#SpawnInLOSInit" "#DrawHealthBar" "#Speed=65" "#IgnorePaths"  "#energy=100" 
		SendToModule "#General" "#TriggerObjectSwitch=8"
	}

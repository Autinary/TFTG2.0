state Chapter2_PlayCameraF
{
	
	Actions
	{
		SetMusic "ACTION Mission2_2 QUIET Generic Play Action"
		SendToModule "#Timer" "#AddTime=90.0"
		SendToModule "#A3C2TunnelF" "#EndExplosion"
		SendToModule "#ProgressPoint" "#ClearAnyBeenTriggered"
		CreateModule "#SplineCamera" "#SplineCamera" "#SetPosition=A3C2CameraF" "#SetFocus=A3C2FocusF" "#CreatureMove=A3C2CreatureF" "#SetTime=3.5"
		SetState Chapter2_WaitForCam
	}
}
state Chapter2_WaitForCam
{
	conditions
	{
		if module "A3C2TunnelA GetPercentageComplete" == 1.0 and
			if module "A3C2TunnelB GetPercentageComplete" == 1.0 and
				if module "A3C2TunnelC GetPercentageComplete" == 1.0 and
					if module "A3C2TunnelD GetPercentageComplete" == 1.0 and
						if module "A3C2TunnelE GetPercentageComplete" == 1.0 and
							if module "A3C2TunnelF GetPercentageComplete" == 1.0 goto Chapter2_Outro
		if module "SplineCamera GetPercentageComplete" == 1.0 goto Chapter2_TunnelHubIntro

	}
}


state Chapter2_TunnelHubIntro
{
	conditions
	{
		if module "DroneCounter DronesDefeated" == 1.0 goto Chapter2_TunnelHubSpeech1
		if module "DroneCounter DronesDefeated" == 2.0 goto Chapter2_TunnelHubSpeech2
		if module "DroneCounter DronesDefeated" == 3.0 goto Chapter2_TunnelHubSpeech3
		if module "DroneCounter DronesDefeated" == 4.0 goto Chapter2_TunnelHubSpeech4
		if module "DroneCounter DronesDefeated" == 5.0 goto Chapter2_TunnelHubSpeech5
		if AlwaysTrue == 1.0 goto Chapter2_TunnelHub
	}
}

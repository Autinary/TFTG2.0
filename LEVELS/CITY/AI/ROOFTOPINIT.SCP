state CycleCount
{
	actions
	{
		SendToModule "#General" "#CountAInc" 
		SetState TrackHubZone

	}
}
state CycleReset
{
	actions
	{
		SendToModule "#General" "#CountASet=0" 
		SetState TrackHubZone

	}
}
state CycleReset2
{
	actions
	{
		SendToModule "#General" "#CountSet=0"
		SetState TrackHubZone

	}
}
state InHubZoneA 
{
	conditions
	{
		if module "SubMissions GetSubMissionAnyBeenTriggered" == 1.0 goto SubMission_Init
		if module "ActionRing AnyBeenTriggered"  == 1.0 goto GlobalStartChapter

		
		if module "General GetCountA" <= 2.0 goto SetZoneADroneGroup1Init
		if module "General GetCountA" <= 4.0 goto SetZoneADroneGroup2Init
		if module "General GetCountA" <= 6.0 goto SetZoneADroneGroup3Init
		if module "General GetCountA" <= 9.0 goto SetZoneADroneGroup4Init
		

		
		if Timer > 0.2 goto SetZoneADroneGroup1Init
		
	}
	actions
	{
		ResetTimer 
	}

}
state SetZoneADroneGroup1Init
{
	conditions
	{
		
		if module "General GetCountB" <= 2.0 goto SetZoneADroneGroup2Init
		
		

		
		if Timer > 0.1 goto SetZoneADroneGroup1
		
	}
	actions
	{
		ResetTimer 
	}

}
state SetZoneADroneGroup2Init
{
	conditions
	{
		
		if module "General GetCountB" <= 4.0 and
			if module "General GetCountB" > 2.0 goto SetZoneADroneGroup3Init
		
		

		
		if Timer > 0.1 goto SetZoneADroneGroup2
		
	}
	actions
	{
		ResetTimer 
	}

}

state Chapter1_Alarm
{
	
	actions
	{
		SetMusic "ACTION Mission1_4 QUIET Generic Play Action"
		SendToModule "#General" "#SetMessage=HIntD14" "#SetMessageTimer=3" "#DangerZoneOn"
		Idle 1.5
		CreateModule "#Speech" "#MISLST" "#speech=#A3_ch1_Fail" "#AutoDestroy" "#Start"
		Idle 0.2
		SetState Chapter1_FailMission
	}
}
state Chapter1_GotoControlRoom
{
	conditions
	{
		if module "A3C1TriggerA InArea" == 1.0 goto Chapter1_Complete
		if module "Timer Timer" < 0.0 goto Chapter1_FailMission
		
	}
	actions
	{
		SetMusic "ACTION Mission1_1 QUIET Generic Play Action"
		DestroyAllModules
		SendToModule "#General" "#SetMessage=GetToControlRoom" "#SetMessageTimer=7"
		CreateModule "#Timer" "#Timer" "Time=60.0"
		CreateModule "#AreaRange" "#A3C1TriggerA" "#Trigger=#A3C1TriggerA" "#SetRadarType=#Critical"
		
	}
}
state Chapter1_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter1_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission"  "#DeathFailMission"
	}
}
state Chapter1_FailMission
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter1_Restart
	}
	actions
	{
		SendToModule "#General" "#DangerZoneOff" "#EndOfMission"  "#FailMission"
	}
}
state Chapter1_Restart
{
	conditions
	{
		if timer > 0.2 goto Chapter1_Restart3
		if module "General ChapterProgress" >= 1.0 goto Chapter1_Restart2
		if module "General ChapterProgress" >= 2.0 goto Chapter1_Restart2
		if module "General ChapterProgress" >= 3.0 goto Chapter1_Restart2
		if module "General ChapterProgress" >= 4.0 goto Chapter1_Restart2
		
	}
	actions
	{
		
		DestroyAllModules "#IncludeProtected"

		SendToModule "#General" "#UnLoadCreature=DroneDefault"
		SendToModule "#General" "#UnLoadCreature=DroneCement"
		SendToModule "#General" "#UnLoadCreature=Barricade"

		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter1Restart" "#FadeUp"

		SendToModule "#General" "#RevertPlayerType"

		ResetTimer
	}
}
state Chapter1_Restart2
{
	actions
	{
		SetMusic "ACTION Mission1_1 QUIET Generic Play Action"
		SetState "GlobalActionRing"
	}
}
state Chapter1_Restart3
{
	conditions
	{
		
	}
	actions
	{
		;SetMusic "ACTION Mission1_1 QUIET Generic Play Action"	

		CreateModule "#AAGun" "#AAGun"
		SendToModule "#AAGun" "#Type=AAGUNTYPE_ROCKETS" "#Placement=TurretRocketGlobal" "#Range=100.0" "#Delay=1.5" "#Energy=100.0" "#RespawnDelay=30" "#Ammo=0" "#Create"


		SendToModule "#General" "#TrafficLv = 0"                       
		SendToModule "#General" "#PatrolLv = 0"                        

		SendToModule "#General" "#ResponseLv_FreeRoam"                  
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            
    	SendToModule "#General" "#ResponseLv_ClampMax   = 1"          
		SendToModule "#General" "#ResponseLv_Detection  = 0"  
		SendToModule "#General" "#ResponseLv_FreeRoamSet"     


		SetState "Chapter1_Restart4"
	}
}
state Chapter1_Restart4
{
	conditions
	{
		if module "Timer FailMission" == 1.0 goto Chapter1_Restart2
	}
	actions
	{
		SetMusic "ACTION Mission1_1 QUIET Generic Play Action"
		CreateModule "#Timer" "#Timer" "#Time=4" "#NoRender"
		;SetState "GlobalActionRing"
	}
}
state Chapter1_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter1_CompleteVideo
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT1" "#Spline=COMCAM1" "#SetFocus=CAMFOCUS1"
		SendToModule "#General" "#CountDSet=0"
		SendToModule "#General" "#CompleteMission" 
		SendToModule "#ActionRing" "#SetCompleted=#Chapter1" "#Unlock=#Chapter2"
		CreateModule "#Speech" "#A3C1BlastDoors" "#speech=#A3_ch1_cmplt" "#PlayDelay=1.2" "#AutoDestroy" "#Start"
		;SetState "Chapter1_CompleteVideo"
	}
}
state Chapter1_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter1_CompleteVideoFinished
	}
	actions
	{
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartOutroVideo=#A3C1Outro1"
	}
}
state Chapter1_CompleteVideoFinished
{
	conditions
	{
		if module "General GetFinishedOutro" == 1.0 goto Chapter1_Leave
	}
	actions
	{
		SendToModule "#General" "#FinishedOutroVideo"
	}
}
state Chapter1_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#ActionRing" "#Unlock=#Chapter2"
		SendToModule "#General" "#UnLoadCreature=DroneDefault"
		SendToModule "#General" "#UnLoadCreature=DroneCement"
		SendToModule "#General" "#UnLoadCreature=Barricade"
		IncreasePlayerHealth max
		setstate "PickGoto" ;goto next chapter
	}
}

		if module "Ratchet PlayerRange" < 30 and 
			if module "General GetCountA" == 1.0 goto Chapter2_Heal3

		
	}
	actions
	{

		ResetTimer
		SendToModule "#General" "#CountDSet=1"
		
		SendToModule "#CreatureWaveD" "#count=2" "#wiicount=2" 
		SendToModule "#CreatureWaveF" "#count=2" "#wiicount=2" 

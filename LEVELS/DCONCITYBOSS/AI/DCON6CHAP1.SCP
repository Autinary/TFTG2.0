		CreateModule "#Creature" "#Starscream" "#Spline=D6C1FIGHT1STARSCREAM" "#Script=Starscream" "#count=1" "#maxalive=1" "#Type=Starscream" "#SpawnAsCreature" "#SpawnInLOSInit" "#SetEnergyMax=4000" "#SetEnergy=500" "#SetEnergyMin=100" "#Friend" "#SetPosition=#D6C1_Starscream1" "#AddToRadarOff"
		CreateModule "#Creature" "#EnergonDrone" "#Script=EnergonDrone" "#count=10000" "#maxalive=3" "#Type=EnergonDrone" "#SpawnAsCreature" "#SpawnInLOSInit" "#ForcePlayerAsOpp" "#Protect" "#DontClampRadar"  "#Spline=D6C1BUILD1" "#KeyLocation=On" "#AddToRadarOff"
		CreateModule "#Creature" "#EnergonDrone2" "#Script=EnergonDrone" "#count=10000" "#maxalive=2" "#Type=EnergonDrone" "#SpawnAsCreature" "#SpawnInLOSInit" "#ForcePlayerAsOpp" "#Protect" "#DontClampRadar"  "#Spline=D6C1BUILD1" "#Friend" "#KeyLocation=On" "#AddToRadarOff"
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=D6LOC1_KEYLOC" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" "#GreyKeyLoc" 

		;CreateModule "#Creature" "#Creature" "#count=0" "#maxalive=2" "#addtoradaralways" "#Type=DronePickupTruck_a" "#TransformForceRobot" "#KeyLocation=On" "#SetEnergyMax=1200" "#Script=TruckDrone"
		;CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#Creature" "#Spline=D6LOC1_Meteors" "#Time=3" "#Time=5" 
		;CreateModule "#Creature" "#Creature2" "#count=0" "#maxalive=1" "#addtoradaralways" "#Type=DroneCement_a" "#TransformForceRobot" "#KeyLocation=On" "#SetEnergyMax=400" "#Script=MixerDrone"
		;CreateModule "#Meteorite" "#Meteorite2" "#ModuleTag=#Creature2" "#Spline=D6LOC1_Meteors" "#Time=7"

		;Move AllSpark	
		CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1SAM4" "#Wobble=2.0" "#Creature=#Creature" "#Time=9999.0" "#NoDraw" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference" 
		;CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D6C1SAM4" "#Wobble=2.0" "#Creature=#EnergonDrone" "#Time=9999.0" "#SpawnTime=0.0" "#Wobble=0.3" "#Start" "#Radar" "#SetRadarInterference" "#NoDraw"
		
		Idle 0.7
		SendToModule "#Starscream" "#Script=FlyOff_M"
		
	}
}


state Chapter3_Speech4
{
	
	actions {
		

		CreateModule "#Goto" "#RustedCar" "#Spline=DVCreateV" "#count=1" "#maxalive=1" "#Type=DronePickupTruck" "#SpawnInLOSInit" "#AddToRadarOff" "#Script=StandAndWait" "#Unstoppable" "#SetPosition=#ObjSet3" "#SuppressShield"
	
		
		SetState Chapter3_Watch
	}
}
state Chapter3_AddOnTimeA
{
	
	actions {
		;CreateModule "#Speech" "#DefeatDrones" "#AutoDestroy" "#speech=#D1C2HeadForBeacon" "#Start"
		SendToModule "#Timer" "#AddTime=30.0"
		SendToModule "#GoToDroneA" "#ClearTriggeredComplete"
		DestroyModule "#GoToDroneA"
		
		SendToModule "#DroneCounter" "#Increment=1"
		SetState Chapter3_SpeechMain
	}
}


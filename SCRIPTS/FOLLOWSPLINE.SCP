
INCLUDE "Rules.scp"

state Base
{
	Actions
	{
		SetFlag "TakeHitPhysics=false" "TakeHitMelee=false" "TakeHit=false" "StuckEscape=false"
		SetState Main
	}
}

state Main
{
	ReferenceScript
	{
		Script=FollowSplineVeh
		Source=Global
		ReturnState=Main
		Conditions
		{
			OnMacro RuleFollowVehicle
		}
	}

	ReferenceScript
	{
		Script=FollowSplineCre
		Source=Global
		ReturnState=Main
		Conditions
		{
			OnMacro RuleFollowRobot
		}
	}
}

		CreateModule "#Creature" "#CreatureWaveG" "#Spline=A2C2SpawnG" "#count=2000" "#wiicount=1" "#maxalive=1" "#Delay=4.0" "#addtoradar" "#Type=DroneForkLift" "#SpawnInLosInit" "#SpawnAsCreature" "#Script=Early_Combat" "#KeyLocation=On"

state Chapter3_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayerAtDeathPoint" "#FadeUp"
		SetState "Chapter3_Goto"
	}
}
state Chapter3_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter3_HubRestart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter3_InitGoto
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		CreateModule "#VehicleLevels" "#VehicleLevels" 
		SendToModule "#VehicleLevels" "#TrafficLv=1" "#PatrolLv=1" 

		SendToModule "#General" "#ResponseLv_FreeRoam"                  ; reset/default values for freeroaming
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
    	SendToModule "#General" "#ResponseLv_ClampMax   = 2"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_FreeRoamSet"               ; update/set the scripted values for freeroaming

		SetMusic "ACTION Mission2_1 QUIET Generic"
    	DestroyModule "#AAGunLaser"
		CreateModule "#AAGun" "#AAGunLaser" "#Protect"
		SendToModule "#AAGunLaser" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAJL" "#Range=100.0" "#Delay=0.5" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"

		DestroyModule "#AAGunRockets"
		CreateModule "#AAGun" "#AAGunRockets" "#Protect"
		SendToModule "#AAGunRockets" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAJR" "#Range=100.0" "#Delay=2.0" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"

		DestroyModule "#AAGunBullets"
		CreateModule "#AAGun" "#AAGunBullets" "#Protect"
		SendToModule "#AAGunBullets" "#Type=AAGUNTYPE_BULLITS" "#Placement=AAJB" "#Range=100.0" "#Delay=0.1" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"

		SetState "Chapter3_Goto"
	}
}
state Chapter3_Goto
{
	actions
	{
		SendToModule "#General" "#AllowPlayerMovement"
		DestroyModule "#MissionStartSpeech"
		
		Idle 2.0
		 
		Idle 3.0
		SetMusic "ACTION Mission2_1 QUIET Generic"
		CreateModule "#AndSwitch" "#AndSwitchReminder" "#moduletag=#DelayedSendReminder" "#placement=#Chapter2Beacon" "#rangeoutside=75"
		SetState "GlobalActionRing"
	}
}
state Chapter3_Enter
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter3_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter3_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules "#IncludeProtected"
		
		SendToModule "#General" "#ResponseLvPlayerDetected=0"
		
;		CreateModule "#VehicleLevels" "#VehicleLevels" "#ResponseLv=3" "#TrafficLv=3" "#PatrolLv=0"
		CreateModule "#VehicleLevels" "#VehicleLevels" "#Protect"
		SendToModule "#VehicleLevels" "#TrafficLv=1" "#PatrolLv=1"

		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 1"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 1"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 1"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission


		DestroyModule "#AAGunLaser"
		CreateModule "#AAGun" "#AAGunLaser" "#Protect"
		SendToModule "#AAGunLaser" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAJL" "#Range=100.0" "#Delay=0.5" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"

		DestroyModule "#AAGunRockets"
		CreateModule "#AAGun" "#AAGunRockets" "#Protect"
		SendToModule "#AAGunRockets" "#Type=AAGUNTYPE_ROCKETS" "#Placement=AAJR" "#Range=100.0" "#Delay=2.0" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"

		DestroyModule "#AAGunBullets"
		CreateModule "#AAGun" "#AAGunBullets" "#Protect"
		SendToModule "#AAGunBullets" "#Type=AAGUNTYPE_BULLITS" "#Placement=AAJB" "#Range=100.0" "#Delay=0.1" "#Energy=300.0" "#RespawnDelay=-1" "#Ammo=0" "#Create"

		SendToModule "#General" "#StartMissionIntro=" "#SetPlayerDeathPoint=#Chapter2Restart"
	}
}
state Chapter3_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter3_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter3_Main
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"

		SendToModule "#General" "#LoadCreature=DronePickupTruck" 
		SendToModule "#General" "#PlayerType=Scorponok"
	}
}

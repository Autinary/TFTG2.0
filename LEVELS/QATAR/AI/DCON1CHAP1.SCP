state Chapter1_Main
{
	conditions
	{
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter1_Complete
		
		
		if module "DestructTime FailMission" == 1.0 goto Chapter1_FailMission
		if message "MissionMessage" == 2.0 goto Chapter1_FailMission 

		
        }
	actions
	{
		SetMusic "ACTION Mission1_2 QUIET Generic Play Action"
		SetDeathPoint "Chapter1_DeathFailMission"

		CreateModule "#Goto" "#Gunship" "#Spline=DVCreateV" "#count=1" "#maxalive=1" "#Type=DroneForklift" "#SpawnInLOSInit" "#AddToRadarOff" "#Script=StandAndWait" "#Unstoppable" "#SetPosition=#ObjSet1c"
		CreateModule "#Goto" "#ArtilleryTurret" "#Spline=DVCreateV" "#count=1" "#maxalive=1" "#Type=DroneDefault" "#SpawnInLOSInit" "#AddToRadarOff" "#Script=StandAndWait" "#Unstoppable" "#SetPosition=#ObjSet2a"
		

		CreateModule "#Speech" "#DefeatDrones" "#GotoReminderSpeech"  "#PlayDelay=2" "#speech=#D1_ch1_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
                CreateModule "#Speech" "#PlayDelay=5" "#GotoReminderSpeech" "#speech=#D1_ch1_obj2" "#AutoDestroy" "#Start"
              ;  CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj3" "#AutoDestroy" "#Start"
		;CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj4" "#AutoDestroy" "#Start"
		;CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj5" "#AutoDestroy" "#Start"
		;CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj6" "#AutoDestroy" "#Start"
                ;CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj7" "#AutoDestroy" "#Start"
		SendToModule "#General" "#PhysObj" "#Building" "#SetPlayer=#Chapter1Start" "#FadeUp" "#DangerZoneOn" "#CountSet=0" "#CountASet=2" "#CountBSet=0" "#CountDSet=0"
		
		CreateModule "#GABIChange" "#Destruction" "#GABIChange=-25000"
		CreateModule "#Timer" "#DestructTime" "#Time=210" #ShowHundredths

		CreateModule "#DriverDrone" "#CreatureWaveA" "#spline=A1C1TankA" "#maxalive=1" "#count=1" "#SpawnInLOSInit" "#FollowPlayer" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire"
		CreateModule "#DriverDrone" "#CreatureWaveB" "#spline=A1C1TankB" "#maxalive=1" "#count=1" "#SpawnInLOSInit" "#FollowPlayer" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire"
		CreateModule "#DriverDrone" "#CreatureWaveC" "#spline=A1C1TankC" "#maxalive=1" "#count=1" "#SpawnInLOSInit" "#FollowPlayer" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire"
		CreateModule "#DriverDrone" "#CreatureWaveD" "#spline=A1C1TankD" "#maxalive=1" "#count=1" "#SpawnInLOSInit" "#FollowPlayer" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire"
		CreateModule "#DriverDrone" "#CreatureWaveE" "#spline=A1C1TankE" "#maxalive=1" "#count=1" "#SpawnInLOSInit" "#FollowPlayer" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire"
		CreateModule "#DriverDrone" "#CreatureWaveF" "#spline=A1C1TankF" "#maxalive=1" "#count=1" "#SpawnInLOSInit" "#FollowPlayer" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire"
		CreateModule "#DriverDrone" "#CreatureWaveG" "#spline=A1C1TankG" "#maxalive=1" "#count=1" "#SpawnInLOSInit" "#FollowPlayer" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire"
		CreateModule "#DriverDrone" "#CreatureWaveH" "#spline=A1C1TankH" "#maxalive=1" "#count=1" "#SpawnInLOSInit" "#FollowPlayer" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire"
		CreateModule "#DriverDrone" "#CreatureWaveI" "#spline=A1C1TankI" "#maxalive=1" "#count=1" "#SpawnInLOSInit" "#FollowPlayer" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire"

		;CreateModule "#DriverDrone" "#CreatureWaveJ" "#spline=DVCreateV" "#maxalive=5" "#count=5000" "#SpawnInLOSInit" "#FollowPlayer" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire"
		;CreateModule "#DriverDrone" "#CreatureWaveK" "#spline=DSGuns" "#maxalive=8" "#count=5000" "#SpawnInLOSInit" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire" #IgnorePaths #WaitEnd
		;CreateModule "#DriverDrone" "#CreatureWaveL" "#spline=DSCreateV" "#maxalive=5" "#count=5000" "#SpawnInLOSInit" "#FollowPlayer" "#type=ShilkaTracer" "#GoalRange=40.0" "#CullRange=150.0" "#NoShibby" "#RapidInitFire"
		

		;CreateModule "#Bombing" "#Bombing" "#RangeMin=0.0" "#RangeMax=40.0" "#Delay=0.2" "#RandomDelay=0.2" "#VFXmode=VFX_BLITZ"

         ;CreateModule "#AirAttack" "#AirAttack" "NumWaves=1" 
         ;SendToModule "#AirAttack" "#Total=3" "#VehicleTypes=DDRIVETYPE_F22" "#Spline=D1C1_Patrol1" "#SplinePos=1500" "#HeightOffset=60.0" "#CruiseSpd=100" "#AttackSpd=75" "#NumBomb=1" "#NumRocket=5" "#BombDelay=5.0" "#RocketDelay=1.5" "#WeaponAccuracy=0.0" "#WeaponBias=0.5" "#Energy=150.0" "#HesitationTime=2.5" #HeatSeekToPlayer "#CreateWave=1"

	 ;CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=30" "#times=7" 
		

		SendToModule "#CreatureWaveI" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveH" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveG" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveF" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveE" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveD" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveC" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveB" "#Object=#RedSmallDot" "#AddToRadarAlways"
		SendToModule "#CreatureWaveA" "#Object=#RedSmallDot" "#AddToRadarAlways"

		Idle 1.0
		SendToModule "#General" "#SetMessage=QS3" "#SetMessageTimer=3.0" 


		SetState Chapter1_Process

	}
}
state Chapter1_Process
{
	conditions
	{
		



		if module "AirAttack WaveDestroyed" == 1.0 and
			if module "General GetCount" == 5.0 goto Chapter1_AirAttackWave2
		if module "AirAttack WaveDestroyed" == 2.0 and
			if module "General GetCount" == 6.0 goto Chapter1_AirAttackWave3
		if module "AirAttack WaveDestroyed" == 3.0 and
			if module "General GetCount" == 7.0 goto Chapter1_AirAttackWave4
		if module "AirAttack WaveDestroyed" == 4.0 and
			if module "General GetCount" == 8.0 goto Chapter1_AirAttackWave5
		if module "AirAttack WaveDestroyed" == 7.0 goto Chapter1_DestroyComServerEarly
		


		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter1_Complete
		
		
		if module "DestructTime FailMission" == 1.0 goto Chapter1_FailMission
		if message "MissionMessage" == 2.0 goto Chapter1_FailMission 



		

		if module "CreatureWaveA GetPercentageComplete" == 1.0 goto Chapter1_CullA
		if module "CreatureWaveB GetPercentageComplete" == 1.0 goto Chapter1_CullB
		if module "CreatureWaveC GetPercentageComplete" == 1.0 goto Chapter1_CullC
		if module "CreatureWaveD GetPercentageComplete" == 1.0 goto Chapter1_CullD
		if module "CreatureWaveE GetPercentageComplete" == 1.0 goto Chapter1_CullE
		if module "CreatureWaveF GetPercentageComplete" == 1.0 goto Chapter1_CullF
		if module "CreatureWaveG GetPercentageComplete" == 1.0 goto Chapter1_CullG
		if module "CreatureWaveH GetPercentageComplete" == 1.0 goto Chapter1_CullH
		if module "CreatureWaveI GetPercentageComplete" == 1.0 goto Chapter1_CullI
		if module "CreatureWaveJ GetPercentageComplete" == 1.0 and
			if module "CreatureWaveK GetPercentageComplete" == 1.0 goto Chapter1_CullJK

		
		if module "General GetCountD" >= 6.0 and
			if module "General GetCount" == 0.0 goto Chapter1_TankDeploymentA

		if module "General GetCountD" >= 9.0 and
			if module "General GetCount" == 1.0 goto Chapter1_TankDeploymentB

		;if module "General GetCountD" == 7.0 and
		;	if module "General GetCount" == 2.0 goto Chapter1_TankDeploymentC

		if module "General GetCountD" == 9.0 and
			if module "General GetCount" == 3.0 goto Chapter1_JetDeployment

	


		if module "General GetCount" == 4.0 goto Chapter1_EnhanceBanter

		

		if Timer > 30 and
			if module "General GetCountA" <= 6.0 and
				if module "General GetCountD" == 9.0 goto Chapter1_Banter
		
	}
	actions
	{
		ResetTimer
	}
}
state Chapter1_EnhanceBanter
{
	conditions
	{
		if module "General GetCountA" == 2.0 goto Chapter1_SetBanterA
		if module "General GetCountA" == 3.0 goto Chapter1_SetBanterB
		if module "General GetCountA" == 4.0 goto Chapter1_SetBanterC
		if module "General GetCountA" == 5.0 goto Chapter1_SetBanterD
		if module "General GetCountA" == 6.0 goto Chapter1_SetBanterE

	}
		
}
state Chapter1_SetBanterA
{
	actions
	{
		SendToModule "#General" "#CountInc" "#CountASet=9"
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj3" "#AutoDestroy" 
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj4" "#AutoDestroy" 
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj5" "#AutoDestroy" 
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj6" "#AutoDestroy" 
                CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#D1_ch1_obj7" "#AutoDestroy" 
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=30" "#times=5" 
	
		SetState Chapter1_Process
	}


}

state Chapter1_Phase4ChooseMegaDropType
{
	conditions
	{
		if module "Megatron Dead" == 1.0 goto Chapter1_Complete
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission2

		
		if module "General GetCountB" == 3.0 goto Chapter1_Ph4MegaDropB
		if module "General GetCountB" == 6.0 goto Chapter1_Ph4MegaDropB
		if module "General GetCountB" == 9.0 goto Chapter1_Ph4MegaDropB
		if module "Megatron Health" > 0.11 and
			if module "General GetCountC" == 5.0 goto Chapter1_Ph4MegaDropC
		
		if Timer > 0.1 goto Chapter1_Ph4MegaDropA
		
	}
	actions
	{
		ResetTimer 
	}
}

state Chapter1_Meteors2Start
{
	conditions
	{
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
		
		if Timer > 2.2 and
			if module "Meteorite GetPercentage" == 1.0 and
				if module "Creature GetCountAlive" == 0.0 and
					if module "Meteorite2 GetPercentage" == 1.0 and
						if module "Creature2 GetCountAlive" == 0.0 goto Chapter1_OptimusArrived2
	}
	actions
	{
		ResetTimer
		SendToModule "#General" "#AllowPlayerMovement"
		CreateModule "#Creature" "#Blackout" "#Spline=D6C1FIGHT2BLACKOUT" "#Script=Blackout" "#count=1" "#maxalive=1" "#Type=Blackout" "#SpawnAsVehicle" "#SpawnInLOSInit" "#SetEnergyMax=4500" "#SetEnergy=2500" "#Friend" "#Unstoppable" "#Protect" "#SetPosition=#D6C1_Blackout1" "#AddToRadarOff"
		Idle 0.1 
		SendToModule "#Blackout" "#Script=D6Allies" "#TargetLinkedMod=#Optimus" "#KeyLocation=Off"
		Idle 3.0
		SendToModule "#Optimus" "#DirectSpline=D6LOC2_OPTIMUSGOTO" "#Script=FollowSplineM" "#AddToRadarOff" "#NoHealthBar" "#KeyLocation=Off"
		
		CreateModule "#Creature" "#Creature" "#count=0" "#maxalive=1" "#addtoradaralways" "#Type=DroneCement_a" "#TransformForceRobot" "#KeyLocation=On" "#SetEnergyMax=400" "#Script=MixerDrone" "#ForcePlayerAsOpp"
		CreateModule "#Meteorite" "#Meteorite" "#ModuleTag=#Creature" "#Spline=D6LOC2_Meteors" "#Time=3"
		CreateModule "#Creature" "#Creature2" "#count=0" "#maxalive=1" "#addtoradaralways" "#Type=DroneTowTruck_a" "#TransformForceRobot" "#KeyLocation=On" "#Script=TowTruckDrone" "#ForcePlayerAsOpp"
		CreateModule "#Meteorite" "#Meteorite2" "#ModuleTag=#Creature2" "#Spline=D6LOC2_Meteors" "#Time=10" 
		Idle 4.0 
		SendToModule "#Creature" "#ForcePlayerAsOpp"
		Idle 7.0
		SendToModule "#Creature2" "#ForcePlayerAsOpp"
		Idle 20.0
		SendToModule "#Blackout" "#Script=FlyOff_I"
	}
}

state Chapter1_OptimusArrived2
{
	conditions
	{
		;if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
	}
	actions
	{

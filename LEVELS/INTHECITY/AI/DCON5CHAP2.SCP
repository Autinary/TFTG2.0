;;	{
;;		if module "General VideoFinished" == 1.0 goto Chapter2_Main
;;	}
;;	actions
;;	{
;;		DestroyAllModules 
;;		SendToModule "#General" "#EndMissionIntro" "#StartIntroVideo=#D5C2Intro1"
;;	}
;;}
state Chapter2_Main
{
	actions
	{
		SetMusic "ACTION Mission2_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter2_DeathFailMission"
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D5_ch2_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		SendToModule "#General" "#ResetLevel" "#SetPlayer=#Chapter2Start" "#FadeUp"
		CreateModule "#Creature" "#Creature" "#Count=0" "#MaxAlive=19" "#Type=EnergonDrone" "#SpawnInLosInit" "#SpawnAsCreature" "#AddToRadar" "#Script=EnergonDrone" ; "#SetEnergyMax=350"
		CreateModule "#SplineObj" "#SplineObj" "#String=EnergonCube" "#Spline=D5C2EnergonStart" "#Wobble=2.0" "#Creature=#Creature" "#SpawnTime=0.0" "#Radar" "#NoDraw"
		CreateModule "#DroneCounter" "#DroneCounter" "#ModuleTag=#Creature" "#IconType=#Drone" "#DronesToDefeat=-1"
		CreateModule "#Timer" "#Timer" "#Time=3.0" "#NoRender"
		
		SendToModule "#General" "#SetMaxOpponents=19" "#SetMaxApproachers=19" "#SetAttackRingSize=20"
		SendToModule "#General" "#ForceHealthSpawnMin=0.8" "#ForceHealthSpawnMed=0.45" "#ForceHealthSpawnMax=0.1"
		
		SendToModule "#General" "#ResponseLv_Mission"                   ; reset/default values for mission
		SendToModule "#General" "#ResponseLv_SetCurrent = 2"            ; starting response lv (1-5) - (0 = OFF)
		SendToModule "#General" "#ResponseLv_ClampMin   = 2"            ; lowest the response can reach
		SendToModule "#General" "#ResponseLv_ClampMax   = 3"            ; maximum the response can reach
		SendToModule "#General" "#ResponseLv_Detection  = 0"            ; level set once place is 'detected' as a robot (0 = OFF)
		SendToModule "#General" "#ResponseLv_MissionSet"                ; update/set the scripted values for mission
		
		CreateModule "#KeyLocation" "#KeyLocation" "#Spline=D5C2KeyLoc" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER" 
		
		SetState Chapter2_SpawnPos1
	}
}
state Chapter2_SpawnPos1
{
	conditions
	{
		if module "Timer" <= 0.0 and
		if module "Creature GetCountAlive" == 0.0 goto Chapter2_Complete
		
		if module "KeyLocation FailMission" == 1.0 goto Chapter2_FailMission

		if module "SplineObj StopSpawn" == 1.0 goto Chapter2_Pos1toPos2
	}
	actions
	{
		;;SPAWN CREATURES
		SendToModule "#SplineObj" "#Creature=#Creature" "#MaxAlive=19" "#StartSpawn=7" "#SpawnSpline=D5C2SPAWNA" "#ForcePlayerAsOpp"
	}
}

state Chapter2_Pos1toPos2
{
	conditions
	{
		if module "Timer" <= 0.0 and
		if module "Creature GetCountAlive" == 0.0 goto Chapter2_Complete
		
		if module "KeyLocation FailMission" == 1.0 goto Chapter2_FailMission

		if module "SplineObj" == 1.0 goto Chapter2_SpawnPos2
	}
	actions
	{
		;;Move Energon Cube
		SendToModule "#SplineObj" "#Spline=D5C2Pos1ToPos2" "#Time=0.3" "#Start" "#StopSpawn"
	}
}


		SendToModule "#AAGunBoneCrusher" #AddToRadarOff "#Type=AAGUNTYPE_LASER" "#Placement=D3C4BR4" "#Range=100.0" "#Delay=0.0" "#Energy=250.0" "#RespawnDelay=-1" "#Ammo=0" "#TargetModuleTag=#BoneCrusherEscape"  "#IgnorePlayer" "#Create=Shilka"  
		SendToModule "#AAGunBoneCrusher" "#InVulnerable"

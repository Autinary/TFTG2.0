state Chapter4_BrawlCP5 
{
	conditions
	{
		if module "General GetCountB" <= 3.0 goto Chapter4_BrawlArrivedAtEndFirst
		if module "General GetCount" == 1.0 goto Chapter4_Escaping
	}
	actions 
	{
 		SendToModule #D3C4KeyLocBrawl #NoProcess #NoRender
		SendToModule "#BrawlEscape" "#TransformForceCar"
		SendToModule "#General" "#SetStateBit=0"
		SendToModule "#BrawlEscape" #RegenHealth=3
		SendToModule "#BrawlEscape" "#DirectSpline=D3C4_Brawl5" "#Object=#GreenMediumDot" "#type=Brawl" "#SplineStep=0" "#Invulnerable" "#Speed=40"
		SendToModule "#General" "#CountASet=5"
		Idle 0.1
		SetState Chapter4_Escaping
	}
}

state Chapter4_DeathFailMission
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter4_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter4_FailMission
{
	conditions
	{
		if module "General GetFinishedMissionFail" == 1.0 goto Chapter4_Restart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#FailMission"
	}
}
state Chapter4_Restart
{
	actions
	{
        DestroyAllModules "#IncludeProtected"
        SendToModule "#General" "#UnLoadCreature=BoneCrusher"
        SendToModule "#General" "#UnLoadCreature=Brawl"
		SendToModule "#General" "#PlayerType=StarScream,StarScream,StarScream,StarScream,StarScream"
        SendToModule "#General" "#ResetLevelCharacters"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#Chapter4Restart" "#FadeUp"
		SetState "GlobalActionRing"
	}
}
state Chapter4_AltIntoComplete
{
	conditions 
	{
		if module "Timer FailMission" == 1.0 goto Chapter4_Complete
	}
	actions 
	{
		SendToModule #D3C4KeyLocBrawl #NoProcess #NoRender
		SendToModule "#BrawlEscape" "#TransformForceCar"
		SendToModule "#General" "#SetStateBit=0"
		SendToModule "#BrawlEscape" #RegenHealth=3
		SendToModule "#BrawlEscape" "#DirectSpline=D3C4_Brawl5" "#Object=#GreenMediumDot" "#type=Brawl" "#SplineStep=0" "#Invulnerable" "#Speed=40"
		SendToModule "#General" "#CountASet=5"

		CreateModule "#Timer" "#Timer" "#Time=5" "#NoDraw"
	}
}
state Chapter4_IntoComplete
{
	conditions 
	{
		if module "Timer FailMission" == 1.0 goto Chapter4_Complete
	}
	actions 
	{
		SendToModule #D3C4KeyLocBoney #NoProcess #NoRender
		SendToModule "#BoneCrusherEscape" "#TransformForceCar"
		SendToModule "#General" "#SetStateBit=1"
		SendToModule "#BoneCrusherEscape" #RegenHealth=3
		SendToModule "#BoneCrusherEscape" "#DirectSpline=D3C4_BC5" "Range=5.0" "#Object=#GreenMediumDot" "#SplineStep=0" "#Invulnerable" "#Speed=40"

		CreateModule "#Timer" "#Timer" "#Time=5" "#NoDraw"
	}
}
state Chapter4_Complete
{
	conditions
	{
		if module "General GetStartOutro" == 1.0 goto Chapter4_CompleteVideo
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#SetPosition=COMPPOINT4" "#Spline=COMCAM4" "#SetFocus=CAMFOCUS4"
		SendToModule #General #UnlockBonus=Character_Brawl
		SendToModule #General #UnlockBonus=Character_StarScream
		SendToModule #General #UnlockBonus=Mission_ThirdMission
		SendToModule "#General" "#CompleteMission" "#LevelCompleteAchievement"
		SendToModule "#ActionRing" "#SetCompleted=#Chapter4" "#Unlock=#Chapter4"
		CreateModule "#Speech" "#DefeatDrones" "#speech=#D3_ch4_cmplt" "#PlayDelay=1.2" "#AutoDestroy" "#Start"
	}
}
state Chapter4_CompleteVideo
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter4_CompleteVideoLink
	}
	actions
	{	
		IncreasePlayerHealth max
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartOutroVideo=#D3C4Outro1"
	}
}
state Chapter4_CompleteVideoLink
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter4_CompleteVideoFinished
	}
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#StartOutroVideo=#D3C4Outro2"
	}
}
state Chapter4_CompleteVideoFinished
{
	conditions
	{
;		if module "General GetFinishedOutro" == 1.0 goto Chapter4_Leave
	}
	actions
	{
		SendToModule "#General" "#UnLoadCreature=Brawl"
		SendToModule "#General" "#UnLoadCreature=BoneCrusher"
		SendToModule "#General" "#PlayerType=StarScream,StarScream,StarScream,StarScream,StarScream"

		SendToModule "#General" "#FinishedOutroVideo"
		SendToModule "#General" "#FinishedLevel"
		SetState Chapter4_Leave		
	}
}
state Chapter4_Leave
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		IncreasePlayerHealth max
		SendToModule "#General" "#SetPlayerDeathPoint=#COMPPOINT4"
		SendToModule #General #AllowPlayerMovement "#CountCSet=0"
		SetState PickGoto
	}
}

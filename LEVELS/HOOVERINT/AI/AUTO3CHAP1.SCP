state Chapter1_DecepticonAmbush2Done
{
	conditions
	{
		if module "DoorC GetPercentageComplete" == 1.0 goto Chapter1_DecepticonAmbush22
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
		;if module "Barricade Dead" == 1.0 goto Chapter1_DecepticonAmbush3
		if module "Barricade IsEnergyAtMin" == 1.0 goto Chapter1_DecepticonAmbush3

		if Timer > 15.0 and
			if module "DroneScout1 Energy" <= 0.0 and
				if module "DroneScout2 Energy" <= 0.0 goto Chapter1_DecepticonAmbush2DoneA
				
	}
	actions
	{	

		ResetTimer
		Idle 15.0 
		SetState Chapter1_DecepticonAmbush2DoneA

	}


}
state Chapter1_DecepticonAmbush2DoneA
{
	conditions
	{
		if module "DoorC GetPercentageComplete" == 1.0 goto Chapter1_DecepticonAmbush22
		if module "KeyLocation FailMission" == 1.0 goto Chapter1_FailMission
		;if module "Barricade Dead" == 1.0 goto Chapter1_DecepticonAmbush3
		if module "Barricade IsEnergyAtMin" == 1.0 goto Chapter1_DecepticonAmbush3

		if Timer > 1.0 and
			if module "DroneScout1 Energy" <= 0.0 and
				if module "DroneScout2 Energy" <= 0.0 goto Chapter1_DecepticonAmbush2Done
				
	}
	actions
	{	

		ResetTimer
		SendToModule "#DroneScout1" "#count=1" 
		SendToModule "#DroneScout2" "#count=1" 

	}


}


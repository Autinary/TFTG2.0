 state Chapter4_HubRestart
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SendToModule "#General" "#ResetAll" "#SetPlayer=#StartMission" "#FadeUp"
		SetState "Chapter4_Goto"
	}
}
state Chapter4_HubDeath
{
	conditions
	{
		if module "General GetFinishedMissionDeathFail" == 1.0 goto Chapter4_HubRestart
	}
	actions
	{
		SendToModule "#General"  "#EndOfMission" "#DeathFailMission"
	}
}
state Chapter4_InitGoto
{
	actions
	{
		DestroyAllModules "#IncludeProtected"
		SetState "Chapter4_Goto"
	}
}
state Chapter4_Goto
{
	actions
	{
		SendToModule "#General" "#AllowPlayerMovement"
		Idle 2.0
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A2_ch4_Goto" "#AutoDestroy" "#Start"
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A2_ch4_Goto2" "#AutoDestroy" 
		CreateModule "#Speech" "#GotoReminderSpeech" "#speech=#A2_ch4_obj3" "#AutoDestroy"
		Idle 3.0
		
		DestroyModule "#MissionStartSpeech"
		SendToModule "#General" "#BG_LoadCreature=DroneDefault"
		CreateModule "#Timer" "#PrimeReply" "#Time=5.3" "#NoRender"
		CreateModule "#DelayedSend" "#DelayedSendReminder" "#moduletag=#GotoReminderSpeech" "#param=#start" "#delay=60" "#times=2" 
		CreateModule "#AndSwitch" "#AndSwitchReminder" "#moduletag=#DelayedSendReminder" "#placement=#Chapter4Beacon" "#rangeoutside=75"
		SetState "GlobalActionRing"
	}
}
state Chapter4_Enter
{
	conditions
	{
;;		if Timer > 0.8 goto Chapter4_LoadCreatures
		if module "General GetMissionIntroTextFadedUp" == 1.0 goto Chapter4_LoadCreatures
	}
	actions
	{
;;		ResetTimer
		DestroyAllModules 
		SendToModule "#General" "#StartMissionIntro"
	}
}
state Chapter4_LoadCreatures
{
	conditions
	{
;;		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter4_VideoIntro
		if module "General GetFinishedMissionIntro" == 1.0 goto Chapter4_Main
	}
	actions
	{
		SendToModule "#ActionRing" "#RemoveCreatures"
		SendToModule "#General" "#UnLoadCreature=DroneDefault_a"
		
		SendToModule "#General" "#UnLoadCreature=DroneDefault"
        SendToModule "#General" "#PlayerType=OptimusPrime"
		SendToModule "#General" "#LoadCreature=TripleC" 
		SendToModule "#General" "#LoadCreature=DroneArmouredCar_a" 
		
	}
}
;;state Chapter4_VideoIntro
;;{
;;	conditions
;;	{
;;		if module "General VideoFinished" == 1.0 goto Chapter4_Main
;;	}
;;	actions
;;	{
;;		DestroyAllModules 
;;		SendToModule "#General" "#EndMissionIntro" "#StartVideo=#A2C4Intro1"
;;	}
;;}
state Chapter4_Main
{
	conditions
	{
		;if message "MissionMessage" == 1.0 goto Chapter4_Complete
		;if message "MissionMessage" == 2.0 goto Chapter4_FailMission 
		if module "Trigger InArea" == 1.0 goto Chapter4_FightStage1Start
		;if module "TripleChanger Health" <= 0.99 goto Chapter4_FightStage1Start
		if module "TripleChanger BeenHit" == 1.0 goto Chapter4_FightStage1Start
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter4_FailMission  
	}
	actions
	{
		DestroyAllModules
		
		SetMusic "ACTION Mission4_1 QUIET Generic Play Action"
		SetDeathPoint "Chapter4_DeathFailMission"
		CreateModule "#Speech" "#DefeatDrones" "#GotoReminderSpeech" "#speech=#A2_ch4_obj1" "#AutoDestroy" "#Start" "#GermanWiiAudioFudge"
		SendToModule "#General" "#PhysObj" "#SetPlayer=#Chapter4Start" "#FadeUp"
		CreateModule "#Creature" "#TripleChanger" "#Boss=#TripleChanger" "#Type=TripleCTurret" "#count=1" "#maxalive=1" "#Spline=A2C4Spawn" "#Script=TC_TURRET" "#SpawnInLos" "#SetEnergyMax=7500"  "#SetEnergyMin=250" "#AddToRadarAlways"  "#ResetHealthDiff" "#BlockDeath" "#FollowSpline=TCTURRET_TARGETS" 
		CreateModule "#KeyLocation" "#KeyLocation" "#Creature=#TripleChanger" "#Radius=170.0f" "#String=KEY_LOC_WARNING" "#ReEnterMsg=KEY_LOC_REENTER"
		CreateModule "#Timer" "#Destruction" "#Time=150.0" "#DrawHealthBar" "#HeadType=#Destruction" "#Index=2" "#Random"
		SendToModule "#TripleChanger" "#AddToRadarAlways"
		SendToModule "#General" "#CountASet=1" "#CountBSet=0" "#CountCSet=0" "#CountDSet=0"

		
		
		;SetState Chapter4_FightStage1Start
	}
}


state Chapter4_FightStage1Start
{

	Conditions
	{
		if module "TripleChanger Health" <= 0.95 goto Chapter4_FightTransform1
		if module "KeyLocation FailMission" == 1.0 goto Chapter4_FailMission
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter4_FailMission
	}
	Actions
	{
		
		  
				
	}
}

state Chapter4_MainProcess
{
	conditions
	{
		;TRIPLECHANGER DRONE FIGHT CONSTANT CONDITIONS 

		if module "A2C4Spawn Dead" == 1.0 goto Chapter4_Chatter
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter4_FailMission
		if module "A2C4KeyLoc FailMission" == 1.0 goto Chapter4_FailMission
		
		
	
		
	
		if module "A2C4Spawn HealthDiff" > 0.10 and
			if module "General GetCountD" == 1.0 goto Chapter4_FightTransform2

		if module "Timer Finished" == 1.0 and
				if module "General GetCountB" == 1.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackEscapeTo2

		if module "A2C4KeyLoc InArea" == 0.0 and
				if module "General GetCountB" == 1.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackRampageReturn1

		if module "A2C4KeyLoc InArea" == 1.0 and
				if module "General GetCountB" == 2.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFightReturn1

	

		
		
		

		
		
	}
	

}
state Chapter4_MainProcess2
{
	conditions
	{
		;TRIPLECHANGER DRONE FIGHT CONSTANT CONDITIONS 

		if module "A2C4Spawn Dead" == 1.0 goto Chapter4_Chatter
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter4_FailMission
		if module "A2C4KeyLoc FailMission" == 1.0 goto Chapter4_FailMission
		
		if module "A2C4Spawn Complete" == 1.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 0.0 goto Chapter4_TripleCStrikesBackShoot2
	
				
		
		if module "A2C4Spawn PlayerRange" < 15.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFight2

		if module "A2C4Spawn BeenHit" == 1.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFight2
		

		
	
		if module "A2C4Spawn HealthDiff" > 0.10 and
			if module "General GetCountD" == 1.0 and
				if module "General GetCountB" == 1.0 goto Chapter4_TripleCStrikesBackEscapeTo3

		if module "Timer Finished" == 1.0 and
				if module "General GetCountB" == 1.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackEscapeTo3

		if module "A2C4KeyLoc InArea" == 0.0 and
				if module "General GetCountB" == 1.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackRampageReturn2

		if module "A2C4KeyLoc InArea" == 1.0 and
				if module "General GetCountB" == 2.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFightReturn2

	

		
		
		


		
				
	}
	actions
	{
		ResetTimer
	}

}
state Chapter4_MainProcess3
{
	conditions
	{
		;TRIPLECHANGER DRONE FIGHT CONSTANT CONDITIONS 

		if module "A2C4Spawn Dead" == 1.0 goto Chapter4_Chatter
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter4_FailMission
		if module "A2C4KeyLoc FailMission" == 1.0 goto Chapter4_FailMission
		
		if module "A2C4Spawn Complete" == 1.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 0.0 goto Chapter4_TripleCStrikesBackShoot3

		
						
		if module "A2C4Spawn PlayerRange" < 15.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFight3

		if module "A2C4Spawn BeenHit" == 1.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFight3
		

		
	
		if module "A2C4Spawn HealthDiff" > 0.10 and
			if module "General GetCountD" == 1.0 and
				if module "General GetCountB" == 1.0 goto Chapter4_TripleCStrikesBackEscapeTo4

		if module "Timer Finished" == 1.0 and
				if module "General GetCountB" == 1.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackEscapeTo4

		if module "A2C4KeyLoc InArea" == 0.0 and
				if module "General GetCountB" == 1.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackRampageReturn3

		if module "A2C4KeyLoc InArea" == 1.0 and
				if module "General GetCountB" == 2.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFightReturn3

	

		
		

		;RATCHET CONDITIONS	
	
		if module "Ratchet PlayerRange" < 30 and
			if module "General GetCountA" == 1.0 goto Chapter4_Heal
		if module "Ratchet GetCountAlive" == 0.0 goto Chapter4_FailMission
		if module "Ratchet Dead" == 1.0 goto Chapter4_FailMission		
		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter4_FailMission		
		
		

		;VARIOUS SCRIPT CHANGE CONDITIONS

		if Timer > 7.0 and
			if module "General GetCountC" == 1.0 goto Chapter4_TripleCThrowsObject3


		
		if Timer > 3.0  and
			if module "General GetCountC" == 2.0 goto Chapter4_TripleCThrowsObject4
		
		

		
		
	}
	actions 
	{
		ResetTimer
	}

}
state Chapter4_MainProcess4
{
	conditions
	{
		;TRIPLECHANGER DRONE FIGHT CONSTANT CONDITIONS 

		if module "A2C4Spawn Dead" == 1.0 goto Chapter4_Chatter
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter4_FailMission
		if module "A2C4KeyLoc FailMission" == 1.0 goto Chapter4_FailMission
		
		if module "A2C4Spawn Complete" == 1.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 0.0 goto Chapter4_TripleCStrikesBackShoot4

		

		if module "A2C4Spawn PlayerRange" < 15.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFight4

		if module "A2C4Spawn BeenHit" == 1.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFight4
		

		
	
		if module "A2C4Spawn HealthDiff" > 0.10 and
			if module "General GetCountD" == 1.0 and
				if module "General GetCountB" == 1.0 goto Chapter4_TripleCStrikesBackEscapeTo5

		if module "Timer Finished" == 1.0 and
				if module "General GetCountB" == 1.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackEscapeTo5

		if module "A2C4KeyLoc InArea" == 0.0 and
				if module "General GetCountB" == 1.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackRampageReturn4

		if module "A2C4KeyLoc InArea" == 1.0 and
				if module "General GetCountB" == 2.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFightReturn4

	

		
		

		;RATCHET CONDITIONS	
	
		if module "Ratchet PlayerRange" < 30 and
				if module "General GetCountA" == 1.0 and
					if module "General GetCountD" == 0.0 goto Chapter4_Heal2
		
		if module "Ratchet IsEnergyAtMin" == 1.0 goto Chapter4_FailMission		
		if module "Ratchet Dead" == 1.0 goto Chapter4_FailMission		
		
	
		

		
		
	}
	actions
	{
		ResetTimer
	}

}
state Chapter4_MainProcess5
{
	conditions
	{
		;TRIPLECHANGER DRONE FIGHT CONSTANT CONDITIONS 

		if module "A2C4Spawn Dead" == 1.0 goto Chapter4_Chatter
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter4_FailMission
		if module "A2C4KeyLoc FailMission" == 1.0 goto Chapter4_FailMission
		
		if module "A2C4Spawn Complete" == 1.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 0.0 goto Chapter4_TripleCStrikesBackShoot5


		

		if module "A2C4Spawn PlayerRange" < 15.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFight5

		if module "A2C4Spawn BeenHit" == 1.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFight5
		

		
	
		if module "A2C4Spawn HealthDiff" > 0.10 and
			if module "General GetCountD" == 1.0 and
				if module "General GetCountB" == 1.0 goto Chapter4_TripleCStrikesBackEscapeTo6

		if module "Timer Finished" == 1.0 and
				if module "General GetCountB" == 1.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackEscapeTo6

		if module "A2C4KeyLoc InArea" == 0.0 and
				if module "General GetCountB" == 1.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackRampageReturn5

		if module "A2C4KeyLoc InArea" == 1.0 and
				if module "General GetCountB" == 2.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFightReturn5

	

		
		

		
		


		
	}
	actions
	{
		ResetTimer
	}		

}
state Chapter4_MainProcess6
{
	conditions
	{
		;TRIPLECHANGER DRONE FIGHT CONSTANT CONDITIONS 

		if module "A2C4Spawn Dead" == 1.0 goto Chapter4_Chatter
		if module "Destruction GetPercentageComplete" == 1.0 goto Chapter4_FailMission
		if module "A2C4KeyLoc FailMission" == 1.0 goto Chapter4_FailMission
		
		if module "A2C4Spawn Complete" == 1.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 0.0 goto Chapter4_TripleCStrikesBackShoot6

		


		if module "A2C4Spawn PlayerRange" < 15.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFight7

		if module "A2C4Spawn BeenHit" == 1.0 and
				if module "General GetCountB" == 0.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFight7
		

		
	
		if module "A2C4Spawn HealthDiff" > 0.10 and
			if module "General GetCountD" == 1.0 and
				if module "General GetCountB" == 1.0 goto Chapter4_TripleCStrikesBackEscapeTo2

		if module "Timer Finished" == 1.0 and
				if module "General GetCountB" == 1.0 and
					if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackEscapeTo2

		if module "A2C4KeyLoc InArea" == 0.0 and
			if module "General GetCount" == 6.0 and
					if module "General GetCountB" == 1.0 and
						if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackRampageReturn6

		if module "A2C4KeyLoc InArea" == 1.0 and
			if module "General GetCount" == 6.0 and
					if module "General GetCountB" == 2.0 and
						if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFightReturn6

	
		if module "A2C4KeyLoc InArea" == 0.0 and
			if module "General GetCount" == 7.0 and
					if module "General GetCountB" == 1.0 and
						if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackRampageReturn7

		if module "A2C4KeyLoc InArea" == 1.0 and
			if module "General GetCount" == 7.0 and
					if module "General GetCountB" == 2.0 and
						if module "General GetCountD" == 1.0 goto Chapter4_TripleCStrikesBackFightReturn7
		
		

		;VARIOUS SCRIPT CHANGE CONDITIONS
		
		
		
		if Timer > 4.0 and
			if module "General GetCountB" == 1.0 and
					if module "General GetCountC" == 4.0 goto Chapter4_TripleCThrowsObject1
		
		
		if Timer > 3.0 and
			if module "General GetCountB" == 1.0 and
				if module "General GetCountC" == 5.0 goto Chapter4_TripleCThrowsObject2
		
		
		
		if Timer > 7.0 and
			if module "General GetCountB" == 1.0 and
				if module "General GetCountC" == 3.0 goto Chapter4_TripleCThrowsObject1
		


		
	}
	actions 
	{
		ResetTimer
	}

}


state Chapter4_FightTransform1
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter4_FightStage2Start
	}
	Actions
	{
		SendToModule "#General" "#StartVideo=#A2C4midtro1"
	}
}
state Chapter4_FightTransform2
{
	conditions
	{
		if module "General VideoFinished" == 1.0 goto Chapter4_TripleCFlysOff 
	}
	Actions
	{
		SendToModule "#General" "#StartVideo=#A2C4midtro2" 
	}
}
state Chapter4_FightStage2Start
{
	Actions
	{
		DestroyModule "#Creature"
		DestroyModule "#KeyLocation"

		SetState Chapter4_TripleCStrikesBackInit
	}
}


state Chapter4_TripleCStrikesBackInit
{
	actions
	{
		DestroyModule "#TripleChanger"

		CreateModule "#Goto" "#A2C4Spawn" "#SpawnSpline=A2C4Spawn" "#Boss=#TripleChanger" "#type=TripleC" "#BlockDeath" "#SetEnergyMax=15000.0" "#SetEnergy=14250.0" "#InhibitRubble"
		CreateModule "#KeyLocation" "#A2C4KeyLoc" "#Spline=A2C4KeyLoc1" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key4Return"

		CreateModule "#Speech" "#A2_ch4_obj5" "#speech=#A2_ch4_obj5" "#AutoDestroy"
		CreateModule "#Speech" "#A2_ch4_obj6" "#speech=#A2_ch4_obj6" "#AutoDestroy"
		CreateModule "#Speech" "#A2_ch4_obj7" "#speech=#A2_ch4_obj7" "#AutoDestroy"
		CreateModule "#Speech" "#A2_ch4_obj8" "#speech=#A2_ch4_obj8" "#AutoDestroy"
		CreateModule "#Speech" "#A2_ch4_obj9" "#speech=#A2_ch4_obj9" "#AutoDestroy"
		CreateModule "#Speech" "#A2_ch4_obj10" "#speech=#A2_ch4_obj10" "#AutoDestroy"

		SetState Chapter4_TripleCStrikesBackFight1
	}
}



state Chapter4_TripleCStrikesBackFight1
{
	
	actions
	{
		SetMusic "ACTION Mission4_1 QUIET Generic Play Action"
		CreateModule "#Speech" "#DefeatDrones" "#speech=#A2_ch4_obj4" "#AutoDestroy" "#Start"
		CreateModule "#Timer" "#Timer" "#Time=20.0" "#NoRender"
		SendToModule "#A2C4Spawn" "#Script=Combat"  "#ResetHealthDiff" "#ShootSpline=null"
		SendToModule "#Destruction" "#NoProcess"
		SendToModule "#General" "#CountSet=1" "#CountBSet=1" "#CountDSet=1"
		SetState Chapter4_MainProcess
	}
}
state Chapter4_TripleCStrikesBackFightReturn1
{
	
	actions
	{
		
		SendToModule "#A2C4Spawn" "#Script=Combat"  "#ShootSpline=null"
		SendToModule "#Destruction" "#NoProcess"
		SendToModule "#General" "#CountBSet=1"
		SetState Chapter4_MainProcess
		
	}
}
state Chapter4_TripleCStrikesBackRampageReturn1
{
	
	actions
	{
	
		SendToModule "#A2C4Spawn" "#Script=Shooty" "#ShootSpline=A2C4Shoot1"
		SendToModule "#Destruction" "#Process"
		SendToModule "#General" "#CountBSet=2"
		SetState Chapter4_MainProcess
		
	}
}
state Chapter4_TripleCFlysOff
{
	conditions
	{
		
	}
	Actions
	{
		DestroyModule "#A2C4Spawn" 
		CreateModule "#Goto" "#A2C4Spawn" "#SpawnSpline=A2C4Spawn" "#Boss=#TripleChanger" "#type=TripleC" "#BlockDeath" "#SetEnergyMax=15000.0" "#SetEnergy=13500.0" "#InhibitRubble" "#SpawnAsVehicle"
		SetState Chapter4_TripleCStrikesBackEscapeTo2
	}
}

state Chapter4_TripleCStrikesBackEscapeTo2
{
	
	actions
	{
		;SendToModule "#General" "#BG_LoadCreature=Jazz"
		SendToModule "#Ratchet" "#AddToRadarOff"
		SetMusic "ACTION Mission4_2 QUIET Generic Play Action"
		SendToModule "#Destruction" "#NoProcess"
		DestroyModule "#A2C4KeyLoc"
		DestroyModule "#Timer"
		SendToModule "#A2C4Spawn" "#Script=FollowSplineTC" "#DirectSpline=A2C4FlyToLoc2" "#TransformForceCar" "#Speed=150" "#ResetHealthDiff" "#Unstoppable"
		SendToModule "#A2_ch4_obj5" "#StartOneShot=2.0"
		SendToModule "#General" "#CountSet=2" "#CountBSet=0" "#CountCSet=0" "#CountDSet=0"
		SetState Chapter4_MainProcess2
	}
}

state Chapter4_TripleCStrikesBackShoot2
{
	conditions
	{
		;if Timer > 1.0 and
		if module "A2C4Spawn PlayerRange" > 130.0 goto Chapter4_TripleChangerArtilleryPrep
		if module "A2C4Spawn PlayerRange" < 150.0 goto Chapter4_MainProcess2
	}
	actions
	{	
		ResetTimer
		CreateModule "#KeyLocation" "#A2C4KeyLoc" "#Spline=A2C4KeyLoc2" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key4Return"
		SendToModule "#A2C4Spawn" "#Script=Shooty" "#TransformForceRobot" "#ShootSpline=A2C4Shoot2" "#Stoppable" 
		SendToModule "#Destruction" "#Process"
		SendToModule "#General" "#CountDSet=1"
		;SetState Chapter4_MainProcess2
	}
}
state Chapter4_TripleChangerArtilleryPrep
{
	actions
	{
		SetMusic "ACTION Mission4_3 QUIET Generic Play Action"
		Idle 1.5
		SetState Chapter4_TripleChangerArtillerySetHealthLevel	


	}
	
}
state Chapter4_TripleChangerArtillerySetHealthLevel
{
	conditions
	{
		if module "A2C4Spawn Energy" > 0.9 goto TripleCArtHealth100
		if module "A2C4Spawn Energy" == 0.9 goto TripleCArtHealth90
		if module "A2C4Spawn Energy" > 0.8 goto TripleCArtHealth90
		if module "A2C4Spawn Energy" == 0.8 goto TripleCArtHealth80
		if module "A2C4Spawn Energy" > 0.7 goto TripleCArtHealth80
		if module "A2C4Spawn Energy" == 0.7 goto TripleCArtHealth70
		if module "A2C4Spawn Energy" > 0.6 goto TripleCArtHealth70
		if module "A2C4Spawn Energy" == 0.6 goto TripleCArtHealth60
		if module "A2C4Spawn Energy" > 0.5 goto TripleCArtHealth60
		if module "A2C4Spawn Energy" == 0.5 goto TripleCArtHealth50
		if module "A2C4Spawn Energy" > 0.4 goto TripleCArtHealth50
		if module "A2C4Spawn Energy" == 0.4 goto TripleCArtHealth40

state Chapter4_MainDFight
{
	conditions
	{
		if module "D2C4SpawnD Health" < 0.01 goto Chapter4_BumbleBeeDead
		if module "D2C4SpawnD Dead" == 1.0 goto Chapter4_BumbleBeeDead
;		if module "D2C4SpawnD GetPercentageComplete" == 1.0 goto Chapter4_Complete
		if module "Creature GetPercentageComplete" == 1.0 goto Chapter4_DronesDead
		if module "D2C4KeyLocD FailMission" == 1.0 goto Chapter4_FailMission
		if Timer > 1.2 goto Chapter4_MainDFight2
		;if module "D2C4SpawnD IsEnergyAtMin" == 1.0 goto Chapter4_BeeShotGunner
	}
	actions
	{

		ResetTimer
		SetMusic "ACTION Mission4_1 QUIET Generic Play Action"
		DestroyAllModules
		CreateModule "#Creature" "#Creature" "#Type=DroneDefault_a" "#Spline=D2C4Spawn4" "#count=10" "#maxalive=3" "#addtoradar" "#SpawnAsCreature" "#KeyLocation=On"
		CreateModule "#Speech" "#D2C4DefeatBumblebee" "#speech=#D2_ch4_obj3" "#AutoDestroy" "#Start"
		SendToModule "#General" "#SetPlayer=#D2C4FightPosBC3"
		CreateModule "#Creature" "#D2C4SpawnD" "#Spline=D2C4SpawnD" "#Boss" "#Type=BumbleBee" "#SpawnInLosInit" "#SpawnAsCreature" "#AddToRadarAlways" "#BlockDeath" "#Script=Advanced" "#SetPosition=#D2C4FightPosBB3"
		;SendToModule "#D2C4SpawnD" "#SetEnergyMax=1500" "#SetHealth=1500" "#SetEnergyMin=1400"
		CreateModule "#KeyLocation" "#D2C4KeyLocD" "#Creature=#D2C4SpawnD" "#String=KEY_LOC_WARNING" "#ReEnterMsg=Key2Return" "#HeadType=#StarScream" "#Radius=150"
		;SendToModule "#General" "#SetPlayer=#D2C4Repos1"
		SendToModule "#Creature" "#ForcePlayerAsOpp"
		
	}
}

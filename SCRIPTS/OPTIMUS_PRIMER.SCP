state MeleeStrafeJump
{
	Conditions
	{
		if GotOpponent == 0.0 goto Alert
		if Timer > 4.0 goto Alert
	}
	Actions
	{
		ResetTimer
		CloseStrafe "MinAngle=80" "MaxAngle=140" "Range=6.5" "Time=4.0" "Jump"
		SetState Alert
	}
}

state MeleeStrafeSlam
{
	Conditions
	{
		if GotOpponent == 0.0 goto Alert
		if Timer > 4.0 goto Alert
	}
	Actions
	{
		ResetTimer
		CloseStrafe "MinAngle=80" "MaxAngle=140" "Range=6.5" "Time=4.0" "Jump" "Slam"
		SetState Alert
	}
}

state MeleeStrafeClose
{
	Conditions
	{
		if GotOpponent == 0.0 goto Alert
		if Timer > 4.0 goto Alert
	}
	Actions
	{
		ResetTimer
		CloseStrafe "MinAngle=80" "MaxAngle=140" "Range=5.5" "Time=4.0"
		SetState Alert
	}
}

state MeleeStrafeShoot
{
	Conditions
	{
		if GotOpponent == 0.0 goto Alert
		if Timer > 5.0 goto Alert
	}
	Actions
	{
		ResetTimer
		CloseStrafe "MinAngle=110" "MaxAngle=140" "Range=13.0" "Time=5.0" "RollAway" "Roll" 
		SetState Alert
	}
}

state TakenHitMelee
{
	Conditions
	{
		if AlwaysTrue 0.66 < "ThrashedMelee" AND
		if Ability "Block" == 1.0 AND
		if Param "Aggression" < 0.1 goto BlockAttackBegin

		if Ability "Block" == 1.0 AND
		if BlockRequest "forceonmelee" == 1.0 goto ForceBlock
		
		
		
		if AlwaysTrue == 1.0 goto Alert
	}
	Actions
	{
		ResetTimer
	}
}

state TakenHitPhysics
{
	Conditions
	{
		if BeenStruck == 1.0 goto BeenStruck
		if AlwaysTrue == 1.0 goto Alert
	}
	Actions
	{
		SetLocator "strikesource=20.0"
	}
}

state TakenHitReflect
{
	Conditions
	{
		if AlwaysTrue > "RAND*4.0" goto Overshield_Start
		if Ability "Block" == 0.0 goto Alert
		if AlwaysTrue == 1.0 goto ForceBlock
	}
}

state ForceBlock
{
	Conditions
	{
		if RobotForm == 0.0 goto RollOut
		if AlwaysTrue > "RAND*4.0" goto Overshield_Start
		
		if Timer > 0.01 goto BlockAttackEnd
	}
	Actions
	{
		ResetTimer
		EngageOpponentTC "goalrange=1.0" "firerange=900.0" "RapidShootRange=900.0" "fireId=0" "firetimemin=0.3" "firetimemax=0.5"
		
		SetState BlockAttackEnd
	}
}

state BlockAttackBegin
{
	Conditions
	{
		if DistanceBetweenOpponent "ThirdScaleOnLargeCreature" > 6.0 goto Overshield_Start
	}
	Actions
	{
		SetBlocking "time=0.3" "attackatend" "faceopp"
		SetState Overshield_Start
	}
}
state Overshield_Start
{
	Conditions 
	{
		
	}
	Actions 
	{
		SetPhysicsState "static=false" "immunetoshots=true" "immunetomelee=true" "immunetothrown=true"
		SetState MeleeApproachO
	}
}
state MeleeApproachO
{
	Conditions
	{
		OnMacro AttackPOI goto BlockAttackEnd

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto BlockAttackEnd

		if GotOpponent == 0.0 goto BlockAttackEnd

		if OpponentOverlapTime > 10.0 goto BlockAttackEnd

		if HasPickup == 1.0 goto BlockAttackEnd
		
		
		
		if DistanceBetweenOpponent < AutoMeleeRangeMin goto MeleeAttackO


		if CanApproach == 0.0 goto BlockAttackEnd

		if PickupAvailable == 1.0 AND
		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent < 55 AND
		if DistanceBetweenOpponent > 10 AND
		if Timer > "(3.0+(RAND*3.0)-(6.0*PICKUPRATE))" AND
		if AlwaysTrue 0.8 > "ThrashedPhys" goto BlockAttackEnd

		if Timer > 4.0 goto BlockAttackEnd

		OnMacro StuckTime goto BlockAttackEnd
		OnMacro StuckJump goto BlockAttackEnd
		OnMacro StuckRoll goto BlockAttackEnd
	}
	Actions
	{
		ResetTimer
		SetStrafe
		EngageOpponent "goalrange=0.0" "fireinterval=((0.1-ThrashedMelee)/FIRERATE)" "firerange=90.0" "spread=0.0"
	}
}

state MeleeAttackO
{
	Conditions
	{
		OnMacro AttackPOI goto BlockAttackEnd

		if StickToKeyLocation == 1.0 and
		if OutsideKeyLocation > -10.0 goto BlockAttackEnd

		if GotOpponent == 0 goto BlockAttackEnd

		if OpponentOverlapTime > 10.0 goto BlockAttackEnd

		if CanApproach == 0.0 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto BlockAttackEnd

		
		
		


		if CanApproach == 1.0 AND
		if DistanceBetweenOpponent > AutoMeleeRangeMax goto BlockAttackEnd

		if Timer > 4.0 goto BlockAttackEnd

		OnMacro StuckTime goto BlockAttackEnd
		OnMacro StuckJump goto BlockAttackEnd
		OnMacro StuckRoll goto BlockAttackEnd
	}
	Actions
	{
		ResetTimer 
		SetStrafe false
		EngageOpponent "goalrange=1.0" "firerange=2.0" "instant" "chainwithdelay=0.8" "numshots=1"
		SetState BlockAttackEnd
	}
}

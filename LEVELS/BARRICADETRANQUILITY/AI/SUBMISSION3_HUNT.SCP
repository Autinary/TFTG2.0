state SubMission3_Leave
{
	conditions
	{
		if module "General ChapterProgress" >= 4.0 goto GlobalActionRing
	}
	actions
	{
 		DestroyAllModules "#IncludeProtected"
		;
		SendToModule "#General" "#ResetAll" "#SetPlayer=#SubMission3" "#FadeUp"
		SendToModule "#General" "#UnLoadCreature=DroneTowTruck_a"
		SendToModule "#General" "#UnLoadCreature=DronePickupTruck_a"
		SendToModule "#General" "#UnLoadCreature=Jazz"
		SendToModule "#General" "#UnLoadCreature=OptimusPrime"
		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar_a"
		SendToModule "#General" "#UnLoadCreature=DroneArmouredCar"
		SendToModule "#General" "#UnLoadCreature=BumbleBee"
		SendToModule "#General" "#LoadCreature=DroneDefault_a"
		SendToModule "#General" "#SetRadarInterference=0"	
		Idle 0.2
		SendToModule "#General" "#PlayerType=Barricade,Barricade,Barricade,Barricade,Barricade"
		SendToModule "#General" "#FadeUp"
			
		SetState "GlobalActionRing"
	}
}

		CreateModule "#Creature" "#Dummy2" "#Type=DroneRedWeak"  "#SpawnInLosInit" "#Spline=Spawn4a" "#SetPosition=#Dummy2" "#Count=1" "#MaxAlive=1" "#Script=Early_Combat" "#AddToRadarOff" "#SuppressShield" "#KeyLocation=On"

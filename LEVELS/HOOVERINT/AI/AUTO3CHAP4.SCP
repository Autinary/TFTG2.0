state MegatronPowerAt100
{
	actions
	{
		SendToModule "#MegatronThawTime" "#SetEnergy=100.0" "#SetEnergyMin=100.0"
		
		SendToModule "#General" "#CountCInc"
		SetState Chapter4_MegaTronAwakesMidtro
	}
}
state Chapter4_Barricade
{
	conditions
	{
		;if Timer > 3.0 goto Chapter4_MegaTronAwakes3
		if module "KeyLocation FailMission" == 1.0 goto Chapter4_FailMission
	}
	actions 
	{
		;ResetTimer 
		DestroyModule "#TimerC"
		CreateModule "#Timer" "#TimerD" "#Time=30" "#NoRender"
		CreateModule "#Creature" "#Barricade" "#spline=A3C4SpawnA" "#Type=Barricade" "#maxalive=1" "#count=1" "#FollowPlayer" "#SpawnInLOSInit" "#SpawnAsVehicle" "#SpawnAsleep" "#BlockDeath" "#SetEnergyMax=600" "#SetEnergy=600" "#AddToRadarOff" "#Script=LeapPunch"
		SendToModule "#CreatureWaveD" "#maxalive=2" "#SetEnergyMax=500" "#Script=Advanced"
		SendToModule "#CreatureWaveF" "#SetEnergyMax=500" "#Script=Advanced"
		Idle 3.0 
		SendToModule "#General" "#SetMessage=HIntD9" "#SetMessageTimer=3.0"
		SendToModule "#Barricade" "#ForceTransformRobot" ; "#Script=TripleChanger"
		
		SetState "Chapter4_MegaTronAwakes"
	}
}

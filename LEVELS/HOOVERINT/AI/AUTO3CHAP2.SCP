		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelAExp2" "#SetSplineType=#DustMedium" "#SetBitRadius=225"
		SendtoModule "#A3C2TunnelA" "#BitSpline=A3C2TunnelAExp3" "#SetSplineType=#DustLarge" "#SetBitRadius=205"
